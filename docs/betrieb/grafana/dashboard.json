{
  "uid": "hermes-betrieb",
  "title": "Hermes Betrieb",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP-Antwortzeit p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hermes_http_server_duration_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
