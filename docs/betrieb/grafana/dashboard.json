{
  "uid": "hermes-betrieb",
  "title": "Hermes Betrieb",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP-Antwortzeit p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hermes_http_server_duration_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Anbieter-Dauer p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hermes_anbieter_dauer_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Anbieter-Aufrufe je Sekunde",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hermes_anbieter_aufrufe_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Event-Loop-Verzögerung p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hermes_eventloop_delay_p99)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event-Loop-Verzögerung max",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hermes_eventloop_delay_max)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB-Pool offen",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hermes_db_pool_open)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DB-Pool wartend",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hermes_db_pool_waiting)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Warteschlange Länge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hermes_queue_length)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Warteschlange ältester Eintrag",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hermes_queue_oldest_age)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Leitungen belegt je Anbieter",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (anbieter) (hermes_lines_occupied)",
          "legendFormat": "{{anbieter}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Leitungen Kapazität je Anbieter",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (anbieter) (hermes_lines_capacity)",
          "legendFormat": "{{anbieter}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Gestartete Anrufe je Sekunde",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(hermes_call_started_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Abgelehnte Anrufe je Sekunde",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (grund) (rate(hermes_call_denied_total[5m]))",
          "legendFormat": "{{grund}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Beendete Anrufe je Sekunde nach Ergebnis und Grund",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction, ergebnis, grund) (rate(hermes_call_ended_total[5m]))",
          "legendFormat": "{{direction}} {{ergebnis}} {{grund}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Gespraechsdauer p95 (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, direction) (rate(hermes_call_duration_bucket[5m])))",
          "legendFormat": "{{direction}}"
        }
      ]
    }
  ]
}
