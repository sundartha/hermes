[
  {
    "uid": "heartbeat-fehlt",
    "title": "Heartbeat fehlt: keine Messwerte von Hermes",
    "condition": "C",
    "data": [
      {"refId":"A","relativeTimeRange":{"from":600,"to":0},"datasourceUid":"prometheus","model":{"refId":"A","expr":"count(hermes_eventloop_delay_p99) or vector(0)"}},
      {"refId":"C","datasourceUid":"__expr__","model":{"refId":"C","type":"threshold","expression":"A","conditions":[{"evaluator":{"type":"lt","params":[1]}}]}}
    ],
    "soll": {"vergleich":"lt","wert":1,"dauer":"5m","ohneDaten":"Alerting"},
    "noDataState": "Alerting",
    "for": "5m",
    "labels": {"bereich":"betrieb"},
    "annotations": {"summary":"Heartbeat fehlt: keine Messwerte von Hermes","runbook_url":"docs/betrieb/alarme/heartbeat-fehlt.md"},
    "notification_settings": {"receiver":"bereitschaft"}
  },
