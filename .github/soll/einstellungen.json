      "deployment_branch_policy": {
        "protected_branches": false,
        "custom_branch_policies": true
      },
      "branch_policies": [
        {
          "name": "master",
          "type": "branch"
        }
      ]
    },
    "pruefer": {
      "deployment_branch_policy": {
        "protected_branches": false,
        "custom_branch_policies": true
      },
      "branch_policies": [
        {
          "name": "master",
          "type": "branch"
        }
      ]
    },
    "produktion": {
      "deployment_branch_policy": {
        "protected_branches": false,
        "custom_branch_policies": true
      },
      "branch_policies": [
        {
          "name": "master",
          "type": "branch"
        }
      ]
    }
  }
}
