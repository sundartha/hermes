{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(shasum:*)",
      "Bash(tar:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Bash(gh auth)",
      "Bash(gh auth *)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api -f*)",
      "Bash(gh api * -f*)",
      "Bash(gh api -F*)",
      "Bash(gh api * -F*)",
      "Bash(gh api --field*)",
      "Bash(gh api * --field*)",
      "Bash(gh api --raw-field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input*)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push * refs/heads/master)",
      "Bash(git push * refs/heads/master *)",
      "Bash(git push *:refs/heads/master)",
      "Bash(git push *:refs/heads/master *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git config core.hooks*)",
      "Bash(git config * core.hooks*)",
      "Bash(git -c core.hooks*)",
      "Bash(git * -c core.hooks*)",
      "mcp__render__create_cron_job",
      "mcp__render__create_key_value",
      "mcp__render__create_postgres",
      "mcp__render__create_static_site",
      "mcp__render__create_web_service",
      "mcp__render__trigger_deploy",
      "mcp__render__update_environment_variables",
      "mcp__telnyx__invoke_api_endpoint",
      "Read(//**/.claude/settings.local.json)",
      "Read(//**/.env)",
      "Read(//**/.env[ --0-~]*)",
      "Read(//**/.env.)",
      "Read(//**/.env.[ -.0-DF-SU-df-su-~]*)",
      "Read(//**/.env.e)",
      "Read(//**/.env.e[ -.0-WY-wy-~]*)",
      "Read(//**/.env.ex)",
      "Read(//**/.env.ex[ -.0-@B-`b-~]*)",
      "Read(//**/.env.exa)",
      "Read(//**/.env.exa[ -.0-LN-ln-~]*)",
      "Read(//**/.env.exam)",
      "Read(//**/.env.exam[ -.0-OQ-oq-~]*)",
      "Read(//**/.env.examp)",
      "Read(//**/.env.examp[ -.0-KM-km-~]*)",
      "Read(//**/.env.exampl)",
      "Read(//**/.env.exampl[ -.0-DF-df-~]*)",
      "Read(//**/.env.t)",
      "Read(//**/.env.t[ -.0-DF-df-~]*)",
      "Read(//**/.env.te)",
      "Read(//**/.env.te[ -.0-RT-rt-~]*)",
      "Read(//**/.env.tes)",
      "Read(//**/.env.tes[ -.0-SU-su-~]*)",
      "Read(//**/.env.example?*)",
      "Edit(//**/.claude/settings.local.json)",
      "Edit(//**/.env)",
      "Edit(//**/.env[ --0-~]*)",
      "Edit(//**/.env.)",
      "Edit(//**/.env.[ -.0-DF-SU-df-su-~]*)",
      "Edit(//**/.env.e)",
      "Edit(//**/.env.e[ -.0-WY-wy-~]*)",
      "Edit(//**/.env.ex)",
      "Edit(//**/.env.ex[ -.0-@B-`b-~]*)",
      "Edit(//**/.env.exa)",
      "Edit(//**/.env.exa[ -.0-LN-ln-~]*)",
      "Edit(//**/.env.exam)",
      "Edit(//**/.env.exam[ -.0-OQ-oq-~]*)",
      "Edit(//**/.env.examp)",
      "Edit(//**/.env.examp[ -.0-KM-km-~]*)",
      "Edit(//**/.env.exampl)",
      "Edit(//**/.env.exampl[ -.0-DF-df-~]*)",
      "Edit(//**/.env.t)",
      "Edit(//**/.env.t[ -.0-DF-df-~]*)",
      "Edit(//**/.env.te)",
      "Edit(//**/.env.te[ -.0-RT-rt-~]*)",
      "Edit(//**/.env.tes)",
      "Edit(//**/.env.tes[ -.0-SU-su-~]*)",
      "Edit(//**/.env.example?*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/auto-sync-master.sh\"",
            "timeout": 20,
            "statusMessage": "Hole upstream (nur Fetch)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/worktree-pflicht.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lesesperre.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/leise-befehle.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint-datei.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
