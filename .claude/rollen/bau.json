{
  "permissions": {
    "deny": [
      "Edit(**/eslint.config.*)",
      "Edit(eslint-suppressions*.json)",
      "Edit(eslint-legacy-exceptions.json)",
      "Edit(tools/**)",
      "Edit(.githooks/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(knip.json)",
      "Edit(.jscpd.json)",
      "Edit(.c8rc.json)",
      "Edit(gitleaks.toml)",
      "Edit(tsconfig*.json)",
      "Edit(.dependency-cruiser.cjs)",
      "Edit(.dependency-cruiser-known-violations.json)",
      "Edit(docs/sicherheitsgrenzen.md)",
      "Edit(docs/sicherheitsabgleich.json)",
      "Edit(test/testbaenke-run.mjs)",
      "Edit(test/werkzeuge/**)",
      "Edit(test/werkzeuge/werkzeugtexte.json)",
      "Edit(test/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "../../.fortschritt"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/tests-schuetzen.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/abnahme-zuerst.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/belege-schuetzen.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
