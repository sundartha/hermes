# ---- Claude (Anthropic) - Gespraechslogik (Budget-Engine) + Summaries ----
ANTHROPIC_API_KEY=sk-ant-...
# Haiku = guenstigstes Modell, reicht fuer Telefonate voellig.
# MUSS eine Preisstaffel in src/config.js (MODEL_PRICE_SCHEDULES) haben - sonst STARTET DER
# DIENST NICHT (Boot-Abbruch, B4a). Gilt auch fuer datierte Snapshot-IDs
# ("claude-haiku-4-5-20251001" ist ein ANDERER Schluessel als der Alias).
CLAUDE_MODEL=claude-haiku-4-5

# ---- Sprachmodell-Anbieter (B5) ----
# Welcher Adapter faehrt den Gespraechs- und Briefing-Pfad. Gueltige Werte:
# anthropic|deepseek. Unbekannter Wert -> Boot-Refusal, kein stiller Fallback.
# Default anthropic - B5 liefert die FAEHIGKEIT zu wechseln, nicht die Umstellung.
#
# Wer auf deepseek stellt, muss DREI Dinge mitziehen, keines davon hat einen Guard:
#  1) CLAUDE_MODEL + PRECALL_BRIEFING_MODEL auf ein DeepSeek-Modell (deepseek-v4-pro).
#     Ein Anthropic-Modell auf DeepSeek endet in HTTP 400 bei JEDEM Aufruf.
#     Jedes Modell braucht eine Preisstaffel in src/config.js, sonst startet der
#     Dienst nicht (assertPricedModels).
#  2) LLM_REQUEST_TIMEOUT_MS pruefen: B1 hat fuer deepseek-v4-pro max 3183 ms gemessen,
#     der Default ist 3500 ms - 9 % Luft, ohne Last. Wer ihn anhebt, rechnet das
#     Turn-Budget in src/turn-budget.js nach (Provider-Hardcut 15 s).
#  3) RESEARCH_ENABLED=false: die Vorab-Recherche nutzt Anthropics SERVERSEITIGES
#     web_search. Der DeepSeek-Adapter lehnt dieses Werkzeug benannt ab, statt es
#     stillschweigend wegzulassen.
# ANTHROPIC_API_KEY bleibt auch dann Boot-Pflicht.
LLM_PROVIDER=anthropic
# Nur noetig bei LLM_PROVIDER=deepseek (dann Boot-Pflicht). Setzen via
# bash scripts/set-deepseek-key.sh --from-clipboard
DEEPSEEK_API_KEY=

# FW2 - Ausweich-Anbieter fuer den Guthaben-Fall. LEER = Funktion AUS (Bestandsverhalten,
# byte-identisch). Gesetzt heisst: laeuft der Primaeranbieter in einen Guthaben-Fehler
# (HTTP 402 bzw. die eigene Marke des Anbieters), wird er prozessweit fuer
# LLM_BILLING_LATCH_COOLDOWN_MS vermerkt und die NAECHSTE Anfrage geht an diesen Anbieter.
# Der Turn, der den Fehler findet, degradiert unveraendert - es werden NIE zwei Anbieter
# je Anfrage versucht (das Turn-Budget, src/turn-budget.js, traegt keinen zweiten Versuch).
# Gleicher Wert wie LLM_PROVIDER = Funktion aus (es gaebe kein Ziel); der Boot meldet das.
# Mitzieh-Pflicht: der Ausweich-Anbieter braucht seinen eigenen API-Key (bei deepseek also
# DEEPSEEK_API_KEY), sonst scheitert der Wechsel im Ernstfall.
# ACHTUNG Preis: der Wechsel aendert die Kosten pro Turn. Jede Latch-Setzung schreibt
# deshalb eine Log-Zeile (Token LLM_PROVIDER_SWITCH) - Alarmregel darauf haengen.
LLM_PROVIDER_FALLBACK=
# Haltedauer des Guthaben-Vermerks in ms (Default 900000 = 15 min). Danach faellt das
# Routing automatisch auf den Primaeranbieter zurueck - ein wieder aufgeladenes Konto
# braucht keinen Neustart. Nur wirksam mit gesetztem LLM_PROVIDER_FALLBACK.
LLM_BILLING_LATCH_COOLDOWN_MS=900000

# Plattform-Beobachtung in EUR. KEIN Gate: seit KS-P9/E10 sperrt die Plattform-Achse
# NICHTS mehr (weder Outbound noch Inbound) - sie misst und ist die Bezugsgroesse der
# Schwellenwarnung PLATFORM_SPEND_WARN_PERCENT weiter unten. Die sperrende Kosten-Achse
# ist die pro-Tenant-Decke (DEFAULT_TENANT_BUDGET_CENTS / tenant_budget-Zeile); der
# bewusste Notaus ist OUTBOUND_FROZEN. Zusaetzlich ist dieser Wert der Pro-Tenant-Fallback
# fuer Tenants ohne Zeile, wenn DEFAULT_TENANT_BUDGET_CENTS=0 (Sentinel).
# 30 ist zugleich der live gemessene Wert (test/prod-env.js LIVE_MEASURED).
MAX_BUDGET_EUR=30

# ---- Mess-Instrumentierung (L0) ----
# PII-freie Latenz-/Loop-/STT-Gap-Logs (src/metrics.js). Default aus = byte-identisch.
# Zum Live-Messen (Datengrundlage fuer das STT-Tuning L1) auf true setzen.
# Ab dem Mehr-Laender-Betrieb NICHT mehr rein optional: das Ablehnungs-Ereignis
# (call_denied mit Land/Sprache) haengt an diesem Schalter. In Produktion "true".
METRICS_ENABLED=false

# ---- Deploy-Wahrheit (GAP-36) ----
# RENDER_GIT_COMMIT setzt Render beim Build automatisch - NICHT von Hand pflegen.
# Ungesetzt (lokal) -> /healthz und Boot-Banner melden commit="unbekannt".

# ---- Anrufbeantworter-Erkennung (GAP-21) ----
# DEFAULT AUS: Feldnamen sind Doku-Stand, noch nicht live gegen die Provider-API belegt
# (Rollback = Env-Variable ohne Deploy, s. src/config.js).
MACHINE_DETECTION_ENABLED=false
MACHINE_DETECTION_TIMEOUT_S=5

# HINWEIS: Absendernummern sind KEINE Env-Var mehr. Der Owner ist
# Tenant Null und haelt seine Nummer(n) wie jeder Tenant im Store. Bestandsnummer
# einmalig eintragen:  npm run seed-owner-number -- <e164> telnyx
# Der Boot-Guard verlangt fail-closed eine aktive Owner-Nummer im Store.

# ---- Telnyx (Telefonie-Provider) ----
# Leer -> Inbound/SMS/Outbound sind fail-closed inaktiv
# (Signatur-Verify -> false, sendSms/originateCall werfen).
# WARNUNG (P5): Das Ed25519-Schema + die Voice-Bezeichner sind NUR gegen die
# Telnyx-Doku, NICHT live bestaetigt. Bis zum gruenen Live-Smoke bleibt Telnyx
# fail-closed (Worst Case: Inbound wird abgelehnt, kein Leck).
# WARNUNG (P7): Telnyx + VOICE_ENGINE=realtime NICHT produktiv nutzen, bevor der
# WS-Echo-Test (scripts/telnyx-ws-echo.mjs) gruen ist - das exakte Media-Payload-
# Format (rohe u-law base64 vs. RTP-gewrappt) ist live unbestaetigt.
# Telnyx API-Key (Bearer). SECRET -> niemals committen. Fehlt -> sendSms wirft.
TELNYX_API_KEY=
# Ed25519-Public-Key des Telnyx-Accounts (Webhook-Signatur). Fehlt -> Verify fail-closed false.
TELNYX_PUBLIC_KEY=
# Telnyx API-Base (Default https://api.telnyx.com; nur fuer Tests/Proxy aendern).
TELNYX_API_BASE=https://api.telnyx.com
# TeXML-Application/Connection-ID (Telnyx-Portal: Voice -> TeXML -> App anlegen,
# voice_url = <PUBLIC_URL>/voice/incoming). Pflicht fuer Telnyx-OUTBOUND
# (originateCall). Leer -> Telnyx-Outbound wirft (fail-closed).
TELNYX_CONNECTION_ID=
# Telnyx-Account-ID (Mission-Control-Portal-Startseite). Pflicht fuer den
# Telnyx-Hangup (endCall). Leer -> endCall wirft (Max-Dauer/Cancel greifen nicht).
TELNYX_ACCOUNT_SID=
# OUTBOUND-E4 (Drift-Waechter, PLAN-OUTBOUND-RESILIENZ.md E-6, Pruefung 2/6): die
# FQDN-Connection, an der der ANI-Override der Plattform-Absendernummer haengt
# (Telnyx-Portal: Voice -> SIP Trunking -> FQDN Connections). Leer -> der Waechter
# meldet Pruefung 2/6 als unbekannt (nie fatal).
TELNYX_FQDN_CONNECTION_ID=
# OUTBOUND-E4 (Drift-Waechter, Pruefung 7): das Outbound-Voice-Profile, dessen
# whitelisted_destinations mit den tatsaechlich bedienten Laendern abgeglichen wird.
# Leer -> der Waechter meldet Pruefung 7 als unbekannt.
TELNYX_OUTBOUND_VOICE_PROFILE_ID=
# OUTBOUND-E5 (F3): Digest-Zugangsdaten der SIP-Trunk-FQDN-Connection oben
# (fqdn_authentication_method: "credential-authentication", gemessen 2026-08-29). Nur
# gebraucht fuer ELEVENLABS_NUMBER_REGISTRATION_ENABLED=true (s.u.) - der Anrufstart
# selbst braucht sie nicht. Leer -> das Anlegen einer Registrierung schlaegt fail-closed
# fehl (benannte Log-Zeile je DID, KEIN No-op) - bestehende DIDs bleiben nutzbar.
TELNYX_SIP_TRUNK_USERNAME=
TELNYX_SIP_TRUNK_PASSWORD=                      # SECRET (nie committen)
# ---- ElevenLabs-TTS ueber Telnyx (globale Plattform-Stimme, optional) ----
# Identifier des Telnyx-Integration-Secrets mit dem ElevenLabs-API-Key (Portal:
# Integration Secrets, oder POST /v2/integration_secrets). Feature nur aktiv,
# wenn REF UND VOICE_ID gesetzt sind - sonst rendert Telnyx die Azure-Stimmen
# (byte-identisch). Bewusste Vereinfachung: EIN Plattform-Key, TTS-Zeichen aller
# Tenants laufen ohne per-Tenant-Metering aufs Owner-ElevenLabs-Konto (Paid-Plan
# noetig, Freemium unterstuetzt Telnyx nicht). STT bleibt davon unberuehrt
# (Deepgram - Telnyx kann ElevenLabs nur fuer TTS).
TELNYX_ELEVENLABS_API_KEY_REF=
# ElevenLabs-Voice-ID aus der Library (multilingual: EINE Stimme fuer alle
# Sprachen - die gesprochene Sprache folgt dem generierten Text).
TELNYX_ELEVENLABS_VOICE_ID=
# Model-Slot im voice-Attribut ElevenLabs.<Model>.<VoiceId>. Telnyx dokumentiert
# "Default" und "v3"; andere Slugs nur nach Live-Probe nutzen.
TELNYX_ELEVENLABS_MODEL=Default

# Play-TTS: ElevenLabs-Stimme via <Play> in der Budget-Engine (Telnyx). GETRENNT vom
# Relay (TELNYX_ELEVENLABS_* oben). Default AUS -> Azure byte-identisch.
ELEVENLABS_PLAY_TTS_ENABLED=false
ELEVENLABS_API_KEY=                       # SECRET (nie committen)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_SYNTH_TIMEOUT_MS=2000                # Teil des 15-s-Turn-Budgets, s. src/turn-budget.js
ELEVENLABS_TTS_TOKEN_TTL_MS=60000

# Rueckfrage-Webhook des ElevenLabs-Conversational-Agents (Werkzeug get_consult,
# POST /webhooks/elevenlabs/consult). ElevenLabs signiert Werkzeug-Webhooks NICHT -
# es gibt nur frei konfigurierbare Request-Header. Dieses geteilte Geheimnis ist
# deshalb die EINZIGE Sicherung des von aussen erreichbaren Endpunkts: der Agent
# schickt es im Header x-hermes-tool-token, der Vergleich ist timing-sicher.
# LEER = fail-closed: der Endpunkt lehnt JEDEN Aufruf ab (nie offen).
ELEVENLABS_TOOL_TOKEN=                          # SECRET (nie committen)
# SEC-P4: scharfer Zustand der Mandanten-Bindung dieses Tokens. Der Anrufstart gibt dem
# Agenten einen aus dem Mandanten abgeleiteten Wert mit (dynamische Variable tenant_token),
# die Werkzeug-Definition schickt ihn im Anfragekoerper zurueck, der Webhook rechnet ihn
# aus dem gebundenen Anruf neu aus. false (Default): fehlt der Wert, gilt das heutige
# Verhalten - ein FALSCHER Wert wird immer abgelehnt. true erst, NACHDEM die
# Werkzeug-Definition am Anbieter den Parameter traegt (PATCH /v1/convai/tools/{id});
# vorher wuerden look_up und get_consult im laufenden Gespraech tot ausgehen.
ELEVENLABS_TENANT_TOKEN_REQUIRED=false

# ---- ElevenLabs-Anrufstart (Convai SIP-Trunk-Outbound) ----
# Dritter Outbound-Weg neben TeXML und Telnyx-Call-Control: das Gespraech fuehrt der
# Agent des ANBIETERS (POST /v1/convai/sip-trunk/outbound-call). Der PROVIDER des Anrufs
# bleibt telnyx - die DID liegt dort, ElevenLabs haengt per SIP-Trunk daran. Schluessel
# und Basis kommen aus ELEVENLABS_API_KEY/ELEVENLABS_API_BASE oben (EIN Konto, kein
# zweiter Satz). DEFAULT AUS: aus -> jeder Anruf laeuft unveraendert ueber Telnyx.
# Der Zweig haengt hinter derselben Outbound-Gate-Kette wie die Telnyx-Zweige
# (Kill-Switch, KYC/Abo, Kostendecke, Auftraggeber-Name) - er umgeht kein Gate.
ELEVENLABS_OUTBOUND_ENABLED=false
# Kennung des im ElevenLabs-Konto angelegten Outbound-Agenten (Vorlage:
# elevenlabs/agent_configs/outbound-agent.template.json). Kein Secret, aber
# deployment-spezifisch. Bei aktivem Schalter Pflicht - fehlt sie, waehlt der Zweig
# NICHT (fail-closed), statt still auf Telnyx zurueckzufallen.
ELEVENLABS_AGENT_ID=
# Kennung der bei ElevenLabs registrierten Absendernummer (SIP-Trunk-Nummer). Bei
# aktivem Schalter ebenfalls Pflicht.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# OUTBOUND-E5 (F3): Schalter fuer den EINZIGEN neuen Anbieter-SCHREIBZUGRIFF dieser
# Etappe - das Anlegen einer EL-Nummernregistrierung je Tenant-DID im Provisioning
# (POST /v1/convai/phone-numbers). Default AUS: der Merge ist inert, unabhaengig von
# ELEVENLABS_OUTBOUND_ENABLED. Braucht zusaetzlich TELNYX_SIP_TRUNK_USERNAME/-PASSWORD
# (s.o.) und PROVISIONING_ENABLED. Ohne eigene Registrierung faellt der Anrufstart je
# DID LAUT (Log + Metrik + Anruf-Datensatz) auf ELEVENLABS_AGENT_PHONE_NUMBER_ID zurueck,
# bis der Reparaturlauf (npm run elevenlabs:nummern) sie nachtraegt.
ELEVENLABS_NUMBER_REGISTRATION_ENABLED=false
# Abholtakt des ZIEHENDEN Ergebniswegs (GET /v1/convai/conversations/{id}): der Anbieter
# meldet das Gespraechsende nicht an uns, wir holen es ab. Bereich 100-60000 ms.
ELEVENLABS_RESULT_POLL_MS=5000
# Thema A (2026-08-19): Notaus fuer die LLM-Vorab-Erzeugung der Eroeffnungszeile
# ({{opening_line}}, src/elevenlabs/opening-line-llm.js). Default AN; auf false faellt
# jede Eroeffnung fail-closed auf den validierten Auftrags-Wortlaut (Anruf-8-Form) bzw.
# die feste Kurzzeile - der EL-Weg selbst bleibt unberuehrt.
ELEVENLABS_OPENING_LINE_LLM_ENABLED=true

# ---- ElevenLabs-Inbound (K1: annehmen, Pflichtsatz sprechen, per SIP uebergeben) ----
# Gegenpart zu ELEVENLABS_OUTBOUND_ENABLED in der EINGEHENDEN Richtung. DEFAULT AUS.
# STAND IE3: der Sprechpfad kommt erst in IE5; heute liest nur der Boot-Riegel diesen
# Wert. Flag an OHNE Katalogzeile fuer das Kostenprofil telnyx_inbound_el_convai ->
# Boot-Refusal (exit 1), damit kein Anrufweg scharf sein kann, dessen Anbieterkosten in
# keinem Buch landen. Ein Flip vor IE5 bewirkt nichts: es gibt noch keinen Schreiber.
ELEVENLABS_INBOUND_ENABLED=false

# ---- Telnyx AI Assistant / Brain-Shim (C-Telnyx, voll-duplex Barge-in - P10) ----
# Master-Flag fuer den in-house Custom-LLM-Shim (/v1/chat/completions) + die Call-
# Control-Origination. DEFAULT AUS: der Shim antwortet 404, der Live-CALL-Pfad
# (Budget/Realtime-Engine) bleibt byte-identisch. Erst NACH verifiziertem Deploy im
# Dashboard scharfstellen (Owner-Cutover, P11). Flag an -> assertConfig verlangt
# TELNYX_ASSISTANT_ID + TELNYX_API_KEY + TELNYX_CONNECTION_ID +
# TELNYX_CALL_CONTROL_APP_ID (fail-closed Boot).
TELNYX_AI_ASSISTANT_ENABLED=false
# ID des in P7 provisionierten Telnyx-AI-Assistants (ai_assistant_start). Opake ID,
# KEIN Secret - aber deployment-spezifisch. Leer + Flag an -> Boot-Refusal.
# Anlegen/Config: scripts/telnyx-assistant-provision.mjs (docs/RUNBOOK-TELNYX-ASSISTANT.md).
TELNYX_ASSISTANT_ID=
# ID der Call-Control-Application (Telnyx-Portal: Voice -> Call Control -> App anlegen).
# NICHT die TeXML-ID aus TELNYX_CONNECTION_ID - Telnyx fuehrt beide als getrennte
# Objekttypen. Die TeXML-ID hier einzutragen liefert bei JEDEM Outbound
# HTTP 422 "10015 Invalid value for connection_id (Call Control App ID)".
# Nur der Call-Control-Pfad (Flag an) nutzt sie. Leer + Flag an -> Boot-Refusal.
TELNYX_CALL_CONTROL_APP_ID=
# Max. Shim-Turns pro callId und Minute (Token-/Toll-Fraud-Bremse VOR agentTurn,
# zusaetzlich zu IP-Limiter + Budget-Cap). Default 30; Werte > 120 werden im Hosting
# bei aktivem Assistant als Footgun abgelehnt (Bremse waere praktisch aus).
TELNYX_SHIM_MAX_TURNS_PER_MIN=30
# stab-p9 Kosten-Notaus fuer den AI-Assistant-Pfad (konservativ, nur bei aktivem Flag
# wirksam; scharfe Kalibrierung aus P4/P5-Evidenz):
# Dead-Air: Sekunden ohne Shim-Turn nach ai_assistant_start -> Call wird kontrolliert beendet
# (stille TTS). Min 5, max 300 (ein Watchdog jenseits von 5 Minuten waere inert).
TELNYX_DEAD_AIR_TIMEOUT_S=45
# Loop-Guard: max. konsekutive leere/Echo-Turns -> Call wird beendet (Re-Prompt-Leerlauf).
# Zusaetzlich zum Rate-Limiter. Min 3, max 50 (darueber wird lautlos auf 50 geklemmt).
TELNYX_LOOP_GUARD_MAX_EMPTY_TURNS=8
# E2: statisches Telnyx-Integration-Secret, das der Shim als Bearer prueft. SECRET.
# Bei Flag an Boot-Pflicht (assertConfig). Muss WERT-gleich mit dem Telnyx-Integration-
# Secret <TELNYX_SHIM_API_KEY_REF> sein (Owner legt beide im Cutover an).
TELNYX_SHIM_SHARED_SECRET=
# E3: NAME (nicht Wert) des Telnyx-Integration-Secrets fuer external_llm.llm_api_key_ref.
# NUR das Provisioning-Skript liest ihn.
TELNYX_SHIM_API_KEY_REF=
# OBS-FLAG (Diagnose): einmaliger Shape-Dump im Shim. AN -> pro authentifiziertem Turn EINE
# keys-only-Log-Zeile (Top-Level-Feldnamen + ccid-Position-Booleans, NIE Werte). Nur fuer den
# EINEN ueberwachten Diagnose-Call auf true setzen, danach wieder false. NICHT boot-relevant.
TELNYX_SHIM_DEBUG_SHAPE=false
# AL-P7: echtes Token-Streaming des Shim-Turns. AN -> der Agent spricht jeden fertigen
# Satz sofort, statt auf die komplette Modellantwort zu warten (Latenzgewinn). AUS ->
# byte-identisches Bestandsverhalten (EIN content-Chunk am Ende). Default false; Rollback
# ist ein Flag-Flip. Wirkt nur, wenn der Request stream:true verlangt.
TELNYX_SHIM_TOKEN_STREAMING=false
# GQ-P1 (Befund B-1): Riegel gegen zwei gesprochene Antworten auf EINE Aeusserung. Kommt
# fuer denselben Call ein Request, dessen Text den noch LAUFENDEN Turn nur fortschreibt,
# wird der laufende Turn verdraengt (er spricht nicht, antwortet aber gueltig und leer).
# Hat er bereits Text gesprochen, wird NICHT verdraengt - Gesprochenes ist nicht
# zurueckholbar. Default true; false = Bestandsverhalten (zwei Antworten).
TELNYX_SHIM_SUPERSEDE_EXTENDED_TURN=true
# GQ-P18: wie lange der Sprech-Draht eines Shim-Turns zurueckgehalten wird, in
# Millisekunden. Die Spracherkennung (deepgram/nova-3) liefert EINE Aeusserung in mehreren
# POSTs, und fuer nova-3 gibt es beim Anbieter KEINEN Turn-End-Regler (die eot_*-Werte
# gelten nur fuer deepgram/flux). Solange nichts gesprochen wurde, kann ein Request mit
# fortgeschriebenem Text den laufenden Turn stumm ueberholen - dieses Fenster haelt der
# Wert offen. Er VERZOEGERT KEINE ANTWORT: am Turn-Ende geht alles raus. Preis nur bei
# Turns, die laenger dauern als die Frist - dort kommt das ERSTE Wort spaeter.
# 3000 deckt 7 der 11 gemessenen Fragment-Luecken (1314-5476 ms); die hold-Log-Zeile
# (outcome silenced/released/flushed) ist die Datengrundlage zum Trimmen.
# 0 = aus (Bestandsverhalten, zwei Antworten). Max 3500.
TELNYX_SHIM_EXTEND_HOLD_MS=3000
# Messschalter fuer EINE unbelegte Anbieter-Frage: ob der Pro-Call-transcription-Block
# (startAssistant/ai_assistant_start) das Assistant-eigene transcription-Objekt (inkl.
# settings.smart_format) ERSETZT oder in es hineinMERGED, sagt die Telnyx-Doku nicht.
# Default true = Bestand byte-identisch (Block wird gesendet). "false" bringt
# transcriptionFields dazu, IMMER {} zu liefern - ausschliesslich fuer EINEN begleiteten
# Testanruf, danach zurueckstellen. Faellt der Block weg UND ersetzt Telnyx tatsaechlich
# statt zu mergen, greift der OpenAPI-Default distil-whisper/distil-large-v2 (ENGLISCH-ONLY)
# - genau das ist die zu messende Unsicherheit. Kein Dauerbetrieb.
TELNYX_PER_CALL_TRANSCRIPTION_ENABLED=true
# GQ-P5 (Befund N-1): Riegel gegen den Provider-Anstoss. Telnyx stoesst nach
# telephony_settings.user_idle_reply_secs Sekunden Anrufer-Stille von sich aus einen Turn an
# (Anbieter-Schema: "the assistant will prompt the user to respond", Live-Wert 4). Dieser
# Request traegt KEINE neue Aeusserung - seine letzte Nachricht ist eine System-Nachricht.
# AN -> der Shim antwortet leer und gueltig, ohne Modell-Aufruf und ohne gesprochenen Satz.
# AUS -> Bestandsverhalten: die ALTE Aeusserung wird erneut beantwortet und ausgesprochen,
# was die gemessene "Ich warte still."-Schleife erzeugt. Default true.
TELNYX_SHIM_IGNORE_PROVIDER_NUDGE=true
# GQ-P6: wie lange Telnyx beim Wählen auf das Abheben wartet (POST /v2/calls, timeout_secs).
# Anbieter-Doku: min 5, max 600, Default 30. Wir setzten das Feld nie und liefen auf die 30 -
# zu knapp, wenn die Zustellung selbst ~30 s braucht (US-DID nach DE): der Anruf lief in den
# Timeout, bevor das Ziel ueberhaupt klingelte. Kostet nichts, solange niemand abhebt.
TELNYX_DIAL_TIMEOUT_SECS=60
# GQ-P3 (Befund B-9): schaltet den INBOUND-Handoff auf den Call-Control-Assistant. AN ->
# eingehende Telnyx-Anrufe laufen wie Outbound ueber den Assistant (Werkzeuge, Streaming,
# echtes Barge-in). AUS -> Inbound bleibt auf der Budget-Engine (TeXML-Gather), Bestand
# byte-identisch. DEFAULT AUS seit 2026-08-04 (422-Befund, Begruendung in src/config.js) -
# dieselbe Wahrheit im boolEnv-Fallback und in render.yaml; "true" ist der bewusste Flip.
# ACHTUNG KOSTEN: der Assistant-Pfad kostet nach eigener Messung (KV-M1) ~5 US-Cent je
# angefangener Minute gegen 1,87 auf der Budget-Engine - Inbound wird rund dreimal teurer.
# Gedeckelt durch die pro-Tenant-Kostendecke, die seit KV-P2 auch Inbound sperrt.
# Wirkt nur mit TELNYX_AI_ASSISTANT_ENABLED=true und Telnyx als Inbound-Provider.
TELNYX_INBOUND_HANDOFF_ENABLED=false

# GQ-P4 (B-10): max. Modell-Turns desselben Calls, die UNMITTELBAR nacheinander scheitern
# duerfen, bevor der Agent sich hoerbar verabschiedet und auflegt. Konsekutiv - ein
# erfolgreicher Turn setzt zurueck, ein einzelner Ausrutscher beendet nie. Default 3
# (~35 s Ausfall bei gemessenen ~11 s je erschoepftem Turn). Min 2, max 10.
# Beendet ZUSAETZLICH; Max-Dauer, Dead-Air-Watchdog und Budget-Kill bleiben unberuehrt.
TELNYX_MAX_CONSECUTIVE_FAILED_TURNS=3
# GQ-P4 (B-10): Abschiedssatz bei anhaltendem Ausfall. LEER lassen (empfohlen) = der
# sprachabhaengige Default aus dem Locale-Bundle. Ein gesetzter Wert wird der Gegenstelle
# VORGELESEN und gilt fuer JEDE Sprache - im mehrsprachigen Betrieb nur mit Bedacht setzen.
TELNYX_FAILED_TURN_FAREWELL_TEXT=

# ---- Sicherheits-Gates ----
# Globaler Outbound-Kill-Switch (Not-Aus). true = ALLE Outbound-Calls sofort gesperrt
# (403), ohne Deploy. Default false. Betriebs-Notbremse + Sekunden-Rollback.
OUTBOUND_FROZEN=false
# OUTBOUND-E4 (F4): der ANI-Riegel - das EINZIGE Gate der Drift-Waechter-Etappe. Default
# AUS (nur Beobachtung). Lehnt NUR ab bei einer frischen, LIVE-nachgemessenen
# ownership_lost-Messung (s. src/telephony/outbound-gates.js). OUTBOUND_FROZEN bleibt der
# bewusste Notaus - dieser Riegel wird von KEINEM Codepfad automatisch gesetzt.
OUTBOUND_ANI_GATE_ENABLED=false
# Frische-Grenze (ms): eine Messung aelter als dieser Wert gated NIE. Default 15 min.
OUTBOUND_ANI_GATE_MAX_AGE_MS=900000
# ALLOWED_NUMBERS: ab outbound-p3 NICHT mehr vom Code gelesen (statische Allowlist
# abgeschafft; Permit = per-Tenant-Verifikation Abo+KYC). Key bleibt nur fuer den
# Env-Cleanup beim Cutover; Wert ist wirkungslos.
ALLOWED_NUMBERS=
# Erlaubte Laendervorwahlen fuer Outbound (kommasepariert, E.164-Prefix wie +49).
# Default +49,+33,+44 (Deutschland, Frankreich, UK). * = alle Laender erlaubt (Land-Gate aus).
ALLOWED_COUNTRY_CODES=+49,+33,+44
# Max. Outbound-Calls EINES TENANTS pro gleitender Stunde (eigenes Gate, NICHT
# RATE_LIMIT_PER_MIN). Default UND Obergrenze fuer Profile - ein Profil kann nur senken.
# Bremse gegen Toll-Fraud/Kosten-Explosion. Default 6; 0 = jeder Outbound gesperrt.
# Es gibt KEINE plattformweite Stundenbremse - Not-Aus ist OUTBOUND_FROZEN.
MAX_CALLS_PER_HOUR=6
# ---- Per-(Tenant,Ziel)-Wiederhol-Cap + Cooldown (outbound-p1d, D4) ----
# Max. Outbound-Calls EINES Tenants an DASSELBE Ziel im Cooldown-Fenster; ab dem Cap
# -> 429 (fail-closed), tenant- + ziel-isoliert. Belaestigungs-Bremse, sobald Fremd-
# Tenants beliebige Nummern waehlen. 0 = jeder Outbound gesperrt (Not-Aus).
PER_TARGET_CALL_CAP=3
# Cooldown-Fenster in Millisekunden (Default 24 h = 86400000).
PER_TARGET_WINDOW_MS=86400000
# Hinweis: Notruf-Kurzwahlen (110/112/911/999) und eine globale Best-effort-Blockliste
# der hoechsten Premium-/Service-/Satelliten-/IPRN-Ziele (u.a. DE 0900/0137/0180/0118/0700,
# UK 118/070/09/084x/087x, FR 118/089x/081x/082x, Satellit +87x/+88x, IPRN +979) sind fest
# gesperrt (hardcoded in src/server.js, kein Env, nicht abschaltbar).
# ---- Onboarding ohne Payment (Kosten-Notbremse statt Stripe) ----
# Harte Obergrenze, wie viele Nummern die Plattform INSGESAMT provisionieren darf
# (jede echte Nummer kostet Geld). Ersetzt das uebersprungene Stripe-Schloss.
# 0 = Provisioning gesperrt (Not-Aus). Default 5 (bewusst klein).
MAX_NUMBERS=5
# Wie viele AKTIVE Nummern ein einzelner Tenant haben darf. Default 1.
MAX_NUMBERS_PER_TENANT=1
# Self-Service-Provisioning (ECHTER Nummern-Kauf). Default false (fail-closed):
# /api/onboard registriert + fragt dann nur an (Nummer 'requested', KEIN Geld).
# Erst true -> echte Kaeufe ueber Telnyx, gedeckelt durch MAX_NUMBERS. Braucht
# TELNYX_CONNECTION_ID + TELNYX_API_KEY. NIE per Default an.
PROVISIONING_ENABLED=false
# ISO-Laendercode fuer die Nummernsuche beim Kauf (DE-only Launch). Default DE.
PROVISIONING_COUNTRY=DE
# ---- PROV-01 Crash-Recovery: Auto-Redrive haengender Provisioning-Jobs (F4/F5) ----
# Maximales Job-Alter in MILLISEKUNDEN, bis zu dem der Boot-Reconciler eine in
# 'requested' haengende Nummer automatisch nachfuehren darf. 0 (Default) = Observe-Only
# (fail-closed): kein Auto-Nachkauf, haengende Jobs werden nur geloggt. MUSS strikt
# KLEINER als das kleinste Anbieter-Idempotenz-Fenster bleiben (Stripe-Hold = 24h),
# sonst Doppelkauf-Risiko. Scharf empfohlen 3600000 (1h). Erst nach gruenem Telnyx-
# Idempotenz-Smoke > 0 setzen.
PROVISIONING_REDRIVE_MAX_AGE_MS=0
# GP-P3 (PLAN-GELDPFAD.md): Versuchsdeckel je Mandant fuer den AUTOMATISCHEN Wiederanlauf
# des Nummern-Provisionings nach einem Kartenwechsel. Gezaehlt werden die terminal
# 'failed' Nummern-Datensaetze - jeder Neuanlauf erzeugt eine neue numberId und laeuft
# strukturell an MAX_NUMBERS_PER_TENANT vorbei. Erschoepft -> needs_manual_reconcile
# (Handbetrieb ueber POST /api/onboard/retry, dort gilt der Deckel NICHT).
# 0 = automatischer Wiederanlauf KOMPLETT AUS.
PROVISIONING_RETRY_MAX_ATTEMPTS=3
# GP-P4 (PLAN-GELDPFAD.md): Mindestfrist zwischen zwei AUTOMATISCHEN Anstoessen desselben
# Mandanten durch den zeitgesteuerten Wiederanlauf (stuendlicher Sweep). Default 24 h -
# kuerzer verbrennt den Deckel oben in wenigen Stunden. 0 = der ZEITGESTEUERTE Zweig ist
# komplett aus; der Wiederanlauf nach Kartenwechsel (GP-P3) laeuft unabhaengig weiter.
PROVISIONING_RETRY_MIN_INTERVAL_MS=86400000
# tenant-prolif-d: Grace-Periode (TAGE), bis der Reconciler eine DID eines >Grace
# suspendierten Tenants automatisch freigibt. 0 (Default) = Observe-Only fail-closed:
# NICHTS wird freigegeben, Kandidaten werden nur geloggt. Erst > 0 schaltet echte
# Telnyx-DELETEs scharf. Ein Fehl-Release ist Rufnummern-Verlust fuer einen zahlenden
# Kunden -> konservativ (mehrere Tage) waehlen.
RELEASE_GRACE_DAYS=0
# Erzwungenes KAUF-Land fuer ALLE neuen Nummern (ISO-2), ENTKOPPELT vom erkannten
# Herkunftsland. Leer (Default) -> Kauf-Land = erkanntes Land (heutiges Verhalten byte-
# identisch). Gesetzt (z.B. US) -> jede neue Nummer wird DORT gekauft; die SPRACHE bleibt
# am erkannten Herkunftsland (number.language), NICHT am Kauf-Land. Geo-/Sprach-Erkennung
# bleibt voll aktiv - diese Var neutralisiert nur die Kauf-Land-Wahl.
FORCE_NUMBER_COUNTRY=
# Geo-Quelle bei der Registrierung (F1 Phase 6): IP->Land-VORSCHLAG ueber lokalen
# maxmind-Lookup. Default false (fail-closed, netzfreie CI): Null-Adapter -> Land-
# Fallback DE, Onboard byte-identisch. Erst true -> lokaler maxmind-Adapter (User-Wahl
# bleibt autoritativ; IP verlaesst den Prozess NIE). Braucht GEO_DB_PATH + ggf. einen
# Owner-genehmigten mmdb-Reader; bis dahin liefert der Adapter fail-safe null (DE).
GEO_ENABLED=false
# Pfad zur lokalen GeoLite2-Country-mmdb (nur bei GEO_ENABLED=true). Leer -> fail-safe
# null (DE-Fallback). Das Asset wird NICHT eingecheckt.
GEO_DB_PATH=
# Weltdefault-Flip (PLAN-I18N-FIX.md P10): DEFAULT_LANGUAGE fuer Laender ohne eigenes
# Sprach-Bundle wird "en" statt "de" (DE/AT/CH/FR/GB/IE bleiben unberuehrt). Lokal/CI
# true (byte-identisch zum Flip-Bestand). Begruendung fuer den abweichenden Produktions-
# wert ("false" bis zur P13-Abnahme) und den Freischalt-Weg stehen EINMAL bei
# WORLD_DEFAULT_LANGUAGE_ENABLED in render.yaml, nicht hier dupliziert.
WORLD_DEFAULT_LANGUAGE_ENABLED=true
# Multi-Tenant-Identitaets-/Laufzeit-Schicht (I4-I7). Default false (fail-closed):
# Owner byte-identisch, kein Tenant-Scoping. Erst true (nach den dichten Scope-Gates)
# loest die Auth-Achse den Request-Tenant aus req.auth.sub auf. NIE per Default an.
MULTI_TENANT=false
# Self-Service-Schicht (I9/#3): web-session-only — getrenntes Tenant-Dashboard + Settings.
# Default false (fail-closed): Self-Service-Routen nicht erreichbar (404), Admin-
# Dashboard + /api/* byte-identisch. Authentifiziert AUSSCHLIESSLICH per OIDC-Browser-
# Session (webAuthMw); kein Bearer-Paste/X-Internal-Identity mehr. Braucht
# MULTI_TENANT=true + SESSION_SECRET + OAuth-Provider. NIE per Default an.
SELF_SERVICE_ENABLED=false
# ---- MCP Rich-UI (P1-W3) ----
# Rich-UI ui://-Resource fuer faehige MCP-Hosts. DEFAULT AN (Produkt-Default). Ein Host
# bekommt das Widget nur, wenn er die UI-Capability deklariert (fail-closed gehedged);
# sonst weiter nur Text/structuredContent. Mit =false explizit abschaltbar.
MCP_UI_ENABLED=true
# ---- Persoenlicher Assistent: strukturierter Per-Call-Kontext (PLAN-PERSONAL-ASSISTANT P3) ----
# Optionales context-Objekt an place_call (summary, key_facts[], recipient_relationship,
# desired_outcome) -> kompakte HINTERGRUND-Sektion im Outbound-Prompt + additiv persistiert.
# Default AN (Produkt-Default seit I12/call-quality): der Kanal ist produktionsreif.
# Auf false setzen, um ihn abzuschalten (b.context wird dann ignoriert, Prompt-Block +
# /api/calls byte-identisch zum Bestand ohne den Kanal).
ASSISTANT_CONTEXT_ENABLED=true
# ---- Pre-Call-Briefing (PLAN-CONVERSATION-QUALITY-V2 P8) ----
# Vor dem Waehlen fuellt ein starkes Modell den strukturierten call.context (+ optional
# das Mandat) aus objective/briefing/constraints. Default AUS (fail-closed): kein zweiter
# LLM-Aufruf, keine Zusatzkosten, /api/calls byte-identisch. Wirkt nur zusammen mit
# ASSISTANT_CONTEXT_ENABLED=true (dort sitzt der Konsument der HINTERGRUND-Sektion).
PRECALL_BRIEFING_ENABLED=false
# Briefing-Modell. MUSS eine Preisstaffel in src/config.js (MODEL_PRICE_SCHEDULES) haben -
# sonst STARTET DER DIENST NICHT (Boot-Abbruch, B4a). Geprueft wird UNABHAENGIG davon, ob
# PRECALL_BRIEFING_ENABLED=false steht; datierte Snapshot-IDs sind andere Schluessel.
PRECALL_BRIEFING_MODEL=claude-sonnet-5
# Eigener kurzer Timeout des Briefing-Aufrufs (kein Retry) - POST /api/calls wartet darauf.
PRECALL_BRIEFING_TIMEOUT_MS=6000
# Ein Timeout ist NICHT kostenlos: der Versuch war raus, deshalb bucht Hermes dafuer eine
# pessimistische Schaetzung auf die Budget-Achse (nie 0 - sonst Loch im Budget-Gate).
# ---- Gespraechs-Zusammenfassung nach dem Anruf ----
# Eigener Per-Request-Timeout der Nachbereitung (summarizeCall). Bewusst getrennt vom
# Sprechpfad (LLM_REQUEST_TIMEOUT_MS, 3500 ms): dort regiert der 15-s-Hardcut eines
# laufenden Provider-Webhooks, die Zusammenfassung laeuft danach detached. Gemessen
# braucht eine volle 800-Token-Zusammenfassung 7,7-9,0 s - mit dem Sprechpfad-Wert
# scheiterte sie strukturell bei genau den langen Gespraechen, in denen sie zaehlt.
# Anheben aendert KEINE Webhook-/Turn-Budget-Rechnung (src/turn-budget.js liest nur
# LLM_REQUEST_TIMEOUT_MS).
CALL_SUMMARY_TIMEOUT_MS=20000
# ---- Vorab-Recherche im Briefing (PLAN-ASSISTANT-LEAP Phase 10) ----
# Web-Recherche IM Pre-Call-Briefing ueber Anthropics serverseitiges web_search - kein
# zweiter Auftragsverarbeiter, kein eigenes Secret. Default AUS (fail-closed): das
# Such-Werkzeug erscheint gar nicht im tools-Array, der Briefing-Aufruf ist
# byte-identisch. Wirkt NUR als Schnittmenge mit dem Per-Tenant-Setting allowResearch.
# ACHTUNG: mit "true" wandert Auftragsmaterial an einen Suchindex.
RESEARCH_ENABLED=false
# Preis EINER serverseitigen Suche in GANZZAHL Cents (dieselbe Achse wie alle anderen
# Kosten). Serverseitige Suchen erscheinen NICHT in input_tokens/output_tokens - ohne
# diesen Posten waere das Budget-Gate hier blind. VOR dem Anschalten gegen die aktuelle
# Anbieter-Preisliste pruefen; aufrunden ist die gewollte Fehlerrichtung.
RESEARCH_SEARCH_FEE_CENTS=1
# ---- Nachschlagen IM Gespraech (PLAN-ASSISTANT-LEAP AL-P10b) ----
# Der Agent schlaegt waehrend des Gespraechs hoechstens zweimal EINE kurze Sachfrage nach
# (Werkzeug look_up). Default AUS (fail-closed): das Werkzeug erscheint nicht im
# tools-Array, der Prompt ist byte-identisch, es entsteht keine Gebuehr und kein Egress.
# ACHTUNG: mit "true" geht eine im Gespraech entstandene Frage an einen ZWEITEN
# Auftragsverarbeiter (Exa) - das gehoert VOR dem Anschalten in die
# Datenschutzerklaerung. Wirkt nur als Schnittmenge mit ASSISTANT_CONTEXT_ENABLED, dem
# Per-Tenant-Recht allowLookup (Profil) und einem gesetzten EXA_API_KEY.
LOOKUP_ENABLED=false
# Preis EINER In-Call-Suche in GANZZAHL Cents (dieselbe Achse wie alle anderen Kosten).
# Wird VOR dem Absenden gebucht - eine ausgeloeste Suche ist bezahlt, auch ohne Antwort.
# Belegt gegen die Exa-Preisliste (Stand 2026-08-01): $7/1k Anfragen + $1/1k Seiten
# = 1,0 US-Cent bei 3 Treffern. Ab 4 Treffern muss der Wert steigen.
LOOKUP_SEARCH_FEE_CENTS=1
# SECRET des Such-Anbieters. Leer = Feature fail-closed inaktiv, auch bei
# LOOKUP_ENABLED=true. Zum BAUEN/Testen nicht noetig (die Tests fahren gegen einen lokalen
# Mock). Niemals committen, niemals loggen.
EXA_API_KEY=
# Anbieter-Basis - NUR fuer Tests gegen einen lokalen Mock (Muster ELEVENLABS_API_BASE).
# Im Betrieb nie setzen; leer/ungesetzt = https://api.exa.ai
# EXA_API_BASE=
# ---- Consult-Kanal am Call (PLAN-ASSISTANT-LEAP AL-P13) ----
# Rueckfrage waehrend der Klingelzeit + MCP-Schleife (await_call_event/answer_consult).
# Default AUS (fail-closed): keine neuen Routen, keine neuen Tools, call.consults bleibt
# null. Wirkt nur als Schnittmenge mit ASSISTANT_CONTEXT_ENABLED=true UND dem
# Per-Tenant-Recht allowConsult im Rechteprofil (PROFILES_JSON).
CONSULT_ENABLED=false
# ---- Rueckfrage IM Gespraech (PLAN-ASSISTANT-LEAP AL-P14) ----
# Der Telefon-Agent bekommt das Werkzeug get_consult und stellt hoechstens EINE kurze
# Sachfrage an seinen Auftraggeber, waehrend der Anruf laeuft. Eigener Schalter neben
# CONSULT_ENABLED, weil sich die Datenschutz-Exposition unterscheidet: hier geht erstmals
# eine Frage aus FREMDER Rede an den MCP-Host (der Angerufene hat dem nie zugestimmt).
# Default AUS (fail-closed): das Werkzeug steht nicht im tools-Array, es entsteht kein
# In-Call-Consult, Prompt und Tool-Satz sind byte-identisch. Wirkt nur als Schnittmenge mit
# CONSULT_ENABLED=true, ASSISTANT_CONTEXT_ENABLED=true und dem Per-Tenant-Recht
# allowConsult - und zusaetzlich nur bei Outbound-Calls, auf die gerade ein Client pollt.
# ERST anschalten, wenn die Datenschutzerklaerung (apps/web) die Weitergabe von Inhalten
# aus dem laufenden Gespraech an den MCP-Host nennt.
IN_CALL_CONSULT_ENABLED=false
# ---- Fristen der Rueckfrage im Gespraech (GQ-P2) ----
# Zwei verschiedene Dinge, deshalb zwei Werte:
# CONSULT_WAIT_MS  = wie lange der Agent im laufenden Turn WARTET, bevor er ueberbrueckt
#                    (Halte-Satz, LLM-frei). Reserviert zugleich Platz in der laufenden
#                    Abrechnungsminute. Geklemmt auf 60000.
# CONSULT_OPEN_MS  = wie lange die Rueckfrage OFFEN bleibt und eine eintreffende Antwort
#                    noch annimmt. Der Agent spricht dabei laengst weiter - ein laenger
#                    offener Consult verlaengert KEIN Gespraech. Hergeleitet aus zwei
#                    Long-Poll-Zyklen (2 x 22 s) plus Abbruchmarge (3 s). Geklemmt auf
#                    300000; danach ist eine Antwort in jedem Fall zu alt (fail-closed).
CONSULT_WAIT_MS=4000
CONSULT_OPEN_MS=47000
# ---- Gestaffelter Halt des ElevenLabs-Rueckfrage-Webhooks (P2, W2) ----
# CONSULT_OPEN_MS oben ist der Wert des MCP-Long-Poll-Wegs und bleibt unveraendert (E-5).
# Der ElevenLabs-Weg (POST /webhooks/elevenlabs/consult) haelt seinen Request seit P2
# NICHT mehr pauschal offen, sondern in DREI Stufen - eine pauschale Frist kann "kann hier
# ueberhaupt jemand antworten?" (Millisekunden) und "wie lautet die Antwort?" (Sekunden)
# nicht gleichzeitig beantworten:
# EL_CONSULT_DELIVERY_MS = Stufe 0: wurde die Frage an einen pollenden Client AUSGELIEFERT?
#                          (ab Entstehung der Rueckfrage). Bei Ausbleiben: reason=not_delivered.
# EL_CONSULT_ACK_MS      = Stufe 1: hat der Client quittiert (answer_consult status=working)?
#                          ZUSAETZLICH zu Stufe 0 (Summe = Zustellung + Quittung ab
#                          Entstehung). Das Ausbleiben der Quittung IST der Berechtigungstest
#                          fuer answer_consult. Bei Ausbleiben: reason=not_acked.
# EL_CONSULT_ANSWER_MS   = Stufe 2: die eigentliche Antwort, GESAMT ab Entstehung. Bei
#                          Ausbleiben: reason=timeout.
# ALLE DREI SIND VORLAEUFIG (E-6): fuer Stufe 0 und 1 existiert noch keine Messung, weil
# diese Zeitpunkte bisher nicht protokolliert wurden. P3 liefert die Telemetrie, aus der
# beide nachkalibriert werden. Geklemmt auf 55000 (response_timeout_secs=60 am Werkzeug
# get_consult, minus 5 s Marge fuer Netz/Verarbeitung).
EL_CONSULT_DELIVERY_MS=5000
EL_CONSULT_ACK_MS=5000
EL_CONSULT_ANSWER_MS=30000
# ---- Denk-Signal (PLAN-ASSISTANT-LEAP AL-P7b) ----
# Der Agent sagt einen kurzen, zum Gespraech passenden Satz, WAEHREND er arbeitet, statt den
# Anrufer auf eine tote Leitung hoeren zu lassen. Der Satz ist der fuehrende Text des Modells
# im selben Antwort-Block wie der Werkzeugaufruf - kein zusaetzlicher Modell-Aufruf.
# Hoechstens EINMAL pro Zug und nur, wenn der Tool-Loop danach weiterlaeuft (kein
# Dauergeplapper). Default AUS (fail-closed): der Prompt-Block entfaellt, es geht kein
# zusaetzliches Fragment auf die Leitung.
# Wirkt NUR zusammen mit TELNYX_SHIM_TOKEN_STREAMING=true (AL-P7 ist Vorbedingung).
# Anschalten erst nach bestandenem Testanruf (tasks/al-testcall-checklist.md).
THINKING_SIGNAL_ENABLED=false
# ---- Nachfassen (tasks/PLAN-WERKZEUGWAHL.md, WW-F2) ----
# Der Agent kuendigt eine Handlung im Text an ("Ich gebe das an Jonas weiter"), ruft aber
# kein Werkzeug auf - am echten Anbieter gemessen: 5 von 5 Laeufen kein Werkzeug, unter
# erzwungener Werkzeugwahl 5 von 5 das richtige. AN -> genau EIN zusaetzlicher, erzwungener
# Modell-Aufruf je Zug holt die Ausfuehrung nach; Werkzeugsatz dabei OHNE end_call (ein
# Nachfassen legt nie auf), hoechstens EINMAL pro Zug (keine Schleife am offenen Telefon).
# Ausgeloest nur, wenn der Text der Runde eine Handlung ankuendigt - ein Zug ohne
# Ankuendigung kostet keinen zusaetzlichen Aufruf und keine zusaetzliche Latenz.
# Default AUS (fail-closed): kein tool_choice auf dem Draht, Bestandsverhalten.
TOOL_FOLLOW_UP_ENABLED=false
# ---- Anruf an die eigene Nummer (PLAN-OWNER-CALL, OC-P1) ----
# Ruft Hermes im Auftrag eines Tenants GENAU dessen eigene hinterlegte Nummer an
# (Dashboard: "meine private Nummer"), entfaellt ab OC-P2 der lange Offenlegungssatz
# ("... im Auftrag von ...") und der Agent spricht den Auftraggeber direkt an.
# Die KI-KENNZEICHNUNG entfaellt dabei NIE - die Eroeffnung sagt in jeder Sprache
# ausdruecklich "KI-Assistent". Fuer JEDES andere Ziel bleibt der vollstaendige
# Offenlegungssatz fest verdrahtet erster Satz (Absolute Regel 2).
# DEFAULT AUS (fail-closed): aus -> Offenlegung ueberall, exaktes Bestandsverhalten.
# Zurueckdrehen ist ein Dashboard-Feld, kein Deploy.
OWNER_SELF_CALL_ENABLED=false
# Komma-Liste der Tenant-IDs, die diese Ausnahme ueberhaupt ausloesen duerfen.
# LEERE LISTE = NIEMAND (ausdruecklich NICHT "alle"). Zweite, unabhaengige Bedingung
# neben dem Schalter: ein fremder Account kann die Ausnahme strukturell nicht ausloesen,
# weil er nicht darin steht. Noetig, weil POST /api/self-service/private-number jedem
# eingeloggten Tenant offensteht und die Nummer nur auf FORMAT und LAND geprueft wird,
# nicht auf BESITZ (Besitz-Verifikation ist eine spaetere, eigene Kette).
# Vor dem Launch gehoert hier ausschliesslich ein Account hinein, der uns gehoert.
OWNER_SELF_CALL_TENANT_IDS=
# ---- Payment/Billing (Stripe Hold/Capture, P6b1) ----
# Master-Flag: Geld halten -> Nummer provisionieren -> capturen -> aktivieren.
# Default false (fail-closed): kein Hold/Capture, requested->provisioning->active.
# Erst true -> Stripe-Hold/Capture beim Onboarding (braucht STRIPE_SECRET_KEY +
# NUMBER_SETUP_FEE_CENTS > 0, nur sinnvoll mit PROVISIONING_ENABLED=true). NIE per Default an.
PAYMENT_ENABLED=false
# Stripe Secret Key (sk_test_... / sk_live_...). SECRET - nie committen/loggen.
STRIPE_SECRET_KEY=
# Stripe-API-Basis (Test-Mode nutzt denselben Host wie Live, Unterschied = Key).
STRIPE_API_BASE=https://api.stripe.com
# Einmalige Setup-Gebuehr pro Nummer in GANZZAHL Cents (Geld nie als Float).
# 0 = ungesetzt; bei PAYMENT_ENABLED=true Pflicht > 0.
NUMBER_SETUP_FEE_CENTS=0
# ---- Flush-Stichtag (KV-P0) ----
# Aeltester Zeitpunkt, den POST /api/billing/flush-meters an Stripe melden darf
# (usage_event.occurredAt >= diesem Wert, inklusiv). ISO-8601 MIT Zone, z.B.
# 2026-08-04T00:00:00Z. Ein Wert ohne Zone oder in anderer Form verweigert den Boot.
# LEER = NICHTS wird gemeldet (fail-closed). Die Fail-Richtung ist "meldet nichts",
# niemals "meldet alles": im Ledger stehen Zeilen aus dem Vorbetrieb (Inbound-Minuten
# zum alten Worst-Case-Tarif, als number_month etikettierte Einrichtungsgebuehren), die
# ein einziger Endpunkt-Aufruf sonst auf einmal an echte Kunden melden wuerde.
# NIE ZURUECKDATIEREN - der Wert ist ein Riegel, kein Berichtsfenster.
# Heute ohne Wirkung im Betrieb: es gibt keinen Ausloeser fuer den Flush, und eine
# nutzungsbasierte Weiterbelastung findet bewusst nicht statt (siehe README).
BILLING_FLUSH_EPOCH=
# Waehrung (ISO-4217, lowercase) fuer den Hold/Capture. Default eur.
PAYMENT_CURRENCY=eur
# Waehrung der Provider-Detail-Records (ISO-4217, Grossschreibung). Default USD (Messung
# 2026-07-20: alle 293 Records USD). NICHT PAYMENT_CURRENCY - Provider-Messwerte sind
# USD, Tarife/Deckel im Repo EUR. Ein Record mit abweichender Waehrung wird VERWORFEN.
PROVIDER_CURRENCY=USD
# Umrechnungskurs USD -> EUR in GANZZAHL-Mikro-Einheiten: wie viele Mikro-EUR-Cent auf
# einen Mikro-USD-Cent entfallen. 920000 = 0,92 EUR je USD.
# DIE EINZIGE Stellschraube des Kurses (GAP-08): sie speist BEIDE Kosten-Achsen - die
# Provider-Achse (Korrekturbuchung aus den Detail-Records) und die KI-Kosten-Achse
# (Token-Kosten -> EUR-Cent; Budget-Gate und Stripe-Ledger, dort als Faktor 0,92). Eine
# Kurskorrektur bewegt damit zwangslaeufig beide Achsen; es gibt keine zweite Variable,
# die man dabei vergessen koennte.
# ACHTUNG Zehnerpotenz: NICHT 920 (das ist 0,00092) - ein Kurs ausserhalb des
# Toleranzbandes verweigert den Boot (die Korrekturbuchung bewegt sonst Geld auf Basis
# eines falschen Kurses). Quartalsweise von Hand pflegen.
PROVIDER_TO_BUCKET_RATE_MICRO=920000
# ---- Kosten-Abgleich im Beobachtungsmodus (LCT P3, misst - bucht NICHT) ----
# Aufschub in Minuten, bevor ein beendeter Outbound-Call abgeglichen wird. GEMESSEN
# (KE-P6B): der Testanruf vom 2026-07-21 hatte spaetestens 133 s nach Gespraechsende alle
# Belege vollstaendig und wertrichtig - 30 min sind der 13-fache Sicherheitsabstand.
COST_TRUING_DELAY_MINUTES=30
# Kadenz des Abgleich-Sweeps in Millisekunden (Default 1 h). Bestimmt, wie lange die
# Ueberreservierung eines Anrufs im Topf steht. Unter 60000 verweigert der Boot (eine
# Kadenz unter einer Minute schoepft nicht einmal ein Provider-Kontingentfenster aus und
# braennte nur den Versuchszaehler jedes Kandidaten ab); ueber 2147483647 wird geklemmt
# (darueber faellt Nodes Timer lautlos auf 1 ms zurueck).
COST_TRUING_SWEEP_INTERVAL_MS=3600000
# Obergrenze der Abgleich-Versuche je Call (persistierter Zaehler). Danach gilt der Call
# als abgeschlossen + 'unavailable', damit der Job nicht ewig gegen tote Calls laeuft.
COST_TRUING_MAX_ATTEMPTS=5
# Kommagetrennte Pflicht-Menge der record_types, die ein GESUNDER Call zeigen muss.
# LEER = 'incomplete' ("nichts bewiesen"), NIEMALS "vollstaendig". Erst nach gemessenem
# Live-Beleg besetzen. WAEHLBAR sind nur die ZUORDENBAREN Typen: sip-trunking,
# call-control, speech-to-text, text-to-speech, recording, ai-voice-assistant.
# NICHT waehlbar: inference - der Beleg traegt nur conversation_id (weder Anker noch
# Session) und kann keinem Call zugeordnet werden; als Pflicht-Typ waere die Menge
# dauerhaft unerfuellbar (keine Rueckerstattung mehr, jede Nachforderung gebucht). Der
# Boot verweigert ihn deshalb seit LCT-FIX-1 genauso hart wie die leere Menge. "call"
# existiert als Typ ueberhaupt nicht (HTTP 400).
# Kein geratener Nicht-leer-Default: der saehe nach Vollstaendigkeit aus.
# LEER verweigert den Boot: die Korrekturbuchung auf Ist-Kosten ist bedingungslos aktiv -
# ein Dienst, der Geld zurueckerstattet, ohne zu wissen, wogegen er Vollstaendigkeit
# prueft, darf nicht starten.
# KV2-5: dieser Wert ist seit der Umstellung auf profil-adressierte Pflichtmengen die
# Pflicht-Typmenge der VIER Telnyx-Profile (telnyx_budget, telnyx_assistant,
# telnyx_inbound_budget, telnyx_inbound_realtime) - unveraendert wie zuvor global.
# Das Profil el_convai_sip liest ihn NICHT: es fuehrt seine eigene, am Anbieter gemessene
# Menge als Literal in src/billing/kostenarten.js (KOSTENPROFILE[...].pflichttypen).
# Eine Aenderung hier bewegt weiterhin alle vier Telnyx-Profile gleichzeitig - bewusst
# akzeptiertes Restrisiko (Spec KV2-5(f)); eine Aufteilung waere eine
# Verhaltensaenderung an der Erstattungsbedingung.
COST_TRUING_REQUIRED_RECORD_TYPES=
# Mindest-Deckungsquote in Prozent (P3/P4 lesen DIESELBE Schwelle). Wird sie
# unterschritten, meldet jeder Sweep coverage_below_threshold (WARN, kein Boot-Refusal).
COST_TRUING_MIN_COVERAGE_PERCENT=80
# Stillstands-Grenze: so viele aufeinanderfolgende Sweeps unter der Schwelle -> Alarm
# coverage_stalled + Owner-Entscheidung. 8 x 1h-Kadenz = rund 8 h.
COST_TRUING_COVERAGE_STALL_SWEEPS=8
# KV2-6: Fenster des HERZSCHLAGS in Stunden. Meldet kosten:erfassung-tot:<traeger>, wenn es
# im Fenster beendete Anrufe mit diesem Pflicht-Traeger gab und KEIN einziger Beleg dieses
# Traegers angelegt wurde - unabhaengig davon, ob irgendein Anruf faellig ist. 0 = aus
# (sichtbar als herzschlag=aus in der Sweep-Zeile). Vom Fenster wird COST_TRUING_DELAY_MINUTES
# + COST_TRUING_SWEEP_INTERVAL_MS als Karenz abgezogen (frisch beendete Anrufe koennen noch
# keinen Beleg haben).
KOSTEN_HEARTBEAT_FENSTER_H=6
# KV2-7 (Owner-Entscheidung 3): Frist in Stunden, nach der ein Anruf auch OHNE
# vollstaendige Belegmenge geschlossen wird. Bis dahin bleibt er Kandidat und sammelt
# weiter (statt beim ersten Teilbeleg zuzulatchen). Nach Fristablauf: nachbuchen ja,
# erstatten NIE (Matrix 4.6) - der Tenant traegt die Schaetzung. Muss unter dem
# Provider-Belegfenster (7 Tage) bleiben.
COST_SETTLE_DEADLINE_HOURS=48
# KV2-9 (Plan 4.4): Mindestalter in Minuten, bevor der ZWEITE ElevenLabs-Abruf die
# Belegzeile von 'vorlaeufig' auf 'belegt' hebt. VERMUTET, nicht gemessen - belegt ist
# nur Stabilitaet ab 4h20m (befund-elevenlabs.md 2). Weicht der zweite Wert ab, gilt der
# HOEHERE und der Abweichungszaehler der Sweep-Zeile steigt; er IST die nachgeholte
# O3-Messung. 0 = sofort reifen.
EL_EVIDENCE_MIN_AGE_MINUTES=15
# Ab welcher relativen Abweichung Ist/Schaetzung eine WARN-Zeile faellt (D2).
COST_DRIFT_WARN_PERCENT=50
# Entprellfenster je Befund-Code in ms (Default 24h). Ohne sie meldete der Sweep denselben
# Befund in jeder Kadenz erneut (bei 1 h: 24-mal am Tag).
# Seit KV2-1 gilt dieses Fenster nur noch fuer die KOSTENLOSE Notiz-Stufe
# (requests_above_threshold, tts_quota_*) und die Tarif-Drift-SMS. Die Deckungs-Befunde
# (coverage_below_threshold/coverage_stalled) gehen ueber den Betreiber-Meldeweg und
# entprellen an OUTAGE_ALERT_DEBOUNCE_MS / OUTAGE_ALERT_RETRY_MS.
COST_ALERT_DEBOUNCE_MS=86400000
# ---- Drift-Waechter (LCT P5, misst den Ist-Minutensatz je Ziel-Praefix - justiert NICHT) ----
# Mindest-Stichprobe je Praefix. Darunter: KEINE Tarif-Aussage, KEIN Alarm, aber der
# sichtbare Befund 'insufficient_samples' samt Stichprobenzahl. Ein Wert oberhalb von 100
# (DRIFT_SAMPLE_WINDOW, src/billing/cost-calibration.js) friert den Waechter dauerhaft auf
# 'insufficient_samples' ein - laut (die Meldung nennt Fenster+Stichprobenzahl), nicht still.
COST_CALIBRATION_MIN_SAMPLES=20
# ---- Outbound-Kosten-Achse / Vorab-Reservierung (outbound-p1c) ----
# Voice-Minuten-Tarif in GANZZAHL Cents/min. EINE Kosten-Quelle: Vorab-Reservierung +
# Budget-Reconcile + Stripe-Voice-Meter. Inland = dieselbe dieser Vorwahlen (+49/+33/+44)
# an beiden Enden des Legs (Absender-DID UND Ziel); alles andere Worst-Case-Default.
# Live mit dem Provider-Tarif abgleichen.
VOICE_TARIFF_DOMESTIC_CENTS=20
# KS-P5a: DERSELBE Satz leitet auch die Plan-Kostendecke ab (30 min * Satz * 5/3 = Starter,
# 120 min * Satz * 5/4 = Business; bei 30 also 1500 / 4500 ct). Es gibt nur EINEN Satz.
# KS-P6/E1: 30 statt vormals 300. 300 war eine Annahme; gemessen wurden 8,18 ct je
# angefangener Minute (21 Live-Anrufe US-DID -> DE-Mobil), 30 ist rund das 3,7-Fache davon.
VOICE_TARIFF_DEFAULT_CENTS=30
# KV-P2 - Minutensatz eines INBOUND-Legs in GANZZAHL EUR-Cent. NICHT der Outbound-Satz:
# gemessen wurden 1,87 US-Cent je angefangener Minute (KV-M1, 2026-08-03; US-DID,
# VOICE_ENGINE=budget, ohne Assistant-Pfad, EIN Anruf). 6 traegt 3,5x Sicherheitsaufschlag.
# Unset -> 6. Muell/negativ -> Boot-Refusal. 0 = Inbound-Kosten-Achse bewusst aus.
VOICE_TARIFF_INBOUND_CENTS=6
# LCT P4b/KV2-10 - Vollkosten-Untergrenze in GANZZAHL EUR-Cent. Sinkt
# VOICE_TARIFF_DOMESTIC_CENTS darunter, meldet der Boot genau eine WARN (kein exit) - seit
# KV2-10 DECKUNGS-UNABHAENGIG (die Deckung steht als Kontext in der Meldung, ist aber kein
# Ausloeser mehr). Herleitung: p95 Vollkosten je Minute der Route el_convai_sip aus der
# KV2-10-Stichprobe (B2+O2: 0,1576 USD x 0,92 = 14,5 -> aufgerundet 15; ohne Eigen-Achsen,
# Kurs 0,92); mit gesetztem Grundbetrag kann die Schwelle sinken - Neuherleitung dann ueber
# den Tarifpaar-Report (cost-calibration.js). 0 = Guard aus (Diagnose, kein Geld-Gate).
VOICE_TARIFF_FULL_COST_FLOOR_CENTS=15
# KV2-10 - Grundbetrag des ZWEITEILIGEN Tarifs (Owner-Entscheidung 5): GANZZAHL EUR-Cent
# je ANRUF, je Route (Kostenprofil) als csv-Karte profil:cents, z.B.
# "el_convai_sip:23". Der Minutensatz bleibt VOICE_TARIFF_DOMESTIC_CENTS (Outbound-Routen)
# bzw. VOICE_TARIFF_INBOUND_CENTS (Inbound-Routen); der Tarifpaar-Waechter im Sweep und im
# Boot prueft das konfigurierte Paar gegen die gemessenen Vollkosten (er JUSTIERT NICHTS -
# Owner-Entscheidung 6: die Zahl setzt ein Mensch). Vorschlag aus der KV2-10-Stichprobe:
# el_convai_sip:20 (dazu Minutensatz 18). Leer = alle Routen 0 ("noch nicht gesetzt"),
# genau die heutige Reserve-Wahrheit - der Grundbetrag geht in KEINE Reserve-Rechnung.
# OFFENER PUNKT: gemessen wird erst, wenn eine je-Anruf-Quelle fuer die Eigen-Achsen
# existiert (ai_token/research_fee, s. Kopfkommentar der Tarifpaar-Sektion in
# src/billing/cost-calibration.js) - bis dahin meldet jede Zeile tarifpaar_zu_wenig_proben.
# Unbekanntes Profil oder Muell-Cent -> Boot-Refusal (fail-closed, nie still 0).
VOICE_TARIFF_GRUNDBETRAG_CENTS=
# Per-Tenant Default-Kostendecke (GANZZAHL Cents). Seedt die tenant_budget-Zeile beim
# Registrieren UND ist der Gate-Fallback fuer jeden Tenant ohne Zeile (P2a). 0 = kein Seed
# und kein Fallback (Tenant faellt auf MAX_BUDGET_EUR, Bestandsverhalten).
# Untergrenze aus dem Boot-Guard (spendCapCoherence Klausel B, exit 1): mindestens
# VOICE_TARIFF_DEFAULT_CENTS * RESERVE_LEAD_MINUTES, seit KS-P3 also 30 * 2 = 60.
# Eine Decke darunter hiesse, dass jedes Ziel ohne gemessenen Inlandssatz schon vor dem Dial
# mit 402 abgewiesen wird.
# 1500 statt der geforderten 150, weil der Wert seit KS-P5a die Starter-Plan-Decke spiegelt
# (30 verkaufte Minuten * 30 ct * 5/3 = 1500) - ein Tenant ohne eigene tenant_budget-Zeile
# bekommt damit dieselbe Decke wie ein Starter-Kunde.
DEFAULT_TENANT_BUDGET_CENTS=1500
# Grober Kostenbeleg pro gesendeter Summary-SMS (F2 P8) in GANZZAHL Cents. Jede
# erfolgreich gesendete Summary-SMS erzeugt ein Usage-Event mit diesem Betrag; 0 =
# Menge ohne Kostenbeleg.
SMS_COST_CENTS=0
# ---- Plattform-Fruehwarnung (Budget-Achsen P6) ----
# Anteil von MAX_BUDGET_EUR, ab dem GENAU EIN Audit-Ereignis pro Spend-Monat feuert.
# Seit KS-P9/E10 gibt es KEINEN Notaus mehr, hinter dem diese Schwelle stuende - sie ist
# die EINZIGE Wirkung der Plattform-Achse. Ganzzahl 0-100. 0 = Warnung AUS.
# AENDERT KEINE Gate-Entscheidung.
PLATFORM_SPEND_WARN_PERCENT=80
# Betreiber-Nummer (E.164) fuer die zusaetzliche Warn-SMS bei der Fruehwarnung oben UND
# (LCT P5) beim Tarif-Drift-Alarm. LEER = KEINE SMS, nur Audit-Log-Eintrag. NIE die
# private Nummer eines Tenants eintragen (das Owner-Konzept ist aus dem Code entfernt,
# Admin laeuft ueber account.role - es gibt keine natuerliche Zielnummer fuer eine
# Plattform-Groesse). Ein leerer Wert wird ab LCT P5 beim Boot als WARN gemeldet
# (alertChannelFindings) - der Wert selbst wird dabei NIE geloggt.
PLATFORM_ALERT_SMS_TO=
# Seit KV2-1 ist dies AUCH das Ziel der Kosten-Befunde (Deckungsquote/Belegausfall). Ist
# keiner der beiden Kanaele einsatzbereit, meldet der Boot den Befund
# kosten_alarm_ohne_ziel (WARN, kein Abbruch) und jede Sweep-Zeile traegt kanaele=keine.
# ---- Systematischer-Ausfall-Melder (OUTBOUND-E3b, PLAN-OUTBOUND-RESILIENZ.md E-4) ----
# Erkennt einen systematischen Outbound-Ausfall (der 27.08.2026-Fall: eine Absendernummer
# verliert die Berechtigung, ALLE Outbounds scheitern) und meldet ihn dem Betreiber, ohne
# dass zufaellig jemand anrufen muss. Zeitfenster fuer die not-placed-Fehlerquote je
# Fehlerklasse (Eimer). 0 = der Melder ist KOMPLETT AUS - dann greift auch der fatale
# Boot-Guard-Befund unten NICHT (kein scharfer Melder -> nichts zu melden).
OUTAGE_ALERT_WINDOW_MS=3600000
# K1 (kleines Volumen): Mindestzahl Fehler derselben Klasse im Fenster, BEVOR ueberhaupt
# ein Alarm moeglich ist.
OUTAGE_ALERT_MIN_FAILURES=3
# Mindestnenner (Versuche im Fenster), ab dem K2 (Skala, Anteilsvergleich) statt K1
# entscheidet.
OUTAGE_ALERT_MIN_ATTEMPTS=20
# K2-Schwelle in Prozent (ganzzahlig, kein Fliesskomma-Prozent-Env im Repo).
OUTAGE_ALERT_FAIL_SHARE_PERCENT=20
# Mindest-Wiederholfrist nach einer bereits ZUGESTELLTEN Meldung (entprellt am VORFALL).
OUTAGE_ALERT_DEBOUNCE_MS=21600000
# Mindest-Wiederholfrist nach einem VERSUCHTEN, aber NICHT zugestellten Versand - ohne
# diesen Wert gibt es nach einer fehlgeschlagenen Mail NULL Meldungen zum echten Vorfall.
OUTAGE_ALERT_RETRY_MS=900000
# C8b (Review-Blocker Runde 2): Mindestabstand zwischen zwei Selbsttests desselben Kanals -
# "ein Kanal, der zwoelf Monate nie ausgeloest wurde, ist kein bewiesener Kanal" (Plan
# Abschnitt "Meldeweg und Alarm-Body"). 0 = Selbsttest KOMPLETT AUS.
OUTAGE_ALERT_SELF_TEST_INTERVAL_MS=2592000000
# C8 (Owner-Entscheidung F-8, PLAN-OUTBOUND-RESILIENZ.md Abschnitt 9): "Darf eine
# Kuendigung wegen einer Plattform-Bindung haengen bleiben? Ja, mit HOLD + Audit +
# 24-h-Eskalation." Mindestalter (ab tenant.suspendedAt), ab dem ein HOLD
# platform_number_in_use GENAU EINEN Betreiber-Befund ueber denselben Meldeweg erzeugt.
# 0 = Eskalation KOMPLETT AUS.
PLATFORM_HOLD_ESCALATION_MAX_AGE_MS=86400000
# GP-P0 (PLAN-GELDPFAD.md): wie lange ein AKTIVER, verifizierter Subscriber ohne
# Live-Nummer bleiben darf, bevor der stuendliche Sweep GENAU EINEN Betreiber-Befund
# erzeugt (WARN + durables Audit, KEIN Mail-/SMS-Versand). Gemessen ab dem Beginn der
# laufenden Stripe-Abrechnungsperiode. 0 = Beobachtung KOMPLETT AUS.
PAID_WITHOUT_NUMBER_GRACE_MS=3600000
# Betreiber-Zieladresse - der PRIMAERE Kanal (haengt an keinem Carrier, anders als
# PLATFORM_ALERT_SMS_TO oben, das ueber DASSELBE Telnyx-Konto laeuft wie der ausgefallene
# Outbound). LEER = kein Mail-Versand, nur Audit-Log. Sind BEIDE Kanaele (dieser UND
# PLATFORM_ALERT_SMS_TO) leer UND ELEVENLABS_OUTBOUND_ENABLED=true UND
# OUTAGE_ALERT_WINDOW_MS>0, verweigert der Boot-Guard den Start (fatal) - "nicht
# konfiguriert" darf nie wie "alles gruen" aussehen.
PLATFORM_ALERT_MAIL_TO=
# Seit KV2-1 ist dies AUCH das Ziel der Kosten-Befunde (Deckungsquote/Belegausfall). Ist
# keiner der beiden Kanaele einsatzbereit, meldet der Boot den Befund
# kosten_alarm_ohne_ziel (WARN, kein Abbruch) und jede Sweep-Zeile traegt kanaele=keine.
# ---- Drift-Waechter (OUTBOUND-E4, F4, PLAN-OUTBOUND-RESILIENZ.md E-6) ----
# Erkennt eine Abweichung zwischen unserer deklarierten Absenderkonfiguration und der
# Anbieter-Wirklichkeit (der 27.08.2026-Fall: die ANI gehoerte dem Telnyx-Konto nicht
# mehr) - OHNE dass ein Anruf stattfindet. Mindestfrist zwischen zwei beanspruchten
# Laeufen (Single-Flight/Deploy-Sturm-Schutz). 0 = der Waechter ist KOMPLETT AUS.
OUTBOUND_DRIFT_MIN_INTERVAL_MS=600000
# Ab wann die letzte ERFOLGREICHE Messung als "watchdog_stale" gilt (faengt einen
# abgelaufenen Schluessel/dauerhaftes 5xx/einen deaktivierten Actions-Workflow).
OUTBOUND_DRIFT_STALE_MS=21600000
# Guthaben-REICHWEITE in Stunden (nicht Betrag): Guthaben reicht fuer weniger als so
# viele Stunden bei aktuellem 24h-Verbrauch -> balance_low.
OUTBOUND_DRIFT_BALANCE_MIN_HOURS=72
# ---- Spend-Monat-Flip (Budget-Achsen P7) ----
# AN = BEIDE Gate-Achsen (Tenant UND Plattform) messen den Verbrauch im UTC-Kalendermonat
# statt im Lebenszeit-Zaehler. AUS (Default) = byte-identisch zum Bestand. Vorbedingung
# vor dem Flip: ein Live-Beleg, dass spendMonthKey einen Neustart uebersteht. Der Rollback
# ist ein Env-Flip OHNE Deploy. NACH dem Flip sind MAX_BUDGET_EUR/DEFAULT_TENANT_BUDGET_
# CENTS oben MONATS-Werte, keine Lebenszeit-Werte mehr - vor dem Flip neu dimensionieren.
BUDGET_MONTH_ENABLED=false
# ---- Fixkosten sichtbar machen (LCT P7) ----
# Listenpreis, NICHT Rechnungsposten - reine Anzeige (GET /api/billing/platform-costs),
# NIE ein Gate. EUR-Cent: USD-Betraege sind vorab mit 0,92 umgerechnet.
#
# ElevenLabs-Fixkosten: GANZZAHL US-Cent LISTENPREIS (befund-elevenlabs.md 3: 6,00
# USD/Monat). Seit KV2-10 rechnet GET /api/billing/platform-costs ueber den EINEN Kurs
# (PROVIDER_TO_BUCKET_RATE_MICRO) nach EUR-Cent um (600 x 0,92 = 552) und gibt den
# USD-Listenpreis separat als elevenLabsUsdCents mit.
PLATFORM_FIXED_COST_CENTS_PER_MONTH=600
# ElevenLabs-Zeichenkontingent des Starter-Tarifs (Play-TTS-Wand). 39981 = das heute
# belegte Kontingent.
TTS_CHARACTER_QUOTA=39981
# Anteil des Kontingents, ab dem GENAU EIN Alarm pro Zyklus feuert (Muster
# PLATFORM_SPEND_WARN_PERCENT). Ganzzahl 0-100; 0 = Warnung AUS.
TTS_CHARACTER_QUOTA_WARN_PERCENT=75
# Tag im Monat, an dem der ElevenLabs-Abrechnungszyklus zurueckgesetzt wird (belegt: der
# 3.) - AUSDRUECKLICH NICHT der Kalendermonatserste. 1-28.
TTS_QUOTA_CYCLE_ANCHOR_DAY=3
# DID-Listenmiete je Nummer in GANZZAHL EUR-Cent (1,00 USD x 0,92 -> 92 EUR-Cent).
NUMBER_MONTHLY_COST_CENTS=92
# ---- Abo-Buchung (Stripe Recurring, W4) ----
# Stripe-Price-Ids (recurring monatlich, EUR) je Tier (im Stripe-Dashboard angelegt).
# Leer ist bei PAYMENT_ENABLED=true seit GP-P6 ein BOOT-REFUSAL (boot.js#assertPricedPlans);
# bei PAYMENT_ENABLED=false bleibt leer folgenlos. Opake price_-Referenzen.
STRIPE_STARTER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Stripe-Webhook-Signing-Secret (whsec_...). SECRET - nie committen/loggen. Bei
# PAYMENT_ENABLED=true Pflicht (sonst ist der Abo-Webhook fail-closed unverifizierbar).
STRIPE_WEBHOOK_SECRET=
# Self-Heal (Fix B, PLAN-CHECKOUT-STALE-STRIPE-CUSTOMER.md): Wartezeit (ms) vor dem
# EINEN Checkout-Retry nach Stripe resource_missing auf den Customer - ueberbrueckt
# die Sichtbarkeits-Verzoegerung zwischen createCustomer und dem naechsten API-Call.
# Default 2000. Min 0 (0 = sofortiger Retry).
STRIPE_CUSTOMER_RETRY_DELAY_MS=2000
# ---- Preis-Waechter (GP-P6, PLAN-GELDPFAD.md) ----
# Mindestabstand zweier Preis-Pruefungen (Katalogpreis gegen GET /v1/prices/<id>). Der
# Waechter haengt im Stunden-Sweep, prueft aber nur einmal am Tag: Stripe-Preise aendern
# sich seltener als Telefonie-Konfiguration, und jede Pruefung ist ein Anbieter-Aufruf.
# 0 = der Waechter ist KOMPLETT AUS (Rollback-Hebel). Default 86400000 (24 h).
PRICE_DRIFT_MIN_INTERVAL_MS=86400000
# Aufeinanderfolgende Laeufe OHNE Urteil (Netzfehler/fehlendes Lese-Scope), nach denen der
# Waechter seine eigene Unwissenheit meldet - GENAU EINMAL. Ein einzelner Netzfehler ist
# keine Betreiber-Meldung wert, ein dauerhaft fehlendes Scope sehr wohl.
# 0 = Unwissenheits-Eskalation AUS. Default 3.
PRICE_DRIFT_UNKNOWN_ESCALATE_AFTER=3
# Maximale Gespraechsdauer: KEINE Env-Variable mehr (KS-P3, Owner-Entscheidung E2/E3).
# MAX_CALL_DURATION_S ist ersatzlos entfallen - ein Operator-Knopf, der jede
# Gespraechsdauer global kuerzt, WAR die willkuerliche Produktgrenze. Die nutzbare Dauer
# eines Anrufs leitet der Server jetzt pro Call aus dem Restguthaben ab (Restminuten +
# 1 Minute Puffer), gedeckelt durch die hartkodierte absolute Obergrenze
# MAX_CALL_DURATION_CAP_S = 1800 s (src/store/defaults.js). Sie ist eine Notbremse gegen
# eine technisch tote Verbindung, KEIN Kostendeckel - die Kosten begrenzen die
# pro-Tenant-Kostendecke und der Live-Verbrauchszaehler.
# Ein in einem Dashboard stehengebliebener MAX_CALL_DURATION_S-Wert wird ignoriert.
# P3.1: Vorlauf (ms) vor dem harten Max-Dauer-Cap, ab dem der Agent im laufenden Turn einen
# Abschluss-Satz spricht und auflegt, statt wortlos vom Timer gekappt zu werden. Verlaengert
# den Cap NICHT (der Satz liegt innerhalb der Frist). Default 20000, Min 0 (= aus), Max 60000.
# Muss deutlich kleiner als die kuerzestmoegliche Notbremse (60 s) sein.
CAP_FAREWELL_LEAD_MS=20000
# OUT-05: Puffer (ms) ueber der Call-Max-Dauer, bis die Worst-Case-Budget-Reserve eines
# Outbound-Calls unabhaengig vom Provider-Callback via Backstop-Timer freigegeben wird.
# Default 15000. Min 0.
RESERVE_RELEASE_GRACE_MS=15000
# IE2: Takt (ms) des wiederkehrenden Geld-Waechters je aktivem Anruf. Er fragt dieselbe
# pro-Tenant-Kostendecke wie jede andere Stelle (blockingBudgetAxis) und beendet ueber
# denselben EINEN Terminierungspfad. Ohne ihn wirkt die Decke mid-call nur, wenn der Anruf
# ohnehin einen Turn oder einen Werkzeugaufruf erzeugt - ein Anruf, der nur eine Nachricht
# hinterlaesst, erreicht sie nie.
# Der Wert IST die bewusst akzeptierte Ueberziehung zwischen zwei Runden: hoechstens dieser
# Takt an Gespraechszeit je laufendem Leg (bei 30 ct/min rund 7,5 Cent), nicht kumulativ.
# 0 = KOMPLETT AUS (Rueckfall-Hebel: im Dashboard auf 0 setzen wirkt sofort, ohne Deploy;
# die vier ereignisgebundenen Pruefstellen bleiben dabei unveraendert scharf).
# Default 15000. Min 0. Max 600000.
BUDGET_WATCHDOG_INTERVAL_MS=15000
# A6: Watchdog-Obergrenze (ms) fuer den Graceful-Shutdown (SIGTERM/SIGINT). Der Drain laesst
# in-flight Requests fertig und flusht dann den Store; danach hartes exit(0). Default 8000,
# Min 0, Max 30000 (< Render-SIGKILL ~30s).
SHUTDOWN_DRAIN_TIMEOUT_MS=8000
# ---- Spracherkennung (STT) ----
# Neutrale Wahl der Erkennungs-Engine - EINMAL fuer alle Pfade (Telnyx-Gather,
# Telnyx-Assistant). Jeder Adapter uebersetzt sie in seine eigene
# Schreibweise: Telnyx -> transcriptionEngine="Deepgram" + model="deepgram/nova-3".
# Gueltige Werte: accurate. Unbekannter Wert -> Boot-Refusal, kein stiller Fallback.
# Der VIERTE Ort (das Telnyx-Assistant-Objekt) wird davon NICHT gepatcht - Abgleich
# per node scripts/telnyx-stt-drift.mjs (nur lesend).
STT_PROFILE=accurate
# STT-Endpointing fuer Folge-Gathers (/voice/turn): fester speechTimeout in Sekunden
# statt "auto". "auto" schneidet bei interner Sprechpause ab ("geht" statt ganzem Satz).
# Konservativer Default 2; tunebar ohne Code-Diff. Min 1. NUR Folge-Gathers - das
# Outbound-Erst-Gather + Inbound-Greeting bleiben auf "auto" (End-of-Speech-Erkennung).
STT_SPEECH_TIMEOUT_SEC=2
# stab-p7 (a): Empty-Turn-Guard. Max. konsekutive Agent-Turns ohne substanzielle Antwort
# des Gegenuebers, bevor der Agent (nur Outbound) ein end_call freigibt. Ein einzelner Leer-/
# Echo-Turn beendet den Call nie. Default 3, Min 2 (haelt den Erst-Turn-Boden).
MAX_EMPTY_TURNS=3
# stab-p7 (b): Mindest-Zeichenlaenge (getrimmt) einer substanziellen Anrufer-Aeusserung.
# Kuerzere/leere Transkripte (Echo-/Rausch-Fragmente) heben den Fruehauflege-Schutz nicht.
# Default 2 ("Ja"/"Ok" >= 2 Zeichen), Min 1.
CALLER_SUBSTANCE_MIN_LEN=2
# Rate-Limit pro IP und Minute fuer alle Routen ausser /voice (localhost ausgenommen).
# Default 120 (Dashboard pollt ~24x/min).
RATE_LIMIT_PER_MIN=120
# SEC-P3: Herkunftspruefung (CSRF) auf den zustandsaendernden Self-Service-Routen
# (/api/self-service/**, ausser GET). Verglichen wird der Host des Origin-Headers mit
# dem Host, unter dem der Request hereinkam - keine gepflegte Liste, in jedem Deployment
# richtig. FEHLENDER Origin geht weiterhin durch (Anbieter-Webhooks/Server-zu-Server
# senden keinen), ein FREMDER Origin -> 403. Default true. "false" ist der Rueckfall-
# Hebel, falls ein Proxy den Host-Header umschreibt - nur bewusst und befristet setzen.
CSRF_ENFORCE=true

# ---- Erst-Setup (kein Owner-Env mehr, P2b) ----
# Owner-Identitaet + -Absendernummer sind KEINE Env-Var mehr. Der erste Tenant wird
# einmalig pro Umgebung per CLI angelegt und lebt dann im Store:
#   npm run bootstrap-tenant -- <e164> telnyx   (Tenant + aktive Provider-DID)
#   npm run grant-admin -- <idp-subject-oder-email>      (Admin-Rolle, optional)
# ownerName + private Summary-Nummer setzt der Tenant ueber das Self-Service-Dashboard.
# Der Boot-Guard verlangt fail-closed eine aktive Nummer im Store (sonst kein Start).
#
# Render-Autoseed der Owner-/Betriebsnummer (render-owner-autoseed): Render (free plan)
# hat ein FLUECHTIGES Dateisystem -> data/store.json (und damit die per bootstrap-tenant
# eingetragene aktive Owner-Nummer) ist nach JEDEM Deploy weg, der Boot-Guard braeche
# fail-closed mit exit(1) ab. OWNER_NUMBER_SEED traegt die Owner-Betriebsnummer beim Boot
# idempotent in den json-Store (nur STORE_BACKEND=json; bei pg ueberfluessig -> Nummer
# dort EINMALIG per CLI seed-owner-number/bootstrap-tenant). Leer = kein Seed -> der
# Boot-Guard bleibt fail-closed. Existiert schon eine aktive Owner-Nummer -> No-Op.
#   OWNER_NUMBER_SEED        E.164 der Owner-Absende-/Routing-Nummer, z.B. +491701234567
#                            (kein gueltiges E.164 -> kein Seed -> Boot-Refusal).
#   OWNER_NUMBER_PROVIDER    telnyx (einziger Anbieter). LEER -> telnyx.
#                            Tippfehler (z.B. "twillio") -> kein Seed -> Boot-Refusal
#                            (kein stiller Falsch-Carrier).
# NICHT verwechseln: dies ist die Betriebs-/Absende-/Routing-Nummer (Tenant "owner"),
# NICHT eine private SMS-Empfaengernummer (die setzt der Tenant ueber Self-Service).
OWNER_NUMBER_SEED=
OWNER_NUMBER_PROVIDER=
# GAP-38: Bootstrap-Parameter des Deploys. Frueher las sie NUR das preDeployCommand in
# render.yaml - Render fuehrt das auf plan:free nicht aus, der Seed lief live also nie.
# Seither liest sie der Boot selbst (src/boot.js healBootstrapStore) und heilt damit einen
# NACHWEISLICH frischen Store: keine Nummer, kein fremder Tenant, keine Call-Historie.
# Jede weitere Zeile heisst "der Store hat gelebt" -> KEINE Heilung, der fail-closed
# Boot-Refusal greift (Proliferations-Schutz). Leer oder ungueltig (E.164 + telnyx)
# -> ebenfalls keine Heilung.
# ABGRENZUNG zu OWNER_NUMBER_SEED oben: jener ist ein json-only Nummern-Seed in
# store/json.js und legt KEINEN Tenant an; BOOTSTRAP_E164/BOOTSTRAP_PROVIDER sind
# backend-agnostisch (Tenant UND Nummer, ueber die Store-Fassade). REIHENFOLGE: der
# json-Seed laeuft in load(), also VOR der Heilung - hat er bereits eine aktive Nummer
# erzeugt, ist die Heilung ein No-Op (kein Doppel-Seed).
# Derselbe Wert speist auch das manuelle CLI: npm run bootstrap-tenant -- <e164> <provider>
BOOTSTRAP_E164=
BOOTSTRAP_PROVIDER=
# OUTBOUND-E1: die Absendernummer (ANI) des Produkt-Outbounds als E.164. Aus diesem Wert
# leitet der Boot beim Start die Plattform-Nummern-Bindung ab (platform_number_use) - der
# dreifache Freigabe-Riegel, der verhindert, dass ein Kuendigungs-/Loeschweg diese Nummer
# versehentlich freigibt (Ausfall 2026-08-24: genau das ist passiert). Leer = KEINE
# Bindung -> Bestandsverhalten, der Boot-Guard meldet das laut (nicht fatal - ein
# Boot-Refusal taeuschte ein Outbound-Problem gegen einen Inbound-Totalausfall).
# ABGRENZUNG zu ELEVENLABS_AGENT_PHONE_NUMBER_ID oben: das ist eine opake Anbieter-ID
# (phnum_...), KEINE E.164, und aus ihr laesst sich keine Bindung ableiten.
# Live dashboard-verwaltet - diese Datei allein setzt live nichts.
PLATFORM_ANI_E164=
# AM6: WorkOS user.id (sub) des Owners idempotent an den Bootstrap-Tenant binden
# (idp_subject). Geschwister-Seed zu OWNER_NUMBER_SEED (ueberlebt Renders fluechtiges FS /
# No-CLI-Free-Tier; greift in BEIDEN Backends - json beim Boot, pg in init()). Damit
# findet resolveTenant beim claude.ai-OAuth-Login den Tenant MIT der aktiven Nummer ueber
# den sub-Claim (EINE Identitaetsquelle wie der Web-Login -> get_my_number ist nicht leer).
# Opake user_-Id, KEIN Secret. Leer = kein Seed (fail-closed: unbekannte Identitaet -> kein
# Tenant). set-if-absent: eine bereits gebundene Identitaet gewinnt. Nur bei MCP_AUTH=oauth
# relevant. Wert = der im WorkOS-Dashboard sichtbare user_... des Owner-Kontos.
OWNER_IDP_SUBJECT=
# SMS-Benachrichtigung nach jedem Call an die private Summary-Nummer (true/false)
SEND_SMS_SUMMARY=true
# Tages-Cap pro Tenant fuer Summary-SMS (F2 P8, Toll-Fraud-Schutz): nach so vielen
# erfolgreich gesendeten Summary-SMS im rollierenden 24h-Fenster wird die naechste
# still uebersprungen. Default 20; 0 = jede Summary-SMS gesperrt (Not-Aus).
DAILY_SMS_CAP=20

# ---- Server ----
PORT=3000
# Oeffentliche URL des Servers (ngrok), OHNE Slash am Ende, z.B. https://abc123.ngrok-free.app
PUBLIC_URL=https://CHANGE-ME.ngrok-free.app

# ---- Frontend (apps/web Static Site, Render-Service hermes-web) ----
# Build-Zeit-Var fuers Astro-Frontend: absoluter Auth-Origin des Gateways. Die
# Funnel-/Login-Links (apps/web/src/lib/routes.js -> LOGIN_URL) zeigen absolut auf
# <PUBLIC_GATEWAY_URL>/auth/login, weil die Static Site selbst kein /auth/login hat
# (404). Fehlt die Var im Static-Site-Build, bricht der Build fail-closed ab. Gesetzt
# beim hermes-web-Service in render.yaml; lokal nur fuer apps/web-Builds/Tests noetig.
PUBLIC_GATEWAY_URL=https://vodafone-agent.onrender.com

# Single-Origin (P1): Verzeichnis des apps/web-Builds (astro build -> apps/web/dist).
# Leer (Default) = AUS -> heutiges Serving byte-identisch (nur public/, oeffentlich).
# Gesetzt -> der Gateway liefert Marketing + App-Shell same-origin.
# Lokal z.B. apps/web/dist (vorher 'astro build' mit PUBLIC_GATEWAY_URL=http://127.0.0.1:<port>).
# Ein relativer Wert wird gegen das Arbeitsverzeichnis aufgeloest (path.resolve).
# Fehlt der Build (<dir>/index.html), verweigert der Boot (sichtbarer Fehler statt 404).
WEB_DIST_DIR=

# ---- Public Hosting (Render) ----
# AUTH-P7: seit dem Wegfall des Basic-Auth-Gates liest KEINE Route diese Variable mehr.
# Sie bleibt trotzdem Boot-Pflicht bei oeffentlichem Hosting - ausschliesslich als
# Rollback-Sicherung: ein Rollback auf einen Commit vor AUTH-P7 findet damit ein
# scharfes Gate vor. Entfernt wird die Variable erst in AUTH-P8.
DASHBOARD_PASSWORD=

# Rechteprofile (Phase 2) als JSON, beim Start in den Store geseedet. Schluessel =
# Identitaet aus dem OAuth-Token (email, sonst der IdP-sub, z.B. "user_01ABC...").
# Noetig auf Render (free plan, fluechtiges Dateisystem); per-API angelegte Profile
# ueberleben dort keinen Neustart. Leer = keine Seed-Profile.
# Beispiel: PROFILES_JSON={"user_01ABC...":{"unrestricted":true,"maxCallsPerHour":6}}
PROFILES_JSON=

# ---- MCP ueber HTTP (Custom Connector) ----
# Auth-Modus fuer /mcp:
#   leer    = Legacy/fail-closed: mit MCP_AUTH_TOKEN gilt das Bearer-Token,
#             ohne Token ist /mcp NUR von localhost erreichbar (Default) - in
#             Produktion (RENDER_EXTERNAL_URL gesetzt) ist auch das deaktiviert (401).
#   token   = statisches Bearer-Token erzwingen (curl/Tests; claude.ai kann das NICHT senden).
#   oauth   = OAuth 2.1 Resource Server fuer den claude.ai-Login-Flow (Produktion).
#   off     = offen ohne Pruefung (NUR lokale Demos!).
MCP_AUTH=
# Statisches Bearer-Token fuer /mcp (Modus leer/token). Token erzeugen: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Nur bei MCP_AUTH=oauth: Issuer-URL des IdP (z.B. WorkOS AuthKit). Das Gateway
# findet JWKS selbst ueber <issuer>/.well-known/openid-configuration.
OAUTH_ISSUER_URL=
# Optional: erwartete Audience im Access-Token. Leer -> PUBLIC_URL + /mcp. Bei WorkOS
# der registrierte Resource-Indicator (z.B. https://app.sundartha.com/mcp).
OAUTH_AUDIENCE=
# AM6: Owner-OAuth-Identitaet -> Bootstrap-Tenant. Damit get_my_number unter MCP_AUTH=oauth
# nicht leer ist (sub-Claim findet den Tenant mit der aktiven Nummer), den Owner-sub binden.
# Definition + Erklaerung oben bei OWNER_NUMBER_SEED (Owner-Seeds gehoeren zusammen).

# ---- Store-Backend ----
# json (Default) = Datei-Persistenz (data/store.json). pg = Postgres.
# Im json-Pfad ist DATABASE_URL nicht noetig (es wird keine DB-Verbindung erzeugt).
STORE_BACKEND=json
# Postgres-Connection-String (NUR bei STORE_BACKEND=pg). Secret -> niemals committen.
DATABASE_URL=

# ---- Queue-Backend (async Provisioning-Worker) ----
# memory (Default) = deterministische In-Memory-Queue (kein Timer, drain-on-demand).
# pgboss ist vorbereitet, aber noch nicht aktiv (deferred). NICHT auf pgboss setzen.
QUEUE_BACKEND=memory

# ---- Datenschutz ----
# Beendete Calls (samt Transkript) und Notifications aelter als X Tage werden
# geloescht (DSGVO-Datenminimierung). 0 = Retention aus.
RETENTION_DAYS=30

# P2b: Roh-Transkripte diagnostisch markierter Calls (Ziel = die eigene verifizierte
# Nummer des Tenants) werden nach X Tagen geloescht - STRENGER als RETENTION_DAYS, das
# weiterhin fuer den Call-Record selbst gilt. 0 = Diagnosemodus aus (kein Call wird
# markiert, markierte Alt-Transkripte fallen beim naechsten Sweep).
# GQ-P11: bei >0 markiert der Server JEDEN Anruf an diese eine Nummer selbst; der
# MCP-Parameter "diagnostic" ist nur noch der Widerspruch (false). Ein Anruf an ein
# fremdes Ziel wird nach wie vor NIE markiert.
# In Produktion erst auf >0 stellen, wenn die Datenschutzerklaerung den Diagnosemodus nennt.
DIAGNOSTIC_RETENTION_DAYS=7

# AL-P11 (O5): woertliche Zitate in der Ergebnis-Karte (result.evidence, hoechstens 2).
# Diese Zahl ist zugleich der Schalter UND die Frist: 0 = aus (kein Zitat wird erhoben,
# Alt-Zitate fallen beim naechsten Sweep). Eigene, KURZE Frist - laeuft NICHT ueber
# RETENTION_DAYS und NICHT ueber DIAGNOSTIC_RETENTION_DAYS.
# Erst auf >0 stellen, wenn die Datenschutzerklaerung woertliche Zitate + Frist nennt.
EVIDENCE_RETENTION_DAYS=0

# ---- Sicherheit (nur fuer lokale Tests) ----
# true = Twilio-Signaturpruefung der /voice-Webhooks abschalten (z.B. fuer curl-Tests).
# NIEMALS im oeffentlichen Hosting setzen!
SKIP_TWILIO_SIGNATURE_CHECK=false
# OUT-05: Test-Seam. true ersetzt den echten Provider-Dial durch einen Fake (Offline-Tests).
# BOOT-GEHAERTET: nur mit SKIP_TWILIO_SIGNATURE_CHECK=true zulaessig -> in Produktion
# (Signaturpruefung an) verweigert der Boot. NIEMALS im Hosting auf true setzen.
FAKE_ORIGINATE=false
# OUT-05-EL: Trockenlege-Naht-Gegenstueck fuer den ElevenLabs-SIP-Trunk-Anrufstart (der
# dritte Outbound-Weg) - FAKE_ORIGINATE oben deckt NUR den Telnyx-Weg ab. true ersetzt den
# einen POST gegen api.elevenlabs.io durch eine Antwort in der Anbieter-Form mit erfundenen
# Werten (kein Netzzugriff, kein echter SIP-Anruf). BOOT-GEHAERTET wie FAKE_ORIGINATE: nur
# mit SKIP_TWILIO_SIGNATURE_CHECK=true zulaessig -> in Produktion verweigert der Boot.
# NIEMALS im Hosting auf true setzen!
FAKE_ORIGINATE_ELEVENLABS=false

# ---- Voice-Engine ----
# budget   = Telnyx TeXML STT/TTS + Claude Haiku (quasi gratis, Default)
# realtime = OpenAI Realtime API: Speech-to-Speech, echtes Barge-in, beste Qualitaet
#            (~0,30-0,50 EUR/Minute, braucht OPENAI_API_KEY mit Guthaben)
VOICE_ENGINE=budget
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=alloy

# ---- Web-Login (Kunden-Portal) ----
# Lokaler Dev-Login: STORE_BACKEND=pg + DATABASE_URL (oder pglite im Test), SESSION_SECRET,
# PUBLIC_URL=http://127.0.0.1:<port>, und ein OIDC-Test-IdP (OAUTH_ISSUER_URL http://127.0.0.1...
# ist erlaubt, s. SSRF-Hinweis in config.js). Erst-Login legt den Tenant SUSPENDED an ->
# Redirect ins Portal (/tenant.html) mit "Choose your plan"; Aktivierung kommt ueber das Abo (W4).
SESSION_SECRET=            # HMAC-Secret fuer Session-Cookies (langer Zufallswert)
OIDC_CLIENT_ID=            # WorkOS AuthKit Client-ID
OIDC_CLIENT_SECRET=        # WorkOS AuthKit Client-Secret (SECRET)
# 312k-Phase 4: EIGENER Schluessel fuer die WorkOS-Nutzerloeschung beim Vertragsende
# (Kuendigung nach § 312k BGB) - NICHT OIDC_CLIENT_SECRET: der Anmeldeschluessel oben ist
# fuer den Login-Flow bestimmt, ob er ueberhaupt Loeschrechte traegt ist ungeklaert, und ein
# Anmeldeschluessel gehoert nicht auf einen unwiderruflichen Loeschpfad. Im WorkOS-Dashboard
# als eigener API-Key mit User-Management-Loeschrecht anlegen. Leer (Auslieferungszustand) =
# die Loeschung wird NICHT versucht - sie wird am Tenant als offen vermerkt (Retry-Sweep),
# der Rest der Vertragsende-Verarbeitung (Sperre, Rufnummer freigeben) laeuft normal weiter.
WORKOS_MANAGEMENT_API_KEY=  # SECRET - nie committen/loggen

# ---- Mail (312k-Phase 5: Kuendigungsbestaetigung; HTTP-Fortsetzung; F2-Mail: Call-Summary-Mail) ----
# ZWEI moegliche Kanaele, EINE Rangfolge (wiring/web-login.js selectMailer): BREVO_API_KEY
# gesetzt -> Versand per HTTP (Brevo, Port 443); sonst SMTP_HOST gesetzt -> Versand per SMTP
# (Zoho EU, s.u.); sonst kein Mailer. Dieselbe Rangfolge speist BEIDE Mail-Pfade: die
# Kuendigungsbestaetigung (billing/cancellation-mail.js) UND die Call-Summary-Mail nach
# jedem beendeten Anruf bei Newsletter-Einwilligung (mail-summary.js, server.js). Ohne
# gesetzte Variablen bleiben beide stumm uebersprungen (Audit-Reason no_mailer), kein
# Fehler.
#
# Warum es BREVO_API_KEY neben SMTP_* gibt: Render sperrt auf kostenlosen Web-Diensten den
# ausgehenden Verkehr auf allen SMTP-Ports (25/465/587) - der SMTP-Weg schlaegt dort mit
# ETIMEDOUT fehl. Brevo (Frankreich, EU-Verarbeitung, kostenloses Kontingent von rund 300
# Mails/Tag) laeuft ueber HTTP auf Port 443, den Render nicht sperrt. Sobald der Dienst auf
# einen bezahlten Plan wechselt, reicht das Setzen von SMTP_* ohne BREVO_API_KEY - der SMTP-
# Adapter bleibt unveraendert.
BREVO_API_KEY=              # SECRET - Brevo-Transactional-API-Key (api-key-Header), nie committen/loggen
#
# SMTP-Fallback: eigenes Postfach ueber SMTP - KEIN neuer Dienstleister. Die Domain liegt bei
# Zoho in der EU (mx.zoho.eu, SPF include:zohomail.eu bereits gesetzt): Host smtp.zoho.eu,
# Port 465 (TLS), Anmeldung mit der Postfachadresse + einem anwendungsspezifischen Passwort
# (im Zoho-Kontrollzentrum unter Sicherheit -> Anwendungspasswoerter anlegen, NICHT das
# normale Postfach-Passwort). Leer (Auslieferungszustand, wie BREVO_API_KEY) = kein Mailer
# konstruiert - die Kuendigungsbestaetigung bleibt am Tenant offen vermerkt, ein spaeterer
# Sweep versucht es erneut, sobald die Variablen gesetzt sind (Muster WORKOS_MANAGEMENT_API_KEY).
SMTP_HOST=                 # z.B. smtp.zoho.eu
SMTP_PORT=                 # TLS-Port, z.B. 465 - leer faellt auf 465 zurueck
SMTP_USER=                 # Postfachadresse, z.B. kontakt@sundartha.com
SMTP_PASSWORD=              # SECRET - anwendungsspezifisches Passwort, nie committen/loggen
MAIL_FROM=                  # Absenderadresse im From-Header (Brevo UND SMTP), meist = SMTP_USER
ADMIN_EMAILS=              # kommasepariert: wer approven/suspenden darf
LOGIN_RATE_LIMIT_PER_MIN=10
SESSION_TTL_SECONDS=3600   # Lebensdauer der Browser-Session in Sekunden (Default 1 h)
LOGIN_COOKIE_TTL_SECONDS=1800  # Lebensdauer der Login-Flow-Cookies (state/pkce) in Sekunden (Default 30 min)
# OAUTH_ISSUER_URL wird mit /mcp geteilt (WorkOS AuthKit Issuer)
# Single-Origin (P1): lokaler Dev-Login-Shim. true -> POST /auth/dev-login mintet eine
# Session OHNE WorkOS (nur fuer den lokalen Chrome-e2e-Loop). DOPPELT fail-closed:
# explizites Opt-in UND nie im Hosting (auf Render verweigert der Boot, falls true).
# NUR lokal setzen.
DEV_LOGIN_ENABLED=false
