# ---- Claude (Anthropic) - Gespraechslogik (Budget-Engine) + Summaries ----
ANTHROPIC_API_KEY=sk-ant-...
# Haiku = guenstigstes Modell, reicht fuer Telefonate voellig
CLAUDE_MODEL=claude-haiku-4-5
# Harter Kosten-Stopp in EUR. Bei Erreichen werden keine neuen Calls mehr angenommen/gestartet.
MAX_BUDGET_EUR=8

# ---- Mess-Instrumentierung (L0) ----
# PII-freie Latenz-/Loop-/STT-Gap-Logs (src/metrics.js). Default aus = byte-identisch.
# Zum Live-Messen (Datengrundlage fuer das STT-Tuning L1) auf true setzen.
METRICS_ENABLED=false

# ---- Twilio (Gratis-Trial-Account: https://www.twilio.com/try-twilio) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EU-Pfad kurz halten
TWILIO_EDGE=frankfurt

# HINWEIS: Absendernummern (Twilio/Telnyx) sind KEINE Env-Var mehr. Der Owner ist
# Tenant Null und haelt seine Nummer(n) wie jeder Tenant im Store. Bestandsnummer
# einmalig eintragen:  npm run seed-owner-number -- <e164> <twilio|telnyx>
# Der Boot-Guard verlangt fail-closed eine aktive Owner-Nummer im Store.

# ---- Telnyx (zweiter Provider, optional - P5) ----
# Leer lassen, wenn nur Twilio genutzt wird. Telnyx-Inbound/SMS sind dann inaktiv
# (fail-closed: Signatur-Verify -> false, sendSms wirft).
# WARNUNG (P5): Das Ed25519-Schema + die Voice-Bezeichner sind NUR gegen die
# Telnyx-Doku, NICHT live bestaetigt. Bis zum gruenen Live-Smoke bleibt Telnyx
# fail-closed (Worst Case: Inbound wird abgelehnt, kein Leck).
# WARNUNG (P7): Telnyx + VOICE_ENGINE=realtime NICHT produktiv nutzen, bevor der
# WS-Echo-Test (scripts/telnyx-ws-echo.mjs) gruen ist - das exakte Media-Payload-
# Format (rohe u-law base64 vs. RTP-gewrappt) ist live unbestaetigt. Twilio-Realtime
# bleibt unberuehrt.
# Telnyx API-Key (Bearer). SECRET -> niemals committen. Fehlt -> sendSms wirft.
TELNYX_API_KEY=
# Ed25519-Public-Key des Telnyx-Accounts (Webhook-Signatur). Fehlt -> Verify fail-closed false.
TELNYX_PUBLIC_KEY=
# Telnyx API-Base (Default https://api.telnyx.com; nur fuer Tests/Proxy aendern).
TELNYX_API_BASE=https://api.telnyx.com
# TeXML-Application/Connection-ID (Telnyx-Portal: Voice -> TeXML -> App anlegen,
# voice_url = <PUBLIC_URL>/voice/incoming). Pflicht fuer Telnyx-OUTBOUND
# (originateCall). Leer -> Telnyx-Outbound wirft (fail-closed), Twilio unberuehrt.
TELNYX_CONNECTION_ID=
# Telnyx-Account-ID (Mission-Control-Portal-Startseite). Pflicht fuer den
# Telnyx-Hangup (endCall). Leer -> endCall wirft (Max-Dauer/Cancel greifen nicht).
TELNYX_ACCOUNT_SID=
# ---- ElevenLabs-TTS ueber Telnyx (globale Plattform-Stimme, optional) ----
# Identifier des Telnyx-Integration-Secrets mit dem ElevenLabs-API-Key (Portal:
# Integration Secrets, oder POST /v2/integration_secrets). Feature nur aktiv,
# wenn REF UND VOICE_ID gesetzt sind - sonst rendert Telnyx die Azure-Stimmen
# (byte-identisch). Bewusste Vereinfachung: EIN Plattform-Key, TTS-Zeichen aller
# Tenants laufen ohne per-Tenant-Metering aufs Owner-ElevenLabs-Konto (Paid-Plan
# noetig, Freemium unterstuetzt Telnyx nicht). STT bleibt davon unberuehrt
# (Deepgram - Telnyx kann ElevenLabs nur fuer TTS).
TELNYX_ELEVENLABS_API_KEY_REF=
# ElevenLabs-Voice-ID aus der Library (multilingual: EINE Stimme fuer alle
# Sprachen - die gesprochene Sprache folgt dem generierten Text).
TELNYX_ELEVENLABS_VOICE_ID=
# Model-Slot im voice-Attribut ElevenLabs.<Model>.<VoiceId>. Telnyx dokumentiert
# "Default" und "v3"; andere Slugs nur nach Live-Probe nutzen.
TELNYX_ELEVENLABS_MODEL=Default

# Play-TTS: ElevenLabs-Stimme via <Play> in der Budget-Engine (Telnyx). GETRENNT vom
# Relay (TELNYX_ELEVENLABS_* oben). Default AUS -> Azure byte-identisch.
ELEVENLABS_PLAY_TTS_ENABLED=false
ELEVENLABS_API_KEY=                       # SECRET (nie committen)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_SYNTH_TIMEOUT_MS=4000
ELEVENLABS_TTS_TOKEN_TTL_MS=60000

# ---- Telnyx AI Assistant / Brain-Shim (C-Telnyx, voll-duplex Barge-in - P10) ----
# Master-Flag fuer den in-house Custom-LLM-Shim (/v1/chat/completions) + die Call-
# Control-Origination. DEFAULT AUS: der Shim antwortet 404, der Live-CALL-Pfad
# (Budget/Realtime-Engine) bleibt byte-identisch. Erst NACH verifiziertem Deploy im
# Dashboard scharfstellen (Owner-Cutover, P11). Flag an -> assertConfig verlangt
# TELNYX_ASSISTANT_ID + TELNYX_API_KEY + TELNYX_CONNECTION_ID +
# TELNYX_CALL_CONTROL_APP_ID (fail-closed Boot).
TELNYX_AI_ASSISTANT_ENABLED=false
# ID des in P7 provisionierten Telnyx-AI-Assistants (ai_assistant_start). Opake ID,
# KEIN Secret - aber deployment-spezifisch. Leer + Flag an -> Boot-Refusal.
# Anlegen/Config: scripts/telnyx-assistant-provision.mjs (docs/RUNBOOK-TELNYX-ASSISTANT.md).
TELNYX_ASSISTANT_ID=
# ID der Call-Control-Application (Telnyx-Portal: Voice -> Call Control -> App anlegen).
# NICHT die TeXML-ID aus TELNYX_CONNECTION_ID - Telnyx fuehrt beide als getrennte
# Objekttypen. Die TeXML-ID hier einzutragen liefert bei JEDEM Outbound
# HTTP 422 "10015 Invalid value for connection_id (Call Control App ID)".
# Nur der Call-Control-Pfad (Flag an) nutzt sie. Leer + Flag an -> Boot-Refusal.
TELNYX_CALL_CONTROL_APP_ID=
# Max. Shim-Turns pro callId und Minute (Token-/Toll-Fraud-Bremse VOR agentTurn,
# zusaetzlich zu IP-Limiter + Budget-Cap). Default 30; Werte > 120 werden im Hosting
# bei aktivem Assistant als Footgun abgelehnt (Bremse waere praktisch aus).
TELNYX_SHIM_MAX_TURNS_PER_MIN=30
# stab-p9 Kosten-Notaus fuer den AI-Assistant-Pfad (konservativ, nur bei aktivem Flag
# wirksam; scharfe Kalibrierung aus P4/P5-Evidenz):
# Dead-Air: Sekunden ohne Shim-Turn nach ai_assistant_start -> Call wird kontrolliert beendet
# (stille TTS). Sinnvoll < MAX_CALL_DURATION_S. Min 5, max 300.
TELNYX_DEAD_AIR_TIMEOUT_S=45
# Loop-Guard: max. konsekutive leere/Echo-Turns -> Call wird beendet (Re-Prompt-Leerlauf).
# Zusaetzlich zum Rate-Limiter. Min 3, max 50 (darueber wird lautlos auf 50 geklemmt).
TELNYX_LOOP_GUARD_MAX_EMPTY_TURNS=8
# E2: statisches Telnyx-Integration-Secret, das der Shim als Bearer prueft. SECRET.
# Bei Flag an Boot-Pflicht (assertConfig). Muss WERT-gleich mit dem Telnyx-Integration-
# Secret <TELNYX_SHIM_API_KEY_REF> sein (Owner legt beide im Cutover an).
TELNYX_SHIM_SHARED_SECRET=
# E3: NAME (nicht Wert) des Telnyx-Integration-Secrets fuer external_llm.llm_api_key_ref.
# NUR das Provisioning-Skript liest ihn.
TELNYX_SHIM_API_KEY_REF=
# OBS-FLAG (Diagnose): einmaliger Shape-Dump im Shim. AN -> pro authentifiziertem Turn EINE
# keys-only-Log-Zeile (Top-Level-Feldnamen + ccid-Position-Booleans, NIE Werte). Nur fuer den
# EINEN ueberwachten Diagnose-Call auf true setzen, danach wieder false. NICHT boot-relevant.
TELNYX_SHIM_DEBUG_SHAPE=false

# ---- Sicherheits-Gates ----
# Globaler Outbound-Kill-Switch (Not-Aus). true = ALLE Outbound-Calls sofort gesperrt
# (403), ohne Deploy. Default false. Betriebs-Notbremse + Sekunden-Rollback.
OUTBOUND_FROZEN=false
# ALLOWED_NUMBERS: ab outbound-p3 NICHT mehr vom Code gelesen (statische Allowlist
# abgeschafft; Permit = per-Tenant-Verifikation Abo+KYC). Key bleibt nur fuer den
# Env-Cleanup beim Cutover; Wert ist wirkungslos.
ALLOWED_NUMBERS=
# Erlaubte Laendervorwahlen fuer Outbound (kommasepariert, E.164-Prefix wie +49).
# Default +49,+33,+44 (Deutschland, Frankreich, UK). * = alle Laender erlaubt (Land-Gate aus).
ALLOWED_COUNTRY_CODES=+49,+33,+44
# Max. Outbound-Calls pro gleitender Stunde (eigenes Gate, NICHT RATE_LIMIT_PER_MIN).
# Bremse gegen Toll-Fraud/Kosten-Explosion. Default 6; 0 = jeder Outbound gesperrt.
MAX_CALLS_PER_HOUR=6
# ---- Per-(Tenant,Ziel)-Wiederhol-Cap + Cooldown (outbound-p1d, D4) ----
# Max. Outbound-Calls EINES Tenants an DASSELBE Ziel im Cooldown-Fenster; ab dem Cap
# -> 429 (fail-closed), tenant- + ziel-isoliert. Belaestigungs-Bremse, sobald Fremd-
# Tenants beliebige Nummern waehlen. 0 = jeder Outbound gesperrt (Not-Aus).
PER_TARGET_CALL_CAP=3
# Cooldown-Fenster in Millisekunden (Default 24 h = 86400000).
PER_TARGET_WINDOW_MS=86400000
# Hinweis: Notruf-Kurzwahlen (110/112/911/999) und eine globale Best-effort-Blockliste
# der hoechsten Premium-/Service-/Satelliten-/IPRN-Ziele (u.a. DE 0900/0137/0180/0118/0700,
# UK 118/070/09/084x/087x, FR 118/089x/081x/082x, Satellit +87x/+88x, IPRN +979) sind fest
# gesperrt (hardcoded in src/server.js, kein Env, nicht abschaltbar).
# ---- Onboarding ohne Payment (Kosten-Notbremse statt Stripe) ----
# Harte Obergrenze, wie viele Nummern die Plattform INSGESAMT provisionieren darf
# (jede echte Nummer kostet Geld). Ersetzt das uebersprungene Stripe-Schloss.
# 0 = Provisioning gesperrt (Not-Aus). Default 5 (bewusst klein).
MAX_NUMBERS=5
# Wie viele AKTIVE Nummern ein einzelner Tenant haben darf. Default 1.
MAX_NUMBERS_PER_TENANT=1
# Self-Service-Provisioning (ECHTER Nummern-Kauf). Default false (fail-closed):
# /api/onboard registriert + fragt dann nur an (Nummer 'requested', KEIN Geld).
# Erst true -> echte Kaeufe ueber Telnyx, gedeckelt durch MAX_NUMBERS. Braucht
# TELNYX_CONNECTION_ID + TELNYX_API_KEY. NIE per Default an.
PROVISIONING_ENABLED=false
# ISO-Laendercode fuer die Nummernsuche beim Kauf (DE-only Launch). Default DE.
PROVISIONING_COUNTRY=DE
# ---- PROV-01 Crash-Recovery: Auto-Redrive haengender Provisioning-Jobs (F4/F5) ----
# Maximales Job-Alter in MILLISEKUNDEN, bis zu dem der Boot-Reconciler eine in
# 'requested' haengende Nummer automatisch nachfuehren darf. 0 (Default) = Observe-Only
# (fail-closed): kein Auto-Nachkauf, haengende Jobs werden nur geloggt. MUSS strikt
# KLEINER als das kleinste Anbieter-Idempotenz-Fenster bleiben (Stripe-Hold = 24h),
# sonst Doppelkauf-Risiko. Scharf empfohlen 3600000 (1h). Erst nach gruenem Telnyx-
# Idempotenz-Smoke > 0 setzen.
PROVISIONING_REDRIVE_MAX_AGE_MS=0
# tenant-prolif-d: Grace-Periode (TAGE), bis der Reconciler eine DID eines >Grace
# suspendierten Tenants automatisch freigibt. 0 (Default) = Observe-Only fail-closed:
# NICHTS wird freigegeben, Kandidaten werden nur geloggt. Erst > 0 schaltet echte
# Telnyx-DELETEs scharf. Ein Fehl-Release ist Rufnummern-Verlust fuer einen zahlenden
# Kunden -> konservativ (mehrere Tage) waehlen.
RELEASE_GRACE_DAYS=0
# Erzwungenes KAUF-Land fuer ALLE neuen Nummern (ISO-2), ENTKOPPELT vom erkannten
# Herkunftsland. Leer (Default) -> Kauf-Land = erkanntes Land (heutiges Verhalten byte-
# identisch). Gesetzt (z.B. US) -> jede neue Nummer wird DORT gekauft; die SPRACHE bleibt
# am erkannten Herkunftsland (number.language), NICHT am Kauf-Land. Geo-/Sprach-Erkennung
# bleibt voll aktiv - diese Var neutralisiert nur die Kauf-Land-Wahl.
FORCE_NUMBER_COUNTRY=
# Geo-Quelle bei der Registrierung (F1 Phase 6): IP->Land-VORSCHLAG ueber lokalen
# maxmind-Lookup. Default false (fail-closed, netzfreie CI): Null-Adapter -> Land-
# Fallback DE, Onboard byte-identisch. Erst true -> lokaler maxmind-Adapter (User-Wahl
# bleibt autoritativ; IP verlaesst den Prozess NIE). Braucht GEO_DB_PATH + ggf. einen
# Owner-genehmigten mmdb-Reader; bis dahin liefert der Adapter fail-safe null (DE).
GEO_ENABLED=false
# Pfad zur lokalen GeoLite2-Country-mmdb (nur bei GEO_ENABLED=true). Leer -> fail-safe
# null (DE-Fallback). Das Asset wird NICHT eingecheckt.
GEO_DB_PATH=
# Multi-Tenant-Identitaets-/Laufzeit-Schicht (I4-I7). Default false (fail-closed):
# Owner byte-identisch, kein Tenant-Scoping. Erst true (nach den dichten Scope-Gates)
# loest die Auth-Achse den Request-Tenant aus req.auth.sub auf. NIE per Default an.
MULTI_TENANT=false
# Self-Service-Schicht (I9/#3): web-session-only — getrenntes Tenant-Dashboard + Settings.
# Default false (fail-closed): Self-Service-Routen nicht erreichbar (404), Admin-
# Dashboard + /api/* byte-identisch. Authentifiziert AUSSCHLIESSLICH per OIDC-Browser-
# Session (webAuthMw); kein Bearer-Paste/X-Internal-Identity mehr. Braucht
# MULTI_TENANT=true + SESSION_SECRET + OAuth-Provider. NIE per Default an.
SELF_SERVICE_ENABLED=false
# ---- MCP Rich-UI (P1-W3) ----
# Rich-UI ui://-Resource fuer faehige MCP-Hosts. DEFAULT AN (Produkt-Default). Ein Host
# bekommt das Widget nur, wenn er die UI-Capability deklariert (fail-closed gehedged);
# sonst weiter nur Text/structuredContent. Mit =false explizit abschaltbar.
MCP_UI_ENABLED=true
# ---- Persoenlicher Assistent: strukturierter Per-Call-Kontext (PLAN-PERSONAL-ASSISTANT P3) ----
# Optionales context-Objekt an place_call (summary, key_facts[], recipient_relationship,
# desired_outcome) -> kompakte HINTERGRUND-Sektion im Outbound-Prompt + additiv persistiert.
# Default AN (Produkt-Default seit I12/call-quality): der Kanal ist produktionsreif.
# Auf false setzen, um ihn abzuschalten (b.context wird dann ignoriert, Prompt-Block +
# /api/calls byte-identisch zum Bestand ohne den Kanal).
ASSISTANT_CONTEXT_ENABLED=true
# ---- Pre-Call-Briefing (PLAN-CONVERSATION-QUALITY-V2 P8) ----
# Vor dem Waehlen fuellt ein starkes Modell den strukturierten call.context (+ optional
# das Mandat) aus objective/briefing/constraints. Default AUS (fail-closed): kein zweiter
# LLM-Aufruf, keine Zusatzkosten, /api/calls byte-identisch. Wirkt nur zusammen mit
# ASSISTANT_CONTEXT_ENABLED=true (dort sitzt der Konsument der HINTERGRUND-Sektion).
PRECALL_BRIEFING_ENABLED=false
# Briefing-Modell. MUSS in config.llm.modelPricesUsd stehen, sonst bucht das Budget-Gate
# fail-closed zur teuersten hinterlegten Rate.
PRECALL_BRIEFING_MODEL=claude-sonnet-5
# Eigener kurzer Timeout des Briefing-Aufrufs (kein Retry) - POST /api/calls wartet darauf.
PRECALL_BRIEFING_TIMEOUT_MS=6000
# ---- Payment/Billing (Stripe Hold/Capture, P6b1) ----
# Master-Flag: Geld halten -> Nummer provisionieren -> capturen -> aktivieren.
# Default false (fail-closed): kein Hold/Capture, requested->provisioning->active.
# Erst true -> Stripe-Hold/Capture beim Onboarding (braucht STRIPE_SECRET_KEY +
# NUMBER_SETUP_FEE_CENTS > 0, nur sinnvoll mit PROVISIONING_ENABLED=true). NIE per Default an.
PAYMENT_ENABLED=false
# Stripe Secret Key (sk_test_... / sk_live_...). SECRET - nie committen/loggen.
STRIPE_SECRET_KEY=
# Stripe-API-Basis (Test-Mode nutzt denselben Host wie Live, Unterschied = Key).
STRIPE_API_BASE=https://api.stripe.com
# Einmalige Setup-Gebuehr pro Nummer in GANZZAHL Cents (Geld nie als Float).
# 0 = ungesetzt; bei PAYMENT_ENABLED=true Pflicht > 0.
NUMBER_SETUP_FEE_CENTS=0
# Waehrung (ISO-4217, lowercase) fuer den Hold/Capture. Default eur.
PAYMENT_CURRENCY=eur
# Waehrung der Provider-Detail-Records (ISO-4217, Grossschreibung). Default USD (Messung
# 2026-07-20: alle 293 Records USD). NICHT PAYMENT_CURRENCY - Provider-Messwerte sind
# USD, Tarife/Deckel im Repo EUR. Ein Record mit abweichender Waehrung wird VERWORFEN.
PROVIDER_CURRENCY=USD
# ---- Outbound-Kosten-Achse / Vorab-Reservierung (outbound-p1c) ----
# Voice-Minuten-Tarif in GANZZAHL Cents/min. EINE Kosten-Quelle: Vorab-Reservierung +
# Budget-Reconcile + Stripe-Voice-Meter. Inland (+49/+33/+44) guenstig, alles andere
# Worst-Case-Default. Live mit dem Provider-Tarif abgleichen.
VOICE_TARIFF_DOMESTIC_CENTS=20
VOICE_TARIFF_DEFAULT_CENTS=300
# Per-Tenant Default-Kostendecke (GANZZAHL Cents). Seedt die tenant_budget-Zeile beim
# Registrieren UND ist der Gate-Fallback fuer jeden Tenant ohne Zeile (P2a). 0 = kein Seed
# und kein Fallback (Tenant faellt auf MAX_BUDGET_EUR, Bestandsverhalten).
# MUSS ECHT KLEINER als MAX_BUDGET_EUR*100 sein - sonst VERWEIGERT der Boot-Guard
# (spendCapCoherence, P3) den Start: eine Tenant-Decke >= dem globalen Plattform-Cap
# ist wirkungslos (der Backstop bindet immer zuerst), das ist echter Schutzverlust.
# 600 = Minutenwert des Starter-Abos (30 min * 20 ct), echt unter MAX_BUDGET_EUR*100=800.
# Globaler Backstop bleibt PARALLEL.
DEFAULT_TENANT_BUDGET_CENTS=600
# Grober Kostenbeleg pro gesendeter Summary-SMS (F2 P8) in GANZZAHL Cents. Jede
# erfolgreich gesendete Summary-SMS erzeugt ein Usage-Event mit diesem Betrag; 0 =
# Menge ohne Kostenbeleg.
SMS_COST_CENTS=0
# ---- Plattform-Fruehwarnung (Budget-Achsen P6) ----
# Anteil von MAX_BUDGET_EUR (Plattform-Cap), ab dem GENAU EIN Audit-Ereignis pro
# Spend-Monat feuert - BEVOR der Notaus (Plattform-Notaus) tatsaechlich blockt.
# Ganzzahl 0-100. 0 = Warnung AUS, byte-identisch zum Bestand. AENDERT KEINE
# Gate-Entscheidung.
PLATFORM_SPEND_WARN_PERCENT=80
# Betreiber-Nummer (E.164) fuer die zusaetzliche Warn-SMS bei der Fruehwarnung oben.
# LEER = KEINE SMS, nur Audit-Log-Eintrag. NIE die private Nummer eines Tenants
# eintragen (das Owner-Konzept ist aus dem Code entfernt, Admin laeuft ueber
# account.role - es gibt keine natuerliche Zielnummer fuer eine Plattform-Groesse).
PLATFORM_ALERT_SMS_TO=
# ---- Spend-Monat-Flip (Budget-Achsen P7) ----
# AN = BEIDE Gate-Achsen (Tenant UND Plattform) messen den Verbrauch im UTC-Kalendermonat
# statt im Lebenszeit-Zaehler. AUS (Default) = byte-identisch zum Bestand. Vorbedingung
# vor dem Flip: ein Live-Beleg, dass spendMonthKey einen Neustart uebersteht. Der Rollback
# ist ein Env-Flip OHNE Deploy. NACH dem Flip sind MAX_BUDGET_EUR/DEFAULT_TENANT_BUDGET_
# CENTS oben MONATS-Werte, keine Lebenszeit-Werte mehr - vor dem Flip neu dimensionieren.
BUDGET_MONTH_ENABLED=false
# ---- Abo-Buchung (Stripe Recurring, W4) ----
# Stripe-Price-Ids (recurring monatlich, EUR) je Tier (im Stripe-Dashboard angelegt).
# Leer = Tier nicht buchbar (Route 500, KEIN Boot-Stop). Opake price_-Referenzen.
STRIPE_STARTER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Stripe-Webhook-Signing-Secret (whsec_...). SECRET - nie committen/loggen. Bei
# PAYMENT_ENABLED=true Pflicht (sonst ist der Abo-Webhook fail-closed unverifizierbar).
STRIPE_WEBHOOK_SECRET=
# Self-Heal (Fix B, PLAN-CHECKOUT-STALE-STRIPE-CUSTOMER.md): Wartezeit (ms) vor dem
# EINEN Checkout-Retry nach Stripe resource_missing auf den Customer - ueberbrueckt
# die Sichtbarkeits-Verzoegerung zwischen createCustomer und dem naechsten API-Call.
# Default 2000. Min 0 (0 = sofortiger Retry).
STRIPE_CUSTOMER_RETRY_DELAY_MS=2000
# Maximale Gespraechsdauer in Sekunden (hartes Limit, Max 300)
MAX_CALL_DURATION_S=180
# P3.1: Vorlauf (ms) vor dem harten Max-Dauer-Cap, ab dem der Agent im laufenden Turn einen
# Abschluss-Satz spricht und auflegt, statt wortlos vom Timer gekappt zu werden. Verlaengert
# den Cap NICHT (der Satz liegt innerhalb der Frist). Default 20000, Min 0 (= aus), Max 60000.
# Muss deutlich kleiner als MAX_CALL_DURATION_S sein.
CAP_FAREWELL_LEAD_MS=20000
# OUT-05: Puffer (ms) ueber der Call-Max-Dauer, bis die Worst-Case-Budget-Reserve eines
# Outbound-Calls unabhaengig vom Provider-Callback via Backstop-Timer freigegeben wird.
# Default 15000. Min 0.
RESERVE_RELEASE_GRACE_MS=15000
# A6: Watchdog-Obergrenze (ms) fuer den Graceful-Shutdown (SIGTERM/SIGINT). Der Drain laesst
# in-flight Requests fertig und flusht dann den Store; danach hartes exit(0). Default 8000,
# Min 0, Max 30000 (< Render-SIGKILL ~30s).
SHUTDOWN_DRAIN_TIMEOUT_MS=8000
# STT-Endpointing fuer Folge-Gathers (/voice/turn): fester speechTimeout in Sekunden
# statt "auto". "auto" schneidet bei interner Sprechpause ab ("geht" statt ganzem Satz).
# Konservativer Default 2; tunebar ohne Code-Diff. Min 1. NUR Folge-Gathers - das
# Outbound-Erst-Gather + Inbound-Greeting bleiben auf "auto" (End-of-Speech-Erkennung).
STT_SPEECH_TIMEOUT_SEC=2
# stab-p7 (a): Empty-Turn-Guard. Max. konsekutive Agent-Turns ohne substanzielle Antwort
# des Gegenuebers, bevor der Agent (nur Outbound) ein end_call freigibt. Ein einzelner Leer-/
# Echo-Turn beendet den Call nie. Default 3, Min 2 (haelt den Erst-Turn-Boden).
MAX_EMPTY_TURNS=3
# stab-p7 (b): Mindest-Zeichenlaenge (getrimmt) einer substanziellen Anrufer-Aeusserung.
# Kuerzere/leere Transkripte (Echo-/Rausch-Fragmente) heben den Fruehauflege-Schutz nicht.
# Default 2 ("Ja"/"Ok" >= 2 Zeichen), Min 1.
CALLER_SUBSTANCE_MIN_LEN=2
# Rate-Limit pro IP und Minute fuer alle Nicht-Twilio-Routen (localhost ausgenommen).
# Default 120 (Dashboard pollt ~24x/min).
RATE_LIMIT_PER_MIN=120

# ---- Erst-Setup (kein Owner-Env mehr, P2b) ----
# Owner-Identitaet + -Absendernummer sind KEINE Env-Var mehr. Der erste Tenant wird
# einmalig pro Umgebung per CLI angelegt und lebt dann im Store:
#   npm run bootstrap-tenant -- <e164> <twilio|telnyx>   (Tenant + aktive Provider-DID)
#   npm run grant-admin -- <idp-subject-oder-email>      (Admin-Rolle, optional)
# ownerName + private Summary-Nummer setzt der Tenant ueber das Self-Service-Dashboard.
# Der Boot-Guard verlangt fail-closed eine aktive Nummer im Store (sonst kein Start).
#
# Render-Autoseed der Owner-/Betriebsnummer (render-owner-autoseed): Render (free plan)
# hat ein FLUECHTIGES Dateisystem -> data/store.json (und damit die per bootstrap-tenant
# eingetragene aktive Owner-Nummer) ist nach JEDEM Deploy weg, der Boot-Guard braeche
# fail-closed mit exit(1) ab. OWNER_NUMBER_SEED traegt die Owner-Betriebsnummer beim Boot
# idempotent in den json-Store (nur STORE_BACKEND=json; bei pg ueberfluessig -> Nummer
# dort EINMALIG per CLI seed-owner-number/bootstrap-tenant). Leer = kein Seed -> der
# Boot-Guard bleibt fail-closed. Existiert schon eine aktive Owner-Nummer -> No-Op.
#   OWNER_NUMBER_SEED        E.164 der Owner-Absende-/Routing-Nummer, z.B. +491701234567
#                            (kein gueltiges E.164 -> kein Seed -> Boot-Refusal).
#   OWNER_NUMBER_PROVIDER    twilio|telnyx. LEER -> twilio (Default). Telnyx-Owner MUESSEN
#                            telnyx setzen, sonst wird die Nummer als twilio geseedet und
#                            der Twilio-Client lehnt sie beim Senden ab. Tippfehler (z.B.
#                            "twillio") -> kein Seed -> Boot-Refusal (kein stiller
#                            Falsch-Carrier).
# NICHT verwechseln: dies ist die Betriebs-/Absende-/Routing-Nummer (Tenant "owner"),
# NICHT eine private SMS-Empfaengernummer (die setzt der Tenant ueber Self-Service).
OWNER_NUMBER_SEED=
OWNER_NUMBER_PROVIDER=
# AM6: WorkOS user.id (sub) des Owners idempotent an den Bootstrap-Tenant binden
# (idp_subject). Geschwister-Seed zu OWNER_NUMBER_SEED (ueberlebt Renders fluechtiges FS /
# No-CLI-Free-Tier; greift in BEIDEN Backends - json beim Boot, pg in init()). Damit
# findet resolveTenant beim claude.ai-OAuth-Login den Tenant MIT der aktiven Nummer ueber
# den sub-Claim (EINE Identitaetsquelle wie der Web-Login -> get_my_number ist nicht leer).
# Opake user_-Id, KEIN Secret. Leer = kein Seed (fail-closed: unbekannte Identitaet -> kein
# Tenant). set-if-absent: eine bereits gebundene Identitaet gewinnt. Nur bei MCP_AUTH=oauth
# relevant. Wert = der im WorkOS-Dashboard sichtbare user_... des Owner-Kontos.
OWNER_IDP_SUBJECT=
# SMS-Benachrichtigung nach jedem Call an die private Summary-Nummer (true/false)
SEND_SMS_SUMMARY=true
# Tages-Cap pro Tenant fuer Summary-SMS (F2 P8, Toll-Fraud-Schutz): nach so vielen
# erfolgreich gesendeten Summary-SMS im rollierenden 24h-Fenster wird die naechste
# still uebersprungen. Default 20; 0 = jede Summary-SMS gesperrt (Not-Aus).
DAILY_SMS_CAP=20

# ---- Server ----
PORT=3000
# Oeffentliche URL des Servers (ngrok), OHNE Slash am Ende, z.B. https://abc123.ngrok-free.app
PUBLIC_URL=https://CHANGE-ME.ngrok-free.app

# ---- Frontend (apps/web Static Site, Render-Service hermes-web) ----
# Build-Zeit-Var fuers Astro-Frontend: absoluter Auth-Origin des Gateways. Die
# Funnel-/Login-Links (apps/web/src/lib/routes.js -> LOGIN_URL) zeigen absolut auf
# <PUBLIC_GATEWAY_URL>/auth/login, weil die Static Site selbst kein /auth/login hat
# (404). Fehlt die Var im Static-Site-Build, bricht der Build fail-closed ab. Gesetzt
# beim hermes-web-Service in render.yaml; lokal nur fuer apps/web-Builds/Tests noetig.
PUBLIC_GATEWAY_URL=https://vodafone-agent.onrender.com

# Single-Origin (P1): Verzeichnis des apps/web-Builds (astro build -> apps/web/dist).
# Leer (Default) = AUS -> heutiges Serving byte-identisch (nur public/, hinter Basic-Auth).
# Gesetzt -> der Gateway liefert Marketing + App-Shell same-origin, VOR der Basic-Auth.
# Lokal z.B. apps/web/dist (vorher 'astro build' mit PUBLIC_GATEWAY_URL=http://127.0.0.1:<port>).
# Ein relativer Wert wird gegen das Arbeitsverzeichnis aufgeloest (path.resolve).
# Fehlt der Build (<dir>/index.html), verweigert der Boot (sichtbarer Fehler statt 401).
WEB_DIST_DIR=

# ---- Public Hosting (Render) ----
# Passwort fuer Dashboard + API (User: admin). PFLICHT bei oeffentlichem Hosting!
DASHBOARD_PASSWORD=

# Rechteprofile (Phase 2) als JSON, beim Start in den Store geseedet. Schluessel =
# Identitaet aus dem OAuth-Token (email, sonst der IdP-sub, z.B. "user_01ABC...").
# Noetig auf Render (free plan, fluechtiges Dateisystem); per-API angelegte Profile
# ueberleben dort keinen Neustart. Leer = keine Seed-Profile.
# Beispiel: PROFILES_JSON={"user_01ABC...":{"unrestricted":true,"maxCallsPerHour":6}}
PROFILES_JSON=

# ---- MCP ueber HTTP (Custom Connector) ----
# Auth-Modus fuer /mcp:
#   leer    = Legacy/fail-closed: mit MCP_AUTH_TOKEN gilt das Bearer-Token,
#             ohne Token ist /mcp NUR von localhost erreichbar (Default) - in
#             Produktion (RENDER_EXTERNAL_URL gesetzt) ist auch das deaktiviert (401).
#   token   = statisches Bearer-Token erzwingen (curl/Tests; claude.ai kann das NICHT senden).
#   oauth   = OAuth 2.1 Resource Server fuer den claude.ai-Login-Flow (Produktion).
#   off     = offen ohne Pruefung (NUR lokale Demos!).
MCP_AUTH=
# Statisches Bearer-Token fuer /mcp (Modus leer/token). Token erzeugen: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Nur bei MCP_AUTH=oauth: Issuer-URL des IdP (z.B. WorkOS AuthKit). Das Gateway
# findet JWKS selbst ueber <issuer>/.well-known/openid-configuration.
OAUTH_ISSUER_URL=
# Optional: erwartete Audience im Access-Token. Leer -> PUBLIC_URL + /mcp. Bei WorkOS
# der registrierte Resource-Indicator (z.B. https://app.sundartha.com/mcp).
OAUTH_AUDIENCE=
# AM6: Owner-OAuth-Identitaet -> Bootstrap-Tenant. Damit get_my_number unter MCP_AUTH=oauth
# nicht leer ist (sub-Claim findet den Tenant mit der aktiven Nummer), den Owner-sub binden.
# Definition + Erklaerung oben bei OWNER_NUMBER_SEED (Owner-Seeds gehoeren zusammen).

# ---- Store-Backend ----
# json (Default) = Datei-Persistenz (data/store.json). pg = Postgres.
# Im json-Pfad ist DATABASE_URL nicht noetig (es wird keine DB-Verbindung erzeugt).
STORE_BACKEND=json
# Postgres-Connection-String (NUR bei STORE_BACKEND=pg). Secret -> niemals committen.
DATABASE_URL=

# ---- Queue-Backend (async Provisioning-Worker) ----
# memory (Default) = deterministische In-Memory-Queue (kein Timer, drain-on-demand).
# pgboss ist vorbereitet, aber noch nicht aktiv (deferred). NICHT auf pgboss setzen.
QUEUE_BACKEND=memory

# ---- Datenschutz ----
# Beendete Calls (samt Transkript) und Notifications aelter als X Tage werden
# geloescht (DSGVO-Datenminimierung). 0 = Retention aus.
RETENTION_DAYS=30

# P2b: Roh-Transkripte diagnostisch markierter Calls (Ziel = die eigene verifizierte
# Nummer des Tenants) werden nach X Tagen geloescht - STRENGER als RETENTION_DAYS, das
# weiterhin fuer den Call-Record selbst gilt. 0 = Diagnosemodus aus (kein Call wird
# markiert, markierte Alt-Transkripte fallen beim naechsten Sweep).
# In Produktion erst auf >0 stellen, wenn die Datenschutzerklaerung den Diagnosemodus nennt.
DIAGNOSTIC_RETENTION_DAYS=7

# ---- Sicherheit (nur fuer lokale Tests) ----
# true = Twilio-Signaturpruefung der /voice-Webhooks abschalten (z.B. fuer curl-Tests).
# NIEMALS im oeffentlichen Hosting setzen!
SKIP_TWILIO_SIGNATURE_CHECK=false
# OUT-05: Test-Seam. true ersetzt den echten Provider-Dial durch einen Fake (Offline-Tests).
# BOOT-GEHAERTET: nur mit SKIP_TWILIO_SIGNATURE_CHECK=true zulaessig -> in Produktion
# (Signaturpruefung an) verweigert der Boot. NIEMALS im Hosting auf true setzen.
FAKE_ORIGINATE=false

# ---- Voice-Engine ----
# budget   = Twilio STT/TTS + Claude Haiku (quasi gratis, Default)
# realtime = OpenAI Realtime API: Speech-to-Speech, echtes Barge-in, beste Qualitaet
#            (~0,30-0,50 EUR/Minute, braucht OPENAI_API_KEY mit Guthaben)
VOICE_ENGINE=budget
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=alloy

# ---- Web-Login (Kunden-Portal) ----
# Lokaler Dev-Login: STORE_BACKEND=pg + DATABASE_URL (oder pglite im Test), SESSION_SECRET,
# PUBLIC_URL=http://127.0.0.1:<port>, und ein OIDC-Test-IdP (OAUTH_ISSUER_URL http://127.0.0.1...
# ist erlaubt, s. SSRF-Hinweis in config.js). Erst-Login legt den Tenant SUSPENDED an ->
# Redirect ins Portal (/tenant.html) mit "Choose your plan"; Aktivierung kommt ueber das Abo (W4).
SESSION_SECRET=            # HMAC-Secret fuer Session-Cookies (langer Zufallswert)
OIDC_CLIENT_ID=            # WorkOS AuthKit Client-ID
OIDC_CLIENT_SECRET=        # WorkOS AuthKit Client-Secret (SECRET)
ADMIN_EMAILS=              # kommasepariert: wer approven/suspenden darf
LOGIN_RATE_LIMIT_PER_MIN=10
SESSION_TTL_SECONDS=3600   # Lebensdauer der Browser-Session in Sekunden (Default 1 h)
LOGIN_COOKIE_TTL_SECONDS=1800  # Lebensdauer der Login-Flow-Cookies (state/pkce) in Sekunden (Default 30 min)
# OAUTH_ISSUER_URL wird mit /mcp geteilt (WorkOS AuthKit Issuer)
# Single-Origin (P1): lokaler Dev-Login-Shim. true -> POST /auth/dev-login mintet eine
# Session OHNE WorkOS (nur fuer den lokalen Chrome-e2e-Loop). DOPPELT fail-closed:
# explizites Opt-in UND nie im Hosting (auf Render verweigert der Boot, falls true).
# NUR lokal setzen.
DEV_LOGIN_ENABLED=false
