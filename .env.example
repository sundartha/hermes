# ---- Claude (Anthropic) - Gespraechslogik (Budget-Engine) + Summaries ----
ANTHROPIC_API_KEY=sk-ant-...
# Haiku = guenstigstes Modell, reicht fuer Telefonate voellig
CLAUDE_MODEL=claude-haiku-4-5
# Harter Kosten-Stopp in EUR. Bei Erreichen werden keine neuen Calls mehr angenommen/gestartet.
MAX_BUDGET_EUR=8

# ---- Twilio (Gratis-Trial-Account: https://www.twilio.com/try-twilio) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Die Twilio-Rufnummer des Agenten (im Trial gratis dabei), E.164-Format
TWILIO_NUMBER=+1xxxxxxxxxx
# EU-Pfad kurz halten
TWILIO_EDGE=frankfurt

# ---- Sicherheits-Gates ----
# Outbound-Anrufe NUR an diese Nummern (kommasepariert, E.164). Leer = Outbound gesperrt!
ALLOWED_NUMBERS=+49172xxxxxxx,+49151xxxxxxx
# Maximale Gespraechsdauer in Sekunden (hartes Limit, Max 300)
MAX_CALL_DURATION_S=180

# ---- Besitzer (du) ----
OWNER_NAME=Jonas
# Deine Handynummer (im Twilio-Trial vorher verifizieren!) - hierhin gehen SMS-Summaries
OWNER_NUMBER=+49172xxxxxxx
# SMS-Benachrichtigung nach jedem Call an OWNER_NUMBER (true/false)
SEND_SMS_SUMMARY=true

# ---- Server ----
PORT=3000
# Oeffentliche URL des Servers (ngrok), OHNE Slash am Ende, z.B. https://abc123.ngrok-free.app
PUBLIC_URL=https://CHANGE-ME.ngrok-free.app

# ---- Public Hosting (Render) ----
# Passwort fuer Dashboard + API (User: admin). PFLICHT bei oeffentlichem Hosting!
DASHBOARD_PASSWORD=

# ---- MCP ueber HTTP (Custom Connector) ----
# Statisches Bearer-Token fuer /mcp. Leer = /mcp ist NUR von localhost erreichbar.
# Token erzeugen z.B. mit: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ---- Sicherheit (nur fuer lokale Tests) ----
# true = Twilio-Signaturpruefung der /voice-Webhooks abschalten (z.B. fuer curl-Tests).
# NIEMALS im oeffentlichen Hosting setzen!
SKIP_TWILIO_SIGNATURE_CHECK=false

# ---- Voice-Engine ----
# budget   = Twilio STT/TTS + Claude Haiku (quasi gratis, Default)
# realtime = OpenAI Realtime API: Speech-to-Speech, echtes Barge-in, beste Qualitaet
#            (~0,30-0,50 EUR/Minute, braucht OPENAI_API_KEY mit Guthaben)
VOICE_ENGINE=budget
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=alloy
