#!/bin/sh
staged_js=$(git diff --cached --no-renames --name-only --diff-filter=ACM -- '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts')
if [ -n "$staged_js" ]; then
  old_ifs=$IFS
  IFS='
'
  set -- $staged_js
  IFS=$old_ifs
fi
node scripts/check-staged-suppressions.js "$@"
status=$?
if [ "$status" -ne 0 ]; then
  exit 1
fi

exit 0
