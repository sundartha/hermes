{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/imagery/**",
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\"]?(?:Norse|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Norse, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, children, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|type|value|defaultValue|placeholder|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, id, type, value, defaultValue, placeholder, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:live|size|style|key|ref|className|style|children)$/]",
        "message": "<LiveDot> doesn't accept that prop. Declared props: live, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveWing'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|status|preset|style|key|ref|className|style|children)$/]",
        "message": "<LiveWing> doesn't accept that prop. Declared props: size, status, preset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveWing'] > JSXAttribute[name.name='preset'] > Literal[value!=/^(?:classic|olympian)$/]",
        "message": "<LiveWing> preset must be one of 'classic' | 'olympian'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PillCTA> doesn't accept that prop. Declared props: children, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:active|completed|cancelled|failed|info|neutral)$/]",
        "message": "<StatusBadge> tone must be one of 'active' | 'completed' | 'cancelled' | 'failed' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WingMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|status|float|shadow|alt|style|key|ref|className|style|children)$/]",
        "message": "<WingMark> doesn't accept that prop. Declared props: size, status, float, shadow, alt, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
