import { Router } from "express";
import { internalOnly } from "../wiring/internal-only.js";
import { lehneEingabeAb } from "../utils/http.js";

export function make%%PASCAL%%Routes({ audit, tenant }) {
  const { requireTenant } = tenant;
  const router = Router();

  router.post("/api/%%KEBAB%%", internalOnly, (req, res) => {
    const tenantId = requireTenant(req, res);
    if (!tenantId) return;
    if (lehneEingabeAb(res, Array.isArray(req.body), "body muss ein Objekt sein")) return;
    audit("%%SNAKE%%", req, "");
    res.json({});
  });

  return router;
}
