import test from "node:test";
import assert from "node:assert/strict";
import express from "express";
import { make%%PASCAL%%Routes } from "../../src/routes/%%KEBAB%%.js";
import { abrufMitFrist } from "../gemeinsam/antwortfrist.mjs";

const HTTP_OK = 200;
const HTTP_FORBIDDEN = 403;
const OWNER_TENANT = "owner";

const erlaubterMandant = { requireTenant: () => OWNER_TENANT };
const abgelehnterMandant = {
  requireTenant: (req, res) => {
    res.status(HTTP_FORBIDDEN).json({ error: "tenant" });
    return null;
  },
};

async function einhaengen(tenant) {
  const audits = [];
  const app = express();
  app.use(express.json());
  app.use(make%%PASCAL%%Routes({ audit: (...args) => audits.push(args), tenant }));
  const server = await new Promise((resolve) => {
    const listener = app.listen(0, () => resolve(listener));
  });
  const base = `http://127.0.0.1:${server.address().port}`;
  return { base, audits, stop: () => new Promise((resolve) => server.close(resolve)) };
}

test("%%KEBAB%%: der eigene Mandant bekommt eine Antwort und einen Audit-Eintrag", async () => {
  const srv = await einhaengen(erlaubterMandant);
  try {
    const res = await abrufMitFrist(`${srv.base}/api/%%KEBAB%%`, { method: "POST" });
    assert.equal(res.status, HTTP_OK);
    assert.equal(srv.audits.length, 1);
  } finally {
    await srv.stop();
  }
});

test("%%KEBAB%%: ohne Mandanten bleibt die Antwort abgelehnt und ohne Audit-Eintrag", async () => {
  const srv = await einhaengen(abgelehnterMandant);
  try {
    const res = await abrufMitFrist(`${srv.base}/api/%%KEBAB%%`, { method: "POST" });
    assert.equal(res.status, HTTP_FORBIDDEN);
    assert.equal(srv.audits.length, 0);
  } finally {
    await srv.stop();
  }
});
