{
  "minTokens": 50,
  "reporters": ["console"],
  "gitignore": false,
  "absolute": false,
  "format": ["javascript", "typescript", "jsx", "tsx", "yaml", "markdown"],
  "ignore": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/data/**",
    "**/public/**",
    "**/.claude/**",
    "**/dist/**",
    "**/dist-*/**",
    "**/build/**",
    "**/out/**",
    "**/.astro/**"
  ]
}
