---
// Huelle der ruhenden Unterseiten — dieselbe Optik wie die Startseite, aber ein
// normales scrollendes Dokument. Loest Site.astro fuer diese Seiten ab.
//
// Kein Inline-Style, kein Inline-Script: die Produktions-CSP
// (default-src 'self') laesst beides nicht zu.
import "../styles/fonts.css";
import "../styles/hermes.css";
import "../styles/hermes-page.css";
import { LOGIN_URL } from "../lib/routes.js";

const { title, description, lang = "de", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const CONTACT = "kontakt@sundartha.com";

const nav = [
  { href: "/so-funktionierts", label: "So funktioniert's" },
  { href: "/preise", label: "Preise" },
];
const legal = [
  { href: "/datenschutz", label: "Datenschutz" },
  { href: "/impressum", label: "Impressum" },
  { href: "/agb", label: "AGB" },
  // § 312k BGB: die Kuendigungsseite muss STAENDIG verfuegbar UND unmittelbar/leicht
  // zugaenglich sein - deshalb im Fussband JEDER Hermes.astro-Seite, nicht nur im
  // Kundenbereich (dort ist "staendig verfuegbar" strittig, s. kuendigen.astro).
  { href: "/kuendigen", label: "Verträge kündigen" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sundartha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="doc-shell">
      <div class="doc-bg" aria-hidden="true"></div>
      <div class="doc-veil" aria-hidden="true"></div>

      <header>
        <nav class="doc-nav" aria-label="Hauptnavigation">
          <a class="lockup" href="/" aria-label="Hermes — Startseite">
            <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
            <span class="lockup__text">
              <span class="lockup__name">HERMES</span>
              <span class="lockup__by">by Sundartha</span>
            </span>
          </a>
          <span class="nav-actions">
            {nav.map((item) => (
              <a class="nav-link" href={item.href}>{item.label}</a>
            ))}
            <!-- Owner-Feedback 2026-08-26: wie auf der Startseite Login + Registrieren statt eines zweiten "Nummer holen". -->
            <!-- Beide Ziele LOGIN_URL — Login = Registrierung, Account entsteht beim ersten OIDC-Login (lib/routes.js). -->
            <a class="nav-link" href={LOGIN_URL}>Login</a>
            <a class="btn-solid" href={LOGIN_URL}>Registrieren</a>
          </span>
        </nav>
      </header>

      <main class="doc-main">
        <slot />
      </main>

      <footer class="doc-footer">
        <span class="site-footer__copy">© Sundartha — Hermes, dein Telefonassistent</span>
        <span class="site-footer__nav">
          {nav.map((item) => (
            <a class="site-footer__link" href={item.href}>{item.label}</a>
          ))}
          <a class="site-footer__link" href={LOGIN_URL}>Nummer holen</a>
          {legal.map((item) => (
            <a class="site-footer__link" href={item.href}>{item.label}</a>
          ))}
          <a class="site-footer__link" href={`mailto:${CONTACT}`}>Kontakt</a>
        </span>
      </footer>
    </div>
  </body>
</html>
