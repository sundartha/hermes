---
// Huelle der ruhenden Unterseiten — dieselbe Optik wie die Startseite, aber ein
// normales scrollendes Dokument. Loest Site.astro fuer diese Seiten ab.
//
// Kein Inline-Style, kein Inline-Script: die Produktions-CSP
// (default-src 'self') laesst beides nicht zu.
import "../styles/fonts.css";
import "../styles/hermes.css";
import "../styles/hermes-page.css";
import { LOGIN_URL } from "../lib/routes.js";
import { homeHref } from "../lib/home-anchors.js";
import { LEGAL_CONTENT } from "../lib/legal-content.js";
import { legalFooterLinks } from "../lib/legal.js";
import { CANCEL_BUTTON_LABEL, CANCEL_BUTTON_LABEL_EN } from "../lib/subscribe.js";
import CookieConsent from "../components/site/CookieConsent.astro";
import AnalyticsSlot from "../components/site/AnalyticsSlot.astro";

const { title, description, lang = "de", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const CONTACT = "kontakt@sundartha.com";

// Owner-Wunsch 2026-09-28: die Huelle spricht die Sprache ihrer Seite - englische
// Seiten (/support, /registrieren, 404, /legal/*) tragen englische Leiste und
// englisches Fussband, deutsche Seiten deutsche. Die Rechtslinks zeigen auf die
// Fassung in dieser Sprache (lib/legal.js, sonst die verbindliche deutsche); der
// Kuendigungs-Wortlaut kommt aus den benannten Konstanten (lib/subscribe.js, § 312k BGB).
const en = lang === "en";
const T = en
  ? {
      how: "How it works",
      pricing: "Pricing",
      logIn: "Log in",
      signUp: "Sign up",
      getNumber: "Get a number",
      contact: "Contact",
      cookies: "Cookie settings",
      copy: "© Sundartha — Hermes, your phone assistant",
      navAria: "Main navigation",
      homeAria: "Hermes — Home",
      cancel: CANCEL_BUTTON_LABEL_EN,
      legal: { privacy: "Privacy", imprint: "Imprint", terms: "Terms" },
    }
  : {
      how: "So funktioniert's",
      pricing: "Preise",
      logIn: "Login",
      signUp: "Registrieren",
      getNumber: "Nummer holen",
      contact: "Kontakt",
      cookies: "Cookie-Einstellungen",
      copy: "© Sundartha — Hermes, dein Telefonassistent",
      navAria: "Hauptnavigation",
      homeAria: "Hermes — Startseite",
      cancel: CANCEL_BUTTON_LABEL,
      legal: { privacy: "Datenschutz", imprint: "Impressum", terms: "AGB" },
    };

// Owner-Wunsch 2026-09-27: "So funktioniert's" und "Preise" fuehren auf die Ebenen der
// Startseite (Desktop-Buehne, Handy-Screens), nicht auf die ruhenden Unterseiten -
// von /kuendigen & Co. aus landete man sonst auf den "falschen Layern". Die alten
// URLs /so-funktionierts und /preise leiten seit 2026-09-28 selbst dorthin weiter
// (components/site/HomeRedirect.astro).
const nav = [
  { href: homeHref("so-funktionierts"), label: T.how },
  { href: homeHref("preise"), label: T.pricing },
];
const legal = [
  ...legalFooterLinks(LEGAL_CONTENT, lang).map((link) => ({ href: link.href, label: T.legal[link.slug] })),
  // § 312k BGB: die Kuendigungsseite muss STAENDIG verfuegbar UND unmittelbar/leicht
  // zugaenglich sein - deshalb im Fussband JEDER Hermes.astro-Seite, nicht nur im
  // Kundenbereich (dort ist "staendig verfuegbar" strittig, s. kuendigen.astro).
  { href: "/kuendigen", label: T.cancel },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover wie auf der Startseite: Bild bis unter die iPhone-Statusleiste. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sundartha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="doc-shell">
      <div class="doc-bg" aria-hidden="true"></div>
      <div class="doc-veil" aria-hidden="true"></div>

      <header>
        <nav class="doc-nav" aria-label={T.navAria}>
          <a class="lockup" href="/" aria-label={T.homeAria}>
            <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
            <span class="lockup__text">
              <span class="lockup__name">HERMES</span>
              <span class="lockup__by">by Sundartha</span>
            </span>
          </a>
          <span class="nav-actions">
            {nav.map((item) => (
              <a class="nav-link" href={item.href}>{item.label}</a>
            ))}
            <!-- Owner-Feedback 2026-08-26: wie auf der Startseite Login + Registrieren statt eines zweiten "Nummer holen". -->
            <!-- Beide Ziele LOGIN_URL — Login = Registrierung, Account entsteht beim ersten OIDC-Login (lib/routes.js). -->
            <a class="nav-link" href={LOGIN_URL}>{T.logIn}</a>
            <a class="btn-solid" href={LOGIN_URL}>{T.signUp}</a>
          </span>
        </nav>
      </header>

      <main class="doc-main">
        <slot />
      </main>

      <footer class="doc-footer">
        <span class="site-footer__copy">{T.copy}</span>
        <span class="site-footer__nav">
          {nav.map((item) => (
            <a class="site-footer__link" href={item.href}>{item.label}</a>
          ))}
          <a class="site-footer__link" href={LOGIN_URL}>{T.getNumber}</a>
          {legal.map((item) => (
            <a class="site-footer__link" href={item.href}>{item.label}</a>
          ))}
          <!-- Oeffentliche Support-Seite (Hilfe, Daten, Trennen des Connectors); Beschriftung
               in DE und EN gleich, darum keine Uebersetzung. -->
          <a class="site-footer__link" href="/support">Support</a>
          <a class="site-footer__link" href={`mailto:${CONTACT}`}>{T.contact}</a>
          <button class="site-footer__link" type="button" data-consent-open>{T.cookies}</button>
        </span>
      </footer>
    </div>
    <CookieConsent lang={lang} />
    <AnalyticsSlot />
  </body>
</html>
