---
// Layout fuer den eingeloggten Produkt-Bereich (/app/*). Reine Huelle: Header
// mit Marke + Auth-Steuerung (named slot "auth") und ein Inhalts-Slot. Keine
// Geschaeftslogik, kein fetch hier -- das machen die Inseln. noindex, weil der
// App-Bereich privat ist (Marketing-SEO lebt in W1 unter eigenem Layout).
//
// RESTYLING (Website-Neubau): app-hermes.css kommt NACH app.css und belegt die
// semantischen Farb-Rollen neu (helle Karten -> Glaskarten auf Wolkenmeer).
// Reihenfolge ist verbindlich: gleiche Spezifitaet, die spaetere Regel gewinnt.
// Dashboard-Redesign (WEB-03): lang="en" statt "de" -- die App-Shell ist
// durchgaengig englisch (Testkatalog dashboard-i18n-surface/single-origin-
// serving). shell.css/calls.css/panels.css sind die neuen, nach Trupp
// getrennten Stylesheets des Dashboard-Umbaus (Trupp A/B/C); calls.css und
// panels.css koennen zum Zeitpunkt dieses Commits noch leere Platzhalter
// sein, falls die jeweiligen Trupps parallel noch nicht geliefert haben.
//
// i18n (Etappe 1): das lang="en" unten bleibt woertlich im Quelltext (WEB-03,
// test/single-origin-serving.test.js prueft den Quelltext) -- es ist der
// Build-/SSR-Default. Zur LAUFZEIT ueberschreibt setLang() (lib/i18n.js) das
// Attribut per document.documentElement.lang, sobald der Besitzer DE waehlt.
import "../styles/fonts.css";
import "../styles/tokens/index.css";
import "../styles/app.css";
import "../styles/app-hermes.css";
import "../styles/app/shell.css";
import "../styles/app/calls.css";
import "../styles/app/panels.css";

const { title = "Hermes" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-bg" aria-hidden="true"></div>
    <div class="app-veil" aria-hidden="true"></div>
    <div class="app-top" aria-hidden="true"></div>

    <header class="app-header">
      <a class="app-brand" href="/" aria-label="Hermes — Home">
        <span class="app-brand__mark" aria-hidden="true">
          <img class="app-brand__wing" src="/assets/hermes-wing.png" alt="" />
        </span>
        <span class="app-brand__text">
          <span class="app-brand__name">HERMES</span>
          <span class="app-brand__by">by Sundartha</span>
        </span>
      </a>
      <slot name="auth" />
    </header>
    <main class="app-main">
      <slot />
    </main>
  </body>
</html>
