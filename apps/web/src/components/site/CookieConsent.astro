---
// Einwilligungs-Karte fuer Cookies & lokale Speicherung (§ 25 TDDDG). Wird in
// jede oeffentliche Huelle eingebunden (index.astro, layouts/Hermes.astro).
//
// Sprache: die Karte rendert serverseitig in der Sprache ihrer Seite. Die
// Startseite ist seit dem Default-Wechsel 2026-09-10 englisch und bindet sie als
// <CookieConsent lang="en" /> ein; die ruhenden Unterseiten (layouts/Hermes.astro)
// bleiben deutsch und nutzen den Default. Auf der Startseite tauscht der
// Sprachumschalter (hermes-scroll.js applyLang) zusaetzlich zur Laufzeit das
// innerHTML aller [data-i18n]-Elemente — die deutschen Texte liegen darum
// ZUSAETZLICH im DE-Woerterbuch von hermes-scroll.js (Praefix "ck...").
//
// Verhalten: scripts/consent.js. Kein Inline-Style, kein Inline-Script — die
// Produktions-CSP (default-src 'self') laesst beides nicht zu. Startet mit
// `hidden`; consent.js zeigt die Karte ungefragt nur, wenn noch keine
// Entscheidung gespeichert ist UND ein gesperrtes Skript auf Einwilligung wartet
// (sonst nur ueber [data-consent-open]).
//
// data-consent-log: Ziel des Einwilligungs-Protokolls (lib/routes.js). Absolut auf
// den Gateway — die CSP der Static Site muss diesen Origin in connect-src fuehren
// (docs/RUNBOOK-ANALYTICS-CONSENT.md).
import "../../styles/consent.css";
import { COOKIE_CONSENT_URL } from "../../lib/routes.js";

// placement="hero": die Startseite (Ein-Screen-Hero). Nur dort weicht die Karte im
// gestapelten Hochformat nach oben ueber das Bild aus (styles/consent.css); auf den
// scrollenden Unterseiten stuende oben die Ueberschrift.
const { lang = "de", placement = "page" } = Astro.props;

// Werte mit Inline-HTML (&amp;, <a>) werden per set:html gesetzt, damit sie
// ZEICHENGLEICH zu den Woerterbuch-Eintraegen in hermes-scroll.js sind — sonst
// flackert der Text beim ersten Umschalten.
const TEXT = {
  de: {
    title: "Cookies &amp; Datenschutz",
    text: 'Wir speichern nur, was die Seite braucht: deine Sprache und diese Wahl. Statistik oder Marketing laufen erst, wenn du zustimmst. <a href="/datenschutz">Datenschutz</a>',
    necessary: "Notwendig",
    necessaryDesc: "Sprachwahl, Login im Kundenbereich und diese Einstellung. Immer aktiv.",
    necessaryAria: "Notwendig — immer aktiv",
    stats: "Statistik",
    statsDesc: "Anonyme Reichweitenmessung, damit wir die Seite verbessern können. Derzeit nicht im Einsatz.",
    marketing: "Marketing",
    marketingDesc: "Werbe- und Social-Media-Dienste. Derzeit nicht im Einsatz.",
    acceptAll: "Alle akzeptieren",
    necessaryOnly: "Nur notwendige",
    save: "Auswahl speichern",
    settings: "Einstellungen",
  },
  en: {
    title: "Cookies &amp; privacy",
    text: 'We only store what the site needs: your language and this choice. Analytics or marketing run only once you agree. <a href="/datenschutz">Privacy policy</a>',
    necessary: "Necessary",
    necessaryDesc: "Language choice, login in the customer area and this setting. Always on.",
    necessaryAria: "Necessary — always on",
    stats: "Analytics",
    statsDesc: "Anonymous reach measurement so we can improve the site. Not in use yet.",
    marketing: "Marketing",
    marketingDesc: "Advertising and social media services. Not in use yet.",
    acceptAll: "Accept all",
    necessaryOnly: "Necessary only",
    save: "Save selection",
    settings: "Settings",
  },
};

const c = TEXT[lang === "en" ? "en" : "de"];
---

<div class="consent" data-consent-root data-prefs="0" data-placement={placement} data-consent-log={COOKIE_CONSENT_URL} hidden>
  <section class="consent__card" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-text" tabindex="-1">
    <h2 class="consent__title" id="consent-title" data-i18n="ckTitle" set:html={c.title}></h2>
    <p class="consent__text" id="consent-text" data-i18n="ckText" set:html={c.text}></p>
    <!-- "Einstellungen" steht hinter dem Text (Handy: im Textfluss, Desktop: oben
         rechts in der Titelzeile) - so braucht die Karte keine eigene Zeile dafuer. -->
    <button class="consent__link" type="button" data-consent-action="prefs" aria-expanded="false" aria-controls="consent-prefs" data-i18n="ckSettings">{c.settings}</button>

    <div class="consent__prefs" id="consent-prefs" data-consent-prefs hidden>
      <label class="consent__row">
        <span class="consent__row-text">
          <span class="consent__row-name" data-i18n="ckNecessary">{c.necessary}</span>
          <span class="consent__row-desc" data-i18n="ckNecessaryDesc">{c.necessaryDesc}</span>
        </span>
        <span class="consent__switch">
          <input type="checkbox" checked disabled aria-label={c.necessaryAria} />
          <span class="consent__knob" aria-hidden="true"></span>
        </span>
      </label>
      <label class="consent__row">
        <span class="consent__row-text">
          <span class="consent__row-name" data-i18n="ckStats">{c.stats}</span>
          <span class="consent__row-desc" data-i18n="ckStatsDesc">{c.statsDesc}</span>
        </span>
        <span class="consent__switch">
          <input type="checkbox" data-consent-cat="statistics" />
          <span class="consent__knob" aria-hidden="true"></span>
        </span>
      </label>
      <label class="consent__row">
        <span class="consent__row-text">
          <span class="consent__row-name" data-i18n="ckMarketing">{c.marketing}</span>
          <span class="consent__row-desc" data-i18n="ckMarketingDesc">{c.marketingDesc}</span>
        </span>
        <span class="consent__switch">
          <input type="checkbox" data-consent-cat="marketing" />
          <span class="consent__knob" aria-hidden="true"></span>
        </span>
      </label>
    </div>

    <div class="consent__actions">
      <button class="consent__btn consent__btn--solid" type="button" data-consent-action="all" data-i18n="ckAcceptAll">{c.acceptAll}</button>
      <button class="consent__btn consent__btn--ghost" type="button" data-consent-action="necessary" data-i18n="ckNecessaryOnly">{c.necessaryOnly}</button>
      <button class="consent__btn consent__btn--ghost consent__btn--save" type="button" data-consent-action="save" data-i18n="ckSave">{c.save}</button>
    </div>
  </section>
</div>

<script>
  // Hoisted: Astro buendelt es als externes, same-origin Modul (CSP-konform).
  import "../../scripts/consent.js";
</script>
