---
// Einwilligungs-Karte fuer Cookies & lokale Speicherung (§ 25 TDDDG). Wird in
// jede oeffentliche Huelle eingebunden (index.astro, layouts/Hermes.astro).
//
// Deutsch steht im Markup; die englische Fassung liegt als data-i18n-Keys in
// hermes-scroll.js (Startseite). Verhalten: scripts/consent.js. Kein Inline-
// Style, kein Inline-Script — die Produktions-CSP (default-src 'self') laesst
// beides nicht zu. Startet mit `hidden`; consent.js zeigt die Karte nur, wenn
// noch keine Entscheidung gespeichert ist (oder ueber [data-consent-open]).
import "../../styles/consent.css";
---

<div class="consent" data-consent-root data-prefs="0" hidden>
  <section class="consent__card" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-text" tabindex="-1">
    <h2 class="consent__title" id="consent-title" data-i18n="ckTitle">Cookies &amp; Datenschutz</h2>
    <p class="consent__text" id="consent-text" data-i18n="ckText">Wir speichern auf deinem Gerät nur, was die Seite braucht: deine Sprachwahl und diese Entscheidung. Statistik- oder Marketing-Dienste laufen erst, wenn du zustimmst. <a href="/datenschutz">Mehr im Datenschutz</a>.</p>

    <div class="consent__prefs" id="consent-prefs" data-consent-prefs hidden>
      <label class="consent__row">
        <span class="consent__row-text">
          <span class="consent__row-name" data-i18n="ckNecessary">Notwendig</span>
          <span class="consent__row-desc" data-i18n="ckNecessaryDesc">Sprachwahl, Login im Kundenbereich und diese Einstellung. Immer aktiv.</span>
        </span>
        <span class="consent__switch">
          <input type="checkbox" checked disabled aria-label="Notwendig — immer aktiv" />
          <span class="consent__knob" aria-hidden="true"></span>
        </span>
      </label>
      <label class="consent__row">
        <span class="consent__row-text">
          <span class="consent__row-name" data-i18n="ckStats">Statistik</span>
          <span class="consent__row-desc" data-i18n="ckStatsDesc">Anonyme Reichweitenmessung, damit wir die Seite verbessern können. Derzeit nicht im Einsatz.</span>
        </span>
        <span class="consent__switch">
          <input type="checkbox" data-consent-cat="statistics" />
          <span class="consent__knob" aria-hidden="true"></span>
        </span>
      </label>
      <label class="consent__row">
        <span class="consent__row-text">
          <span class="consent__row-name" data-i18n="ckMarketing">Marketing</span>
          <span class="consent__row-desc" data-i18n="ckMarketingDesc">Werbe- und Social-Media-Dienste. Derzeit nicht im Einsatz.</span>
        </span>
        <span class="consent__switch">
          <input type="checkbox" data-consent-cat="marketing" />
          <span class="consent__knob" aria-hidden="true"></span>
        </span>
      </label>
    </div>

    <div class="consent__actions">
      <button class="consent__btn consent__btn--solid" type="button" data-consent-action="all" data-i18n="ckAcceptAll">Alle akzeptieren</button>
      <button class="consent__btn consent__btn--ghost" type="button" data-consent-action="necessary" data-i18n="ckNecessaryOnly">Nur notwendige</button>
      <button class="consent__btn consent__btn--ghost consent__btn--save" type="button" data-consent-action="save" data-i18n="ckSave">Auswahl speichern</button>
      <button class="consent__link" type="button" data-consent-action="prefs" aria-expanded="false" aria-controls="consent-prefs" data-i18n="ckSettings">Einstellungen</button>
    </div>
  </section>
</div>

<script>
  // Hoisted: Astro buendelt es als externes, same-origin Modul (CSP-konform).
  import "../../scripts/consent.js";
</script>
