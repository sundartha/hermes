---
// HeroAnimation (W4): scroll-getriggerte Storyboard-Animation des MCP-
// Verbindungsflusses (KI -> MCP -> Telefonnetz -> Anruf aktiv). Ersetzt den
// W1-Platzhalter (#hero-animation-placeholder).
//
// HIGGSFIELD-STATUS (Strategie R5/H1, Sicherheit): `higgsfield generate create`
// kostet unwiderruflich Credits und der clawcode-User ist NICHT authentifiziert
// ("Not authenticated"). Eine echte Generierung ist ein mensch-gegateter,
// kostenpflichtiger Schritt und wird hier NICHT autonom ausgeloest. Diese
// Variante ist der CSP-saubere, sofort lauffaehige Stand-in: EINE Inline-SVG-
// Szene mit progressivem Reveal (kein externes Asset, kein data:, kein Inline-
// Script/-Style). Spaeter koennen Higgsfield-Frames die SVG-Szene ersetzen, der
// Scroll-Scrub-Mechanismus (unten) bleibt.
//
// GRACEFUL DEGRADATION: ohne JS / bei prefers-reduced-motion / Save-Data bleibt
// die VOLLE Kette als statisches Poster sichtbar (kein Layout-Bruch, kein LCP-
// Block). Erst JS mit erlaubter Bewegung schaltet den schrittweisen Scrub frei.
//
// Tenant-frei: rein statische Marken-Illustration, kein Fetch, keine Nutzerdaten.
---

<div id="hero-animation" class="hero-anim hero-anim--flow">
  <svg
    class="flow"
    viewBox="0 0 360 150"
    role="img"
    aria-label="KI-Agent verbindet sich ueber den MCP-Server mit dem Telefonnetz"
  >
    <!-- Verbindungslinien (progressiv sichtbar je Schritt) -->
    <line class="flow__link flow__link--1" x1="92" y1="60" x2="148" y2="60" />
    <line class="flow__link flow__link--2" x1="212" y1="60" x2="268" y2="60" />

    <!-- Aktiv-Puls am Telefon-Knoten (nur im letzten Schritt) -->
    <circle class="flow__pulse" cx="300" cy="60" r="40" />

    <!-- Knoten: KI-Agent -->
    <g class="flow__node flow__node--ki">
      <circle cx="60" cy="60" r="30" />
      <path
        class="flow__glyph"
        transform="translate(46 46) scale(1.2)"
        d="M2 3h16a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H8l-4 3v-3H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"
      />
    </g>

    <!-- Knoten: MCP-Server -->
    <g class="flow__node flow__node--mcp">
      <circle cx="180" cy="60" r="30" />
      <g class="flow__glyph" transform="translate(166 48) scale(1.2)">
        <circle cx="4" cy="5" r="2.2" />
        <circle cx="20" cy="5" r="2.2" />
        <circle cx="12" cy="14" r="2.2" />
        <path d="M4 5h16M4 5l8 9M20 5l-8 9" />
      </g>
    </g>

    <!-- Knoten: Telefonnetz -->
    <g class="flow__node flow__node--tel">
      <circle cx="300" cy="60" r="30" />
      <path
        class="flow__glyph"
        transform="translate(286 46) scale(1.2)"
        d="M6.6 10.8a11 11 0 0 0 4.6 4.6l1.5-1.5a1 1 0 0 1 1-.24 8 8 0 0 0 2.5.4 1 1 0 0 1 1 1V18a1 1 0 0 1-1 1A14 14 0 0 1 5 6a1 1 0 0 1 1-1h2.3a1 1 0 0 1 1 1 8 8 0 0 0 .4 2.5 1 1 0 0 1-.24 1z"
      />
    </g>

    <text class="flow__label" x="60" y="112">KI-Agent</text>
    <text class="flow__label" x="180" y="112">MCP-Server</text>
    <text class="flow__label" x="300" y="112">Telefonnetz</text>
  </svg>

  <p id="hero-animation-caption" class="hero-anim__caption">
    Verbindung steht — dein KI-Agent telefoniert.
  </p>
</div>

<script>
  // Scroll-Scrub: schaltet schrittweise die Verbindungslinien + den Aktiv-Puls
  // frei. Logik in lib/hero-scrub.js (testbar + erzwingt ein EXTERNES, CSP-
  // konformes Bundle statt inline-<script>). Hier nur Caption-Texte + das
  // Bewegungs-Gate (prefers-reduced-motion / Save-Data).
  import { initHeroScrub } from "../lib/hero-scrub.js";

  const CAPTIONS = [
    "Dein KI-Agent klinkt sich per MCP ein.",
    "Der MCP-Server waehlt ins Telefonnetz.",
    "Verbindung steht — der Anruf laeuft.",
  ];
  // Scroll-Strecke (in Viewport-Hoehen), ueber die die Szene durchscrubt.
  const SCRUB_RANGE_VH = 1.2;

  const root = document.getElementById("hero-animation");
  const caption = document.getElementById("hero-animation-caption");

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = Boolean(navigator.connection && navigator.connection.saveData);

  // Nur bei erlaubter Bewegung scrubben; sonst bleibt das statische Poster
  // (volle Kette) stehen -- Graceful Degradation.
  if (root && caption && !prefersReducedMotion && !saveData) {
    initHeroScrub({ root, caption, captions: CAPTIONS, rangeVh: SCRUB_RANGE_VH });
  }
</script>
