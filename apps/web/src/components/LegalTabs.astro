---
// Reiter im Rechts-Blatt der Startseite (pages/index.astro): ALLE Ziele des
// Fussbands an einem Ort (Owner-Wunsch 2026-09-27: "dass man alle Tabs da drin
// hat"). Nachgezogen am selben Tag: auch "Verträge kündigen" und "Support" sind
// Reiter - vorher fuehrten sie aus dem Blatt heraus auf eigene Seiten, und von dort
// waren die anderen Texte nicht mehr zu sehen.
// - Reiter: die drei Rechtstexte (legalDocs) und Kuendigen/Support (infoTabs). Die
//   Knoepfe tragen data-legal-pill; scripts/hermes-scroll.js (wireLegal) tauscht den
//   Inhalt und setzt aria-current, das CSS hebt den aktiven Reiter hervor. Desktop:
//   eine Zeile; Handy: zwei Zeilen (drei Rechtstexte oben, Kuendigen/Support unten).
// - Darunter die zwei Handlungen, die kein Inhalt im Blatt sind: Kontakt (mailto)
//   und Cookie-Einstellungen (oeffnet die Einwilligungs-Karte, scripts/consent.js).
const { legalDocs, infoTabs, contact } = Astro.props;
---

<div class="legal-tabs">
  <div class="legal-seg" aria-label="Legal">
    {legalDocs.map((entry) => (
      <button class="legal-pill" type="button" data-legal-pill={entry.slug} data-i18n={entry.i18n}>{entry.label}</button>
    ))}
    {infoTabs.map((entry) => (
      <button class="legal-pill legal-pill--info" type="button" data-legal-pill={entry.slug}>{entry.label}</button>
    ))}
  </div>
  <div class="legal-more">
    <a class="legal-more__link" href={`mailto:${contact}`} data-i18n="contact">Contact</a>
    <button class="legal-more__link" type="button" data-consent-open data-i18n="cookieSettings">Cookie settings</button>
  </div>
</div>
