---
// "Works with any AI agent" — Sektion fuer die Startseite, direkt unter dem
// Vollbild-Hero.
//
// V4 (Jonas-Feedback, dritte Runde): V3s Higgsfield-Videos sahen zwar
// "produziert" aus, waren aber inhaltsleer — abstrakte Stimmungsclips ohne
// Bezug zur jeweiligen Karten-Aussage, plus ein KI-generierter Fantasie-
// Fluegel statt des echten Hermes-Logos. Zurueck zur handgebauten Loesung
// (wie V2), aber diesmal konkret/beschriftet (zeigt explizit Claude/Gemini/
// Custom-Agent, ein echtes Anruf-Ablauf-Display, eine echte Sprach-Waveform)
// UND handwerklich hochwertiger: Glasoptik mit echter Tiefe (Schatten,
// Blur-Layer), das echte /assets/hermes-wing.png statt eines Ersatz-Icons,
// dauerhaft laufende statt einmalige Bewegung.
import "../../styles/tokens/hero.css";
import "../../styles/sections.css";

const agents = [
  { code: "C", label: "Claude" },
  { code: "G", label: "Gemini" },
  { code: "+", label: "Any MCP agent" },
];

const cards = [
  {
    stage: "connect",
    heading: "Any agent, one number",
    copy: "Attach Hermes as an MCP server to Claude, Gemini or your own stack — the phone line just works.",
  },
  {
    stage: "call",
    heading: "Give it a goal, it calls",
    copy: "Tell your agent what needs doing on the phone. Hermes dials, talks and follows up — then reports back.",
  },
  {
    stage: "voice",
    heading: "Sounds human, every time",
    copy: "Natural pacing and graceful interruptions — callers hear a conversation, not a script.",
  },
] as const;
---

<section class="band band--alt agents" id="works-with">
  <div class="agents__glow" aria-hidden="true"></div>
  <div class="band__inner">
    <p class="band__eyebrow reveal">Works with</p>
    <h2 class="band__title reveal">One phone line. <em>Any</em> AI agent.</h2>
    <p class="band__lead reveal">
      Hermes speaks Model Context Protocol — connect Claude, Gemini or your
      own agent stack. No telephony build of your own required.
    </p>

    <div class="agent-badges reveal">
      {agents.map((a) => (
        <span class="agent-badge">
          <span class="agent-badge__glyph" aria-hidden="true">{a.code}</span>
          {a.label}
        </span>
      ))}
    </div>

    <div class="steps agents__steps">
      {cards.map((card) => (
        <article class="step reveal">
          <div class={`step__stage step__stage--${card.stage}`} aria-hidden="true">
            {card.stage === "connect" && (
              <div class="scene-connect">
                <div class="scene-connect__chips">
                  <span class="model-chip model-chip--a">Claude</span>
                  <span class="model-chip model-chip--b">Gemini</span>
                  <span class="model-chip model-chip--c">Your agent</span>
                </div>
                <svg class="scene-connect__lines" viewBox="0 0 220 160" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                  <path class="flow flow--a" d="M40 34 C 120 34, 150 80, 190 80" />
                  <path class="flow flow--b" d="M40 80 L 190 80" />
                  <path class="flow flow--c" d="M40 126 C 120 126, 150 80, 190 80" />
                </svg>
                <div class="scene-connect__hub">
                  <span class="hub-pulse"></span>
                  <span class="hub-pulse hub-pulse--b"></span>
                  <img class="hub-wing" src="/assets/hermes-wing.png" alt="" />
                </div>
              </div>
            )}
            {card.stage === "call" && (
              <div class="scene-call">
                <div class="scene-call__ring">
                  <span class="ring-pulse"></span>
                  <span class="ring-pulse ring-pulse--b"></span>
                  <svg class="scene-call__glyph" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6.6 10.8c1.3 2.6 3.4 4.7 6 6l2-2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.9c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>
                  </svg>
                </div>
                <div class="scene-call__log">
                  <span class="call-line call-line--a"><i class="call-dot"></i>Dialing front desk…</span>
                  <span class="call-line call-line--b"><i class="call-dot"></i>Connected</span>
                  <span class="call-line call-line--c">
                    <svg class="call-check" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M4 10.5l4 4L16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Goal reached
                  </span>
                </div>
              </div>
            )}
            {card.stage === "voice" && (
              <div class="scene-voice">
                <div class="scene-voice__wave">
                  <span></span><span></span><span></span><span></span><span></span>
                  <span></span><span></span><span></span><span></span><span></span>
                  <span></span><span></span>
                </div>
                <div class="scene-voice__bubble">
                  <span class="voice-bubble__label">Hermes</span>
                  <span class="voice-bubble__text">"Hi, this is Hermes calling on behalf of Alex — is now a good time?"</span>
                </div>
              </div>
            )}
          </div>
          <h3 class="step__heading">{card.heading}</h3>
          <p class="step__copy">{card.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Hoisted Module-Script (kein is:inline): Astro/Vite buendeln das inkl.
  // gsap als externes same-origin JS -> CSP-konform (script-src 'self'),
  // kein CDN-Load zur Laufzeit (siehe astro.config.mjs Kommentar).
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const section = document.getElementById("works-with");

  // Ohne JS oder bei reduzierter Bewegung bleibt der Inhalt einfach sichtbar
  // (kein FOUC, kein Hidden-Content) — progressive enhancement. Die
  // dauerhaften Szenen-Loops laufen unabhaengig davon rein per CSS.
  if (section && !prefersReduced) {
    gsap.registerPlugin(ScrollTrigger);
    const targets = Array.from(section.querySelectorAll(".reveal"));
    gsap.set(targets, { opacity: 0, y: 22 });
    ScrollTrigger.batch(targets, {
      start: "top 88%",
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: "power2.out",
          stagger: 0.12,
        }),
    });
  }
</script>

<style>
  /* Bleibt strikt in der bestehenden Farbfamilie (Navy/Blau/Weiss) — keine
   * neuen Akzentfarben, nur var(--hero-*) aus tokens/hero.css. */
  .agents {
    position: relative;
    padding-top: clamp(72px, 10vw, 128px);
    padding-bottom: clamp(88px, 11vw, 140px);
    overflow: hidden;
  }

  .agents__glow {
    position: absolute;
    top: -14%;
    left: 50%;
    width: min(1100px, 140%);
    height: 620px;
    transform: translateX(-50%);
    background: radial-gradient(
      closest-side,
      rgba(255, 255, 255, 0.06) 0%,
      rgba(27, 79, 134, 0.1) 45%,
      rgba(27, 79, 134, 0) 72%
    );
    filter: blur(10px);
    pointer-events: none;
    animation: glow-drift 18s ease-in-out infinite;
  }
  @keyframes glow-drift {
    0%,
    100% {
      transform: translateX(-54%) translateY(0) scale(1);
    }
    50% {
      transform: translateX(-46%) translateY(20px) scale(1.06);
    }
  }

  .band__title {
    font-size: clamp(38px, 5vw, 64px);
  }

  .agents__steps {
    margin-top: var(--space-block);
  }
</style>

<style>
  .agent-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-tight);
    margin: var(--space-roomy) 0 0;
  }
  .agent-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-tight);
    padding: 8px 16px 8px 8px;
    border-radius: var(--radius-badge);
    background: rgba(255, 255, 255, 0.08);
    border: var(--border-width) solid rgba(255, 255, 255, 0.14);
    color: var(--text-on-dark-muted);
    font-family: var(--font-grotesk);
    font-size: 13.5px;
    font-weight: var(--weight-medium);
  }
  .agent-badge__glyph {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-round);
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-family: var(--font-grotesk);
    font-size: 12px;
    font-weight: 600;
  }

  /* --- Buehne: Glasoptik mit echter Tiefe statt flacher Box --- */
  .step__stage {
    position: relative;
    height: 280px;
    margin: -6px -4px var(--space-card);
    border-radius: var(--radius-control);
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 50% -10%, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 55%),
      linear-gradient(165deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01)),
      var(--hero-navy-900);
    box-shadow:
      0 24px 50px -24px rgba(3, 10, 26, 0.75),
      inset 0 0 0 1px rgba(255, 255, 255, 0.09);
  }

  /* Higgsfield-Textur pro Karte: eigene, zum jeweiligen Motiv passende
   * Hintergrund-Grafik (navy/blau/weiss-Palette, per Higgsfield generiert)
   * als unterste Layer hinter den handgebauten Szenen. Die zwei Glas-
   * Gradienten + ein Verdunkelungs-Layer bleiben on top, damit Text/Chips/
   * Waveform lesbar bleiben — die Fotografie liefert nur Tiefe/Textur,
   * nicht die eigentliche Aussage der Karte (die kommt weiterhin aus den
   * echten .scene-* Elementen). */
  .step__stage--connect {
    background-image:
      radial-gradient(120% 100% at 50% -10%, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 55%),
      linear-gradient(165deg, rgba(255,255,255,0.06), rgba(255,255,255,0.01) 45%),
      linear-gradient(180deg, rgba(6,16,36,0.32) 0%, rgba(6,16,36,0.8) 100%),
      url("/assets/images/agents-connect-bg.jpg");
    background-size: auto, auto, auto, cover;
    background-position: center, center, center, center;
    background-repeat: no-repeat;
  }
  .step__stage--call {
    background-image:
      radial-gradient(120% 100% at 50% -10%, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 55%),
      linear-gradient(165deg, rgba(255,255,255,0.06), rgba(255,255,255,0.01) 45%),
      linear-gradient(180deg, rgba(6,16,36,0.28) 0%, rgba(6,16,36,0.76) 100%),
      url("/assets/images/agents-call-bg.jpg");
    background-size: auto, auto, auto, cover;
    background-position: center, center, center, center;
    background-repeat: no-repeat;
  }
  .step__stage--voice {
    background-image:
      radial-gradient(120% 100% at 50% -10%, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 55%),
      linear-gradient(165deg, rgba(255,255,255,0.06), rgba(255,255,255,0.01) 45%),
      linear-gradient(180deg, rgba(6,16,36,0.3) 0%, rgba(6,16,36,0.78) 100%),
      url("/assets/images/agents-voice-bg.jpg");
    background-size: auto, auto, auto, cover;
    background-position: center, center, center, center;
    background-repeat: no-repeat;
  }

  @media (max-width: 560px) {
    .agent-badges {
      gap: 8px;
    }
    .agent-badge {
      font-size: 12.5px;
    }
    .step__stage {
      height: 240px;
    }
  }
</style>

<style>
  /* --- Szene 1: Claude/Gemini/Custom-Agent fliessen zum echten Hermes-Fluegel --- */
  .scene-connect {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 22px;
  }
  .scene-connect__chips {
    position: absolute;
    left: 22px;
    top: 22px;
    bottom: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 2;
  }
  .model-chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: var(--radius-badge);
    background: rgba(10, 26, 54, 0.72);
    border: var(--border-width) solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.6);
    color: var(--text-on-dark-strong);
    font-family: var(--font-grotesk);
    font-size: 12.5px;
    font-weight: var(--weight-medium);
    animation: chip-breathe 3.6s ease-in-out infinite;
  }
  .model-chip--b {
    animation-delay: 0.6s;
  }
  .model-chip--c {
    animation-delay: 1.2s;
  }
  @keyframes chip-breathe {
    0%,
    100% {
      transform: translateX(0);
      box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.6);
    }
    50% {
      transform: translateX(3px);
      box-shadow: 0 8px 22px -8px rgba(255, 255, 255, 0.12);
    }
  }

  .scene-connect__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .scene-connect__lines .flow {
    stroke: rgba(255, 255, 255, 0.45);
    stroke-width: 1.5;
    fill: none;
    stroke-dasharray: 6 10;
    animation: flow-run 2.4s linear infinite;
  }
  .flow--b {
    animation-delay: -0.4s;
  }
  .flow--c {
    animation-delay: -0.8s;
  }
  @keyframes flow-run {
    to {
      stroke-dashoffset: -160;
    }
  }

  .scene-connect__hub {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
  }
  .hub-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0) 70%
    );
    animation: hub-ping 3s ease-out infinite;
  }
  .hub-pulse--b {
    animation-delay: 1.5s;
  }
  @keyframes hub-ping {
    0% {
      transform: scale(0.7);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  .hub-wing {
    position: relative;
    z-index: 1;
    width: 40px;
    height: auto;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.55));
  }
</style>

<style>
  /* --- Szene 2: Anruf-Ablauf mit echtem Status-Text --- */
  .scene-call {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    width: 100%;
    height: 100%;
  }
  .scene-call__ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
  }
  .ring-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    animation: ring-out 2.6s ease-out infinite;
  }
  .ring-pulse--b {
    animation-delay: 1.3s;
  }
  @keyframes ring-out {
    0% {
      transform: scale(0.6);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  .scene-call__glyph {
    position: relative;
    z-index: 1;
    width: 26px;
    height: 26px;
    color: #fff;
    animation: glyph-shake 3.2s ease-in-out infinite;
  }
  @keyframes glyph-shake {
    0%,
    80%,
    100% {
      transform: rotate(0deg);
    }
    82% {
      transform: rotate(-8deg);
    }
    85% {
      transform: rotate(8deg);
    }
    88% {
      transform: rotate(-6deg);
    }
    91% {
      transform: rotate(0deg);
    }
  }

  .scene-call__log {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-family: var(--font-grotesk);
    font-size: 13.5px;
    color: var(--text-on-dark-muted);
    min-height: 24px;
  }
  .call-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: call-step 4.8s ease-in-out infinite;
  }
  .call-line--a {
    animation-delay: 0s;
  }
  .call-line--b {
    animation-delay: 1.6s;
  }
  .call-line--c {
    animation-delay: 3.2s;
    color: #fff;
    font-weight: 600;
  }
  @keyframes call-step {
    0%,
    100% {
      opacity: 0;
      transform: translateY(4px);
    }
    8%,
    28% {
      opacity: 1;
      transform: translateY(0);
    }
    38% {
      opacity: 0;
    }
  }
  .call-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
  }
  .call-check {
    width: 16px;
    height: 16px;
    color: #fff;
  }
</style>

<style>
  /* --- Szene 3: echte Waveform + Beispiel-Satz in Sprechblase --- */
  .scene-voice {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    width: 100%;
    height: 100%;
    padding: 0 20px;
  }
  .scene-voice__wave {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 46px;
  }
  .scene-voice__wave span {
    display: block;
    width: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.85);
    animation: wave-pulse 1.3s ease-in-out infinite;
  }
  .scene-voice__wave span:nth-child(1) { height: 30%; animation-delay: 0s; }
  .scene-voice__wave span:nth-child(2) { height: 55%; animation-delay: 0.08s; }
  .scene-voice__wave span:nth-child(3) { height: 85%; animation-delay: 0.16s; }
  .scene-voice__wave span:nth-child(4) { height: 45%; animation-delay: 0.24s; }
  .scene-voice__wave span:nth-child(5) { height: 100%; animation-delay: 0.32s; }
  .scene-voice__wave span:nth-child(6) { height: 60%; animation-delay: 0.4s; }
  .scene-voice__wave span:nth-child(7) { height: 90%; animation-delay: 0.48s; }
  .scene-voice__wave span:nth-child(8) { height: 40%; animation-delay: 0.56s; }
  .scene-voice__wave span:nth-child(9) { height: 70%; animation-delay: 0.64s; }
  .scene-voice__wave span:nth-child(10) { height: 35%; animation-delay: 0.72s; }
  .scene-voice__wave span:nth-child(11) { height: 58%; animation-delay: 0.8s; }
  .scene-voice__wave span:nth-child(12) { height: 28%; animation-delay: 0.88s; }
  @keyframes wave-pulse {
    0%,
    100% {
      transform: scaleY(0.45);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .scene-voice__bubble {
    max-width: 260px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(10, 26, 54, 0.72);
    border: var(--border-width) solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.6);
    text-align: center;
  }
  .voice-bubble__label {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-grotesk);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark-faint);
  }
  .voice-bubble__text {
    font-family: var(--font-grotesk);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-on-dark-strong);
    font-style: italic;
  }
</style>

<style>
  @media (prefers-reduced-motion: reduce) {
    .model-chip,
    .flow,
    .hub-pulse,
    .ring-pulse,
    .scene-call__glyph,
    .call-line,
    .scene-voice__wave span,
    .agents__glow {
      animation: none !important;
    }
    .flow {
      stroke-dasharray: none;
    }
    .call-line {
      opacity: 1;
    }
    .scene-voice__wave span {
      transform: scaleY(0.7);
    }
  }
</style>
