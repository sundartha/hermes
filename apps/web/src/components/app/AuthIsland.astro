---
// Auth-Insel: die EINE interaktive Stelle, die den Auth-Zustand ermittelt.
// Sie ruft genau einmal loadAuthState() (ein fetch gegen /api/self-service/state),
// schaltet ihre eigene Steuerung (Anmelden-Link vs. Konto+Abmelden) und meldet
// den Zustand per AUTH_EVENT an die App-Shell weiter -- so faellt der state-Fetch
// nur einmal an. KEINE OIDC-/Session-Logik hier (lebt im Gateway): "Anmelden" ist
// nur ein Link auf LOGIN_URL, "Abmelden" ein POST auf /auth/logout.
//
// i18n (Etappe 1): diese Insel ist auch die EINE Stelle fuer den EN/DE-
// Umschalter (immer sichtbar, auch ausgeloggt -- links neben Sign out, s.
// shell.css .lang-toggle). Sie ist die einzige Insel, die auf jeder /app-Seite
// garantiert genau einmal existiert (slot="auth"), darum lebt hier auch der
// initiale applyStaticTranslations()-Aufruf und die Verteilung an alle
// anderen Inseln: beim hermes:lang-Event cachen wir das zuletzt ermittelte
// AUTH_EVENT-Detail und feuern es erneut -- so rendern alle Inseln (Begruessung,
// AgentChip, Calls/Settings/Billing/Newsletter) in der neuen Sprache neu, ganz
// ohne Reload und ohne dass jede Insel selbst einen Lang-Listener braucht.
import { LOGIN_URL } from "../../lib/routes.js";
---

<div class="auth-island">
  <span class="lang-toggle">
    <button class="lang-toggle__opt" type="button" data-lang="en" aria-pressed="true">EN</button>
    <span class="lang-toggle__sep" aria-hidden="true">/</span>
    <button class="lang-toggle__opt" type="button" data-lang="de" aria-pressed="false">DE</button>
  </span>
  <a id="auth-login" class="btn" href={LOGIN_URL} data-i18n="signIn">Sign in</a>
  <div id="auth-account" class="auth-account" hidden>
    <span id="auth-who" class="auth-who"></span>
    <button id="auth-logout" class="btn" type="button" data-i18n="signOut">Sign out</button>
  </div>
</div>

<script>
  import {
    AUTH_STATE,
    AUTH_EVENT,
    agentInfo,
    loadAuthState,
    logout,
    NUMBER_POLL_INTERVAL_MS,
    shouldPollNumberStatus,
  } from "../../lib/api.js";
  import { getLang, setLang, t, applyStaticTranslations, LANG_EVENT } from "../../lib/i18n.js";

  const loginLink = document.getElementById("auth-login");
  const account = document.getElementById("auth-account");
  const whoEl = document.getElementById("auth-who");
  const logoutBtn = document.getElementById("auth-logout");
  const langButtons = document.querySelectorAll("[data-lang]");

  // Hintergrund-Poll waehrend die Rufnummer eingerichtet wird (requested/provisioning):
  // sonst haengt der Chip auf "Setting up..." fest, bis der Nutzer manuell neu laedt.
  // pollTimer haelt IMMER hoechstens einen ausstehenden Timer (refresh() raeumt vor
  // jedem Reschedule auf) -- kein Doppel-Polling bei parallelen refresh()-Aufrufen
  // (z.B. Logout waehrend ein Poll ansteht).
  let pollTimer = null;
  let pollAttempts = 0;

  // Eine bestehende Session liegt vor, sobald das Cookie den webAuth-Check
  // passiert (200) ODER der Tenant nur auf Freigabe wartet (403). In beiden
  // Faellen ist "Abmelden" sinnvoll; nur anonym/Fehler zeigt "Anmelden".
  function hasSession(state) {
    return state === AUTH_STATE.AUTHENTICATED || state === AUTH_STATE.PENDING;
  }

  // Letztes VERTEILTES AUTH_EVENT-Detail -- der Lang-Umschalter feuert es beim
  // Sprachwechsel unveraendert erneut (kein zweiter state-Fetch, s. Kopfkommentar).
  // Gecacht wird ueber den Event-Listener unten, NICHT nur das eigene refresh()-
  // Ergebnis: auch andere Inseln (z.B. Billing nach einer Aktion) re-fetchen den
  // State und dispatchen AUTH_EVENT selbst. Wuerde nur das eigene Ergebnis
  // gecacht, wuerfe ein Sprachwechsel danach alle Inseln auf den aelteren Stand
  // zurueck.
  let lastAuthResult = null;
  document.addEventListener(AUTH_EVENT, (event) => {
    if (event.detail) lastAuthResult = event.detail;
  });

  function whoText(result) {
    if (result.state === AUTH_STATE.PENDING) return t("authPending");
    const { owner } = agentInfo(result.data);
    return owner ? t("authSignedInAs").replace("{name}", owner) : t("authSignedIn");
  }

  function applyControls(result) {
    const session = hasSession(result.state);
    loginLink.hidden = session;
    account.hidden = !session;
    if (session) whoEl.textContent = whoText(result);
  }

  async function refresh() {
    if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
    const result = await loadAuthState();
    applyControls(result);
    // App-Shell ueber den ermittelten Zustand + Daten informieren. Empfaenger
    // registriert seinen Listener synchron beim Modul-Start; dieser dispatch
    // liegt hinter dem await oben und damit garantiert danach.
    document.dispatchEvent(new CustomEvent(AUTH_EVENT, { detail: result }));
    if (shouldPollNumberStatus(result, pollAttempts)) {
      pollAttempts += 1;
      pollTimer = setTimeout(refresh, NUMBER_POLL_INTERVAL_MS);
    } else {
      pollAttempts = 0;
    }
  }

  // Sprachumschalter: aria-pressed auf beiden Knoepfen mit getLang() synchron
  // halten (Init UND nach jedem Wechsel). Das Markup ist Englisch (lang="en" in
  // layouts/App.astro); steht eine gespeicherte DE-Wahl an, muss <html lang> beim
  // Start mitgezogen werden -- setLang() tut das nur beim Klick, nicht beim Laden.
  function syncLangButtons() {
    const lang = getLang();
    document.documentElement.lang = lang;
    for (const btn of langButtons) btn.setAttribute("aria-pressed", String(btn.dataset.lang === lang));
  }

  for (const btn of langButtons) {
    btn.addEventListener("click", () => setLang(btn.dataset.lang));
  }

  // setLang() (lib/i18n.js) feuert LANG_EVENT. Darauf: Knopf-Zustand + alle
  // [data-i18n]-Texte neu setzen, Auth-Steuerung (whoText ist sprachabhaengig)
  // neu berechnen und das zuletzt gecachte AUTH_EVENT erneut an die anderen
  // Inseln verteilen -- kein Reload, kein zweiter Fetch.
  document.addEventListener(LANG_EVENT, () => {
    syncLangButtons();
    applyStaticTranslations(document);
    if (!lastAuthResult) return;
    applyControls(lastAuthResult);
    document.dispatchEvent(new CustomEvent(AUTH_EVENT, { detail: lastAuthResult }));
  });

  // Initialer Stand vor dem ersten state-Fetch (Markup ist Englisch-Default).
  syncLangButtons();
  applyStaticTranslations(document);

  logoutBtn.addEventListener("click", async () => {
    logoutBtn.disabled = true;
    let logoutUrl = null;
    try {
      logoutUrl = await logout();
    } finally {
      logoutBtn.disabled = false;
    }
    // WorkOS-Session-ID vorhanden -> Browser muss TOP-LEVEL zu WorkOS' Sign-out-Endpunkt
    // navigieren, sonst bleibt die AuthKit-SSO-Session aktiv (siehe PLAN-WORKOS-LOGOUT.md).
    if (logoutUrl) {
      window.location.href = logoutUrl;
      return;
    }
    await refresh(); // nach Logout neu bewerten -> faellt auf "anonym" zurueck
  });

  refresh();
</script>
