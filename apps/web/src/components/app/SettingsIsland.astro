---
// SettingsIsland (W5): der EINZIGE existierende Schreibpfad des Frontends.
// POST /api/self-service/settings mit der bekannten ENGEN Whitelist
// (src/self-service.js, NUR-Lese-Vertrag). Settings-Redesign (Aug 2026): der
// Bereich fokussiert sich auf die Sprachwahl -- die UI bietet nur noch:
//   - language   ("" automatisch / de / fr / en) -- das Hauptelement der Karte,
//                als Auswahlkacheln im Radiobutton-Stil (Dashboard-Design-Spec §9)
//   - allowPersonalData / allowBankData (Toggle, NUR restriktiver: true->false)
// Agent-Name (Freitext), Agent-Stil (Dropdown, agentStyle) und die Begruessungs-
// Vorlagenauswahl (greeting) sind aus der UI entfernt. Die SERVER-WHITELIST
// BLEIBT UNVERAENDERT (SELF_SERVICE_FREE_FIELDS traegt weiterhin agentName/
// agentStyle, src/self-service.js) -- der Client bietet die Felder nur nicht
// mehr an. buildSettingsPatch (lib/api.js) sendet ein Feld nur, wenn das
// Formular es ueberhaupt liefert; da readForm() unten kein agentName/agentStyle/
// greeting mehr liefert, reisen diese Keys gar nicht erst im POST-Body mit --
// kein Serverabgleich noetig, keine Aenderung an /src.
// allowCalendar/allowBooking, allowSummaries, Disclosure-Felder und alles
// Unbekannte fehlten schon vorher bewusst -- der Self-Service-Pfad lehnt sie
// ohnehin ab (kein UI-Schreibpfad fuer rejected-Felder).
//
// DASHBOARD-DESIGN-SPEC §9: die Sprachkacheln ersetzen das fruehere <select>-
// aehnliche Pillen-Markup (lang-pill). DIE SPRACHLISTE KOMMT UNVERAENDERT AUS
// SETTINGS_LANGUAGES (lib/api.js) -- keine Sprache hinzugefuegt/entfernt, nur
// die Kachel-Optik ist neu. Echte input[type=radio] pro Kachel, optisch
// versteckt via opacity:0; position:absolute (NICHT display:none) -- der
// Fokusring bleibt sichtbar (Tastaturbedienung/Screenreader-Semantik echter
// Radios, kein nachgebautes ARIA-Widget). Optik lebt in styles/app/panels.css
// (Trupp-C-Stylesheet, Muster shell.css/calls.css) -- kein inline-Style-Block
// mehr hier.
//
// Nach Speichern: "Gespeichert", listet changed/rejected (aus der Antwort
// abgeleitet, settingsOutcome) und RE-FETCHt den State (fetchTenantState ->
// AUTH_EVENT neu dispatchen, damit ALLE Inseln auf den frischen Server-Stand
// gehen). Der Bestaetigungstext blendet 2600ms nach dem Speichern aus (§9) --
// nur bei Erfolg (ok===true), Fehlermeldungen bleiben stehen. Der restriktivere
// Permission-Toggle greift ueber die Server-Semantik: ein false->true-Versuch
// auf allowPersonalData/allowBankData kommt als rejected zurueck (der
// gespeicherte Wert bleibt), die UI zeigt es an und re-fetcht.
//
// KEIN eigener Auth-/state-Fetch im Normalfall: die Auth-Insel ermittelt den
// Zustand einmal und dispatcht AUTH_EVENT -- diese Insel hoert darauf und befuellt
// das Formular. Tenant-Werte gehen NUR ueber [checked]/textContent in den DOM
// (nie innerHTML) -- kein XSS-Pfad (Leitplanke).
//
// Feedback-Runde 2 (Befund 4, Aug 2026) hatte den "Summary SMS number"-Block
// (privates Zweit-Formular, eigener Endpunkt /api/self-service/private-number)
// aus der UI entfernt -- Zusammenfassungen liefen seitdem ueber den Newsletter
// (NewsletterIsland). Das Feld selbst blieb unangetastet server- und lib-seitig
// (savePrivateNumber/privateNumberStatusText/ERROR_INVALID_PRIVATE_NUMBER).
//
// OC-P2/OC-P3 (PLAN-OWNER-CALL, 2026-08-20): das Feld hat seitdem eine ZWEITE,
// gewichtigere Wirkung -- tenant.privateNumber entscheidet (zusammen mit der
// server-seitig gepinnten Tenant-Allowlist, s. CLAUDE.md Regel 2) mit darueber,
// ob der gesetzliche Offenlegungssatz bei einem Outbound-Call entfaellt (Anruf
// an genau diese Nummer = Anruf an dich selbst). Deshalb kommt der Block hier
// als "Eigene Nummer"-Feld ZURUECK, NEU gerahmt um die Owner-Erkennung (nicht
// mehr um die Summary-SMS): Erklaertext/Titel sagen NIE, dass die KI-Kennzeichnung
// entfaellt -- die bleibt in JEDEM Fall fest verdrahtet (Backend, claude.js).
// Was entfaellt, ist NUR die lange Drittpersonen-Vorstellung. Wortlaut zweisprachig
// ueber lib/i18n.js STRINGS (privateNumberTitle/privateNumberHint/-Save/-Remove),
// Statuszeile/Fehlertexte dynamisch ueber lib/api.js (privateNumberStatusText,
// privateNumberMessage) -- gleiche Aufteilung wie der Rest dieser Insel (s.u.).
//
// Angezeigt wird ausschliesslich die Server-Maske (maskPrivateNumber, ueber
// privateNumberStatusText); der volle Wert wird nie ins Eingabefeld zurueckgeschrieben
// (kein PII-Echo). Eigener Endpunkt, eigenes <form> -- NICHT der settings-Patch
// (buildSettingsPatch/saveSettings bleiben unangetastet, s.u.).
import { SETTINGS_LANGUAGES } from "../../lib/api.js";
---

<section id="settings-card" class="card" hidden>
  <h2 data-i18n="settingsTitle">My agent settings</h2>
  <p class="muted" data-i18n="settingsHint">Takes effect on the next call.</p>

  <form id="settings-form" class="settings-form">
    <fieldset class="settings-lang">
      <legend class="field-label" data-i18n="agentLanguage">Agent language</legend>
      <p class="muted settings-lang__hint" data-i18n="agentLanguageHint">
        Choose the language your agent speaks on calls, or leave it automatic.
      </p>
      <div
        class="lang-picker"
        role="radiogroup"
        aria-label="Agent language"
        data-i18n-attr="aria-label:agentLanguage"
      >
        {
          SETTINGS_LANGUAGES.map(({ value, label }) => (
            <label class="lang-tile">
              <input type="radio" name="settings-language" class="lang-tile__input" value={value} />
              <span class="lang-tile__fill" aria-hidden="true" />
              <span class="lang-tile__ring" aria-hidden="true">
                <span class="lang-tile__dot" aria-hidden="true" />
              </span>
              <span class="lang-tile__label" data-lang-value={value}>{label}</span>
              <span class="lang-tile__code" aria-hidden="true">{value ? value.toUpperCase() : "AUTO"}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <!-- Owner-Entscheidung 2026-08-14: der Permissions-Block (Personal data /
         Bank details) ist aus der Oberflaeche entfernt. Die Settings-Felder
         existieren serverseitig weiter; buildSettingsPatch laesst nicht
         gerenderte Toggles aus dem Patch (kein stilles Zuruecksetzen). -->

    <div class="settings-actions">
      <button id="settings-save" class="btn" type="submit" data-i18n="save">Save</button>
      <span id="settings-msg" class="settings-msg" hidden></span>
    </div>
  </form>

  <!-- OC-P2/OC-P3: eigene Naht (eigener Endpunkt, PII am Tenant-Record) -- deshalb
       ein EIGENES <form> neben dem Settings-Formular (Muster vor Feedback-Runde 2).
       Das Eingabefeld wird NIE vorbefuellt: angezeigt wird ausschliesslich die
       Server-Maske (privateNumberStatusText), der volle Wert verlaesst den Server
       nicht. .billing-section/__title = dieselbe Mono-Zwischenlabel-Ebene wie im
       Abrechnungs-Block (panels.css Abschnitt 6), kein drittes Label-Aussehen. -->
  <form id="private-number-form" class="settings-form billing-section">
    <p class="billing-section__title" data-i18n="privateNumberTitle">YOUR OWN NUMBER</p>
    <p class="muted" data-i18n="privateNumberHint">
      Save your own phone number so your agent recognizes you. When it calls you on this
      number, it skips the full third-party introduction.
    </p>
    <p id="private-number-status" class="muted private-number-status">—</p>
    <input
      id="private-number-input"
      class="field-input"
      type="tel"
      inputmode="tel"
      autocomplete="off"
      placeholder="+49 151 23456789"
      aria-label="Your own phone number"
      data-i18n-attr="aria-label:privateNumberInputAriaLabel"
    />
    <div class="settings-actions">
      <button id="private-number-save" class="btn" type="submit" data-i18n="privateNumberSave">
        Save number
      </button>
      <button
        id="private-number-clear"
        class="private-number-form__remove"
        type="button"
        data-i18n="privateNumberRemove"
      >
        Remove
      </button>
      <span id="private-number-msg" class="settings-msg" hidden></span>
    </div>
  </form>
</section>

<script>
  import {
    ApiError,
    AUTH_STATE,
    AUTH_EVENT,
    HTTP_UNAUTHORIZED,
    ERROR_INVALID_PRIVATE_NUMBER,
    buildSettingsPatch,
    fetchTenantState,
    privateNumberMessage,
    privateNumberStatusText,
    saveSettings,
    savePrivateNumber,
    settingsFrom,
    settingsOutcome,
    settingsLanguageLabel,
  } from "../../lib/api.js";
  import { t } from "../../lib/i18n.js";

  const cardEl = document.getElementById("settings-card");
  const formEl = document.getElementById("settings-form");
  const saveBtn = document.getElementById("settings-save");
  const msgEl = document.getElementById("settings-msg");

  const privateFormEl = document.getElementById("private-number-form");
  const privateInputEl = document.getElementById("private-number-input");
  const privateStatusEl = document.getElementById("private-number-status");
  const privateSaveBtn = document.getElementById("private-number-save");
  const privateClearBtn = document.getElementById("private-number-clear");
  const privateMsgEl = document.getElementById("private-number-msg");

  const MSG_OK_CLASS = "settings-msg--ok";
  const MSG_ERR_CLASS = "settings-msg--err";
  // §9: der Bestaetigungstext blendet nach dieser Zeit wieder aus (nur bei
  // Erfolg -- eine Fehlermeldung bleibt stehen, bis der naechste Versuch sie
  // ersetzt). EIN Timer pro Meldungs-Element (WeakMap, kein Leak).
  const CONFIRM_HIDE_MS = 2600;
  const hideTimers = new WeakMap();

  // Kurze Rueckmeldung mit Erfolgs-/Fehler-Faerbung, an ein beliebiges Meldungs-
  // Element. text leer -> verstecken. Erfolgsmeldungen blenden nach
  // CONFIRM_HIDE_MS aus.
  function showMessage(el, text, ok) {
    el.textContent = text;
    el.classList.toggle(MSG_OK_CLASS, Boolean(text) && ok);
    el.classList.toggle(MSG_ERR_CLASS, Boolean(text) && !ok);
    el.hidden = !text;
    clearTimeout(hideTimers.get(el));
    if (text && ok) {
      hideTimers.set(
        el,
        setTimeout(() => {
          el.hidden = true;
        }, CONFIRM_HIDE_MS),
      );
    }
  }

  // Sprachkacheln-Beschriftungen sind serverseitig/englisch aus
  // SETTINGS_LANGUAGES gerendert (Astro-Frontmatter, laeuft nur einmal, ohne
  // Sprachkontext) -- diese Funktion bringt sie auf die aktuelle Sprache. Aufgerufen von fillForm() (jedes AUTH_EVENT, inkl. des vom
  // Sprachumschalter re-dispatchten -- s. AuthIsland.astro), kein eigener
  // LANG_EVENT-Listener noetig.
  function syncSettingsLabels() {
    for (const node of formEl.querySelectorAll("[data-lang-value]")) {
      node.textContent = settingsLanguageLabel(node.dataset.langValue);
    }
  }

  // Formular aus dem state befuellen: die Sprach-Kachel auswaehlen (fehlend/leer
  // -> "Automatic", die erste Kachel mit value=""). Kein clientseitiger DOM-Bau
  // mehr; der Permissions-Block ist entfernt (Owner-Entscheidung 2026-08-14).
  function fillForm(data) {
    syncSettingsLabels();
    const { settings } = settingsFrom(data);
    const language = settings.language || "";
    for (const input of formEl.querySelectorAll('input[name="settings-language"]')) {
      input.checked = input.value === language;
    }
  }

  // Roher Formular-Snapshot fuer buildSettingsPatch (die Whitelist-Grenze lebt
  // dort, nicht hier). Sprache aus der gecheckten Kachel (keine Auswahl -> "",
  // sollte praktisch nicht vorkommen, da immer genau eine Kachel checked ist).
  function readForm() {
    const checkedLang = formEl.querySelector('input[name="settings-language"]:checked');
    return { language: checkedLang ? checkedLang.value : "" };
  }

  // changed/rejected fuer die Rueckmeldung formatieren (Schluessel, keine Werte
  // -- die Feldnamen selbst sind technische Bezeichner, keine natuersprachlichen
  // Strings, darum unuebersetzt; nur die umgebenden Praefixe kommen aus t()).
  function outcomeText({ changed, rejected }) {
    const applied = changed.length ? changed.join(", ") : t("settingsAppliedEmpty");
    const parts = [`${t("settingsAppliedPrefix")} ${applied}`];
    if (rejected.length) parts.push(`${t("settingsRejectedPrefix")} ${rejected.join(", ")}`);
    return parts.join(" · ");
  }

  // Re-Fetch nach dem Speichern: den State neu laden und per AUTH_EVENT an ALLE
  // Inseln (inkl. dieser) verteilen -> das Formular zeigt den frischen Server-
  // Stand (so erscheint ein serverseitig abgelehnter Toggle wieder im alten Wert).
  async function refetchState() {
    const data = await fetchTenantState();
    document.dispatchEvent(new CustomEvent(AUTH_EVENT, { detail: { state: AUTH_STATE.AUTHENTICATED, data } }));
  }

  // Fehlertext beim Speichern: 401 = abgelaufene Session (neu anmelden), sonst
  // generisch. Fail-closed: nie als Teil-Erfolg deuten.
  function saveErrorText(err) {
    if (err instanceof ApiError && err.status === HTTP_UNAUTHORIZED) return t("settingsSessionExpired");
    return t("settingsNotSaved");
  }

  // Fehlertext der Nummern-Route. Der eingegebene Wert wird NIE zurueckgespiegelt
  // (keine PII in Meldungen); nur der stabile Server-Code entscheidet den Text.
  // ERROR_INVALID_PRIVATE_NUMBER bekommt eine verstaendliche, zweisprachige
  // Meldung (lib/api.js privateNumberMessage); alles andere (401/Netzfehler)
  // teilt sich denselben generischen Fehlertext wie das Settings-Formular
  // (saveErrorText, s.o. -- keine zweite Kopie).
  function privateNumberErrorText(err) {
    if (err instanceof ApiError && err.code === ERROR_INVALID_PRIVATE_NUMBER) return privateNumberMessage("invalid");
    return saveErrorText(err);
  }

  // Schreibt die Nummer und synchronisiert danach den State ueber DIESELBE eine
  // Refetch-Naht wie das Settings-Speichern (G5). Nebeneffekt im Namen (N7).
  async function submitPrivateNumber(value, okText) {
    privateSaveBtn.disabled = true;
    privateClearBtn.disabled = true;
    try {
      await savePrivateNumber(value);
      privateInputEl.value = ""; // das Eingabefeld traegt nie einen gespeicherten Wert
      showMessage(privateMsgEl, okText, true);
      await refetchState();
    } catch (err) {
      showMessage(privateMsgEl, privateNumberErrorText(err), false);
    } finally {
      privateSaveBtn.disabled = false;
      privateClearBtn.disabled = false;
    }
  }

  async function submit(event) {
    event.preventDefault();
    saveBtn.disabled = true;
    const patch = buildSettingsPatch(readForm());
    try {
      const saved = await saveSettings(patch);
      showMessage(msgEl, outcomeText(settingsOutcome(patch, saved)), true);
      await refetchState(); // frischen Stand ziehen + an alle Inseln verteilen
    } catch (err) {
      showMessage(msgEl, saveErrorText(err), false);
    } finally {
      saveBtn.disabled = false;
    }
  }

  formEl.addEventListener("submit", submit);

  privateFormEl.addEventListener("submit", (event) => {
    event.preventDefault();
    const value = privateInputEl.value.trim();
    // Leeres Feld ist KEIN implizites Loeschen - Loeschen ist der eigene Knopf.
    if (!value) {
      showMessage(privateMsgEl, privateNumberMessage("missing"), false);
      return;
    }
    submitPrivateNumber(value, privateNumberMessage("saved"));
  });

  privateClearBtn.addEventListener("click", () => submitPrivateNumber("", privateNumberMessage("removed")));

  // Die Auth-Insel ermittelt den Zustand einmal und dispatcht AUTH_EVENT; nur im
  // eingeloggten Zustand traegt die Antwort settings/greetingTemplates. Listener
  // synchron beim Modul-Start registrieren, BEVOR die Auth-Insel dispatcht. Im
  // Nicht-eingeloggten Zustand: Karte verstecken (kein stale Tenant-Datum, keine
  // Schreibflaeche ohne Session).
  document.addEventListener(AUTH_EVENT, (event) => {
    const { state, data } = event.detail;
    if (state === AUTH_STATE.AUTHENTICATED) {
      fillForm(data);
      privateStatusEl.textContent = privateNumberStatusText(data);
      cardEl.hidden = false;
    } else {
      cardEl.hidden = true;
    }
  });
</script>
