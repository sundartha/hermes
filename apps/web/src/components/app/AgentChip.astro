---
// AgentChip (W4, Dashboard-Redesign §3): eigenstaendige Nummern-Karte im
// Seitenkopf -- Live-Dot + Rufnummer + Kopier-Knopf. Read-only aus genau dem
// state, den die Auth-Insel ermittelt -- KEIN eigener state-Fetch (AUTH_EVENT).
//
// Stale-Daten-Schutz: bei jedem Nicht-authenticated-Zustand (anonym/pending/
// Fehler bzw. data==null) wird die Nummer geleert und der Dot auf "off" gesetzt
// -- kein stehen gebliebenes Tenant-Datum.
//
// Tenant-Werte (die Nummer) gehen ausschliesslich ueber textContent in den DOM
// -- nie als HTML interpretiert (XSS-Schutz, Leitplanke).
//
// .card liefert die Glasoptik (Hintergrund/Rand/Radius/Schatten/Blur,
// app.css + app-hermes.css); shell.css ergaenzt nur Layout + Puls/Copy-
// Interaktion. Kein Inline-Style, kein Inline-Script (CSP) -- Kopier-Fallback
// positioniert sein Scratch-Element ausschliesslich ueber die Klasse
// .agent-chip__scratch (shell.css).
---


<!-- Feedback-Runde 2 (Befund 1): der Radiopunkt sitzt jetzt IN der Nummern-
     Zeile (agent-chip__row), nicht mehr neben dem ganzen Label+Nummer-Block --
     so zentriert er sich nur zur Nummer, das Label darueber zieht ihn nicht
     mehr nach oben. -->
<div id="agent-chip" class="agent-chip card" hidden>
  <!-- GP-P6: obere Zeile = Text links, Knopf rechts. Der Erklaersatz haengt DARUNTER
       ueber die volle Kartenbreite (statt neben dem Knopf in einer schmalen Spalte zu
       stehen) -- sonst frisst der Knopf die halbe Zeilenbreite und der Satz laeuft auf
       vier Zeilen, gerade auf Deutsch. -->
  <span class="agent-chip__main">
    <span class="agent-chip__body">
      <span class="agent-chip__label" data-i18n="yourNumber">Your number</span>
      <!-- Owner-Entscheid 15.09.2026: die Rufnummer selbst ist der Kopier-Knopf. Auf
           schmalen Breiten stand daneben eine 99px-Pille, die die Ziffernreihe auf zwei
           Zeilen gedrueckt hat ("geht auf gar keinen Fall") -- die Zeile traegt jetzt nur
           noch ein kleines Symbol direkt hinter der Nummer. Im Stoerfall steht hier ein
           Satz statt Ziffern; dann ist der Knopf disabled (s. showChip) und verhaelt sich
           wie der frueher reine Text. -->
      <button
        id="agent-number-copy"
        class="agent-chip__row"
        type="button"
        aria-label="Copy phone number"
        data-i18n-attr="aria-label:copyAriaLabel"
      >
        <span id="agent-dot" class="live-dot live-dot--off" aria-hidden="true"></span>
        <span id="agent-number" class="agent-chip__number"></span>
        <!-- Owner-Befund 15.09.2026: als blosses 14px-Symbol sah das Kopieren "komisch"
             aus. Es sitzt darum wieder in einem runden Feld wie ganz am Anfang -- nur
             ist das Feld jetzt Teil der klickbaren Zeile, nicht ein zweiter Knopf
             daneben. Ein <span>, kein <button>: ein Knopf im Knopf waere ungueltiges
             HTML und fuer die Tastatur ein doppelter Halt. -->
        <span class="agent-chip__row-copy" aria-hidden="true">
          <svg
            id="agent-number-copy-icon"
            class="agent-chip__row-icon"
            viewBox="0 0 16 16"
            focusable="false"
          >
            <rect x="2" y="2" width="9" height="9" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
            <rect x="5.5" y="5.5" width="9" height="9" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
          </svg>
        </span>
      </button>
    </span>
    <!-- GP-P3: Aktion zum gescheiterten Nummern-Setup (Kartenwechsel). Label wird
         ausschliesslich per textContent gesetzt (XSS), Sichtbarkeit per .hidden.
         GP-P6 (Owner-Befund 15.09.2026): der Knopf steht jetzt RECHTS neben dem
         Textblock -- genau da, wo im Normalfall der Kopier-Knopf sitzt -- statt als
         vierte Zeile unter der Nummer. Die Karte waechst dadurch in die Breite statt
         in die Hoehe, und beide Zustaende teilen dieselbe Silhouette. -->
    <button id="agent-number-action" class="agent-chip__action" type="button" hidden>
      <!-- GP-P6 Runde 3: dasselbe Kartensymbol wie in der Billing-Insel
           (BillingIsland.astro .payment-card__icon). Es traegt die Bedeutung, die
           vorher im langen Label stand -- das Label sagt nur noch "Update". Markup
           ist statisch (kein Tenant-Wert), das Label bleibt textContent (XSS). -->
      <svg
        class="agent-chip__action-icon"
        viewBox="0 0 24 16"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="1" y="1" width="22" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
        <rect x="1" y="4.5" width="22" height="3" fill="currentColor"></rect>
      </svg>
      <span id="agent-number-action-label" class="agent-chip__action-label"></span>
    </button>
    <button
      id="agent-copy"
      class="agent-chip__copy"
      type="button"
      aria-label="Copy phone number"
      data-i18n-attr="aria-label:copyAriaLabel"
    >
      <svg
        class="agent-chip__copy-icon"
        viewBox="0 0 16 16"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="2" y="2" width="9" height="9" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
        <rect x="5.5" y="5.5" width="9" height="9" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
      </svg>
      <span id="agent-copy-label" class="agent-chip__copy-label" data-i18n="copy">Copy</span>
    </button>
  </span>
  <!-- GP-P5: WARUM es haengt und was als Naechstes passiert. Der Knopf allein sagt dem
       Kunden nicht, ob er handeln muss, warten kann oder sich melden soll. Text per
       textContent (XSS), Sichtbarkeit per .hidden; aria-live, weil der Satz nach einem
       Zustandswechsel ohne Reload erscheint.
       GP-P6: steht als eigene Zeile UNTER der Kopfzeile und nutzt die volle Kartenbreite. -->
  <span id="agent-number-hint" class="agent-chip__hint" hidden aria-live="polite"></span>
  <!-- Owner-Befund 18.09.2026 ("der Update-Knopf geht nicht"): scheiterte der Start der
       Karten-Erfassung, wurde der Knopf nur still wieder freigegeben -- kein Wort, kein
       Fehler. Genau das ist bei einer abgelaufenen Sitzung passiert (acht Klicks am
       17.09.2026, alle 401). Jetzt steht hier dieselbe Meldung wie in der Billing-Insel.
       role="status" statt aria-live allein: die Zeile erscheint erst nach dem Klick. -->
  <span id="agent-number-msg" class="agent-chip__msg" role="status" hidden></span>
  <!-- Eine einzige, immer unsichtbare Meldezeile fuer "Copied". Sie sitzt bewusst NEBEN
       beiden Kopier-Wegen (Pille am Desktop, Ziffernreihe darunter): die Pille ist unter
       981px display:none und koennte von dort aus nichts mehr melden, und zwei
       aria-live-Bereiche wuerden dieselbe Meldung doppelt vorlesen. -->
  <span id="agent-copy-live" class="agent-chip__live" aria-live="polite"></span>
</div>

<script>
  import {
    AUTH_STATE,
    AUTH_EVENT,
    ApiError,
    HTTP_UNAUTHORIZED,
    agentInfo,
    isAgentLive,
    numberPlaceholderAction,
    numberPlaceholderHint,
    numberPlaceholderText,
    startBillingSetupCheckout,
  } from "../../lib/api.js";
  import { t } from "../../lib/i18n.js";

  const DOT_OFF_CLASS = "live-dot--off";
  // GP-P6: bernsteinfarbener Punkt, solange das Setup haengt. Die Dringlichkeit traegt
  // jetzt die Farbe -- vorher trug sie die Schriftgroesse des Statussatzes (22-30px
  // Mono), und genau die hat die Karte in die Hoehe getrieben.
  const DOT_ALERT_CLASS = "live-dot--alert";
  // GP-P6: ein Statussatz ist keine Rufnummer. Ohne diese Klasse steht "Number setup
  // failed" in der Ziffernzeile (shell.css .agent-chip__number.is-status).
  const STATUS_CLASS = "is-status";
  // GP-P6: Breitenzustand der Karte (eigene Zeile im Seitenkopf), s. showChip.
  const NOTICE_CLASS = "agent-chip--notice";
  const COPIED_CLASS = "is-copied";
  const COPIED_LABEL_MS = 1800;

  const chipEl = document.getElementById("agent-chip");
  const dotEl = document.getElementById("agent-dot");
  const numberEl = document.getElementById("agent-number");
  const actionEl = document.getElementById("agent-number-action");
  // GP-P6 Runde 3: das Label ist ein eigener Knoten NEBEN dem Kartensymbol. Frueher
  // schrieb showChip direkt in actionEl.textContent -- das haette das SVG geloescht.
  const actionLabelEl = document.getElementById("agent-number-action-label");
  const hintEl = document.getElementById("agent-number-hint");
  const msgEl = document.getElementById("agent-number-msg");
  // Schluessel (lib/i18n.js) der aktuell sichtbaren Fehlermeldung zum Kartenwechsel,
  // "" = keine. Als Schluessel statt als fertiger Text, damit ein Sprachwechsel (er
  // verteilt AUTH_EVENT erneut -> showChip) die Meldung in der neuen Sprache zeigt.
  let msgKey = "";
  const copyBtn = document.getElementById("agent-copy");
  const copyLabelEl = document.getElementById("agent-copy-label");
  // Owner-Entscheid 15.09.2026: zweiter, gleichwertiger Kopier-Weg -- die Ziffernreihe
  // selbst. Auf schmalen Breiten ist sie der EINZIGE (die Pille ist dort ausgeblendet,
  // shell.css), am Desktop steht sie neben der Pille.
  const rowBtn = document.getElementById("agent-number-copy");
  const liveEl = document.getElementById("agent-copy-live");

  let copyResetTimer = null;

  // GP-P6 Runde 2 (Owner-Befund 15.09.2026): jeder Satz des Hinweises beginnt in einer
  // eigenen Zeile. Als ein Textblock lief der Satz durch und brach mitten im zweiten
  // Satz um ("... Add a card - setup / restarts automatically."), was wie ein Fehler
  // aussah. Aufbau ueber echte Knoten + textContent (KEIN innerHTML, CSP/XSS-Leitplanke
  // dieser Datei). Getrennt wird nach einem Punkt mit folgendem Leerzeichen; traegt der
  // Text keinen, bleibt es genau eine Zeile.
  function renderHint(text) {
    hintEl.textContent = "";
    if (!text) return;
    for (const sentence of text.split(/(?<=\.)\s+/)) {
      const line = document.createElement("span");
      line.className = "agent-chip__hint-line";
      line.textContent = sentence;
      hintEl.appendChild(line);
    }
  }

  function renderMsg() {
    msgEl.textContent = msgKey ? t(msgKey) : "";
    msgEl.hidden = !msgKey;
  }

  function showChip(data) {
    const { number } = agentInfo(data);
    // Aktive Nummer -> ihre e164; sonst ein statusabhaengiger Platzhalter (Fix C: jetzt
    // inkl. failed/blocked statt beide auf "No number assigned yet" zu buendeln). Tenant-
    // Werte weiter ausschliesslich via textContent (XSS).
    numberEl.textContent = number || numberPlaceholderText(data);
    // GP-P6: Ziffernzeile nur fuer echte Ziffern; jeder Platzhalter ist ein Satz.
    numberEl.classList.toggle(STATUS_CLASS, !number);
    dotEl.classList.toggle(DOT_OFF_CLASS, !isAgentLive(data));
    // GP-P5: Kopieren ergibt nur Sinn, wenn es eine echte Nummer gibt. Der Knopf stand
    // bisher auch neben "Einrichtung der Nummer fehlgeschlagen" und kopierte damit den
    // FEHLERTEXT in die Zwischenablage (copyNumber liest schlicht numberEl).
    copyBtn.hidden = !number;
    // Dieselbe Bedingung fuer die klickbare Ziffernreihe: ohne echte Nummer steht dort
    // ein Satz, und der darf sich nicht wie ein Knopf verhalten (kein Fokus, kein
    // Kopieren des Fehlertexts). disabled statt hidden -- der Satz bleibt sichtbar.
    rowBtn.disabled = !number;
    // GP-P3: die failed-Nummer bekommt einen Knopf auf die BESTEHENDE Karten-Erfassung
    // (kein neuer Endpunkt). Label per textContent (XSS), Sichtbarkeit per .hidden.
    const action = numberPlaceholderAction(data);
    actionEl.hidden = !action;
    if (action) actionLabelEl.textContent = action.label;
    // Die Fehlermeldung gehoert zum Knopf: verschwindet er (Nummer inzwischen aktiv,
    // anderer Grund), verschwindet sie mit.
    if (!action) msgKey = "";
    renderMsg();
    // GP-P6: genau dieser Zustand (failed) faerbt den Punkt bernstein.
    dotEl.classList.toggle(DOT_ALERT_CLASS, !!action);
    // GP-P5: der erklaerende Satz. Er steht NEBEN dem Knopf, nicht statt seiner - im
    // Wartefall und im Support-Fall gibt es keinen Knopf, aber sehr wohl etwas zu sagen.
    const hint = numberPlaceholderHint(data);
    renderHint(hint);
    hintEl.hidden = !hint;
    // GP-P6: nur DIESER Zustand (Statussatz + Erklaersatz + Knopf) braucht Breite. Die
    // Klasse gibt der Karte im Seitenkopf eine eigene, volle Zeile (shell.css
    // .agent-chip--notice) -- sonst quetscht sie die Begruessung daneben zusammen und
    // der Erklaersatz bricht auf drei Zeilen um. Ohne Hinweis bleibt alles wie gehabt:
    // kompakte Karte rechts neben der Begruessung.
    chipEl.classList.toggle(NOTICE_CLASS, !!hint);
    chipEl.hidden = false;
  }

  // Nicht eingeloggt -> Chip verstecken UND leeren (kein stale Tenant-Datum).
  function clearChip() {
    numberEl.textContent = "";
    actionEl.hidden = true;
    actionLabelEl.textContent = "";
    hintEl.hidden = true;
    renderHint("");
    msgKey = "";
    renderMsg();
    copyBtn.hidden = false; // Grundzustand, damit der naechste Login ihn wieder sieht
    rowBtn.disabled = false;
    rowBtn.classList.remove(COPIED_CLASS);
    numberEl.classList.remove(STATUS_CLASS);
    chipEl.classList.remove(NOTICE_CLASS);
    dotEl.classList.remove(DOT_ALERT_CLASS);
    dotEl.classList.add(DOT_OFF_CLASS);
    chipEl.hidden = true;
  }

  document.addEventListener(AUTH_EVENT, (event) => {
    const { state, data } = event.detail;
    if (state === AUTH_STATE.AUTHENTICATED) showChip(data);
    else clearChip();
  });

  // Copy-to-clipboard: navigator.clipboard mit document.execCommand-Fallback
  // (aeltere/eingeschraenkte Browser bzw. unsicherer Kontext). Rein clientseitig,
  // kein Netz-Aufruf.
  function legacyCopy(value) {
    const scratch = document.createElement("textarea");
    scratch.className = "agent-chip__scratch";
    scratch.value = value;
    scratch.setAttribute("readonly", "");
    document.body.appendChild(scratch);
    scratch.select();
    scratch.setSelectionRange(0, value.length);
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    document.body.removeChild(scratch);
    return ok;
  }

  function showCopiedState() {
    copyBtn.classList.remove(COPIED_CLASS);
    rowBtn.classList.remove(COPIED_CLASS);
    // Reflow erzwingen, damit die Pop-Animation bei schnellem Doppelklick erneut laeuft.
    void copyBtn.offsetWidth;
    copyBtn.classList.add(COPIED_CLASS);
    // Auf schmalen Breiten ist die Pille ausgeblendet -- dort traegt die Ziffernreihe
    // die Rueckmeldung (gruene Einfaerbung, shell.css .agent-chip__row.is-copied).
    rowBtn.classList.add(COPIED_CLASS);
    copyLabelEl.textContent = t("copied");
    liveEl.textContent = t("copied");
    clearTimeout(copyResetTimer);
    copyResetTimer = setTimeout(() => {
      copyBtn.classList.remove(COPIED_CLASS);
      rowBtn.classList.remove(COPIED_CLASS);
      copyLabelEl.textContent = t("copy");
      liveEl.textContent = "";
    }, COPIED_LABEL_MS);
  }

  async function copyNumber() {
    const value = (numberEl.textContent || "").trim();
    if (!value) return;
    let ok = false;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        ok = true;
      } catch {
        ok = legacyCopy(value);
      }
    } else {
      ok = legacyCopy(value);
    }
    if (ok) showCopiedState();
  }

  copyBtn.addEventListener("click", copyNumber);
  rowBtn.addEventListener("click", copyNumber);

  // GP-P3: fuehrt zur bestehenden Stripe-Checkout-Session (setup-mode) - dieselbe, die
  // die Billing-Insel nutzt. Doppelklick-Schutz ueber disabled; scheitert der Start,
  // wird der Knopf wieder bedienbar.
  // Owner-Befund 18.09.2026: bis hierhin endete jeder Fehler STUMM (der Knopf wurde nur
  // wieder freigegeben) - fuer den Kunden sah das aus wie ein toter Knopf. Jetzt dieselbe
  // Rueckmeldung wie am Knopf der Billing-Insel (checkoutErrorText dort): 401 sagt
  // "Sitzung abgelaufen", alles andere "Checkout konnte nicht gestartet werden". Bei 401
  // schaltet zusaetzlich die Auth-Insel die Seite auf "Anmeldung erforderlich" um
  // (SESSION_EXPIRED_EVENT, lib/api.js) - die Karte ist danach ohnehin ausgeblendet.
  async function startCardUpdate() {
    actionEl.disabled = true;
    msgKey = "";
    renderMsg();
    try {
      window.location.assign(await startBillingSetupCheckout());
    } catch (err) {
      const expired = err instanceof ApiError && err.status === HTTP_UNAUTHORIZED;
      msgKey = expired ? "billingSessionExpired" : "checkoutError";
      renderMsg();
      actionEl.disabled = false;
    }
  }

  actionEl.addEventListener("click", startCardUpdate);

  // Zurueck-Knopf aus dem Stripe-Checkout (18.09.2026): im Erfolgsfall bleibt der Knopf
  // bewusst gesperrt, die Seite wird ja verlassen. Stellt der Browser sie danach aus dem
  // Zwischenspeicher wieder her (bfcache), laeuft kein Skript neu -- der Knopf stuende
  // dauerhaft auf disabled und waere tot.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) actionEl.disabled = false;
  });
</script>
