---
// Billing-Insel (W3 + P2, Payment-Neugestaltung Aug 2026): Karte hinterlegen, Abo
// buchen, Kuendigen/Reaktivieren, Newsletter-Einwilligung -- der heute existierende
// Backend-Umfang, NUR neu angeordnet/dargestellt (keine Datenwege/Endpunkte/Payloads
// geaendert). Reihenfolge laut Auftrag:
//   1. aktueller Tarif + Status (EIN Satz, was als Naechstes passiert -- s.
//      billingStatusKind/-Text in lib/subscribe.js: kein Abo / Karte fehlt / aktiv /
//      gekuendigt-zum-Periodenende. "Fehler" ist keine Karten-/Abo-LAGE, sondern eine
//      fehlgeschlagene AKTION -- s. die farblich abgesetzten Ruecklauf-/Fehlermeldungen
//      weiter unten, showMessage)
//   2. Zahlungsmittel ("Add payment method" -> POST .../setup-checkout -> Stripe-
//      Redirect. Rueckkehr ueber ?card=ok|canceled|error)
//   3. verbrauchtes/verbleibendes Kontingent (nur mit aktivem Abo, quotaFrom)
//   4. Tarifwechsel: die Plan-Kacheln (aus dem Build-Spiegel lib/plans.js), NUR ohne
//      aktives Abo -- eine BESTEHENDE Buchung umzustellen bietet der Server nicht an
//      (kein neuer Endpunkt, Auftrag: "keine Datenwege"). Subscribe-Klick ->
//      Zustandsmaschine (lib/subscribe.js): ok -> Tenant aktiv + alle Inseln
//      refreshen; 409 no_card -> gefuehrter Stripe-Checkout MIT Plan; 409 sonst ->
//      "bereits abonniert"; 401 -> Session.
//   5. Newsletter-Einwilligung (Opt-in, DSGVO Art. 7 Abs. 1): NIE vorangekreuzt,
//      Zustand kommt ausschliesslich aus data.newsletter (newsletterConsentFrom).
//      Umschalten schreibt sofort gegen POST .../newsletter-consent.
//   6. Kuendigung (312k-P3, § 312k BGB): ruhig ganz unten, ein Text-Link statt eines
//      fetten Knopfs (unmittelbar sichtbar/erreichbar bleibt sie trotzdem).
//
// Kein eigener state-Fetch im Normalfall: die Auth-Insel ermittelt den Zustand einmal
// und meldet ihn per AUTH_EVENT -- diese Insel hoert mit. Nach jeder erfolgreichen
// Aktion re-fetcht sie den State selbst und re-dispatcht AUTH_EVENT (so gehen ALLE
// Inseln auf den frischen Stand). Anzeige-Strings nur ueber textContent (XSS-Schutz).
import {
  CANCEL_BUTTON_LABEL,
  CONFIRM_CANCEL_BUTTON_LABEL,
  CANCEL_ABORT_LABEL,
  RESUME_BUTTON_LABEL,
} from "../../lib/subscribe.js";
---

<!-- Default versteckt: ohne PAYMENT_ENABLED (hasCard kein Boolean) bleibt der
     Block verborgen, byte-identisch zum Bestand. JS zeigt ihn nur bei present. -->
<section id="billing-card" class="card" hidden>
  <h2>Billing</h2>
  <p class="muted">Your plan, payment method and usage for Hermes.</p>

  <!-- 1. aktueller Tarif + Status -->
  <div class="billing-status">
    <span id="billing-status-badge" class="billing-status-badge"></span>
    <p id="billing-status-text" class="billing-status-text"></p>
  </div>
  <p id="billing-msg" class="billing-msg" hidden></p>

  <!-- 2. Zahlungsmittel -->
  <div class="billing-section">
    <h3 class="billing-section__title">Payment method</h3>
    <p id="billing-card-status" class="muted"></p>
    <button id="billing-add" class="btn" type="button">Add payment method</button>
  </div>

  <!-- 3. Kontingent -- nur mit aktivem Abo vorhanden (quotaFrom liefert sonst null). -->
  <div id="billing-quota-section" class="billing-section" hidden>
    <h3 class="billing-section__title">Usage</h3>
    <p id="sub-quota" class="muted"></p>
  </div>

  <!-- 4. Tarifwechsel: die Plan-Kacheln, NUR ohne aktives Abo (s. Kopf-Kommentar). -->
  <div class="billing-section">
    <h3 id="sub-tiles-title" class="billing-section__title" hidden>Choose your plan</h3>
    <div id="sub-tiles" class="plans" hidden></div>
    <p id="sub-msg" class="billing-msg" hidden></p>
  </div>

  <!-- 5. Newsletter-Einwilligung (Opt-in, DSGVO Art. 7 Abs. 1). Die Checkbox startet
       IMMER ungecheckt im Markup -- der tatsaechliche Zustand kommt ausschliesslich
       aus data.newsletter (renderNewsletter/newsletterConsentFrom), nie aus einem
       lokalen Default "true" (kein Dark Pattern, kein Vorankreuzen). -->
  <div class="billing-section">
    <h3 class="billing-section__title">Product updates</h3>
    <p class="muted">
      Occasional email about new Hermes features. Not required for your subscription —
      you can change your mind anytime.
    </p>
    <div class="perm-row">
      <span class="perm-text">
        <span class="perm-title">Send me product updates</span>
      </span>
      <label class="switch">
        <input type="checkbox" id="newsletter-toggle" />
        <span class="switch-slider" aria-hidden="true"></span>
      </label>
    </div>
    <p id="newsletter-msg" class="billing-msg" hidden></p>
  </div>

  <!-- 6. 312k-P3: zweistufiger Kuendigungsweg (§ 312k BGB), ruhig ganz unten. Sichtbar
       NUR mit aktivem Abo (renderCancelBlock blendet den Block sonst aus). Stufe 1:
       CANCEL_BUTTON_LABEL (gesetzlich vorgegebener Wortlaut) als ruhiger Text-Link
       (.cancel-link), kein roter Schreckknopf -- bleibt trotzdem unmittelbar sichtbar
       und erreichbar. Stufe 2: cancel-confirm nennt WAS/WANN und bietet
       CONFIRM_CANCEL_BUTTON_LABEL (ebenfalls gesetzlich vorgegeben) sowie den
       Abbruch. Bereits gekuendigt -> cancel-status + Ruecknahme-Schaltflaeche. -->
  <div id="cancel-block" class="billing-section" hidden>
    <p id="cancel-status" class="muted" hidden></p>
    <button id="cancel-open" class="cancel-link" type="button" hidden>{CANCEL_BUTTON_LABEL}</button>
    <div id="cancel-confirm" class="cancel-confirm" hidden>
      <p id="cancel-confirm-text"></p>
      <button id="cancel-confirm-btn" class="btn" type="button">{CONFIRM_CANCEL_BUTTON_LABEL}</button>
      <button id="cancel-abort" class="plan-skip" type="button">{CANCEL_ABORT_LABEL}</button>
    </div>
    <button id="resume-btn" class="btn" type="button" hidden>{RESUME_BUTTON_LABEL}</button>
    <p id="cancel-msg" class="billing-msg" hidden></p>
  </div>
</section>

<script>
  import {
    ApiError,
    AUTH_STATE,
    AUTH_EVENT,
    HTTP_UNAUTHORIZED,
    cardStatus,
    subscriptionFrom,
    quotaFrom,
    numberSetupFeeFrom,
    fetchTenantState,
    startBillingSetupCheckout,
  } from "../../lib/api.js";
  import {
    planTiles,
    quotaLine,
    wireSubscribe,
    cancelConfirmText,
    cancelStatusLine,
    wireCancelControls,
    billingStatusKind,
    billingStatusBadge,
    billingStatusBadgeClass,
    billingStatusText,
    newsletterConsentFrom,
    wireNewsletterToggle,
  } from "../../lib/subscribe.js";

  // Rueckkehr-Parameter (kein Magic-String an den Vergleichsstellen).
  const RETURN_PARAM_CARD = "card";
  const RETURN_PARAM_SUB = "sub";
  const RETURN_OK = "ok";
  const RETURN_CANCELED = "canceled";
  const RETURN_ERROR = "error";
  const RETURN_FAILED = "failed";

  const cardEl = document.getElementById("billing-card");
  const statusBadgeEl = document.getElementById("billing-status-badge");
  const statusTextEl = document.getElementById("billing-status-text");
  const msgEl = document.getElementById("billing-msg");
  const cardStatusEl = document.getElementById("billing-card-status");
  const addBtn = document.getElementById("billing-add");
  const quotaSectionEl = document.getElementById("billing-quota-section");
  const subQuotaEl = document.getElementById("sub-quota");
  const subTilesTitleEl = document.getElementById("sub-tiles-title");
  const subTilesEl = document.getElementById("sub-tiles");
  const subMsgEl = document.getElementById("sub-msg");
  const newsletterToggleEl = document.getElementById("newsletter-toggle");
  const newsletterMsgEl = document.getElementById("newsletter-msg");

  // 312k-P3: die vier festen Kuendigungs-Steuerelemente + Nebenbereiche.
  const cancelBlockEl = document.getElementById("cancel-block");
  const cancelStatusEl = document.getElementById("cancel-status");
  const cancelOpenEl = document.getElementById("cancel-open");
  const cancelConfirmEl = document.getElementById("cancel-confirm");
  const cancelConfirmTextEl = document.getElementById("cancel-confirm-text");
  const cancelConfirmBtnEl = document.getElementById("cancel-confirm-btn");
  const cancelAbortEl = document.getElementById("cancel-abort");
  const resumeBtnEl = document.getElementById("resume-btn");
  const cancelMsgEl = document.getElementById("cancel-msg");

  // Ruhige, farblich abgesetzte Rueckmeldung statt roher Textzeilen (Auftrag): EINE
  // Implementierung fuer alle vier Meldungs-Absaetze dieser Insel (Muster
  // SettingsIsland showMessage). ok=true/false faerbt, ok=null/undefined bleibt
  // neutral (muted) -- z.B. ein selbst abgebrochener Checkout ist kein Fehler.
  const MSG_OK_CLASS = "billing-msg--ok";
  const MSG_ERR_CLASS = "billing-msg--err";
  function showMessage(el, text, ok) {
    el.textContent = text;
    el.classList.toggle(MSG_OK_CLASS, Boolean(text) && ok === true);
    el.classList.toggle(MSG_ERR_CLASS, Boolean(text) && ok === false);
    el.hidden = !text;
  }
  const showBillingMsg = (text, ok) => showMessage(msgEl, text, ok);
  const showSubMsg = (text, ok) => showMessage(subMsgEl, text, ok);
  const showCancelMsg = (text, ok) => showMessage(cancelMsgEl, text, ok);
  const showNewsletterMsg = (text, ok) => showMessage(newsletterMsgEl, text, ok);

  // 1. Status-Zeile: Badge + EIN Satz, was der aktuelle Zustand fuer den Kunden
  // bedeutet (billingStatusKind/-Badge/-Text, lib/subscribe.js -- EINE Quelle, G5).
  function renderStatus(hasCard, sub) {
    const kind = billingStatusKind({ hasCard, sub });
    statusBadgeEl.textContent = billingStatusBadge(kind);
    statusBadgeEl.className = `billing-status-badge billing-status-badge--${billingStatusBadgeClass(kind)}`;
    statusTextEl.textContent = billingStatusText(kind, sub);
  }

  // 2. Zahlungsmittel: Karten-Status + Button-Text (1:1 zum Bestand).
  function renderCardSection(hasCard) {
    cardStatusEl.textContent = hasCard ? "Card on file." : "No card on file yet.";
    addBtn.textContent = hasCard ? "Add a different card" : "Add payment method";
  }

  // 3. Kontingent: quotaLine liefert null ohne aktives Abo -> die ganze Sektion bleibt
  // versteckt (kein leerer "Usage"-Titel ohne Inhalt).
  function renderQuotaSection(quota) {
    const text = quotaLine(quota);
    quotaSectionEl.hidden = !text;
    subQuotaEl.textContent = text || "";
  }

  // 4. Tarifwechsel: Kacheln aus dem Build-Spiegel, NUR ohne aktives Abo (Kopf-
  // Kommentar). Der Umschlag bleibt sichtbar (Trennlinie), Titel/Kacheln togglen.
  function renderPlanTiles(data, sub) {
    const showTiles = !sub.planSlug;
    subTilesTitleEl.hidden = !showTiles;
    subTilesEl.hidden = !showTiles;
    subTilesEl.replaceChildren(...(showTiles ? planTiles(document, numberSetupFeeFrom(data)) : []));
  }

  // 5. Newsletter: die Checkbox spiegelt IMMER den Server-Stand, nie einen lokalen
  // Default (newsletterConsentFrom faellt fail-closed auf false zurueck).
  function renderNewsletter(data) {
    newsletterToggleEl.checked = newsletterConsentFrom(data);
  }

  // 6. 312k-P3: Kuendigungs-Region. NUR mit aktivem Abo sichtbar; cancelAtPeriodEnd
  // -> Zustand + Ruecknahme, sonst die zweistufige Kuendigung (Stufe 1 sichtbar,
  // Stufe 2 erst nach Klick). Der Bestaetigungstext wird bei JEDEM Render neu gesetzt
  // (aktueller Plan/Termin), die Sichtbarkeit der zweiten Stufe bleibt dabei unberuehrt
  // (kein Zuklappen mitten im Bestaetigungs-Dialog durch einen Hintergrund-Re-Render).
  function renderCancelBlock(sub) {
    cancelBlockEl.hidden = !sub.planSlug;
    if (!sub.planSlug) return;
    cancelConfirmTextEl.textContent = cancelConfirmText(sub);
    if (sub.cancelAtPeriodEnd) {
      cancelStatusEl.textContent = cancelStatusLine(sub);
      cancelStatusEl.hidden = false;
      cancelOpenEl.hidden = true;
      cancelConfirmEl.hidden = true;
      resumeBtnEl.hidden = false;
    } else {
      cancelStatusEl.hidden = true;
      resumeBtnEl.hidden = true;
      if (cancelConfirmEl.hidden) cancelOpenEl.hidden = false; // Stufe 2 nicht schon offen
    }
  }

  // Sichtbarkeit + alle sechs Abschnitte aus genau dem state, den die Auth-Insel
  // ermittelt hat. result.present===false (hasCard kein Boolean) -> Block versteckt.
  function renderBilling(data) {
    const { present, hasCard } = cardStatus(data);
    cardEl.hidden = !present;
    if (!present) return;
    const sub = subscriptionFrom(data);
    renderStatus(hasCard, sub);
    renderCardSection(hasCard);
    renderQuotaSection(quotaFrom(data));
    renderPlanTiles(data, sub);
    renderNewsletter(data);
    renderCancelBlock(sub);
  }

  // Fehler -> kurze Meldung wie in der Vorlage (tenant.html addCard): 401 sagt
  // "Session expired" (neu anmelden), alles andere die generische Meldung.
  function checkoutErrorText(err) {
    if (err instanceof ApiError && err.status === HTTP_UNAUTHORIZED)
      return "Session expired - please sign in again.";
    return "Couldn't start checkout.";
  }

  // Checkout starten: POST liefert die Stripe-URL -> Browser dorthin leiten.
  // Doppelklick-Schutz: der Button ist waehrend des Requests deaktiviert.
  addBtn.addEventListener("click", async () => {
    addBtn.disabled = true;
    try {
      const url = await startBillingSetupCheckout();
      window.location.assign(url); // Redirect zur Stripe-Checkout-Seite
    } catch (err) {
      showBillingMsg(checkoutErrorText(err), false);
      addBtn.disabled = false;
    }
  });

  // Re-Fetch nach erfolgreicher Aktion: den State neu laden und per AUTH_EVENT an
  // ALLE Inseln (inkl. dieser) verteilen -> aktiver Plan, ggf. Nummer, ohne Reload.
  async function refreshState() {
    const data = await fetchTenantState();
    document.dispatchEvent(
      new CustomEvent(AUTH_EVENT, { detail: { state: AUTH_STATE.AUTHENTICATED, data } }),
    );
  }

  // EIN delegierter Subscribe-Listener am stabilen Kachel-Container (G5). Die Kacheln
  // werden bei jedem Render ersetzt -> kein Binding pro Button, kein Listener-Leak.
  wireSubscribe(subTilesEl, { onSubscribed: refreshState, onMessage: showSubMsg });

  // 312k-P3: die vier festen Kuendigungs-Steuerelemente. onDone re-fetcht denselben Weg
  // wie onSubscribed (der Webhook bestaetigt den geschriebenen Zustand ohnehin kurz
  // danach noch einmal - der Re-Fetch hier zeigt nur schneller, was der Server bereits
  // gespeichert hat, s. self-service-routes.js setSubscriptionCancellation).
  wireCancelControls(
    {
      openBtn: cancelOpenEl,
      confirmPanel: cancelConfirmEl,
      confirmBtn: cancelConfirmBtnEl,
      abortBtn: cancelAbortEl,
      resumeBtn: resumeBtnEl,
    },
    { onDone: refreshState, onMessage: showCancelMsg },
  );

  // Newsletter-Toggle: schreibt sofort gegen die Route (lib/subscribe.js
  // wireNewsletterToggle) -- kein eigener re-fetch noetig, der Server-Antwortwert
  // (result.newsletterConsent) ist bereits die neue Wahrheit fuer die Checkbox.
  wireNewsletterToggle(newsletterToggleEl, { onMessage: showNewsletterMsg });

  // Rueckkehr von Stripe Checkout: kurze Rueckmeldung. Der echte Status kommt ohnehin
  // aus dem naechsten state-Fetch (AUTH_EVENT). ?card=ok|canceled|error = reiner
  // Karten-Flow; ?sub=ok|failed = Kachel-Flow (BK2). P14: ?card=error ist der Stripe-/
  // Netzwerk-Fehlerpfad des Servers (asyncBilling) - ohne Zweig bliebe genau der
  // Fehlerfall des Geldwegs fuer den Kunden stumm. Query danach entfernen (kein
  // Wiederholen).
  function returnMessageText(card, sub) {
    if (card === RETURN_OK) return "Card saved.";
    if (card === RETURN_CANCELED) return "Cancelled - no card saved.";
    if (card === RETURN_ERROR) return "Something went wrong - no card was saved. Please try again.";
    if (sub === RETURN_OK) return "Subscription booked.";
    if (sub === RETURN_FAILED)
      return "Card saved, but the subscription couldn't be booked. Please try again.";
    return "";
  }

  // SEPARATE Hilfsfunktion fuer die Faerbung (p14-Vertrag bindet NUR den Wortlaut aus
  // returnMessageText, s. test/p14-checkout-return-app-shell.test.js -- diese Funktion
  // aendert NICHTS an ihrer Form). ok=true bei echtem Erfolg, ok=false bei den beiden
  // Fehlerpfaden, null bei "canceled" (der Kunde hat selbst abgebrochen -- weder Erfolg
  // noch Fehler, bleibt neutral/muted).
  function returnMessageTone(card, sub) {
    if (card === RETURN_OK || sub === RETURN_OK) return true;
    if (card === RETURN_ERROR || sub === RETURN_FAILED) return false;
    return null;
  }

  function showReturnMessage() {
    const params = new URLSearchParams(location.search);
    const text = returnMessageText(params.get(RETURN_PARAM_CARD), params.get(RETURN_PARAM_SUB));
    if (!text) return;
    showBillingMsg(text, returnMessageTone(params.get(RETURN_PARAM_CARD), params.get(RETURN_PARAM_SUB)));
    history.replaceState(null, "", location.pathname);
  }

  // Die Auth-Insel ermittelt den Zustand einmal und dispatcht AUTH_EVENT; nur im
  // eingeloggten Zustand traegt die state-Antwort hasCard/subscription. Listener
  // synchron beim Modul-Start registrieren, BEVOR die Auth-Insel dispatcht.
  document.addEventListener(AUTH_EVENT, (event) => {
    const { state, data } = event.detail;
    if (state === AUTH_STATE.AUTHENTICATED) renderBilling(data);
    else cardEl.hidden = true; // anonym/pending/Fehler -> kein Billing-Block
  });

  showReturnMessage();
</script>

<style is:global>
  /* Payment-Neugestaltung (Aug 2026): Struktur-/Optik-Ergaenzungen, die sich ueber die
     bestehenden Tokens/Klassen (app.css) nicht ausdruecken lassen. is:global aus
     derselben Begruendung wie CallsIsland/SettingsIsland: eine Datei, eine CSS-
     Handschrift fuer diese App-Schicht -- die Klassennamen (billing-status*,
     billing-section*, cancel-link, billing-msg--ok/--err) sind eigens fuer diese Insel
     benannt, kein Kollisionsrisiko mit anderen Komponenten. AUSSCHLIESSLICH
     semantische Tokens (Strategie 2.5) -- kein neuer fester Wert. Diese Datei bleibt
     trotzdem eine ECHTE, von Astro ausgelagerte CSS-Datei (CSP 'self', kein Inline-
     Style-Attribut, kein Inline-Script). */

  .billing-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-cozy);
    margin-top: var(--space-stack);
  }

  .billing-status-text {
    margin: 0;
    color: var(--color-text);
  }

  .billing-status-badge {
    flex-shrink: 0;
    padding: var(--space-hairline) var(--space-cozy);
    border-radius: var(--radius-badge);
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    white-space: nowrap;
  }

  /* Ruhige neutrale Farbe fuer die beiden Vorbereitungs-Zustaende (kein Abo/keine
     Karte) -- informativ, nicht alarmierend. */
  .billing-status-badge--pending {
    background: var(--color-status-neutral-surface);
    color: var(--color-status-neutral);
  }

  .billing-status-badge--active {
    background: var(--color-status-positive-surface);
    color: var(--color-status-positive);
  }

  .billing-status-badge--cancelled {
    background: var(--color-status-critical-surface);
    color: var(--color-status-critical);
  }

  /* Ruhige Abschnitts-Unterteilung innerhalb der EINEN Billing-Karte (Reihenfolge
     laut Auftrag: Tarif+Status, Zahlungsmittel, Kontingent, Tarifwechsel, Newsletter,
     Kuendigung). Kein eigener Kartenrahmen je Abschnitt -- eine Trennlinie reicht. */
  .billing-section {
    margin-top: var(--space-stack);
    padding-top: var(--space-stack);
    border-top: var(--border-width) solid var(--color-divider);
  }

  .billing-section__title {
    margin: 0 0 var(--space-tight);
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-muted);
  }

  /* § 312k-P3 (Auftrag): ein ruhiger Text-Link statt eines fetten .btn -- unmittelbar
     sichtbar und erreichbar bleibt er, nur optisch zurueckhaltend (Muster .plan-skip
     aus app.css, hier als eigene Klasse, weil .plan-skip semantisch der Aktivierungs-
     Skip ist). */
  .cancel-link {
    display: inline-block;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .cancel-link:hover {
    color: var(--color-text);
  }

  .cancel-link:focus-visible {
    outline: 2px solid var(--color-accent, var(--color-status-info));
    outline-offset: 2px;
  }

  /* Faerbung der Ruecklauf-/Fehlermeldungen (Muster .settings-msg--ok/--err, app.css) --
     hier lokal, weil .billing-msg (app.css) bisher nur die neutrale Muted-Farbe traegt. */
  .billing-msg--ok {
    color: var(--color-status-positive);
  }

  .billing-msg--err {
    color: var(--color-status-critical);
  }
</style>
