---
// Billing-Insel (W3): NUR Karte hinterlegen -- exakt der heute existierende
// Backend-Umfang. 1:1-Verhalten zu public/tenant.html (renderBilling + addCard):
//   - sichtbar NUR wenn state.hasCard ein Boolean ist (PAYMENT_ENABLED an);
//     sonst versteckt (byte-identisch zum Bestand ohne Payment).
//   - "Zahlungsmethode hinzufuegen" -> POST /api/self-service/billing/setup-checkout
//     (ueber lib/api.js) -> Browser-Redirect zur Stripe-Checkout-URL.
//   - Rueckkehr ueber ?card=ok|canceled -> kurze Rueckmeldung.
//
// BEWUSSTE ABGRENZUNG (CLAUDE.md Regel 6, kein toter Code/404-Pfad): Abo buchen/
// kuendigen/upgraden/downgraden, Plan-/Tier-Wechsel, Rechnungssicht existieren
// API-seitig NICHT (verifiziert: src/billing/ports.js + stripe.js kennen nur
// Karten-Setup + Hold/Capture/Cancel + Metering, keine Stripe-Subscriptions).
// Diese Insel bietet daher AUSSCHLIESSLICH "Karte hinterlegen" an.
//
// Kein eigener state-Fetch: die App-Shell ermittelt den Zustand einmal (Auth-
// Insel) und meldet ihn per AUTH_EVENT -- diese Insel hoert nur darauf mit.
---

<!-- Default versteckt: ohne PAYMENT_ENABLED (hasCard kein Boolean) bleibt der
     Block verborgen, byte-identisch zum Bestand. JS zeigt ihn nur bei present. -->
<section id="billing-card" class="card" hidden>
  <h2>Zahlungsmethode</h2>
  <p class="muted">Fuer kostenpflichtige Funktionen (z.B. eigene Rufnummer).</p>
  <p id="billing-status" class="muted"></p>
  <button id="billing-add" class="btn" type="button">Zahlungsmethode hinzufuegen</button>
  <p id="billing-msg" class="billing-msg" hidden></p>
</section>

<script>
  import {
    ApiError,
    AUTH_STATE,
    AUTH_EVENT,
    HTTP_UNAUTHORIZED,
    cardStatus,
    startBillingSetupCheckout,
  } from "../../lib/api.js";

  // Rueckkehr-Parameter (kein Magic-String an den Vergleichsstellen).
  const RETURN_PARAM = "card";
  const RETURN_OK = "ok";
  const RETURN_CANCELED = "canceled";

  const cardEl = document.getElementById("billing-card");
  const statusEl = document.getElementById("billing-status");
  const addBtn = document.getElementById("billing-add");
  const msgEl = document.getElementById("billing-msg");

  function showMessage(text) {
    msgEl.textContent = text;
    msgEl.hidden = false;
  }

  // Sichtbarkeit + Status aus genau dem state, den die Auth-Insel ermittelt hat.
  // result.present===false (hasCard kein Boolean) -> Block versteckt; sonst
  // Status/Button-Text wie im Bestand (renderBilling in tenant.html).
  function renderBilling(data) {
    const { present, hasCard } = cardStatus(data);
    cardEl.hidden = !present;
    if (!present) return;
    statusEl.textContent = hasCard ? "Karte hinterlegt." : "Noch keine Karte hinterlegt.";
    addBtn.textContent = hasCard ? "Andere Karte hinterlegen" : "Zahlungsmethode hinzufuegen";
  }

  // Fehler -> kurze Meldung wie in der Vorlage (tenant.html addCard): 401 sagt
  // "Sitzung abgelaufen" (der Nutzer soll sich neu anmelden), alles andere die
  // generische Meldung. Fail-closed: nie als Teil-Erfolg deuten.
  function checkoutErrorText(err) {
    if (err instanceof ApiError && err.status === HTTP_UNAUTHORIZED)
      return "Sitzung abgelaufen - bitte neu anmelden.";
    return "Konnte Checkout nicht starten.";
  }

  // Checkout starten: POST liefert die Stripe-URL -> Browser dorthin leiten.
  addBtn.addEventListener("click", async () => {
    addBtn.disabled = true;
    try {
      const url = await startBillingSetupCheckout();
      window.location.assign(url); // Redirect zur Stripe-Checkout-Seite
    } catch (err) {
      showMessage(checkoutErrorText(err));
      addBtn.disabled = false;
    }
  });

  // Rueckkehr von Stripe Checkout: kurze Rueckmeldung. Der echte Karten-Status
  // kommt ohnehin aus dem naechsten state-Fetch (AUTH_EVENT). Query danach
  // entfernen, damit ein Reload die Meldung nicht wiederholt.
  function showReturnMessage() {
    const value = new URLSearchParams(location.search).get(RETURN_PARAM);
    if (value !== RETURN_OK && value !== RETURN_CANCELED) return;
    showMessage(value === RETURN_OK ? "Karte hinterlegt." : "Abgebrochen - keine Karte hinterlegt.");
    history.replaceState(null, "", location.pathname);
  }

  // Die Auth-Insel ermittelt den Zustand einmal und dispatcht AUTH_EVENT; nur im
  // eingeloggten Zustand traegt die state-Antwort hasCard. Listener synchron beim
  // Modul-Start registrieren, BEVOR die Auth-Insel (hinter ihrem fetch) dispatcht.
  document.addEventListener(AUTH_EVENT, (event) => {
    const { state, data } = event.detail;
    if (state === AUTH_STATE.AUTHENTICATED) renderBilling(data);
    else cardEl.hidden = true; // anonym/pending/Fehler -> kein Billing-Block
  });

  showReturnMessage();
</script>
