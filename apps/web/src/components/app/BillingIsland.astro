---
// Billing-Insel (W3 + P2, Dashboard-Design-Spec §10): Karte hinterlegen, Abo
// buchen, Kuendigen/Reaktivieren -- der heute existierende Backend-Umfang, NUR
// neu angeordnet/dargestellt (keine Datenwege/Endpunkte/Payloads geaendert).
// Reihenfolge laut Spec §10 (unveraendert zum vorherigen Stand):
//   1. aktueller Tarif + Status (Serif-Statuswert + Mono-Nebenangabe -- s.
//      billingStatusHeadline/-Detail in lib/subscribe.js, EINE Quelle ueber
//      billingStatusKind/subscriptionLine/cancelStatusLine/billingStatusText.
//      "Fehler" ist keine Karten-/Abo-LAGE, sondern eine fehlgeschlagene AKTION
//      -- s. die farblich abgesetzten Ruecklauf-/Fehlermeldungen weiter unten,
//      showMessage)
//   2. Zahlungsmittel ("Add payment method" -> POST .../setup-checkout -> Stripe-
//      Redirect. Rueckkehr ueber ?card=ok|canceled|error)
//   3. verbrauchtes/verbleibendes Kontingent (nur mit aktivem Abo, quotaFrom) +
//      Minuten-Fortschrittsbalken (quotaUsedPercent, §10)
//   4. Tarifwechsel: die Plan-Kacheln (aus dem Build-Spiegel lib/plans.js), NUR ohne
//      aktives Abo -- eine BESTEHENDE Buchung umzustellen bietet der Server nicht an
//      (kein neuer Endpunkt). Subscribe-Klick -> Zustandsmaschine (lib/subscribe.js):
//      ok -> Tenant aktiv + alle Inseln refreshen; 409 no_card -> gefuehrter Stripe-
//      Checkout MIT Plan; 409 sonst -> "bereits abonniert"; 401 -> Session.
//   5. Kuendigung (312k-P3, § 312k BGB): ruhig ganz unten, ein Text-Link statt eines
//      fetten Knopfs (unmittelbar sichtbar/erreichbar bleibt sie trotzdem).
//
// Newsletter (frueher Punkt 5 in dieser Karte) ist per Dashboard-Design-Spec §11 in
// eine eigene Insel (NewsletterIsland.astro) ausgelagert -- NUR die Darstellung zog
// um, die Einwilligungs-Logik (Route, nie vorangekreuzt, Widerruf, Fehler-Rueckfall)
// lebt unveraendert in lib/subscribe.js (wireNewsletterToggle/newsletterConsentFrom).
//
// Kein eigener state-Fetch im Normalfall: die Auth-Insel ermittelt den Zustand einmal
// und meldet ihn per AUTH_EVENT -- diese Insel hoert mit. Nach jeder erfolgreichen
// Aktion re-fetcht sie den State selbst und re-dispatcht AUTH_EVENT (so gehen ALLE
// Inseln auf den frischen Stand). Anzeige-Strings nur ueber textContent (XSS-Schutz).
// Optik lebt in styles/app/panels.css (Trupp-C-Stylesheet, Muster shell.css/calls.css)
// -- kein inline-Style-Block mehr hier.
import {
  CANCEL_BUTTON_LABEL,
  CONFIRM_CANCEL_BUTTON_LABEL,
  CANCEL_ABORT_LABEL,
  RESUME_BUTTON_LABEL,
} from "../../lib/subscribe.js";
---

<!-- Default versteckt: ohne PAYMENT_ENABLED (hasCard kein Boolean) bleibt der
     Block verborgen, byte-identisch zum Bestand. JS zeigt ihn nur bei present. -->
<section id="billing-card" class="card" hidden>
  <h2 data-i18n="billingTitle">Billing</h2>
  <p class="muted" data-i18n="billingSubtitle">Your plan, payment method and usage for Hermes.</p>

  <!-- 1. aktueller Tarif + Status: Serif-Hauptwert + Mono-Nebenangabe (§10). -->
  <div class="billing-status">
    <span class="billing-status__head">
      <span id="billing-status-badge" class="billing-status-badge"></span>
      <span id="billing-status-value" class="billing-status-value"></span>
    </span>
    <span id="billing-status-detail" class="billing-status-detail"></span>
  </div>
  <p id="billing-msg" class="billing-msg" hidden></p>

  <!-- 2. Zahlungsmittel: Kartensymbol + Text + Ghost-Knopf (§10). -->
  <div class="billing-section">
    <h3 class="billing-section__title" data-i18n="paymentMethod">Payment method</h3>
    <div class="payment-card">
      <svg class="payment-card__icon" viewBox="0 0 24 16" aria-hidden="true" focusable="false">
        <rect x="1" y="1" width="22" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
        <rect x="1" y="4.5" width="22" height="3" fill="currentColor"></rect>
      </svg>
      <p id="billing-card-status" class="payment-card__status muted"></p>
      <button id="billing-add" class="payment-card__action" type="button" data-i18n="addPaymentMethod">Add payment method</button>
    </div>
  </div>

  <!-- 3. Kontingent + Minuten-Balken -- nur mit aktivem Abo vorhanden (quotaFrom
       liefert sonst null). Der Balken selbst bleibt zusaetzlich versteckt, solange
       keine Kontingent-Zeile gerendert wird (§10: "nur rendern, wenn ein Kontingent
       vorliegt"). Die Fuellbreite reist als CSS-Custom-Property (--quota-fill,
       panels.css) statt als style-Attribut -- kein Inline-Style im Markup. -->
  <div id="billing-quota-section" class="billing-section" hidden>
    <h3 class="billing-section__title" data-i18n="usage">Usage</h3>
    <div id="quota-bar" class="quota-bar" hidden>
      <div id="quota-bar-fill" class="quota-bar__fill"></div>
    </div>
    <p id="sub-quota" class="quota-line muted"></p>
  </div>

  <!-- 4. Tarifwechsel: die Plan-Kacheln, NUR ohne aktives Abo (s. Kopf-Kommentar).
       Owner-Befund 15.09.2026: der Abschnitt trug mit aktivem Abo zwar nur versteckte
       Kinder, aber weiterhin seinen eigenen 28px-Abstand -- zusammen mit dem Abstand des
       Kuendigungsblocks darunter war das die grosse Luecke zwischen Zahlungsmittel und
       "Cancel contracts". Der Wrapper bekommt darum eine id und wird mitversteckt
       (Muster von #billing-quota-section direkt darueber). -->
  <div id="billing-plans-section" class="billing-section">
    <h3 id="sub-tiles-title" class="billing-section__title" hidden data-i18n="choosePlan">Choose your plan</h3>
    <div id="sub-tiles" class="plans" hidden></div>
    <p id="sub-msg" class="billing-msg" hidden></p>
  </div>

  <!-- 5. 312k-P3: zweistufiger Kuendigungsweg (§ 312k BGB), ruhig ganz unten. Sichtbar
       NUR mit aktivem Abo (renderCancelBlock blendet den Block sonst aus). Stufe 1:
       ruhiger Text-Link (.cancel-link), kein roter Schreckknopf -- bleibt trotzdem
       unmittelbar sichtbar und erreichbar. Stufe 2: cancel-confirm nennt WAS/WANN
       sowie den Abbruch. Bereits gekuendigt -> cancel-status + Ruecknahme.
       Beschriftungen sprachbewusst (renderCancelBlock): DE-Modus zeigt den
       gesetzlich vorgegebenen deutschen Wortlaut WOERTLICH, EN-Modus die
       eindeutige englische Formulierung (Owner-Entscheidung 2026-08-14,
       s. subscribe.js); das SSR-Markup traegt den deutschen Pflichtwortlaut
       als Default. -->
  <div id="cancel-block" class="billing-section" hidden>
    <p id="cancel-status" class="muted" hidden></p>
    <button id="cancel-open" class="cancel-link" type="button" hidden>{CANCEL_BUTTON_LABEL}</button>
    <div id="cancel-confirm" class="cancel-confirm" hidden>
      <p id="cancel-confirm-text"></p>
      <button id="cancel-confirm-btn" class="btn" type="button">{CONFIRM_CANCEL_BUTTON_LABEL}</button>
      <button id="cancel-abort" class="plan-skip" type="button">{CANCEL_ABORT_LABEL}</button>
    </div>
    <button id="resume-btn" class="btn" type="button" hidden>{RESUME_BUTTON_LABEL}</button>
    <p id="cancel-msg" class="billing-msg" hidden></p>
  </div>

  <p class="billing-footnote" data-i18n="billingFootnote">Payments are processed securely via Stripe.</p>
</section>

<script>
  import {
    ApiError,
    AUTH_STATE,
    AUTH_EVENT,
    HTTP_UNAUTHORIZED,
    cardStatus,
    subscriptionFrom,
    quotaFrom,
    numberSetupFeeFrom,
    fetchTenantState,
    startBillingSetupCheckout,
  } from "../../lib/api.js";
  import { quotaFillPercent } from "../../lib/quota-fill.js";
  import {
    planTiles,
    quotaLine,
    wireSubscribe,
    cancelConfirmText,
    cancelStatusLine,
    wireCancelControls,
    billingStatusKind,
    billingStatusBadge,
    billingStatusBadgeClass,
    billingStatusHeadline,
    billingStatusDetail,
    cancelAbortLabel,
    resumeButtonLabel,
    cancelButtonLabel,
    confirmCancelButtonLabel,
  } from "../../lib/subscribe.js";
  import { t } from "../../lib/i18n.js";

  // Rueckkehr-Parameter (kein Magic-String an den Vergleichsstellen).
  const RETURN_PARAM_CARD = "card";
  const RETURN_PARAM_SUB = "sub";
  const RETURN_OK = "ok";
  const RETURN_CANCELED = "canceled";
  const RETURN_ERROR = "error";
  const RETURN_FAILED = "failed";

  const cardEl = document.getElementById("billing-card");
  const statusBadgeEl = document.getElementById("billing-status-badge");
  const statusValueEl = document.getElementById("billing-status-value");
  const statusDetailEl = document.getElementById("billing-status-detail");
  const msgEl = document.getElementById("billing-msg");
  const cardStatusEl = document.getElementById("billing-card-status");
  const addBtn = document.getElementById("billing-add");
  const quotaSectionEl = document.getElementById("billing-quota-section");
  const quotaBarEl = document.getElementById("quota-bar");
  const quotaBarFillEl = document.getElementById("quota-bar-fill");
  const subQuotaEl = document.getElementById("sub-quota");
  const plansSectionEl = document.getElementById("billing-plans-section");
  const subTilesTitleEl = document.getElementById("sub-tiles-title");
  const subTilesEl = document.getElementById("sub-tiles");
  const subMsgEl = document.getElementById("sub-msg");

  // 312k-P3: die vier festen Kuendigungs-Steuerelemente + Nebenbereiche.
  const cancelBlockEl = document.getElementById("cancel-block");
  const cancelStatusEl = document.getElementById("cancel-status");
  const cancelOpenEl = document.getElementById("cancel-open");
  const cancelConfirmEl = document.getElementById("cancel-confirm");
  const cancelConfirmTextEl = document.getElementById("cancel-confirm-text");
  const cancelConfirmBtnEl = document.getElementById("cancel-confirm-btn");
  const cancelAbortEl = document.getElementById("cancel-abort");
  const resumeBtnEl = document.getElementById("resume-btn");
  const cancelMsgEl = document.getElementById("cancel-msg");

  // Ruhige, farblich abgesetzte Rueckmeldung statt roher Textzeilen: EINE
  // Implementierung fuer alle drei Meldungs-Absaetze dieser Insel (Muster
  // SettingsIsland showMessage). ok=true/false faerbt, ok=null/undefined bleibt
  // neutral (muted) -- z.B. ein selbst abgebrochener Checkout ist kein Fehler.
  const MSG_OK_CLASS = "billing-msg--ok";
  const MSG_ERR_CLASS = "billing-msg--err";
  function showMessage(el, text, ok) {
    el.textContent = text;
    el.classList.toggle(MSG_OK_CLASS, Boolean(text) && ok === true);
    el.classList.toggle(MSG_ERR_CLASS, Boolean(text) && ok === false);
    el.hidden = !text;
  }
  const showBillingMsg = (text, ok) => showMessage(msgEl, text, ok);
  // Die Tarif-Meldung sitzt IM Tarif-Umschlag, und der ist mit aktivem Abo versteckt
  // (s. renderPlanTiles): eine Meldung holt ihn darum sichtbar zurueck.
  const showSubMsg = (text, ok) => {
    showMessage(subMsgEl, text, ok);
    if (text) plansSectionEl.hidden = false;
  };
  const showCancelMsg = (text, ok) => showMessage(cancelMsgEl, text, ok);

  // 1. Status-Zeile: Badge + Serif-Hauptwert + Mono-Nebenangabe (billingStatusKind/
  // -Badge/-Headline/-Detail, lib/subscribe.js -- EINE Quelle, G5).
  function renderStatus(hasCard, sub) {
    const kind = billingStatusKind({ hasCard, sub });
    const badge = billingStatusBadge(kind);
    const headline = billingStatusHeadline(kind, sub);
    statusBadgeEl.textContent = badge;
    statusBadgeEl.className = `billing-status-badge billing-status-badge--${billingStatusBadgeClass(kind)}`;
    // Ohne Tarif faellt billingStatusHeadline auf den Badge-Text zurueck (subscribe.js).
    // Beides nebeneinander waere dieselbe Aussage zweimal -- dann traegt der Badge den
    // Zustand allein und der Serif-Hauptwert bleibt leer (kein zweiter Wortlaut, G5).
    const duplicate = headline === badge;
    statusBadgeEl.hidden = !badge;
    statusValueEl.textContent = duplicate ? "" : headline;
    statusValueEl.hidden = duplicate;
    statusDetailEl.textContent = billingStatusDetail(kind, sub);
  }

  // 2. Zahlungsmittel: Karten-Status + Button-Text (1:1 zum Bestand).
  function renderCardSection(hasCard) {
    cardStatusEl.textContent = hasCard ? t("cardOnFile") : t("noCardOnFile");
    addBtn.textContent = hasCard ? t("addDifferentCard") : t("addPaymentMethod");
  }

  // 3. Kontingent: quotaLine liefert null ohne aktives Abo -> die ganze Sektion UND
  // der Balken bleiben versteckt (kein leerer "Usage"-Titel ohne Inhalt, §10). Die
  // Fuellbreite reist als CSS-Custom-Property (kein style-Attribut im Markup).
  function renderQuotaSection(quota) {
    const text = quotaLine(quota);
    quotaSectionEl.hidden = !text;
    subQuotaEl.textContent = text || "";
    quotaBarEl.hidden = !quota;
    if (quota) quotaBarFillEl.style.setProperty("--quota-fill", `${quotaFillPercent(quota)}%`);
  }

  // 4. Tarifwechsel: Kacheln aus dem Build-Spiegel, NUR ohne aktives Abo (Kopf-
  // Kommentar). Owner-Befund 15.09.2026: der Umschlag blieb sichtbar und trug mit
  // aktivem Abo einen leeren 28px-Abstand mitten in die Karte -- er wird jetzt
  // mitversteckt (wie #billing-quota-section). Eine Meldung in #sub-msg haelt ihn
  // sichtbar, sonst verschwaende sie mit dem Umschlag.
  function renderPlanTiles(data, sub) {
    const showTiles = !sub.planSlug;
    plansSectionEl.hidden = !showTiles && subMsgEl.hidden;
    subTilesTitleEl.hidden = !showTiles;
    subTilesEl.hidden = !showTiles;
    subTilesEl.replaceChildren(...(showTiles ? planTiles(document, numberSetupFeeFrom(data)) : []));
  }

  // 5. 312k-P3: Kuendigungs-Region. NUR mit aktivem Abo sichtbar; cancelAtPeriodEnd
  // -> Zustand + Ruecknahme, sonst die zweistufige Kuendigung (Stufe 1 sichtbar,
  // Stufe 2 erst nach Klick). Der Bestaetigungstext wird bei JEDEM Render neu gesetzt
  // (aktueller Plan/Termin), die Sichtbarkeit der zweiten Stufe bleibt dabei unberuehrt
  // (kein Zuklappen mitten im Bestaetigungs-Dialog durch einen Hintergrund-Re-Render).
  function renderCancelBlock(sub) {
    // Die Kuendigungs-Beschriftungen sind serverseitig aus subscribe.js in die
    // Karte gerendert (Astro-Frontmatter, ohne Sprachkontext); renderCancelBlock
    // laeuft bei jedem AUTH_EVENT (inkl. des vom Sprachumschalter re-dispatchten)
    // und bringt alle auf die aktuelle Sprache. cancelButtonLabel()/
    // confirmCancelButtonLabel() liefern im DE-Modus den gesetzlich vorgegebenen
    // Wortlaut woertlich, im EN-Modus die eindeutige englische Formulierung
    // (Owner-Entscheidung 2026-08-14, s. subscribe.js).
    cancelOpenEl.textContent = cancelButtonLabel();
    cancelConfirmBtnEl.textContent = confirmCancelButtonLabel();
    cancelAbortEl.textContent = cancelAbortLabel();
    resumeBtnEl.textContent = resumeButtonLabel();
    cancelBlockEl.hidden = !sub.planSlug;
    if (!sub.planSlug) return;
    cancelConfirmTextEl.textContent = cancelConfirmText(sub);
    if (sub.cancelAtPeriodEnd) {
      cancelStatusEl.textContent = cancelStatusLine(sub);
      cancelStatusEl.hidden = false;
      cancelOpenEl.hidden = true;
      cancelConfirmEl.hidden = true;
      resumeBtnEl.hidden = false;
    } else {
      cancelStatusEl.hidden = true;
      resumeBtnEl.hidden = true;
      if (cancelConfirmEl.hidden) cancelOpenEl.hidden = false; // Stufe 2 nicht schon offen
    }
  }

  // Sichtbarkeit + alle fuenf Abschnitte aus genau dem state, den die Auth-Insel
  // ermittelt hat. result.present===false (hasCard kein Boolean) -> Block versteckt.
  function renderBilling(data) {
    const { present, hasCard } = cardStatus(data);
    cardEl.hidden = !present;
    if (!present) return;
    const sub = subscriptionFrom(data);
    renderStatus(hasCard, sub);
    renderCardSection(hasCard);
    renderQuotaSection(quotaFrom(data));
    renderPlanTiles(data, sub);
    renderCancelBlock(sub);
  }

  // Fehler -> kurze Meldung wie in der Vorlage (tenant.html addCard): 401 sagt
  // "Session expired" (neu anmelden), alles andere die generische Meldung.
  function checkoutErrorText(err) {
    if (err instanceof ApiError && err.status === HTTP_UNAUTHORIZED) return t("billingSessionExpired");
    return t("checkoutError");
  }

  // Checkout starten: POST liefert die Stripe-URL -> Browser dorthin leiten.
  // Doppelklick-Schutz: der Button ist waehrend des Requests deaktiviert.
  addBtn.addEventListener("click", async () => {
    addBtn.disabled = true;
    try {
      const url = await startBillingSetupCheckout();
      window.location.assign(url); // Redirect zur Stripe-Checkout-Seite
    } catch (err) {
      showBillingMsg(checkoutErrorText(err), false);
      addBtn.disabled = false;
    }
  });

  // Zurueck-Knopf aus dem Stripe-Checkout (18.09.2026): im Erfolgsfall bleibt der Knopf
  // gesperrt, weil die Seite verlassen wird. Aus dem bfcache wiederhergestellt, liefe
  // kein Skript neu -- ohne diese Zeile waere "Add a different card" danach tot.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) addBtn.disabled = false;
  });

  // Re-Fetch nach erfolgreicher Aktion: den State neu laden und per AUTH_EVENT an
  // ALLE Inseln (inkl. dieser) verteilen -> aktiver Plan, ggf. Nummer, ohne Reload.
  async function refreshState() {
    const data = await fetchTenantState();
    document.dispatchEvent(
      new CustomEvent(AUTH_EVENT, { detail: { state: AUTH_STATE.AUTHENTICATED, data } }),
    );
  }

  // EIN delegierter Subscribe-Listener am stabilen Kachel-Container (G5). Die Kacheln
  // werden bei jedem Render ersetzt -> kein Binding pro Button, kein Listener-Leak.
  // Kein onSubscribed mehr: der Klick verlaesst die Seite Richtung Stripe-Checkout
  // (auch MIT Karte-on-file) - es gibt im Klick-Pfad keine Buchung, die ein Re-Fetch
  // zeigen koennte. Die Rueckkehr laedt die Seite ohnehin neu und meldet ?sub=ok.
  wireSubscribe(subTilesEl, { onMessage: showSubMsg });

  // 312k-P3: die vier festen Kuendigungs-Steuerelemente. onDone re-fetcht denselben Weg
  // wie onSubscribed (der Webhook bestaetigt den geschriebenen Zustand ohnehin kurz
  // danach noch einmal - der Re-Fetch hier zeigt nur schneller, was der Server bereits
  // gespeichert hat, s. self-service-routes.js setSubscriptionCancellation).
  wireCancelControls(
    {
      openBtn: cancelOpenEl,
      confirmPanel: cancelConfirmEl,
      confirmBtn: cancelConfirmBtnEl,
      abortBtn: cancelAbortEl,
      resumeBtn: resumeBtnEl,
    },
    { onDone: refreshState, onMessage: showCancelMsg },
  );

  // Rueckkehr von Stripe Checkout: kurze Rueckmeldung. Der echte Status kommt ohnehin
  // aus dem naechsten state-Fetch (AUTH_EVENT). ?card=ok|canceled|error = reiner
  // Karten-Flow; ?sub=ok|failed = Kachel-Flow (BK2). P14: ?card=error ist der Stripe-/
  // Netzwerk-Fehlerpfad des Servers (asyncBilling) - ohne Zweig bliebe genau der
  // Fehlerfall des Geldwegs fuer den Kunden stumm. Query danach entfernen (kein
  // Wiederholen).
  function returnMessageText(card, sub) {
    if (card === RETURN_OK) return t("cardSaved");
    if (card === RETURN_CANCELED) return t("cardCancelled");
    if (card === RETURN_ERROR) return t("cardError");
    if (sub === RETURN_OK) return t("subBooked");
    if (sub === RETURN_FAILED) return t("subFailed");
    return "";
  }

  // SEPARATE Hilfsfunktion fuer die Faerbung (p14-Vertrag bindet NUR den Wortlaut aus
  // returnMessageText, s. test/p14-checkout-return-app-shell.test.js -- diese Funktion
  // aendert NICHTS an ihrer Form). ok=true bei echtem Erfolg, ok=false bei den beiden
  // Fehlerpfaden, null bei "canceled" (der Kunde hat selbst abgebrochen -- weder Erfolg
  // noch Fehler, bleibt neutral/muted).
  function returnMessageTone(card, sub) {
    if (card === RETURN_OK || sub === RETURN_OK) return true;
    if (card === RETURN_ERROR || sub === RETURN_FAILED) return false;
    return null;
  }

  function showReturnMessage() {
    const params = new URLSearchParams(location.search);
    const text = returnMessageText(params.get(RETURN_PARAM_CARD), params.get(RETURN_PARAM_SUB));
    if (!text) return;
    showBillingMsg(text, returnMessageTone(params.get(RETURN_PARAM_CARD), params.get(RETURN_PARAM_SUB)));
    history.replaceState(null, "", location.pathname);
  }

  // Die Auth-Insel ermittelt den Zustand einmal und dispatcht AUTH_EVENT; nur im
  // eingeloggten Zustand traegt die state-Antwort hasCard/subscription. Listener
  // synchron beim Modul-Start registrieren, BEVOR die Auth-Insel dispatcht.
  document.addEventListener(AUTH_EVENT, (event) => {
    const { state, data } = event.detail;
    if (state === AUTH_STATE.AUTHENTICATED) renderBilling(data);
    else cardEl.hidden = true; // anonym/pending/Fehler -> kein Billing-Block
  });

  showReturnMessage();
</script>
