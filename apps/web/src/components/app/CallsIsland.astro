---
// CallsIsland (Dashboard-Design-Spec §7+§8): read-only Anrufliste aus der
// state-Antwort. Pro Call: Richtung (Pfeil-Kreis), Gegenstelle, Mono-Meta
// (Zeit · Dauer) und die einzeilige Zusammenfassung, rechts eine Status-Pille.
// Die ganze Zeile ist ein <button> -- ein Klick oeffnet das EINE, statisch
// hier vorhandene Detail-Fenster (Modal) mit Transkript + Zusammenfassung
// (Daten sind schon im state -- kein neuer Endpunkt, views.js publicCall
// strippt sie nicht).
//
// KEIN eigener state-Fetch (AUTH_EVENT). READ-ONLY: kein POST/PUT/DELETE.
// Stale-Daten-Schutz: bei jedem Nicht-authenticated-Zustand wird die Liste
// geleert. Der DOM-Bau (inkl. textContent-only XSS-Schutz) lebt getestet in
// lib/render.js -- diese Insel verdrahtet nur DOM-Container, AUTH_EVENT und
// die Modal-Interaktion (Oeffnen/Schliessen/Fokus-Falle) -- Letzteres ist
// reine Browser-Interaktion (Fokus, Tastatur) und bewusst NICHT in render.js
// (dort lebt nur, was ohne echtes DOM testbar ist, s. render.test.js).
---

<section class="card">
  <div class="calls-head">
    <h2 data-i18n="callsTitle">Calls</h2>
    <!-- Owner-Wunsch 16.09.2026: die Karte zeigt nur noch die letzten drei Anrufe; an der
         Stelle des Hinweises steht dann der Aufklapper. Beides teilt sich denselben Platz,
         weil immer nur eines davon etwas zu sagen hat: bei hoechstens drei Anrufen gibt es
         nichts aufzuklappen (dann bleibt der Hinweis, dass eine Zeile das Gespraech
         oeffnet), ab vier Anrufen ist der Aufklapper die wichtigere Auskunft. -->
    <span id="calls-hint" class="calls-head__hint" data-i18n="viewDetails">View details</span>
    <button
      id="calls-toggle"
      class="calls-head__toggle"
      type="button"
      aria-controls="calls-list"
      aria-expanded="false"
      hidden
    ></button>
  </div>
  <ul id="calls-list" class="data-list calls-list" aria-live="polite"></ul>
</section>

<div id="call-modal" class="call-modal" aria-hidden="true">
  <div class="call-modal__backdrop" data-call-modal-close></div>
  <div
    id="call-modal-card"
    class="call-modal__card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="call-modal-name"
  >
    <div class="call-modal__head">
      <span id="call-modal-direction" class="direction-pill"></span>
      <button
        type="button"
        id="call-modal-close"
        class="call-modal__close"
        aria-label="Close"
        data-i18n-attr="aria-label:modalClose"
        data-call-modal-close
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M3 3 L13 13 M13 3 L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <div id="call-modal-contact" class="call-modal__contact"></div>
    <div id="call-modal-summary" class="call-modal__summary" hidden></div>
    <div class="call-modal__transcript">
      <span class="call-modal__transcript-label" data-i18n="transcript">Transcript</span>
      <div id="call-modal-transcript-body"></div>
    </div>
  </div>
</div>

<script>
  import { bindList, callRows, fillCallModal } from "../../lib/render.js";
  // Fuer den Aufklapper unten: AUTH_EVENT ist dasselbe Ereignis, auf das bindList
  // hoert (ein state-Fetch, s.u.); t() liefert die Beschriftung in der gewaehlten
  // Sprache -- sie wechselt zur Laufzeit und kann darum nicht als data-i18n im
  // Markup stehen.
  import { AUTH_EVENT } from "../../lib/api.js";
  import { t } from "../../lib/i18n.js";

  const modalEl = document.getElementById("call-modal");
  const modalCardEl = document.getElementById("call-modal-card");
  const closeBtn = document.getElementById("call-modal-close");
  const modalTargets = {
    directionEl: document.getElementById("call-modal-direction"),
    contactEl: document.getElementById("call-modal-contact"),
    summaryEl: document.getElementById("call-modal-summary"),
    transcriptEl: document.getElementById("call-modal-transcript-body"),
  };

  const MODAL_OPEN_CLASS = "is-open";
  // Fokussierbare Elemente innerhalb der Karte fuer die Tab-Falle (Spec §8).
  const FOCUSABLE_SELECTOR = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

  // Fokus-Rueckkehrpunkt: die Zeile, die das Fenster geoeffnet hat.
  let triggerEl = null;

  function focusableNodes() {
    return [...modalCardEl.querySelectorAll(FOCUSABLE_SELECTOR)];
  }

  // Tab innerhalb der Karte einsperren: am jeweils letzten/ersten Element
  // springt der Fokus zurueck zum anderen Ende, statt die Karte zu verlassen.
  function trapFocus(event) {
    const nodes = focusableNodes();
    if (!nodes.length) return;
    const first = nodes[0];
    const last = nodes[nodes.length - 1];
    const forward = !event.shiftKey;
    const atEdge = forward ? document.activeElement === last : document.activeElement === first;
    if (!atEdge) return;
    event.preventDefault();
    (forward ? first : last).focus();
  }

  function onModalKeydown(event) {
    if (event.key === "Escape") {
      closeModal();
      return;
    }
    if (event.key === "Tab") trapFocus(event);
  }

  function openModal(call, rowButton) {
    fillCallModal(document, modalTargets, call);
    triggerEl = rowButton;
    modalEl.classList.add(MODAL_OPEN_CLASS);
    modalEl.setAttribute("aria-hidden", "false");
    document.addEventListener("keydown", onModalKeydown);
    // Fokus beim Oeffnen auf das Schliessen-Kreuz (Spec §8).
    closeBtn.focus();
  }

  function closeModal() {
    modalEl.classList.remove(MODAL_OPEN_CLASS);
    modalEl.setAttribute("aria-hidden", "true");
    document.removeEventListener("keydown", onModalKeydown);
    if (triggerEl) triggerEl.focus();
    triggerEl = null;
  }

  // Backdrop-Klick UND Kreuz-Klick tragen beide data-call-modal-close --
  // ein delegierter Listener statt zwei identischer. closest() faengt Klicks
  // auf das SVG/den Pfad im Kreuz ab (deren event.target ist NICHT der
  // <button> selbst).
  modalEl.addEventListener("click", (event) => {
    if (event.target.closest("[data-call-modal-close]")) closeModal();
  });

  // bindList hoert auf AUTH_EVENT, rendert read-only und leert die Liste bei
  // Auth-Verlust (kein stale Tenant-Datenleck) -- gemeinsame Verdrahtung (G5).
  // Ein Klick auf eine Zeile oeffnet das eine Detail-Fenster (openModal).
  bindList(document, "calls-list", (doc, data) => callRows(doc, data, openModal));

  // ---- Aufklappen der Anrufliste (Owner-Wunsch 16.09.2026) -------------------
  // "Wenn man ganz viele Calls hat, sieht man die ganzen Calls" -- die Karte wuchs
  // unbegrenzt mit der Liste und schob alles darunter nach unten. Zugeklappt stehen
  // darum nur noch die drei juengsten Anrufe da; aufgeklappt sind sechs zu sehen und
  // der Rest kommt per Scrollen INNERHALB der Liste, ohne sichtbare Scrollleiste
  // (Owner: "ohne dass man rechts diesen Scroll-Button sieht").
  //
  // Die Liste selbst wird weiterhin KOMPLETT gerendert (bindList/callRows bleiben
  // unangetastet) -- hier wird nur ein- und ausgeblendet. Damit bleibt der DOM-Bau
  // an der einen getesteten Stelle in render.js, und der Zustand ueberlebt jedes
  // Neu-Rendern: dieser Listener haengt NACH dem von bindList am selben Ereignis
  // und laeuft darum immer auf der frisch gebauten Liste.
  const COLLAPSED_ROWS = 3;
  const OPEN_ROWS = 6;
  const SCROLL_CLASS = "is-scroll";
  const AT_END_CLASS = "is-at-end";
  const SCROLL_END_TOLERANCE = 1;

  const listEl = document.getElementById("calls-list");
  const hintEl = document.getElementById("calls-hint");
  const toggleEl = document.getElementById("calls-toggle");
  let callsExpanded = false;

  // Nur echte Anrufzeilen zaehlen -- die Leermeldung ist ein <li class="data-empty">.
  function callRowNodes() {
    return [...listEl.children].filter((node) => node.classList.contains("call-row"));
  }

  // Der weiche Rand am unteren Ende sagt, dass da noch etwas kommt (die Leiste ist ja
  // ausgeblendet). Am Ende der Liste hat er nichts mehr anzukuendigen und faellt weg,
  // sonst saehe die letzte Zeile dauerhaft ausgeblichen aus.
  function updateScrollFade() {
    if (!listEl.classList.contains(SCROLL_CLASS)) return;
    const atEnd = listEl.scrollTop + listEl.clientHeight >= listEl.scrollHeight - SCROLL_END_TOLERANCE;
    listEl.classList.toggle(AT_END_CLASS, atEnd);
  }

  function applyCallsCollapse() {
    const rows = callRowNodes();
    const hasMore = rows.length > COLLAPSED_ROWS;
    if (!hasMore) callsExpanded = false;
    toggleEl.hidden = !hasMore;
    hintEl.hidden = hasMore;
    toggleEl.textContent = callsExpanded ? t("showLess") : t("showMore");
    toggleEl.setAttribute("aria-expanded", String(callsExpanded));
    for (const [index, row] of rows.entries()) {
      row.hidden = !callsExpanded && index >= COLLAPSED_ROWS;
      // Die unterste SICHTBARE Zeile traegt keine Trennlinie -- sonst haengt zugeklappt
      // ein Strich unter der dritten Zeile, unter dem nichts mehr kommt. Die Regel dafuer
      // ist sonst :last-child, und das ist im zugeklappten Zustand die falsche Zeile.
      // Per Klasse statt :has() (im Projekt nicht verwendet).
      row.classList.toggle("is-collapse-edge", !callsExpanded && index === COLLAPSED_ROWS - 1);
    }
    const scrolls = callsExpanded && rows.length > OPEN_ROWS;
    listEl.classList.toggle(SCROLL_CLASS, scrolls);
    if (scrolls) {
      // Geschnitten wird exakt an der Oberkante der siebten Zeile, gemessen von der
      // ersten -- eine feste Pixelhoehe waere falsch, weil eine Zeile mit langer
      // Zusammenfassung zweizeilig wird. Gemessen wird erst, nachdem die Zeilen oben
      // sichtbar geschaltet sind (der Lesezugriff erzwingt den Umbruch).
      const cut = rows[OPEN_ROWS].offsetTop - rows[0].offsetTop;
      listEl.style.setProperty("--calls-max", `${Math.round(cut)}px`);
    } else {
      listEl.style.removeProperty("--calls-max");
      listEl.classList.remove(AT_END_CLASS);
    }
    updateScrollFade();
  }

  toggleEl.addEventListener("click", () => {
    callsExpanded = !callsExpanded;
    if (!callsExpanded) listEl.scrollTop = 0;
    applyCallsCollapse();
  });

  listEl.addEventListener("scroll", updateScrollFade, { passive: true });

  // Nach jedem Render (auch nach einem Sprachwechsel -- der re-dispatcht denselben
  // AUTH_EVENT) den Zustand neu anlegen; die Beschriftung des Knopfes kommt dabei
  // frisch aus dem Woerterbuch.
  document.addEventListener(AUTH_EVENT, applyCallsCollapse);
</script>
