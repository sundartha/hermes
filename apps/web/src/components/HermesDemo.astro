---
// Erklär-Animation, Neubau 2026-08-14 ("Session-Stream" statt Folien).
//
// Konzept: EIN durchgehendes Agent-Session-Fenster erzählt die Geschichte
// chronologisch aus Nutzersicht — wie ein Screen-Recording: Setup-Events
// (Nummer aktiv, MCP verbunden) → der Auftrag an die eigene KI im Chat →
// der Tool-Call (prepare_call, Bestätigung in der Hermes-Karte) → der echte
// Anruf mit Live-Transkript → das Ergebnis zurück im Chat. Drei Szenen im
// SELBEN Fenster (der Fensterkopf bleibt stehen, nur der Inhalt zieht weiter)
// statt sechs getrennter Folien. Die Werkzeugliste (ev2v) nennt nur Werkzeuge,
// die der MCP-Server heute anbietet; einen Kalender hat Hermes nicht mehr.
//
// Technik unverändert zum Vorgänger (bewährt + CSP-konform): die Zeit läuft
// rein über CSS-Keyframes einer 76s-Schleife; hermes-demo.js setzt nur Pause,
// Scrub und Kopieren per CSSOM (LOOP=76 dort muss zur animation-duration hier
// passen). Inline-Styles wären unter der Produktions-CSP (default-src 'self')
// blockiert — darum trägt jedes Element seine Klasse aus hermes-demo.css.
//
// Sprache: die Komponente rendert serverseitig in der Sprache ihrer Seite.
// Die Startseite ist seit dem Default-Wechsel 2026-09-10 englisch und bindet
// sie als <HermesDemo lang="en" /> ein; /so-funktionierts bleibt deutsch und
// nutzt den Default. Der EN/DE-Umschalter der Startseite (hermes-scroll.js
// applyLang) tauscht zur Laufzeit das innerHTML aller [data-i18n]-Elemente —
// die DE-Texte der Demo leben darum ZUSÄTZLICH im DE-Wörterbuch von
// hermes-scroll.js (Präfix "hd..."). Sprachneutrale Werte (Rufnummer,
// Werkzeugliste, "Live", "Hermes") tragen bewusst KEINEN Key.
//
// Füllt seinen Elternrahmen (.demo-frame auf der Startseite, .sheet__demo im
// Blatt). Die Maße hängen am Container, nicht am Fenster.
import "../styles/hermes-demo.css";

const { lang = "de" } = Astro.props;

const DEMO = {
  de: {
    winTitle: "deine-ki — Hermes-Session",
    scene1: "01 · Verbinden & beauftragen",
    scene2: "02 · Hermes telefoniert",
    scene3: "03 · Das Ergebnis",
    ev1k: "Hermes-Nummer aktiv", ev1v: "+49 176 44 12 908",
    ev2k: "Als MCP-Connector verbunden", ev2v: "prepare_call · place_call · list_calls · get_call_result",
    youLabel: "Du, an deine KI",
    aiLabel: "Deine KI",
    userMsg: "Kannst du mir für diese Woche einen Kontrolltermin bei Dr. Behrens machen?",
    aiMsg1: "Klar — bestätige den Anruf in der Hermes-Karte, dann ruft Hermes die Praxis an.",
    toolName: "prepare_call",
    toolArg: "Praxis Dr. Behrens",
    callLabel: "Ausgehender Anruf",
    callee: "Praxis Dr. Behrens",
    speakerHermes: "Hermes",
    speakerThem: "Praxis",
    l1: "Hallo, ich bin der KI-Assistent von Jonas. Ich würde gern einen Termin für ihn vereinbaren.",
    l2: "Gerne, worum geht es denn?",
    l3: "Um eine Kontrolluntersuchung. Ginge es am Donnerstag, dem 14. August?",
    l4: "Donnerstag wäre frei.",
    l5: "Das passt gut, den nehmen wir. Auf den Namen Kroh.",
    hangup: "Anruf beendet · 0:47",
    aiMsg2: "Erledigt! Donnerstag, 14. Aug. um 11:30 bei Dr. Behrens ist gebucht.",
    r1k: "Termin", r1v: "Donnerstag, 14. Aug. · 11:30 · Praxis Dr. Behrens",
    r2v: "Zusammenfassung & Transkript liegen in deinem Dashboard",
    live: "Live",
    pauseLabel: "Pause / Weiter", scrub: "Zum Springen klicken oder ziehen",
    step1: "Auftrag geben", step2: "Hermes telefoniert", step3: "Ergebnis",
  },
  en: {
    winTitle: "your-ai — Hermes session",
    scene1: "01 · Connect & instruct",
    scene2: "02 · Hermes makes the call",
    scene3: "03 · The result",
    ev1k: "Hermes number active", ev1v: "+49 176 44 12 908",
    ev2k: "Connected as an MCP connector", ev2v: "prepare_call · place_call · list_calls · get_call_result",
    youLabel: "You, to your AI",
    aiLabel: "Your AI",
    userMsg: "Can you get me a check-up appointment with Dr. Behrens this week?",
    aiMsg1: "Sure — confirm the call in the Hermes card, then Hermes rings the practice.",
    toolName: "prepare_call",
    toolArg: "Dr. Behrens' practice",
    callLabel: "Outgoing call",
    callee: "Dr. Behrens' practice",
    speakerHermes: "Hermes",
    speakerThem: "Practice",
    l1: "Hi, I'm the AI assistant for Jonas. I'd like to book an appointment for him.",
    l2: "Sure, what is it about?",
    l3: "A check-up. Would Thursday, August 14th work?",
    l4: "Thursday would be free.",
    l5: "That works well, let's take it. Under the name Kroh.",
    hangup: "Call ended · 0:47",
    aiMsg2: "Done! Thursday, Aug 14 at 11:30 am with Dr. Behrens is booked.",
    r1k: "Appointment", r1v: "Thursday, Aug 14 · 11:30 am · Dr. Behrens' practice",
    r2v: "Summary & transcript are waiting in your dashboard",
    live: "Live",
    pauseLabel: "Pause / play", scrub: "Click or drag to jump",
    step1: "Give the task", step2: "Hermes calls", step3: "The result",
  },
};

const d = DEMO[lang === "en" ? "en" : "de"];

// Wer spricht im Transkript: Hermes rechts (hell), die Gegenseite links.
// i18n: Sprecher "Hermes" ist in beiden Sprachen identisch (kein Key);
// "Praxis"/"Practice" und jede Zeile tragen einen data-i18n-Key (s.u.).
const transcript = [
  { text: d.l1, who: "hermes", label: d.speakerHermes, cls: "hd-l1", key: "hdL1", labelKey: undefined },
  { text: d.l2, who: "them", label: d.speakerThem, cls: "hd-l2", key: "hdL2", labelKey: "hdSpeakerThem" },
  { text: d.l3, who: "hermes", label: d.speakerHermes, cls: "hd-l3", key: "hdL3", labelKey: undefined },
  { text: d.l4, who: "them", label: d.speakerThem, cls: "hd-l4", key: "hdL4", labelKey: "hdSpeakerThem" },
  { text: d.l5, who: "hermes", label: d.speakerHermes, cls: "hd-l5", key: "hdL5", labelKey: undefined },
];

// Die Marken sitzen auf den Szenenwechseln der 76s-Schleife (s. hdScene*-
// Keyframes in hermes-demo.css). hermes-demo.js setzt tick.style.left daraus.
const ticks = ["27.2%", "75.3%"];
---

<span class="hd-mount">
  <div class="hd-stage" data-hd-stage data-paused="0">
    <span class="hd-glow hd-glow--a" aria-hidden="true"></span>
    <span class="hd-glow hd-glow--b" aria-hidden="true"></span>

    <!-- Das eine Session-Fenster: Kopf bleibt stehen, die Szenen ziehen
         darunter durch. -->
    <div class="hd-window">
      <div class="hd-winhead">
        <span class="hd-windot" aria-hidden="true"></span>
        <span class="hd-windot" aria-hidden="true"></span>
        <span class="hd-windot" aria-hidden="true"></span>
        <span class="hd-wintitle" data-i18n="hdWinTitle">{d.winTitle}</span>
        <!-- Szenen-Titel überblenden an derselben Stelle (rechts im Kopf). -->
        <span class="hd-scenetag">
          <span class="hd-scenetag__item hd-sc1" data-i18n="hdScene1">{d.scene1}</span>
          <span class="hd-scenetag__item hd-sc2" data-i18n="hdScene2">{d.scene2}</span>
          <span class="hd-scenetag__item hd-sc3" data-i18n="hdScene3">{d.scene3}</span>
        </span>
      </div>

      <div class="hd-body">
        <!-- ---------------------------- Szene 1: Verbinden & beauftragen -->
        <div class="hd-scene hd-scene--1">
          <span class="hd-event hd-anim hd-e1">
            <span class="hd-event__check" aria-hidden="true">✓</span>
            <span class="hd-event__text">
              <span class="hd-event__key" data-i18n="hdEv1k">{d.ev1k}</span>
              <span class="hd-event__value">{d.ev1v}</span>
            </span>
            <span class="hd-event__dot" aria-hidden="true"></span>
          </span>
          <span class="hd-event hd-anim hd-e2">
            <span class="hd-event__check" aria-hidden="true">✓</span>
            <span class="hd-event__text">
              <span class="hd-event__key" data-i18n="hdEv2k">{d.ev2k}</span>
              <span class="hd-event__value hd-event__value--mono">{d.ev2v}</span>
            </span>
          </span>
          <span class="hd-msg hd-msg--you hd-anim hd-u1">
            <span class="hd-msg__label" data-i18n="hdYouLabel">{d.youLabel}</span>
            <span class="hd-msg__bubble" data-i18n="hdUserMsg">{d.userMsg}</span>
          </span>
          <span class="hd-msg hd-msg--ai hd-anim hd-a1">
            <span class="hd-msg__label" data-i18n="hdAiLabel">{d.aiLabel}</span>
            <span class="hd-msg__bubble" data-i18n="hdAiMsg1">{d.aiMsg1}</span>
          </span>
          <span class="hd-toolcall hd-anim hd-tc1">
            <span class="hd-toolcall__spark" aria-hidden="true"></span>
            <span class="hd-mono" data-i18n="hdToolcall"><span class="hd-toolcall__fn">{d.toolName}</span>(&quot;{d.toolArg}&quot;)</span>
          </span>
        </div>

        <!-- ------------------------------- Szene 2: der Anruf, live ------ -->
        <div class="hd-scene hd-scene--2">
          <span class="hd-callcard hd-anim hd-cc">
            <span class="hd-avatar hd-avatar--ringing" aria-hidden="true"><span class="hd-avatar__glyph"></span></span>
            <span class="hd-callcard__text">
              <span class="hd-callcard__label" data-i18n="hdCallLabel">{d.callLabel}</span>
              <span class="hd-callcard__callee" data-i18n="hdCallee">{d.callee}</span>
            </span>
            <span class="hd-callcard__live">
              <span class="hd-livedot" aria-hidden="true"></span>{d.live}
            </span>
            <span class="hd-levels" aria-hidden="true">
              <span class="hd-vbar"></span>
              <span class="hd-vbar"></span>
              <span class="hd-vbar"></span>
              <span class="hd-vbar"></span>
            </span>
          </span>
          <div class="hd-transcript">
            {transcript.map((line) => (
              <span class:list={["hd-line", `hd-line--${line.who}`, "hd-anim", line.cls]}>
                <span class="hd-line__speaker" data-i18n={line.labelKey}>{line.label}</span>
                <span class="hd-line__text" data-i18n={line.key}>{line.text}</span>
              </span>
            ))}
          </div>
          <span class="hd-hangup hd-anim hd-hu" data-i18n="hdHangup">{d.hangup}</span>
        </div>

        <!-- ------------------------------- Szene 3: das Ergebnis --------- -->
        <div class="hd-scene hd-scene--3">
          <span class="hd-msg hd-msg--ai hd-anim hd-a2">
            <span class="hd-msg__label" data-i18n="hdAiLabel">{d.aiLabel}</span>
            <span class="hd-msg__bubble" data-i18n="hdAiMsg2">{d.aiMsg2}</span>
          </span>
          <span class="hd-result hd-anim hd-r1">
            <span class="hd-result__dot" aria-hidden="true"></span>
            <span class="hd-result__text">
              <span class="hd-result__key" data-i18n="hdR1k">{d.r1k}</span>
              <span class="hd-result__value" data-i18n="hdR1v">{d.r1v}</span>
            </span>
          </span>
          <span class="hd-result hd-result--done hd-anim hd-r2">
            <span class="hd-result__check" aria-hidden="true">✓</span>
            <span class="hd-result__done-text" data-i18n="hdR2v">{d.r2v}</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Steuerung (Verträge mit hermes-demo.js: data-hd-pause, data-hd-track,
         data-hd-tick, .hd-foot für die Höhenmessung). -->
    <div class="hd-foot">
      <div class="hd-controls">
        <button class="hd-pause" type="button" data-hd-pause title={d.pauseLabel} aria-label={d.pauseLabel}>❙❙</button>
        <span class="hd-steps">
          <span class="hd-step" data-i18n="hdStep1">{d.step1}</span>
          <span class="hd-step" data-i18n="hdStep2">{d.step2}</span>
          <span class="hd-step" data-i18n="hdStep3">{d.step3}</span>
        </span>
      </div>
      <span class="hd-track" data-hd-track title={d.scrub} role="slider" aria-label={d.scrub} tabindex="0" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="hd-rail">
          <span class="hd-fill"></span>
        </span>
        {ticks.map((left) => (
          <span class="hd-tick" data-hd-tick={left} aria-hidden="true"></span>
        ))}
      </span>
    </div>
  </div>
</span>
