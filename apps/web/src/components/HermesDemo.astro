---
// Erklär-Animation — 40s-Schleife in sechs Akten.
// Umsetzung von "Hermes Demo.dc.html". Das Quell-Design setzt Animationsnamen
// und Maße über inline style="..."; unter der Produktions-CSP
// (default-src 'self') ist das blockiert, darum trägt hier jedes Element seine
// Klasse aus hermes-demo.css. Die Zeitsteuerung läuft rein über CSS-Keyframes;
// Pause und Scrub setzt hermes-demo.js per CSSOM (das ist CSP-erlaubt).
//
// Füllt seinen Elternrahmen (.demo-frame auf der Startseite, .sheet__demo im
// Blatt). Die Maße hängen am Container, nicht am Fenster.
import "../styles/hermes-demo.css";

const { lang = "de" } = Astro.props;

const DEMO = {
  de: {
    e1: "01 · Nummer holen", e2: "02 · Als Connector einrichten", e3: "03 · Verbunden",
    e4: "04 · Ausgehender Anruf", e5: "05 · Das Gespräch", e6: "Ergebnis",
    h1: "Eine echte Nummer, sofort.",
    s1: "Direkt nach der Anmeldung vergeben — keine Hardware, keine Portierung, keine Wartezeit.",
    yourNumber: "Deine Hermes-Nummer", caller: "+49 176 44 12 908", active: "aktiv",
    h2: "Ein Connector — egal welche KI.",
    s2: "Hermes ist ein MCP-Server. Einmal eintragen, und deine KI kann telefonieren.",
    wayA: "In Claude, ChatGPT & Co.", mcpUrl: "https://app.sundartha.com/mcp",
    copy: "Kopieren", copied: "Kopiert ✓", scrub: "Zum Springen klicken oder ziehen",
    wayB: "Oder im Terminal", cmd: "claude mcp add --transport http hermes https://app.sundartha.com/mcp",
    h3: "Deine KI telefoniert — raus und rein.",
    s3: "Sie ruft selbst an und nimmt Anrufe für dich entgegen.",
    connected: "Hermes verbunden",
    tool1: "place_call", tool1Desc: "Selbst rauswählen",
    tool2: "list_calls", tool2Desc: "Ein- und ausgehende Anrufe",
    tool3: "get_transcript", tool3Desc: "Gespräch nachlesen",
    tool4: "get_calendar", tool4Desc: "Termine abrufen",
    pauseLabel: "Pause / Weiter",
    h4: "Deine KI ruft an — nicht du.",
    s4: "Termin beim Arzt, Rückruf beim Amt, Tisch reservieren: Hermes wählt und spricht.",
    incoming: "Ausgehender Anruf", callee: "Praxis Dr. Behrens",
    l1: "Hallo, ich bin der KI-Assistent von Jonas. Ich würde gern einen Termin für ihn vereinbaren.",
    l2: "Gerne, worum geht es denn?",
    l3: "Um eine Kontrolluntersuchung. Ginge es am Donnerstag, dem 14. August?",
    l4: "Donnerstag wäre frei.",
    l5: "Das passt gut, den nehmen wir. Auf den Namen Kroh.",
    h6: "Du erfährst nur das Ergebnis.",
    s6: "Zusammenfassung, Termin und Aufgabe landen in deinem Dashboard.",
    r1k: "Zusammenfassung", r1v: "Kontrolltermin bei Dr. Behrens vereinbart",
    r2k: "Termin", r2v: "Donnerstag, 14. Aug. · 11:30 · Praxis Dr. Behrens",
    r3v: "Liegt in deinem Dashboard",
    live: "Live",
    step1: "Nummer holen", step2: "Verbinden", step3: "Abnehmen lassen",
  },
  en: {
    e1: "01 · Get a number", e2: "02 · Add it as a connector", e3: "03 · Connected",
    e4: "04 · Outgoing call", e5: "05 · The conversation", e6: "Result",
    h1: "A real number, right away.",
    s1: "Issued the moment you sign up — no hardware, no porting, no waiting.",
    yourNumber: "Your Hermes number", caller: "+49 176 44 12 908", active: "active",
    h2: "One connector — any AI.",
    s2: "Hermes is an MCP server. Add it once, and your AI can make phone calls.",
    wayA: "In Claude, ChatGPT & co.", mcpUrl: "https://app.sundartha.com/mcp",
    copy: "Copy", copied: "Copied ✓", scrub: "Click or drag to jump",
    wayB: "Or in the terminal", cmd: "claude mcp add --transport http hermes https://app.sundartha.com/mcp",
    h3: "Your AI calls out — and picks up.",
    s3: "It dials out itself and takes incoming calls for you.",
    connected: "Hermes connected",
    tool1: "place_call", tool1Desc: "Dial out itself",
    tool2: "list_calls", tool2Desc: "Incoming and outgoing calls",
    tool3: "get_transcript", tool3Desc: "Read the conversation",
    tool4: "get_calendar", tool4Desc: "Fetch appointments",
    pauseLabel: "Pause / play",
    h4: "Your AI makes the call — not you.",
    s4: "A doctor's appointment, a callback, a table for two: Hermes dials and speaks.",
    incoming: "Outgoing call", callee: "Dr. Behrens' practice",
    l1: "Hi, I'm the AI assistant for Jonas. I'd like to book an appointment for him.",
    l2: "Sure, what is it about?",
    l3: "A check-up. Would Thursday, August 14th work?",
    l4: "Thursday would be free.",
    l5: "That works well, let's take it. Under the name Kroh.",
    h6: "You only get the result.",
    s6: "Summary, appointment and task land in your dashboard.",
    r1k: "Summary", r1v: "Check-up booked with Dr. Behrens",
    r2k: "Appointment", r2v: "Thursday, Aug 14 · 11:30 am · Dr. Behrens' practice",
    r3v: "Waiting in your dashboard",
    live: "Live",
    step1: "Get a number", step2: "Connect", step3: "Let it answer",
  },
};

const d = DEMO[lang === "en" ? "en" : "de"];

const tools = [
  { name: d.tool1, desc: d.tool1Desc, cls: "hd-w1" },
  { name: d.tool2, desc: d.tool2Desc, cls: "hd-w2" },
  { name: d.tool3, desc: d.tool3Desc, cls: "hd-w3" },
  { name: d.tool4, desc: d.tool4Desc, cls: "hd-w4" },
];

// Wer spricht: Hermes ist "me" (helle Blase rechts), die Gegenseite "them".
const chat = [
  { text: d.l1, who: "me", cls: "hd-t1" },
  { text: d.l2, who: "them", cls: "hd-t2" },
  { text: d.l3, who: "me", cls: "hd-t3" },
  { text: d.l4, who: "them", cls: "hd-t4" },
  { text: d.l5, who: "me", cls: "hd-t5" },
];

const results = [
  { key: d.r1k, value: d.r1v, cls: "hd-r1" },
  { key: d.r2k, value: d.r2v, cls: "hd-r2" },
];

// Die Marken sitzen auf den Aktwechseln der 76s-Schleife.
const ticks = ["12.5%", "28.3%", "41.4%", "53.3%", "84.9%"];
---

<span class="hd-mount">
  <div class="hd-stage" data-hd-stage data-paused="0">
    <span class="hd-glow hd-glow--a" aria-hidden="true"></span>
    <span class="hd-glow hd-glow--b" aria-hidden="true"></span>

    <!-- Akt 1 — die Nummer -->
    <div class="hd-act hd-act--1">
      <span class="hd-actnum" aria-hidden="true">01</span>
      <div class="hd-say">
        <span class="hd-eyebrow">{d.e1}</span>
        <h3 class="hd-head">{d.h1}</h3>
        <p class="hd-sub">{d.s1}</p>
      </div>
      <div class="hd-show">
        <span class="hd-panel">
          <span class="hd-callcard">
            <span class="hd-avatar" aria-hidden="true"><span class="hd-avatar__glyph"></span></span>
            <span class="hd-callcard__text">
              <span class="hd-label">{d.yourNumber}</span>
              <span class="hd-number">{d.caller}</span>
              <span class="hd-active">
                <span class="hd-active__dot" aria-hidden="true"></span>{d.active}
              </span>
            </span>
          </span>
        </span>
      </div>
    </div>

    <!-- Akt 2 — der Connector, zwei Wege -->
    <div class="hd-act hd-act--2">
      <span class="hd-actnum" aria-hidden="true">02</span>
      <div class="hd-say">
        <span class="hd-eyebrow">{d.e2}</span>
        <h3 class="hd-head">{d.h2}</h3>
        <p class="hd-sub">{d.s2}</p>
      </div>
      <div class="hd-show">
        <span class="hd-panel hd-anim hd-s1">
          <span class="hd-winbar">
            <span class="hd-windot" aria-hidden="true"></span>
            <span class="hd-windot" aria-hidden="true"></span>
            <span class="hd-windot" aria-hidden="true"></span>
            <span class="hd-wintitle">{d.wayA}</span>
          </span>
          <span class="hd-winrow">
            <span class="hd-mono">{d.mcpUrl}</span>
            <button class="hd-copy" type="button" data-hd-copy={d.mcpUrl} data-hd-copied={d.copied}>{d.copy}</button>
          </span>
        </span>
        <span class="hd-panel hd-panel--term hd-anim hd-s2">
          <span class="hd-termbar">
            <span class="hd-wintitle">{d.wayB}</span>
            <button class="hd-copy" type="button" data-hd-copy={d.cmd} data-hd-copied={d.copied}>{d.copy}</button>
          </span>
          <span class="hd-termbody">
            <span class="hd-mono"><span class="hd-prompt">$ </span>{d.cmd}<span class="hd-caret" aria-hidden="true">▊</span></span>
          </span>
        </span>
      </div>
    </div>

    <!-- Akt 3 — verbunden, die Werkzeuge -->
    <div class="hd-act hd-act--3">
      <span class="hd-actnum" aria-hidden="true">03</span>
      <div class="hd-say">
        <span class="hd-eyebrow">{d.e3}</span>
        <h3 class="hd-head">{d.h3}</h3>
        <p class="hd-sub">{d.s3}</p>
      </div>
      <div class="hd-show">
        <span class="hd-connected">
          <span class="hd-connected__check" aria-hidden="true">✓</span>
          <span class="hd-connected__text">{d.connected}</span>
        </span>
        {tools.map((tool) => (
          <span class:list={["hd-tool", "hd-anim", tool.cls]}>
            <span class="hd-mono">{tool.name}</span>
            <span class="hd-tool__desc">{tool.desc}</span>
          </span>
        ))}
      </div>
    </div>

    <!-- Akt 4 — der ausgehende Anruf -->
    <div class="hd-act hd-act--4">
      <span class="hd-actnum" aria-hidden="true">04</span>
      <div class="hd-say">
        <span class="hd-eyebrow">{d.e4}</span>
        <h3 class="hd-head">{d.h4}</h3>
        <p class="hd-sub">{d.s4}</p>
      </div>
      <div class="hd-show">
        <span class="hd-panel">
          <span class="hd-callcard hd-callcard--in">
            <span class="hd-avatar hd-avatar--ringing" aria-hidden="true"><span class="hd-avatar__glyph"></span></span>
            <span class="hd-callcard__text">
              <span class="hd-label">{d.incoming}</span>
              <span class="hd-callee">{d.callee}</span>
            </span>
            <span class="hd-levels" aria-hidden="true">
              <span class="hd-bar"></span>
              <span class="hd-bar"></span>
              <span class="hd-bar"></span>
              <span class="hd-bar"></span>
              <span class="hd-bar"></span>
            </span>
          </span>
        </span>
      </div>
    </div>

    <!-- Akt 5 — das Gespräch -->
    <div class="hd-act hd-act--5 hd-act--chat">
      <span class="hd-actnum" aria-hidden="true">05</span>
      <div class="hd-say hd-say--chat">
        <span class="hd-eyebrow">{d.e5}</span>
        <span class="hd-callhead">
          <span class="hd-callhead__dot" aria-hidden="true"></span>
          <span class="hd-callhead__name">{d.callee}</span>
          <span class="hd-callhead__live">{d.live}</span>
          <span class="hd-callhead__bars" aria-hidden="true">
            <span class="hd-bar"></span>
            <span class="hd-bar"></span>
            <span class="hd-bar"></span>
          </span>
        </span>
      </div>
      <div class="hd-chat">
        {chat.map((line) => (
          <span class:list={["hd-bubble", `hd-bubble--${line.who}`, "hd-anim", line.cls]}>{line.text}</span>
        ))}
      </div>
    </div>

    <!-- Akt 6 — das Ergebnis -->
    <div class="hd-act hd-act--6">
      <span class="hd-actnum" aria-hidden="true">06</span>
      <div class="hd-say">
        <span class="hd-eyebrow">{d.e6}</span>
        <h3 class="hd-head">{d.h6}</h3>
        <p class="hd-sub">{d.s6}</p>
      </div>
      <div class="hd-show">
        {results.map((row) => (
          <span class:list={["hd-tool", "hd-tool--result", "hd-anim", row.cls]}>
            <span class="hd-result__dot" aria-hidden="true"></span>
            <span class="hd-result__text">
              <span class="hd-result__key">{row.key}</span>
              <span class="hd-result__value">{row.value}</span>
            </span>
          </span>
        ))}
        <span class="hd-tool hd-tool--done hd-anim hd-r3">
          <span class="hd-connected__check" aria-hidden="true">✓</span>
          <span class="hd-done__text">{d.r3v}</span>
        </span>
      </div>
    </div>

    <!-- Steuerung -->
    <div class="hd-foot">
      <div class="hd-controls">
        <button class="hd-pause" type="button" data-hd-pause title={d.pauseLabel} aria-label={d.pauseLabel}>❙❙</button>
        <span class="hd-steps">
          <span class="hd-step">{d.step1}</span>
          <span class="hd-step">{d.step2}</span>
          <span class="hd-step">{d.step3}</span>
        </span>
      </div>
      <span class="hd-track" data-hd-track title={d.scrub} role="slider" aria-label={d.scrub} tabindex="0" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="hd-rail">
          <span class="hd-fill"></span>
        </span>
        {ticks.map((left) => (
          <span class="hd-tick" data-hd-tick={left} aria-hidden="true"></span>
        ))}
      </span>
    </div>
  </div>
</span>
