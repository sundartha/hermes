// Die drei Leistungen unter der Minuten-Zeile, je Tarif (Handoff-Copy), aus
// lib/plan-benefits.js - dieselbe Quelle wie die Agenten-Fassungen (/index.md,
// /llms.txt). Ein Tarif ohne Copy bricht den Build ab, statt leer auszuliefern.
const plans = PLAN_CATALOG.map((plan) => {
  const benefits = PLAN_BENEFITS[plan.slug];
  if (!benefits) throw new Error(`MobileHome: keine Leistungs-Copy fuer Tarif "${plan.slug}"`);
  return {
    slug: plan.slug,
    name: plan.name,
    numberCount: plan.numberCount,
    minutes: plan.includedMinutes,
    price: { en: formatPlanPrice(plan.amountCents, plan.currency, "en"), de: formatPlanPrice(plan.amountCents, plan.currency, "de") },
    benefits,
    // Vorlese-Fassung fuer Screenreader und Browser-Agenten: die Preis-Rolle (Einzel-
    // ziffern) und die Leistungs-Schaechte (beide Tarife uebereinander) sind
    // aria-hidden, stattdessen steht je Tarif ein ganzer Satz im Baum.
    srText: {
      en: `${plan.name}: ${formatPlanPrice(plan.amountCents, plan.currency, "en")} per month, ${plan.includedMinutes} minutes of calls per month. ${planBenefitsText(plan.slug, "en").join(". ")}.`,
      de: `${plan.name}: ${formatPlanPrice(plan.amountCents, plan.currency, "de")} pro Monat, ${plan.includedMinutes} Minuten Telefonie pro Monat. ${planBenefitsText(plan.slug, "de").join(". ")}.`,
    },
  };
});
// Kartendetails je Tarif: Anrufe nach aussen und Support-Art, wie in
// lib/plans.js (features) und lib/plan-benefits.js beschrieben.
const PLAN_CARD = {
  starter: { out: false, support: { en: "Email", de: "E-Mail" } },
  business: { out: true, support: { en: "Priority", de: "Priority" } },
};
const cardStats = (plan) => {
  const card = PLAN_CARD[plan.slug];
  if (!card) throw new Error(`MobileHome: keine Kartendetails fuer Tarif "${plan.slug}"`);
  const yes = { en: T.en.cardYes, de: T.de.cardYes };
  return [
    { en: String(plan.numberCount), de: String(plan.numberCount) },
    card.out ? yes : { en: "—", de: "—" },
    card.support,
  ];
};
// Start auf dem hervorgehobenen Tarif (Handoff: plan = 1, Pro).
const featured = Math.max(0, PLAN_CATALOG.findIndex((plan) => plan.featured));
const rel = (index, current) => (index === current ? "cur" : index < current ? "before" : "after");
const [ctaPre, ctaSuf] = T.en.choose.split("{}");


// Code-Feld je Weg: Zeilen aus farbigen Teilstuecken (lib/mobile-code.js). Getippt
// wird per Skript, ohne Skript steht der volle Text. Kopiert wird immer der ganze
// Befehl bzw. Satz (data-copy-*).
const agentPrompt = { en: `${SITE_AGENT_LINE.en.slice(0, -1)}: https://${agentGuide}`, de: `${SITE_AGENT_LINE.de.slice(0, -1)}: https://${agentGuide}` };
const ways = [
  { copy: { en: mcpUrl, de: mcpUrl }, mono: true, lines: codeTokens(mcpUrl) },
  { copy: { en: mcpCmd, de: mcpCmd }, mono: true, lines: codeTokens(mcpCmd, { prompt: true }) },
  {
    copy: agentPrompt,
    mono: false,
    lines: [[{ kind: "n", en: SITE_AGENT_LINE.en, de: SITE_AGENT_LINE.de }], [{ kind: "b", en: agentGuide, de: agentGuide }]],
  },
];
const SEGMENTS = 4;
// Ohne Skript steht nur der Kern einer Szene: optionale Zeilen entfallen, von
// mehreren Fassungen derselben Zeile steht die erste (kuerzeste). Mit Skript
// waehlt hermes-mobile.js (fitScenes) neu.
const offByDefault = (msgs, mi) =>
  msgs[mi].opt != null || (msgs[mi].alt != null && msgs.findIndex((msg) => msg.alt === msgs[mi].alt) !== mi);
// Eine Szene als Satz fuer Screenreader: Ausgangslage, dann das Ergebnis (die
// letzte Blase - Benachrichtigung bzw. Ergebnis-Karte).
const sceneSr = (scene) => `${scene.title} ${scene.msgs[scene.msgs.length - 1].text}`;
// Schlichte Linien-Icons (24px-Raster, currentColor), je ein Use Case.
const USE_ICONS = {
  answer: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1z"/>',
  dash: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="4" rx="1.5"/><rect x="13" y="10" width="7" height="10" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/>',
  brief: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/>',
  book: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/><path d="m9.5 15 2 2 3.5-4"/>',
  call: '<path d="M14 4h6v6"/><path d="m20 4-7 7"/><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1z" transform="translate(-1 0)"/>',
};
const footRows = [legalDocs.map((entry) => ({ kind: "doc", entry })).concat([{ kind: "cancel" }]), [{ kind: "contact" }, { kind: "cookies" }]];
---

<div class="mh" data-mh>
  <div class="mh-bg" aria-hidden="true">
    <img class="mh-clouds" src="/assets/howto_clouds.png" alt="" decoding="async" />
    <div class="mh-hero">
      <img class="mh-temple" src="/assets/olymp_hero.png" alt="" fetchpriority="high" />
      <!-- Ziehende Wolken ueber dem Berg (Design-Schema 6.1): je Schicht 4 Kacheln im
           Wechsel normal/gespiegelt, verschoben um 2 Kacheln = nahtlose Schleife. -->
      <div class="mh-fog">
        <div class="mh-fog__layer mh-fog__layer--back"><i></i><i></i><i></i><i></i></div>
        <div class="mh-fog__layer mh-fog__layer--front"><i></i><i></i><i></i><i></i></div>
      </div>
    </div>
    <div class="mh-base"></div>
    <div class="mh-deep"></div>
    <div class="mh-veil"></div>
    <div class="mh-edge mh-edge--top"></div>
    <div class="mh-edge mh-edge--bottom"></div>
  </div>
  <!-- Farbquelle fuer Safaris Statusleiste, s. styles/hermes-mobile-viewport.css -->
  <div class="mh-tint" aria-hidden="true"></div>

  <div class="mh-scroll">
    <!-- Screen 1: Start -->
    <section class="mh-screen mh-s-hero" data-active="1" aria-labelledby="mh-hero-title">
      <h1 class="mh-h1" id="mh-hero-title">
        <span class="mh-line mh-r mh-hl mh-d1" data-mh-de={T.de.hero[0]}>{T.en.hero[0]}</span>
        <em class="mh-line mh-r mh-hl mh-d2" data-mh-de={T.de.hero[1]}>{T.en.hero[1]}</em>
      </h1>
      <p class="mh-lead mh-lead--hero mh-r mh-d3" data-mh-de={T.de.heroLead} set:html={T.en.heroLead}></p>
      <div class="mh-actions mh-r mh-d4">
        <a class="mh-pill" href={LOGIN_URL} data-mh-de={T.de.getNumber}>{T.en.getNumber}</a>
        <button class="mh-how-link" type="button" data-mh-go="1">
          <span data-mh-de={T.de.howItWorks}>{T.en.howItWorks}</span>
          <span class="mh-how-link__thread" aria-hidden="true"><i class="mh-drop mh-drop--loop"></i></span>
        </button>
      </div>
    </section>

    <!-- Screen 2: Was Hermes kann (Use Cases) -->
    <section class="mh-screen mh-s-content mh-uses" data-active="0" aria-labelledby="mh-uses-title">
      <p class="mh-label mh-r mh-d1" data-mh-de={T.de.usesLabel}>{T.en.usesLabel}</p>
      <h2 class="mh-h2 mh-h2--uses" id="mh-uses-title"><span class="mh-line mh-r mh-hl mh-d2" data-mh-de={T.de.uses}>{T.en.uses}</span></h2>

      <!-- Die Buehne: vier Szenen wechseln durch (CSS, je 7 s), jede ein kurzer
           Verlauf aus Blasen und kleinen Bildern (Anruf-Zeile, Kalender), die
           nacheinander erscheinen (hermes-mobile-motion.css). Darunter vier Icon-Punkte als Fortschritt. Ohne Bewegung
           steht die erste Szene fertig da. -->
      <div class="mh-stage mh-r mh-d3" aria-hidden="true">
        {T.en.scenes.map((scene, si) => (
          <div class="mh-scene" data-scene={si}>
            <span class="mh-scene__tag" data-mh-de={T.de.scenes[si].tag}>{scene.tag}</span>
            <p class="mh-scene__title" data-mh-de={T.de.scenes[si].title}>{scene.title}</p>
            <div class="mh-chat">
              {scene.msgs.map((msg, mi) => (
                <div class={`mh-msg mh-msg--${msg.who}`} data-opt={msg.opt} data-alt={msg.alt} data-off={offByDefault(scene.msgs, mi) ? "" : undefined}>
                  {msg.name && <span class="mh-msg__name" data-mh-de={T.de.scenes[si].msgs[mi].name}>{msg.name}</span>}
                  {msg.who === "hermes" && <img class="mh-msg__wing" src="/assets/hermes-wing.png" alt="" />}
                  {msg.icon && <svg class="mh-msg__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={USE_ICONS[msg.icon]}></svg>}
                  {msg.who === "ring" && <i class="mh-msg__dot" aria-hidden="true"></i>}
                  {msg.who === "notif" && <span class="mh-notif__head"><img class="mh-notif__app" src="/assets/hermes-wing.png" alt="" /><span data-mh-de={T.de.scenes[si].msgs[mi].meta}>{msg.meta}</span></span>}
                  <span class="mh-msg__text" data-mh-de={T.de.scenes[si].msgs[mi].text}>{msg.text}</span>
                  {msg.rows && (
                    <span class="mh-cal">
                      {msg.rows.map((row, ri) => (
                        <span class={`mh-cal__row mh-cal__row--${row[2]}`} data-opt={row[3]} data-off={row[3] ? "" : undefined}><span class="mh-cal__time">{row[0]}</span><span class="mh-cal__what" data-mh-de={T.de.scenes[si].msgs[mi].rows[ri][1]}>{row[1]}</span></span>
                      ))}
                    </span>
                  )}
                  {msg.action && <span class="mh-msg__action" data-mh-de={T.de.scenes[si].msgs[mi].action}>{msg.action}</span>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <!-- Vorlese-Fassung: die Buehne ist aria-hidden, hier steht je Szene die
           Ausgangslage und das Ergebnis als ganzer Satz. -->
      <ul class="mh-sr">
        {T.en.scenes.map((scene, si) => (
          <li data-mh-de={sceneSr(T.de.scenes[si])}>{sceneSr(scene)}</li>
        ))}
      </ul>
      <!-- Vier Knoepfe: Antippen springt zu der Szene (hermes-mobile.js, pickScene).
           Der Balken fuellt sich waehrend der Szene. -->
      <ol class="mh-dots mh-r mh-d6">
        {["answer", "book", "call", "dash"].map((icon, k) => (
          <li class="mh-dot" data-scene={k}>
            <button class="mh-dot__btn" type="button" data-mh-scene={k}>
              <span class="mh-sr" data-mh-de={T.de.dots[k]}>{T.en.dots[k]}</span>
              <span class="mh-dot__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={USE_ICONS[icon]}></svg></span>
              <i class="mh-dot__bar" aria-hidden="true"><b></b></i>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <!-- Screen 3: Preise. Wie Screen 2: einzeilige Ueberschrift, darunter eine
         Glasflaeche, die den Platz fuellt - oben der Tarif-Umschalter, mittig Preis
         und Minuten, dann die Leistungen mit Haken, unten der Knopf. -->
    <section class="mh-screen mh-s-content mh-price" data-active="0" data-plan={featured} aria-labelledby="mh-price-title">
      <p class="mh-label mh-r mh-d1" data-mh-de={T.de.pricing}>{T.en.pricing}</p>
      <h2 class="mh-h2 mh-h2--uses" id="mh-price-title"><span class="mh-line mh-r mh-hl mh-d2" data-mh-de={T.de.priceTitle}>{T.en.priceTitle}</span></h2>

      <ul class="mh-sr">
        {plans.map((plan) => (
          <li data-mh-de={plan.srText.de}>{plan.srText.en}</li>
        ))}
      </ul>
      <div class="mh-plan mh-r mh-d3">
        <!-- Je Tarif eine Karte (wie in einer Wallet): die gewaehlte liegt vorn,
             die andere schaut versetzt dahinter hervor. Antippen oder waagerecht
             wischen wechselt (hermes-mobile.js). Vorgelesen wird die Liste oben. -->
        <div class="mh-focus mh-cards" aria-hidden="true" data-sel={featured}>
          {plans.map((plan, index) => (
            <div class={`mh-card mh-card--${plan.slug}`} data-mh-plan={index} data-card={index}>
              <img class="mh-card__wing" src="/assets/hermes-wing.png" alt="" />
              <div class="mh-card__top">
                <span class="mh-card__name">{plan.name}</span>
                {index === featured && <span class="mh-card__badge" data-mh-de={T.de.popular}>{T.en.popular}</span>}
              </div>
              <p class="mh-card__line" data-mh-de={T.de.planLine[plan.slug]}>{T.en.planLine[plan.slug]}</p>
              <p class="mh-card__price"><b data-mh-de={plan.price.de}>{plan.price.en}</b><small data-mh-de={T.de.perMonth}>{T.en.perMonth}</small></p>
              <!-- Minuten mit Leiste darunter (ein Segment = 30 Minuten). -->
              <div class="mh-card__min">
                <span class="mh-card__minrow"><span data-mh-de={T.de.cardMinutes}>{T.en.cardMinutes}</span><b>{plan.minutes}</b></span>
                <span class="mh-segs">{Array.from({ length: SEGMENTS }, (_, j) => <span class={`mh-seg${j < Math.round((plan.minutes / Math.max(...plans.map((p) => p.minutes))) * SEGMENTS) ? " is-on" : ""}`}><i></i></span>)}</span>
              </div>
              <dl class="mh-card__stats">
                {cardStats(plan).map((value, k) => (
                  <div><dt data-mh-de={T.de.cardStats[k]}>{T.en.cardStats[k]}</dt><dd data-mh-de={value.de}>{value.en}</dd></div>
                ))}
              </dl>
              <ul class="mh-card__list">
                {plan.benefits.en.map((line, row) => (
                  <li><svg class="mh-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg><span data-mh-de={plan.benefits.de[row]} set:html={line}></span></li>
                ))}
              </ul>
              <span class="mh-card__brand" data-mh-de={T.de.cardBrand}>{T.en.cardBrand}</span>
            </div>
          ))}
        </div>
        <!-- Bedienbarer Umschalter unter den Karten (zugleich Punkt-Anzeige). -->
        <div class="mh-plan-tabs" role="tablist" aria-label={T.en.pricing}>
          {plans.map((plan, index) => (
            <button class="mh-plan-tab" type="button" role="tab" data-mh-plan={index} aria-selected={String(index === featured)}>{plan.name}</button>
          ))}
        </div>
        <div class="mh-plan__end">
          <!-- "Choose ..." bleibt stehen, nur der Tarifname rollt (Design-Schema 6.3). -->
          <a class="mh-pill mh-cta" href={LOGIN_URL} data-cta-en={T.en.choose} data-cta-de={T.de.choose}>
            <span class="mh-cta__in">
              <span class="mh-cta__pre">{ctaPre}</span>
              <span class="mh-cta__roll">
                {plans.map((plan, index) => (
                  <span class="mh-cta__name" data-rel={rel(index, featured)}>{plan.name}</span>
                ))}
              </span>
              <span class="mh-cta__suf">{ctaSuf}</span>
            </span>
          </a>
          <div class="mh-plan__trust">
            <p class="mh-promise">{T.en.promise.map((item, index) => <span data-mh-de={T.de.promise[index]}>{item}</span>)}</p>
            <p class="mh-foot" data-mh-de={T.de.priceFoot}>{T.en.priceFoot}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Screen 4: Fuer Entwickler -->
    <section class="mh-screen mh-s-content mh-dev" data-active="0" data-way="0" data-copied="0" aria-labelledby="mh-dev-title">
      <span class="mh-thread" aria-hidden="true"><i class="mh-drop"></i></span>
      <p class="mh-label mh-r mh-d1" data-mh-de={T.de.forDevs}>{T.en.forDevs}</p>
      <h2 class="mh-h2 mh-h2--uses" id="mh-dev-title"><span class="mh-line mh-r mh-hl mh-d2" data-mh-de={T.de.devTitle}>{T.en.devTitle}</span></h2>

      <!-- Ein Terminal-Fenster als Mittelpunkt: oben die Wege als Fenster-Tabs,
           darin der Code (getippt, hermes-mobile.js) und drei Schritte fuer den
           gewaehlten Weg (data-way am Screen). Darunter die Aktionen. -->
      <div class="mh-window mh-r mh-d3">
        <div class="mh-toggle mh-toggle--3" role="tablist" data-sel="0" aria-label={T.en.forDevs}>
          <span class="mh-toggle__thumb" aria-hidden="true"></span>
          {T.en.ways.map((way, index) => (
            <button class="mh-toggle__opt" type="button" role="tab" data-mh-way={index} aria-selected={String(index === 0)} data-mh-de={T.de.ways[index].tab}>{way.tab}</button>
          ))}
        </div>
        <div class="mh-focus">
          <button class="mh-copy" type="button" data-mh-copy aria-live="polite" data-copy-label-en={T.en.copy} data-copy-label-de={T.de.copy} data-copy-url-label-en={T.en.copyUrl} data-copy-url-label-de={T.de.copyUrl} data-copied-en={T.en.copied} data-copied-de={T.de.copied}>
            <span class="mh-copy__roll" aria-hidden="true">
              <span class="mh-copy__label" data-mh-de={T.de.copy}>{T.en.copy}</span>
              <span class="mh-copy__label mh-copy__label--url" data-mh-de={T.de.copyUrl}>{T.en.copyUrl}</span>
              <span class="mh-copy__label mh-copy__label--done" data-mh-de={`✓  ${T.de.copied}`}>{`✓  ${T.en.copied}`}</span>
            </span>
            <span class="mh-sr" data-mh-copy-sr>{T.en.copy}</span>
          </button>
          <div class="mh-ways">
            {ways.map((way, index) => (
              <div class="mh-way" data-rel={rel(index, 0)} data-copy-en={way.copy.en} data-copy-de={way.copy.de}>
                <h3 class="mh-way__label" data-mh-de={T.de.ways[index].title}>{T.en.ways[index].title}</h3>
                <div class={`mh-code${way.mono ? "" : " mh-code--text"}`}>
                  {way.lines.map((line) => (
                    <span class="mh-code__line">
                      <span class="mh-code__sel">
                        {line.map((token) => (
                          <span class={`mh-tk mh-tk--${token.kind}`} data-t-en={token.en} data-t-de={token.de}>{token.en}</span>
                        ))}
                      </span>
                    </span>
                  ))}
                </div>
                <ol class="mh-steps">
                  {T.en.ways[index].steps.map((step, k) => (
                    <li><b>{k + 1}</b><span><strong data-mh-de={T.de.ways[index].steps[k][0]}>{step[0]}</strong><small data-mh-de={T.de.ways[index].steps[k][1]}>{step[1]}</small></span></li>
                  ))}
                </ol>
                <div class="mh-gain">
                  <p class="mh-gain__ask" data-mh-de={T.de.devAsk}>{T.en.devAsk}</p>
                  <p class="mh-gain__result" data-mh-de={T.de.devResult}>{T.en.devResult}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mh-controls mh-r mh-d6">
        <!-- Nur beim Weg "Connector" (data-way="0", CSS): echter Link in Claudes
             Connector-Dialog, Name und URL schon eingetragen. "Copy" bleibt der Weg
             fuer ChatGPT und andere Clients und wird dort zur zweiten Aktion. -->
        <div class="mh-connect">
          <a class="mh-pill mh-connect__btn" href={CLAUDE_CONNECT_URL} target="_blank" rel="noopener noreferrer"><span data-mh-de={T.de.connect}>{T.en.connect}</span><span class="mh-sr" data-mh-de={T.de.newTab}>{T.en.newTab}</span></a>
          <p class="mh-connect__hint" data-mh-de={T.de.connectHint}>{T.en.connectHint}</p>
          <a class="mh-connect__admin" href={CLAUDE_ADMIN_CONNECT_URL} target="_blank" rel="noopener noreferrer"><span data-mh-de={T.de.connectAdmin}>{T.en.connectAdmin}</span><span class="mh-sr" data-mh-de={T.de.newTab}>{T.en.newTab}</span></a>
        </div>
      </div>
    </section>

    <!-- Screen 5: Abschluss -->
    <section class="mh-screen mh-s-close" data-active="0" aria-labelledby="mh-close-title">
      <h2 class="mh-h2 mh-h2--close" id="mh-close-title">
        <span class="mh-line mh-r mh-hl mh-d1" data-mh-de={T.de.hero[0]}>{T.en.hero[0]}</span>
        <em class="mh-line mh-r mh-hl mh-d2" data-mh-de={T.de.hero[1]}>{T.en.hero[1]}</em>
      </h2>
      <p class="mh-lead mh-lead--hero mh-r mh-d3" data-mh-de={T.de.heroLead} set:html={T.en.heroLead}></p>
      <a class="mh-pill mh-r mh-d3" href={LOGIN_URL} data-mh-de={T.de.getNumber}>{T.en.getNumber}</a>
      <footer class="mh-footer mh-r mh-d4">
        <nav class="mh-links" aria-label="Legal">
          {footRows.map((row) => (
            <span class="mh-links__row">
              {row.map((item) => {
                if (item.kind === "doc") {
                  return <a class="mh-link" href={item.entry.href} data-legal-open={item.entry.slug} data-mh-de={T.de[item.entry.slug]}>{T.en[item.entry.slug]}</a>;
                }
                if (item.kind === "cancel") {
                  /* § 312k BGB: Wortlaut aus lib/subscribe.js je Sprache. Fuehrt direkt zur Kuendigung im Kundenbereich (CANCEL_URL, Owner 2026-10-01). */
                  return <a class="mh-link" href={CANCEL_URL}><BiText en={CANCEL_BUTTON_LABEL_EN} de={CANCEL_BUTTON_LABEL} /></a>;
                }
                if (item.kind === "contact") {
                  return <a class="mh-link" href={`mailto:${contact}`} data-mh-de={T.de.contact}>{T.en.contact}</a>;
                }
                return <button class="mh-link" type="button" data-consent-open data-mh-de={T.de.cookies}>{T.en.cookies}</button>;
              })}
            </span>
          ))}
        </nav>
        <span class="mh-copyright" data-mh-de={T.de.footCopy}>{T.en.footCopy}</span>
      </footer>
    </section>
  </div>

  <header class="mh-head">
    <button class="mh-brand" type="button" data-mh-go="0" aria-label="Hermes by Sundartha">
      <img src="/assets/hermes-wing.png" alt="" />
      <span class="mh-brand__text" aria-hidden="true">
        <span class="mh-brand__name">HERMES</span>
        <span class="mh-brand__by">by Sundartha</span>
      </span>
    </button>
    <!-- Eine Glaskapsel: EN / DE, Haarlinie, "Log in" als Glas-Daumen (Design-Schema 6). -->
    <span class="mh-cap">
      <span class="mh-lang">
        <button class="mh-lang__opt" type="button" data-lang="en" aria-pressed="true" aria-label="English">EN</button>
        <span class="mh-lang__sep" aria-hidden="true">/</span>
        <button class="mh-lang__opt" type="button" data-lang="de" aria-pressed="false" aria-label="Deutsch">DE</button>
      </span>
      <span class="mh-cap__rule" aria-hidden="true"></span>
      <a class="mh-login" href={LOGIN_URL}><span class="mh-login__thumb" data-mh-de={T.de.login}>{T.en.login}</span></a>
    </span>
  </header>
</div>
