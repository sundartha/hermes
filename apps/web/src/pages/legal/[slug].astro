---
// Informative EN-Fassung der Rechtsdokumente (Owner-Entscheidung O13). Gebaut
// wird NUR, was als Content-Datei geliefert ist: ohne Datei entsteht keine Seite,
// die Route liefert 404 statt einer falschen Zusicherung. noindex, weil die
// deutsche Fassung die verbindliche und die zu indexierende ist.
//
// getStaticPaths, Datenquelle und noindex unverändert — nur die Hülle ist neu.
import Hermes from "../../layouts/Hermes.astro";
import { LEGAL_CONTENT } from "../../lib/legal-content.js";
import { legalRouteEntries, LEGAL_TRANSLATION_NOTICE } from "../../lib/legal.js";

export function getStaticPaths() {
  return legalRouteEntries(LEGAL_CONTENT, "en").map(({ slug, doc }) => ({
    params: { slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;

// Gegenstücke auf Deutsch: die verbindliche Fassung ist immer einen Klick weit weg.
const pills = [
  { href: "/datenschutz", label: "Datenschutz (DE)" },
  { href: "/impressum", label: "Impressum (DE)" },
  { href: "/agb", label: "AGB (DE)" },
];
---

<Hermes lang="en" noindex title={doc.metaTitle} description={doc.metaDescription}>
  <h1 class="doc-title">{doc.title}</h1>
  <div class="doc-pills">
    {pills.map((pill) => (
      <a class="legal-pill" href={pill.href}>{pill.label}</a>
    ))}
  </div>

  <div class="doc-block doc-legal">
    <div class="legal-card">
      {doc.sections.map((section) => (
        <div class="legal-section">
          <span class="legal-eyebrow">{section.heading}</span>
          <span class="legal-text">{section.text}</span>
        </div>
      ))}
    </div>
  </div>

  <p class="doc-note">{LEGAL_TRANSLATION_NOTICE}</p>
</Hermes>
