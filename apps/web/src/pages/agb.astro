---
// Marketing: AGB (SSG), verbindliche deutsche Fassung. Text und Metadaten
// stehen in src/data/legal/terms.de.json; fehlt die Datei oder ist sie
// unvollstaendig, bricht der Build ab.
import Site from "../layouts/Site.astro";
import LegalDocument from "../components/site/LegalDocument.astro";
import { LEGAL_CONTENT } from "../lib/legal-content.js";
import { requireLegalDocument } from "../lib/legal.js";

const doc = requireLegalDocument(LEGAL_CONTENT, "terms", "de");
---

<Site lang="de" title={doc.metaTitle} description={doc.metaDescription}>
  <LegalDocument doc={doc} note={doc.note} />
</Site>
