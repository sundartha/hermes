---
// AGB — verbindliche deutsche Fassung. Der Text kommt aus
// src/data/legal/terms.de.json, NICHT aus dieser Datei: dieselbe Quelle, aus der auch
// das Rechts-Blatt der Startseite gebaut wird. Ein zweiter Textstand kann so
// nicht entstehen.
import Hermes from "../layouts/Hermes.astro";
import doc from "../data/legal/terms.de.json";

const pills = [
  { href: "/datenschutz", label: "Datenschutz" },
  { href: "/impressum", label: "Impressum" },
  { href: "/agb", label: "AGB" },
];
const CONTACT = "kontakt@sundartha.com";
---

<Hermes title={doc.metaTitle} description={doc.metaDescription} lang="de">
  <h1 class="doc-title">{doc.title}</h1>
  <div class="doc-pills">
    {pills.map((pill) => (
      <a
        class="legal-pill"
        href={pill.href}
        aria-current={pill.href === "/agb" ? "page" : undefined}
      >{pill.label}</a>
    ))}
    <a class="legal-pill" href={`mailto:${CONTACT}`}>Kontakt</a>
  </div>

  <div class="doc-block doc-legal">
    <div class="legal-card">
      {doc.sections.map((section) => (
        <div class="legal-section">
          <span class="legal-eyebrow">{section.heading}</span>
          <span class="legal-text">{section.text}</span>
        </div>
      ))}
    </div>
  </div>

  <p class="doc-note">{doc.note}</p>
</Hermes>
