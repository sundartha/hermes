---
// Marketing: 404 (SSG). Gestylte Fehlerseite im Marken-Look mit Rueckweg.
import Site from "../layouts/Site.astro";
---

<Site
  title="Page not found — Sundartha Hermes"
  description="This page does not exist. Back to the Sundartha Hermes homepage."
>
  <section class="hero">
    <div class="container error-page">
      <span class="error-page__code">404</span>
      <h1 class="hero__title">Page not <span class="highlight">found</span></h1>
      <p class="hero__lead">
        This page does not exist (any more). Maybe the way back to the start or a
        look at the pricing helps.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="/">To the homepage</a>
        <a class="button button--ghost" href="/so-funktionierts">How it works</a>
      </div>
    </div>
  </section>
</Site>
