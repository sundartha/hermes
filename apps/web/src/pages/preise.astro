---
// Marketing: Preise (SSG). W1-Grundgeruest: zwei Tarife als statisches Markup,
// CTAs verlinken auf den Login. KEINE Stripe-Anbindung, KEIN Client-Fetch — den
// Karte-hinterlegen-Funnel (POST /api/self-service/billing/setup-checkout) und
// den ehrlichen Hinweis zur fehlenden wiederkehrenden Abbuchung ergaenzt W2.
import Marketing from "../layouts/Marketing.astro";

const plans = [
  {
    name: "Starter",
    price: "$4.99",
    cadence: "pro Monat",
    featured: false,
    features: [
      "30 Minuten Telefonie pro Monat",
      "1 Telefonnummer",
      "Anrufe annehmen und zusammenfassen",
      "Anruf-Verlauf in deinem Bereich",
    ],
  },
  {
    name: "Business",
    price: "$9.99",
    cadence: "pro Monat",
    featured: true,
    features: [
      "120 Minuten Telefonie pro Monat",
      "3 Telefonnummern",
      "Ausgehende Anrufe in deinem Auftrag",
      "Priorisierter Support",
    ],
  },
];
---

<Marketing
  title="Preise — Sundartha Hermes"
  description="Zwei klare Tarife fuer Hermes: Starter und Business. Telefonie-Minuten, Rufnummern und Support im Ueberblick."
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">Tarife</span>
      <h1 class="hero__title">Preise, die <span class="highlight">mitwachsen</span></h1>
      <p class="hero__lead">
        Starte klein und schalte mehr frei, wenn dein Assistent mehr uebernehmen
        soll. Keine versteckten Kosten.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pricing">
        {plans.map((plan) => (
          <article class={plan.featured ? "plan plan--featured" : "plan"}>
            {plan.featured && <span class="badge badge--accent">Beliebt</span>}
            <h2 class="plan__name">{plan.name}</h2>
            <p class="plan__price">{plan.price} <small>{plan.cadence}</small></p>
            <ul class="plan__features">
              {plan.features.map((feature) => (
                <li class="plan__feature">{feature}</li>
              ))}
            </ul>
            <a class="button button--primary plan__cta" href="/auth/login">Jetzt starten</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Marketing>
