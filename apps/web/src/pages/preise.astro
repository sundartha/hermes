---
// Marketing: Pricing (SSG). Zwei Tarife aus dem geteilten Plan-Katalog
// (lib/plans.js, drift-getestete Backend-SSoT-Kopie) — USD via formatPlanPrice,
// KEIN Preis-Literal hier. Zur BUILD-Zeit gerendert (zero-JS SSG).
//
// Visuell 1:1 zum Claude-Design (Pricing-Band): Wolken-Band + Glas-Karten +
// Haken-Features (sections.css), eingebettet ins gemeinsame Site-Chrome. Der CTA
// funnelt ueber LOGIN_URL in den Login-Einstieg (echter Checkout = spaeter).
import Site from "../layouts/Site.astro";
import "../styles/sections.css";
import { LOGIN_URL } from "../lib/routes.js";
import { PLAN_CATALOG, formatPlanPrice } from "../lib/plans.js";
---

<Site
  title="Pricing — Sundartha Hermes"
  description="Two clear plans for Hermes: Starter and Business. Call minutes, phone numbers and support at a glance."
>
  <section class="band band--alt band--center" id="pricing">
    <div class="band__inner">
      <p class="band__eyebrow">Plans</p>
      <h1 class="band__title">Pricing that <em>grows with you</em></h1>
      <p class="band__lead">
        Start small and unlock more as your assistant takes on more. No hidden
        costs.
      </p>
      <div class="tiers">
        {PLAN_CATALOG.map((plan) => (
          <article class={plan.featured ? "tier tier--featured" : "tier"}>
            {plan.featured && <span class="tier__badge">Popular</span>}
            <h2 class="tier__name">{plan.name}</h2>
            <p class="tier__price">
              {formatPlanPrice(plan.amountCents, plan.currency)}
              <small>per {plan.cadence}</small>
            </p>
            <ul class="tier__features">
              {plan.features.map((feature) => (
                <li class="tier__feature">{feature}</li>
              ))}
            </ul>
            <a class="button button--primary tier__cta" href={LOGIN_URL}>Choose plan</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Site>
