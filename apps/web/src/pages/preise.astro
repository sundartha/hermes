---
// Marketing: Pricing (SSG). Zwei Tarife als statisches Markup; CTAs funneln in
// den Registrieren-/Login-Flow. KEINE Stripe-Anbindung, KEIN Client-Fetch hier.
//
// EHRLICHER BEFUND (Strategie R1, §2.6): Das Backend kennt KEINE Abo-/Preis-
// Tiers — nur Karten-Hinterlegung (Stripe setup-mode), nutzungsbasiertes
// Metering und eine einmalige Nummern-Gebuehr. Die Karte hinterlegst du nach
// dem Login in deinem Bereich (auth-gated). Die automatische monatliche
// Abbuchung (echtes Subscription-Billing) ist ein benannter Backend-Follow-up
// und wird hier NICHT vorgetaeuscht (kein Fake-Charge). Der Hinweis-Block unten
// macht das transparent.
//
// SCOPE W1: nur Design + Sprach-Vereinheitlichung. Die Tier-Zahlen sind 1:1 aus
// der DE-Fassung uebersetzt; die inhaltliche Tier-Korrektur (Business = 1 Nummer)
// ist W2 und wird hier NICHT vorgenommen.
import Site from "../layouts/Site.astro";

const plans = [
  {
    name: "Starter",
    price: "$4.99",
    cadence: "per month",
    featured: false,
    features: [
      "30 minutes of calls per month",
      "1 phone number",
      "Answer and summarise calls",
      "Call history in your area",
    ],
  },
  {
    name: "Business",
    price: "$9.99",
    cadence: "per month",
    featured: true,
    features: [
      "120 minutes of calls per month",
      "3 phone numbers",
      "Outgoing calls on your behalf",
      "Priority support",
    ],
  },
];
---

<Site
  title="Pricing — Sundartha Hermes"
  description="Two clear plans for Hermes: Starter and Business. Call minutes, phone numbers and support at a glance."
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">Plans</span>
      <h1 class="hero__title">Pricing that <span class="highlight">grows with you</span></h1>
      <p class="hero__lead">
        Start small and unlock more as your assistant takes on more. No hidden
        costs.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pricing">
        {plans.map((plan) => (
          <article class={plan.featured ? "plan plan--featured" : "plan"}>
            {plan.featured && <span class="badge badge--accent">Popular</span>}
            <h2 class="plan__name">{plan.name}</h2>
            <p class="plan__price">{plan.price} <small>{plan.cadence}</small></p>
            <ul class="plan__features">
              {plan.features.map((feature) => (
                <li class="plan__feature">{feature}</li>
              ))}
            </ul>
            <a class="button button--primary plan__cta" href="/registrieren">Get started</a>
          </article>
        ))}
      </div>

      <div class="note">
        <h2 class="note__title">How billing works</h2>
        <p class="note__text">
          You add your payment method securely in your area once your account is
          activated — billing is usage-based. We are still setting up automatic
          monthly charging; until then we activate your plan manually. Nothing is
          charged without your consent.
        </p>
      </div>
    </div>
  </section>
</Site>
