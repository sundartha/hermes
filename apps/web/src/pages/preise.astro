---
// Preise — ruhende Fassung der Preis-Ebene der Startseite. Zahlen und Merkmale
// wortgleich mit index.astro; beide folgen dem verbindlichen Design-Entwurf.
import Hermes from "../layouts/Hermes.astro";
import { LOGIN_URL } from "../lib/routes.js";
---

<Hermes
  title="Preise — Hermes von Sundartha"
  description="Zwei Tarife, keine Überraschungen: Starter 4,99 € mit 30 Minuten, Pro 9,99 € mit 120 Minuten. Monatlich kündbar."
>
  <h1 class="doc-title">Zwei Tarife, <em>keine Überraschungen</em>.</h1>
  <p class="doc-lead">
    {/* Beide Halbsätze bewusst auf EINER Zeile: der Zeilenumbruch zwischen
        </strong>, und <strong> wird beim Bauen verschluckt, im Ergebnis stand
        „kündbar,keine" ohne Leerzeichen. */}
    Wähle das Paket, welches zu dir passt. <strong>Monatlich kündbar</strong>, <strong>keine versteckten Kosten</strong>.
  </p>

  <div class="doc-block">
    <div class="price-grid">
      <div class="plan">
        <span class="plan__head">
          <span class="plan__label">Starter</span>
        </span>
        <span class="plan__price">4,99 €<span class="plan__per">/ Monat</span></span>
        <span class="plan__features">
          <span><strong>30 Minuten</strong> Gespräche pro Monat</span>
          <span>Nimmt jeden Anruf für dich an</span>
          <span>Fasst jedes Gespräch für dich zusammen</span>
          <span>E-Mail-Support</span>
        </span>
        <a class="plan__cta" href={LOGIN_URL}>Starter wählen</a>
      </div>
      <div class="plan plan--featured">
        <span class="plan__head">
          <span class="plan__label">Pro</span>
          <span class="plan__badge">Beliebt</span>
        </span>
        <span class="plan__price">9,99 €<span class="plan__per">/ Monat</span></span>
        <span class="plan__features">
          <span><strong>120 Minuten</strong> Gespräche pro Monat</span>
          <span>Nimmt an <em>und</em> telefoniert für dich raus</span>
          <span>Erledigt Aufgaben eigenständig für dich</span>
          <span>Priorisierter Support</span>
        </span>
        <a class="plan__cta" href={LOGIN_URL}>Pro wählen</a>
      </div>
    </div>
  </div>

  <p class="doc-note">
    Minuten aufgebraucht? Du bekommst einen Hinweis — kein automatischer Aufpreis.
  </p>
</Hermes>
