---
// Marketing: Pricing (SSG). Zwei Tarife als statisches Markup; der CTA funnelt
// ueber LOGIN_URL in den Login-Einstieg (echter Checkout kommt in BK2). KEINE
// Stripe-Anbindung, KEIN Client-Fetch hier.
//
// BK0: Preise/Leistungen kommen aus dem geteilten Plan-Katalog (lib/plans.js,
// Marketing-Spiegel der Backend-SSoT src/plans.js, drift-getestet) - kein lokales
// Preis-Literal mehr. Zur BUILD-Zeit gerendert (zero-JS SSG), NICHT per fetch.
//
// EHRLICHER BEFUND (Strategie R1, §2.6): Das Backend kennt die Abo-/Preis-Tiers
// jetzt (Plan-Katalog), aber der Self-Service bucht noch nicht von hier aus. Die
// Karte hinterlegst du nach dem Login in deinem Bereich (auth-gated). Echter
// Checkout von dieser Seite aus ist BK2 und wird hier NICHT vorgetaeuscht (kein
// Fake-Charge). Der Hinweis-Block unten macht das transparent.
import Site from "../layouts/Site.astro";
import { LOGIN_URL } from "../lib/routes.js";
import { PLAN_CATALOG, formatPlanPrice } from "../lib/plans.js";
---

<Site
  title="Pricing — Sundartha Hermes"
  description="Two clear plans for Hermes: Starter and Business. Call minutes, phone numbers and support at a glance."
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">Plans</span>
      <h1 class="hero__title">Pricing that <span class="highlight">grows with you</span></h1>
      <p class="hero__lead">
        Start small and unlock more as your assistant takes on more. No hidden
        costs.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pricing">
        {PLAN_CATALOG.map((plan) => (
          <article class={plan.featured ? "plan plan--featured" : "plan"}>
            {plan.featured && <span class="badge badge--accent">Popular</span>}
            <h2 class="plan__name">{plan.name}</h2>
            <p class="plan__price">{formatPlanPrice(plan.amountCents, plan.currency)} <small>per {plan.cadence}</small></p>
            <ul class="plan__features">
              {plan.features.map((feature) => (
                <li class="plan__feature">{feature}</li>
              ))}
            </ul>
            <a class="button button--primary plan__cta" href={LOGIN_URL}>Choose plan</a>
          </article>
        ))}
      </div>

      <div class="note">
        <h2 class="note__title">How billing works</h2>
        <p class="note__text">
          You start your monthly subscription after signing in. Your card is
          charged only for the plan you choose; nothing is charged without your
          consent.
        </p>
      </div>
    </div>
  </section>
</Site>
