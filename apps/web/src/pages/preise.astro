---
// Marketing: Preise (SSG). Zwei Tarife als statisches Markup; CTAs funneln in
// den Registrieren-/Login-Flow. KEINE Stripe-Anbindung, KEIN Client-Fetch hier.
//
// EHRLICHER BEFUND (Strategie R1, §2.6): Das Backend kennt KEINE Abo-/Preis-
// Tiers — nur Karten-Hinterlegung (Stripe setup-mode), nutzungsbasiertes
// Metering und eine einmalige Nummern-Gebuehr. Die Karte hinterlegst du nach
// dem Login in deinem Bereich (auth-gated). Die automatische monatliche
// Abbuchung (echtes Subscription-Billing) ist ein benannter Backend-Follow-up
// und wird hier NICHT vorgetaeuscht (kein Fake-Charge). Der Hinweis-Block unten
// macht das transparent.
import Marketing from "../layouts/Marketing.astro";

const plans = [
  {
    name: "Starter",
    price: "$4.99",
    cadence: "pro Monat",
    featured: false,
    features: [
      "30 Minuten Telefonie pro Monat",
      "1 Telefonnummer",
      "Anrufe annehmen und zusammenfassen",
      "Anruf-Verlauf in deinem Bereich",
    ],
  },
  {
    name: "Business",
    price: "$9.99",
    cadence: "pro Monat",
    featured: true,
    features: [
      "120 Minuten Telefonie pro Monat",
      "3 Telefonnummern",
      "Ausgehende Anrufe in deinem Auftrag",
      "Priorisierter Support",
    ],
  },
];
---

<Marketing
  title="Preise — Sundartha Hermes"
  description="Zwei klare Tarife fuer Hermes: Starter und Business. Telefonie-Minuten, Rufnummern und Support im Ueberblick."
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">Tarife</span>
      <h1 class="hero__title">Preise, die <span class="highlight">mitwachsen</span></h1>
      <p class="hero__lead">
        Starte klein und schalte mehr frei, wenn dein Assistent mehr uebernehmen
        soll. Keine versteckten Kosten.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pricing">
        {plans.map((plan) => (
          <article class={plan.featured ? "plan plan--featured" : "plan"}>
            {plan.featured && <span class="badge badge--accent">Beliebt</span>}
            <h2 class="plan__name">{plan.name}</h2>
            <p class="plan__price">{plan.price} <small>{plan.cadence}</small></p>
            <ul class="plan__features">
              {plan.features.map((feature) => (
                <li class="plan__feature">{feature}</li>
              ))}
            </ul>
            <a class="button button--primary plan__cta" href="/registrieren">Jetzt starten</a>
          </article>
        ))}
      </div>

      <div class="note">
        <h2 class="note__title">So funktioniert die Abrechnung</h2>
        <p class="note__text">
          Deine Zahlungsmethode hinterlegst du sicher in deinem Bereich, sobald
          dein Konto freigeschaltet ist — abgerechnet wird nutzungsbasiert. Die
          automatische monatliche Abbuchung richten wir gerade ein; bis dahin
          aktivieren wir deinen Tarif manuell. Es wird nichts ohne deine
          Zustimmung abgebucht.
        </p>
      </div>
    </div>
  </section>
</Marketing>
