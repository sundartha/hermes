---
// Marketing: Pricing (SSG). Zwei Tarife als statisches Markup; der CTA funnelt
// ueber LOGIN_URL in den Login-Einstieg (echter Checkout kommt in W4). KEINE
// Stripe-Anbindung, KEIN Client-Fetch hier.
//
// EHRLICHER BEFUND (Strategie R1, §2.6): Das Backend kennt KEINE Abo-/Preis-
// Tiers — nur Karten-Hinterlegung (Stripe setup-mode), nutzungsbasiertes
// Metering und eine einmalige Nummern-Gebuehr. Die Karte hinterlegst du nach
// dem Login in deinem Bereich (auth-gated). Echtes Subscription-Billing
// (Recurring) ist ein benannter Backend-Follow-up (W4) und wird hier NICHT
// vorgetaeuscht (kein Fake-Charge). Der Hinweis-Block unten macht das transparent.
//
// W2: Tier-Korrektur umgesetzt (Business = 1 Nummer, Q-ABO); der CTA funnelt
// ueber LOGIN_URL. Echter Checkout = W4.
import Site from "../layouts/Site.astro";
import { LOGIN_URL } from "../lib/routes.js";

const plans = [
  {
    name: "Starter",
    price: "$4.99",
    cadence: "per month",
    featured: false,
    features: [
      "30 minutes of calls per month",
      "1 phone number",
      "Answer and summarise calls",
      "Call history in your area",
    ],
  },
  {
    name: "Business",
    price: "$9.99",
    cadence: "per month",
    featured: true,
    features: [
      "120 minutes of calls per month",
      "1 phone number",
      "Outgoing calls on your behalf",
      "Priority support",
    ],
  },
];
---

<Site
  title="Pricing — Sundartha Hermes"
  description="Two clear plans for Hermes: Starter and Business. Call minutes, phone numbers and support at a glance."
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">Plans</span>
      <h1 class="hero__title">Pricing that <span class="highlight">grows with you</span></h1>
      <p class="hero__lead">
        Start small and unlock more as your assistant takes on more. No hidden
        costs.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="pricing">
        {plans.map((plan) => (
          <article class={plan.featured ? "plan plan--featured" : "plan"}>
            {plan.featured && <span class="badge badge--accent">Popular</span>}
            <h2 class="plan__name">{plan.name}</h2>
            <p class="plan__price">{plan.price} <small>{plan.cadence}</small></p>
            <ul class="plan__features">
              {plan.features.map((feature) => (
                <li class="plan__feature">{feature}</li>
              ))}
            </ul>
            <a class="button button--primary plan__cta" href={LOGIN_URL}>Choose plan</a>
          </article>
        ))}
      </div>

      <div class="note">
        <h2 class="note__title">How billing works</h2>
        <p class="note__text">
          You start your monthly subscription after signing in. Your card is
          charged only for the plan you choose; nothing is charged without your
          consent.
        </p>
      </div>
    </div>
  </section>
</Site>
