---
// App-Shell (/app): Einstiegspunkt nach dem Login. Hostet die Auth-Insel und
// zeigt -- je nach gemeldetem Auth-Zustand -- genau eine Region: Laden / anonym /
// wartet auf Freigabe / Fehler / eingeloggte Shell. Die Shell beweist den
// Roundtrip, indem sie echte Tenant-Daten aus /api/self-service/state zeigt
// (Rufnummer, Besitzer). Die leeren Slots fuellt W4 (Anrufe/Items/Kalender).
import App from "../../layouts/App.astro";
import AuthIsland from "../../components/app/AuthIsland.astro";
import BillingIsland from "../../components/app/BillingIsland.astro";
import SettingsIsland from "../../components/app/SettingsIsland.astro";
import AgentChip from "../../components/app/AgentChip.astro";
import CallsIsland from "../../components/app/CallsIsland.astro";
import ActionItemsIsland from "../../components/app/ActionItemsIsland.astro";
import CalendarIsland from "../../components/app/CalendarIsland.astro";
---

<App title="Hermes — App">
  <AuthIsland slot="auth" />

  <!-- Auth-Gate: genau eine Region sichtbar. Default = "Laden" (vor JS / bis der
       erste state-Fetch antwortet). Die Insel meldet den Zustand per Event. -->
  <section id="region-loading" class="card">
    <p class="muted">Lade…</p>
  </section>

  <section id="region-anonymous" class="card" hidden>
    <h1>Anmeldung erforderlich</h1>
    <p>Bitte melde dich an, um deinen Telefon-Assistenten zu verwalten.</p>
    <a class="btn" href="/auth/login">Anmelden</a>
  </section>

  <section id="region-pending" class="card" hidden>
    <h1>Konto wartet auf Freigabe</h1>
    <p>Dein Zugang wurde angelegt und wartet auf die Freischaltung. Sobald er
      aktiv ist, erscheint hier dein Assistent.</p>
  </section>

  <section id="region-error" class="card" hidden>
    <h1>Etwas ist schiefgelaufen</h1>
    <p>Die App konnte gerade nicht geladen werden. Bitte versuche es spaeter erneut.</p>
  </section>

  <!-- Eingeloggte Shell. W2 zeigt nur den Beweis (echte Tenant-Daten); die
       leere Karte ist der Slot, in den W4 Anrufe/Items/Kalender haengt. -->
  <div id="region-shell" hidden>
    <section class="card">
      <h1>Dein Assistent</h1>
      <!-- W4: Rufnummer + Live-Dot als eigene Insel (hoert auf AUTH_EVENT). -->
      <AgentChip />
      <dl class="kv">
        <dt>Besitzer</dt>
        <dd id="shell-owner">—</dd>
      </dl>
    </section>

    <!-- W5: Settings-Editor (der EINZIGE Schreibpfad). Bietet AUSSCHLIESSLICH die
         Whitelist-Felder an (greeting nur als Vorlage, kein Freitext). Hoert auf
         AUTH_EVENT, re-fetcht nach Speichern ueber lib/api.js. -->
    <SettingsIsland />

    <!-- W4: read-only Datensicht aus dem EINEN state-Fetch (AUTH_EVENT). Anrufe
         breit, Action Items + Kalender daneben. Jede Insel leert sich bei
         Auth-Verlust selbst (kein stale Tenant-Datenleck). -->
    <CallsIsland />
    <div class="shell-cols">
      <ActionItemsIsland />
      <CalendarIsland />
    </div>

    <!-- W3: Billing-Insel (NUR Karte hinterlegen). Versteckt sich selbst, solange
         der Server kein hasCard liefert (PAYMENT_ENABLED aus) -> byte-identisch
         zum Bestand. Sie hoert auf AUTH_EVENT, kein zweiter state-Fetch. -->
    <BillingIsland />
  </div>

  <noscript>
    <p>Diese App benoetigt JavaScript.</p>
  </noscript>
</App>

<script>
  import { AUTH_STATE, AUTH_EVENT, agentInfo } from "../../lib/api.js";

  // Region pro Auth-Zustand. "Laden" ist separat (Default vor dem ersten Event).
  const regions = {
    [AUTH_STATE.ANONYMOUS]: document.getElementById("region-anonymous"),
    [AUTH_STATE.PENDING]: document.getElementById("region-pending"),
    [AUTH_STATE.AUTHENTICATED]: document.getElementById("region-shell"),
    [AUTH_STATE.ERROR]: document.getElementById("region-error"),
  };
  const loadingRegion = document.getElementById("region-loading");
  const ownerEl = document.getElementById("shell-owner");

  function showOnly(activeState) {
    loadingRegion.hidden = true;
    for (const [state, el] of Object.entries(regions)) {
      el.hidden = state !== activeState;
    }
  }

  // Die Rufnummer + der Live-Dot leben jetzt in der AgentChip-Insel (W4); die
  // Shell zeigt nur noch den Besitzer als Eckdatum. Beide hoeren auf dasselbe
  // AUTH_EVENT (ein state-Fetch).
  function fillShell(data) {
    const { owner } = agentInfo(data);
    ownerEl.textContent = owner || "—";
  }

  // Listener synchron registrieren, BEVOR die Auth-Insel (hinter ihrem fetch)
  // dispatcht -- so geht kein Event verloren.
  document.addEventListener(AUTH_EVENT, (event) => {
    const { state, data } = event.detail;
    if (state === AUTH_STATE.AUTHENTICATED) fillShell(data);
    showOnly(state);
  });
</script>
