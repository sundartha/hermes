---
// App-Shell (/app): Einstiegspunkt nach dem Login. Hostet die Auth-Insel und
// zeigt -- je nach gemeldetem Auth-Zustand -- genau eine Region: Laden / anonym /
// wartet auf Freigabe / Fehler / eingeloggte Shell. Die Shell zeigt echte
// Tenant-Daten aus /api/self-service/state (Begruessung, Statistik, Verlauf,
// Einstellungen, Karte). KEIN eigener state-Fetch je Insel -- die Auth-Insel
// ermittelt den Zustand einmal und verteilt ihn per AUTH_EVENT.
import App from "../../layouts/App.astro";
import { LOGIN_URL } from "../../lib/routes.js";
import AuthIsland from "../../components/app/AuthIsland.astro";
import BillingIsland from "../../components/app/BillingIsland.astro";
import SettingsIsland from "../../components/app/SettingsIsland.astro";
import AgentChip from "../../components/app/AgentChip.astro";
import DashboardStats from "../../components/app/DashboardStats.astro";
import CallsIsland from "../../components/app/CallsIsland.astro";
import ActionItemsIsland from "../../components/app/ActionItemsIsland.astro";
import CalendarIsland from "../../components/app/CalendarIsland.astro";

// In-App-Navigation: Anker auf die Bereiche der Shell (reine Links, kein JS). Die
// #anrufe/#einstellungen/#abrechnung-Anker bleiben (interne ids, nicht user-facing).
const dashNav = [
  { href: "#stats", label: "Overview" },
  { href: "#anrufe", label: "Calls" },
  { href: "#einstellungen", label: "Settings" },
  { href: "#abrechnung", label: "Billing" },
];
---

<App title="Hermes — App">
  <AuthIsland slot="auth" />

  <!-- Auth-Gate: genau eine Region sichtbar. Default = "Laden" (vor JS / bis der
       erste state-Fetch antwortet). Die Insel meldet den Zustand per Event. Nur
       die eingeloggte Shell zeigt Tenant-Daten -- das ist das Gate. -->
  <section id="region-loading" class="card">
    <p class="muted">Loading…</p>
  </section>

  <section id="region-anonymous" class="card" hidden>
    <h1>Sign in required</h1>
    <p>Please sign in to manage your phone assistant.</p>
    <a class="btn" href={LOGIN_URL}>Sign in</a>
  </section>

  <!-- Suspended-Pfad (P2): wartet auf Aktivierung. Bei PAYMENT_ENABLED rendert das
       Script die Plan-Kacheln (billing/status, suspended-erreichbar) -> der Tenant
       aktiviert sich per Abo selbst. Ohne Payment bleibt der Wartetext. -->
  <section id="region-pending" class="card" hidden>
    <h1 id="pending-title">Account awaiting activation</h1>
    <p id="pending-text">Your account has been created and is awaiting activation.
      Once it's active, your assistant will appear here.</p>
    <div id="pending-tiles" class="plans"></div>
    <p id="pending-msg" class="billing-msg" hidden></p>
    <!-- AM3: sekundaerer "Maybe later"-Skip, nur im Payment-Aktivierungs-Pfad sichtbar.
         Rein praesentational - aktiviert NICHTS (kein subscribe/setStatus, /state bleibt 403). -->
    <button id="pending-skip" class="plan-skip" type="button" hidden>Maybe later</button>
  </section>

  <section id="region-error" class="card" hidden>
    <h1>Something went wrong</h1>
    <p>The app couldn't load just now. Check your connection and try again.</p>
    <button id="error-retry" class="btn" type="button">Try again</button>
  </section>

  <!-- Eingeloggte Shell: Begruessung + Statistik + Verlauf + Einstellungen + Karte. -->
  <div id="region-shell" hidden>
    <header class="dash-head card">
      <div class="dash-head__intro">
        <span class="dash-head__eyebrow">Your area</span>
        <h1 class="dash-head__title">Welcome, <span id="shell-owner">—</span></h1>
        <!-- W4: Rufnummer + Live-Dot als eigene Insel (hoert auf AUTH_EVENT). -->
        <AgentChip />
      </div>
    </header>

    <nav class="dash-nav" aria-label="Section navigation">
      {dashNav.map((item) => (
        <a class="dash-nav__link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <!-- W3: abgeleitete Kennzahlen (Anzahl/Woche/Monat/Dauer) aus dem state. -->
    <DashboardStats />

    <!-- W4: read-only Anruf-Verlauf aus dem EINEN state-Fetch (AUTH_EVENT). -->
    <div id="anrufe">
      <CallsIsland />
    </div>
    <div class="shell-cols">
      <ActionItemsIsland />
      <CalendarIsland />
    </div>

    <!-- W5: Settings-Editor (der EINZIGE Schreibpfad), nur Whitelist-Felder. -->
    <div id="einstellungen">
      <SettingsIsland />
    </div>

    <!-- W3: Billing-Insel (NUR Karte hinterlegen). Versteckt sich selbst, solange
         der Server kein hasCard liefert (PAYMENT_ENABLED aus). -->
    <div id="abrechnung">
      <BillingIsland />
    </div>
  </div>

  <noscript>
    <p>This app requires JavaScript.</p>
  </noscript>
</App>

<script>
  import { AUTH_STATE, AUTH_EVENT, agentInfo, fetchBillingStatus, numberSetupFeeFrom } from "../../lib/api.js";
  import { wireSubscribe, renderPlanChoice, dismissPlanChoice } from "../../lib/subscribe.js";

  // Region pro Auth-Zustand. "Laden" ist separat (Default vor dem ersten Event).
  const regions = {
    [AUTH_STATE.ANONYMOUS]: document.getElementById("region-anonymous"),
    [AUTH_STATE.PENDING]: document.getElementById("region-pending"),
    [AUTH_STATE.AUTHENTICATED]: document.getElementById("region-shell"),
    [AUTH_STATE.ERROR]: document.getElementById("region-error"),
  };
  const loadingRegion = document.getElementById("region-loading");
  const ownerEl = document.getElementById("shell-owner");

  // Retry bei Netz-/Server-Fehler: neu laden -> die Auth-Insel fetcht den state
  // erneut (kein Insel-uebergreifendes Coupling noetig).
  const retryBtn = document.getElementById("error-retry");
  if (retryBtn) retryBtn.addEventListener("click", () => window.location.reload());

  function showOnly(activeState) {
    loadingRegion.hidden = true;
    for (const [state, el] of Object.entries(regions)) {
      el.hidden = state !== activeState;
    }
  }

  // Begruessung mit dem Besitzer-Namen; Rufnummer/Live-Dot liefert die AgentChip-
  // Insel (W4). Beide hoeren auf dasselbe AUTH_EVENT (ein state-Fetch).
  function fillShell(data) {
    const { owner } = agentInfo(data);
    ownerEl.textContent = owner || "—";
  }

  // Suspended-Pfad (P2): die Aktivierungs-Region. Holt den schlanken Billing-Status
  // (suspended-erreichbar, webAuthPendingMw) und rendert bei PAYMENT_ENABLED dieselben
  // Plan-Kacheln wie der aktive Pfad -> der Tenant aktiviert sich per Abo selbst. Sonst
  // bleibt der uebersetzte Wartetext (literal port von tenant.html renderActivation).
  const pendingTextEl = document.getElementById("pending-text");
  const pendingTilesEl = document.getElementById("pending-tiles");
  const pendingMsgEl = document.getElementById("pending-msg");
  // Element-Buendel fuer die reinen Aktivierungs-Helfer (renderPlanChoice/dismissPlanChoice).
  const pendingEls = {
    title: document.getElementById("pending-title"),
    subtitle: pendingTextEl,
    tiles: pendingTilesEl,
    skip: document.getElementById("pending-skip"),
  };

  function showPendingMessage(text) {
    pendingMsgEl.textContent = text;
    pendingMsgEl.hidden = !text;
  }

  async function renderPending() {
    let status;
    try {
      status = await fetchBillingStatus();
    } catch {
      return; // 401/Netzfehler -> Wartetext bleibt (kein Leak, kein Crash)
    }
    if (!status.paymentEnabled) return; // ohne Payment: byte-identisch (Wartetext, kein Skip)
    // AM3: Plan-Auswahl ist der prominente Default (H1 "Choose your plan" + Kacheln + Skip).
    renderPlanChoice(document, pendingEls, numberSetupFeeFrom(status));
  }

  // "Maybe later": rein praesentational -> Plan-Auswahl ausblenden, Pending-Banner zeigen.
  // Kein subscribe/setStatus (aktiviert nichts, /state bleibt 403).
  pendingEls.skip.addEventListener("click", () => dismissPlanChoice(pendingEls));

  // EIN delegierter Subscribe-Listener am stabilen Kachel-Container (G5, kein Binding
  // pro Button). Nach erfolgreicher Buchung wird der Tenant aktiv -> ein Reload zieht
  // die volle Shell (die meisten suspended-Tenants laufen aber ueber 409 no_card ->
  // gefuehrter Stripe-Checkout -> Rueckkehr aktiviert).
  wireSubscribe(pendingTilesEl, {
    onSubscribed: () => window.location.reload(),
    onMessage: showPendingMessage,
  });

  // Listener synchron registrieren, BEVOR die Auth-Insel (hinter ihrem fetch)
  // dispatcht -- so geht kein Event verloren.
  document.addEventListener(AUTH_EVENT, (event) => {
    const { state, data } = event.detail;
    if (state === AUTH_STATE.AUTHENTICATED) fillShell(data);
    if (state === AUTH_STATE.PENDING) renderPending();
    showOnly(state);
  });
</script>
