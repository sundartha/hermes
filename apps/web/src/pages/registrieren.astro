---
// Marketing: Sign up (SSG). KEIN Self-Service-Registrierungsformular —
// das Backend kennt keinen Signup-Endpunkt (Strategie R2): ein Konto entsteht
// beim ersten Login über den Gateway-OIDC-Flow (LOGIN_URL). Aktiv wird es über
// den Q-APPROVAL-Flow (erst Abo, dann live) — kein Admin-Review. Diese Seite
// erklärt genau diesen Ablauf und funnelt nach LOGIN_URL. KEIN Client-Fetch,
// kein Formular, das gegen einen nicht existierenden Endpunkt liefe.
//
// Texte wortgleich aus der Vorfassung übernommen — nur die Hülle ist neu.
import Hermes from "../layouts/Hermes.astro";
import { LOGIN_URL } from "../lib/routes.js";
import { homeHref } from "../lib/home-anchors.js";

const steps = [
  {
    num: "01",
    title: "Sign in",
    text: "You start by signing in through our secure login. There is no password form of your own — sign-in runs through your linked account.",
  },
  {
    num: "02",
    title: "Choose your plan",
    text: "After your first sign-in we create your account. To activate it you pick a plan and start your monthly subscription — your assistant goes live once the subscription is set up.",
  },
  {
    num: "03",
    title: "Activation",
    text: "With an active subscription your assistant appears in your area. You set the phone number, permissions and greeting, and you are ready to go.",
  },
];
---

<Hermes
  title="Sign up — Sundartha Hermes"
  description="How to set up your Hermes account: sign in, a short review, activation. Then you connect your AI agent to a real phone line."
  lang="en"
>
  <span class="doc-eyebrow">Create account</span>
  <h1 class="doc-title">Up and running in <em>minutes</em>.</h1>
  <p class="doc-lead">
    Hermes has no classic registration form. You sign in, choose a plan and
    start your subscription — then the phone assistant is yours.
  </p>
  <div class="doc-actions">
    <a class="btn-solid" href={LOGIN_URL}>Sign in now</a>
    <a class="btn-ghost" href={homeHref("preise")}>View pricing</a>
  </div>

  <div class="doc-block doc-steps">
    <div class="sheet__card">
      {steps.map((step, index) => (
        <>
          {index > 0 && <span class="rule" aria-hidden="true"></span>}
          <span class="step">
            <span class="step__num">{step.num}</span>
            <span class="step__body">
              <span class="step__title">{step.title}</span>
              <span class="step__text">{step.text}</span>
            </span>
          </span>
        </>
      ))}
    </div>
  </div>

  <p class="doc-note">
    Already have an account? <a href={LOGIN_URL}>Sign in</a> and manage your
    assistant directly in your area.
  </p>
</Hermes>
