---
// Marketing: Sign up (SSG). KEIN Self-Service-Registrierungsformular —
// das Backend kennt keinen Signup-Endpunkt (Strategie R2): ein Konto entsteht
// beim ersten Login ueber den Gateway-OIDC-Flow (/auth/login) und ist danach
// erst nach Admin-Freigabe nutzbar (bis dahin "in Pruefung"). Diese Seite
// erklaert genau diesen Ablauf und funnelt nach /auth/login. KEIN Client-Fetch,
// kein Formular, das gegen einen nicht existierenden Endpunkt liefe.
import Site from "../layouts/Site.astro";

const steps = [
  {
    title: "Sign in",
    text: "You start by signing in through our secure login. There is no password form of your own — sign-in runs through your linked account.",
  },
  {
    title: "Account is reviewed",
    text: "After your first sign-in we create your account and review it briefly. That protects the phone network from misuse — Hermes places real calls and incurs real costs.",
  },
  {
    title: "Activation",
    text: "Once your account is approved, your assistant appears in your area. You set the phone number, permissions and greeting, and you are ready to go.",
  },
];
---

<Site
  title="Sign up — Sundartha Hermes"
  description="How to set up your Hermes account: sign in, a short review, activation. Then you connect your AI agent to a real phone line."
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">Create account</span>
      <h1 class="hero__title">Up and running in <span class="highlight">minutes</span></h1>
      <p class="hero__lead">
        Hermes has no classic registration form. You sign in, we review your
        account briefly and activate it — then the phone assistant is yours.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="/auth/login">Sign in now</a>
        <a class="button button--ghost" href="/preise">View pricing</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">How it goes</span>
        <h2 class="section__title">From login to your own agent</h2>
      </div>
      <div class="grid grid--three">
        {steps.map((step, index) => (
          <article class="card">
            <span class="step__index" aria-hidden="true">{index + 1}</span>
            <h3 class="card__title">{step.title}</h3>
            <p class="card__text">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">Already have an account?</h2>
        <p class="section__lead">
          Sign in and manage your assistant directly in your area.
        </p>
      </div>
      <div class="hero__actions">
        <a class="button button--primary" href="/auth/login">Sign in</a>
        <a class="button button--action" href="/so-funktionierts">How it works</a>
      </div>
    </div>
  </section>
</Site>
