---
// Marketing: Impressum (SSG). Geruest mit Platzhalter-Inhalt — die
// verbindlichen Angaben (Anbieterkennzeichnung) liefert der Owner (N1, geflaggt).
import Site from "../layouts/Site.astro";

const sections = [
  {
    heading: "Anbieter",
    text: "Sundartha — Anbieter des Telefon-Assistenten Hermes. Die vollstaendige Anschrift und Rechtsform ergaenzt der finale Impressums-Text.",
  },
  {
    heading: "Kontakt",
    text: "E-Mail: kontakt@sundartha.com. Weitere Kontaktwege folgen mit der finalen Fassung.",
  },
  {
    heading: "Verantwortlich fuer den Inhalt",
    text: "Die verantwortliche Person nach den geltenden Vorgaben benennt Sundartha in der finalen Fassung.",
  },
];
---

<Site
  lang="de"
  title="Impressum — Sundartha Hermes"
  description="Anbieterkennzeichnung und Kontaktangaben zu Sundartha Hermes."
>
  <section class="section">
    <div class="container">
      <div class="legal">
        <span class="eyebrow">Rechtliches</span>
        <h1 class="section__title">Impressum</h1>
        <p class="legal__note">
          Platzhalter-Fassung. Die rechtsverbindliche Anbieterkennzeichnung
          liefert Sundartha.
        </p>
        {sections.map((section) => (
          <>
            <h2 class="legal__heading">{section.heading}</h2>
            <p class="legal__text">{section.text}</p>
          </>
        ))}
      </div>
    </div>
  </section>
</Site>
