---
// Hermes-Startseite — Redesign nach dem freigegebenen Design-Canvas v64
// (x-dc-Canvas, Desktop 1440 fluide, Handy dieselbe Seite bei 390).
//
// Die Canvas stylt ueber inline style="..."-Attribute und steuert ueber onClick.
// Unter der Produktions-CSP des Static-Service (default-src 'self'; script-src
// 'self') waere davon nichts wirksam. Darum hier dieselbe Seite mit externem
// Stylesheet (styles/home.css) und externem Modul (scripts/home.js).
// Kein Inline-Style, kein Inline-Script ausser JSON-LD.
//
// Standalone-Dokument (KEIN Site-Layout): die Navigation liegt transparent ueber
// dem Hero, die Seite hat ein eigenes Fussband.
//
// Sprache: Englisch steht im Markup (indexierte Fassung). Deutsch liegt als
// Woerterbuch in scripts/home.js ([data-i18n], [data-i18n-attr]) und wird per
// EN/DE-Umschalter im Fuss zur Laufzeit eingesetzt (lib/i18n.js, Key hermes.lang.v2).
// Werte aus Katalog und Konstanten (Preise, Kuendigungs-Wortlaut) stehen in beiden
// Sprachen im HTML (BiText, [data-lang-only]); sichtbar ist die zu <html lang> passende.
import "../styles/fonts.css";
import "../styles/home.css";
import "../styles/home-sound.css";
import "../styles/home-proof.css";
import "../styles/lang-only.css";
import CookieConsent from "../components/site/CookieConsent.astro";
import AnalyticsSlot from "../components/site/AnalyticsSlot.astro";
import BiText from "../components/site/BiText.astro";
import { CANCEL_URL, LOGIN_URL } from "../lib/routes.js";
import { CANCEL_BUTTON_LABEL, CANCEL_BUTTON_LABEL_EN } from "../lib/subscribe.js";
import { PLAN_CATALOG, formatPlanPrice } from "../lib/plans.js";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { VIDEO_WIDE_SUFFIX, VOICE_LANGS, VOICE_SCRIPT, voiceCaptionFile, voiceFilesFor } from "../lib/home-voice.js";
// MCP-URL, Befehl, Claude-Link und Agenten-Satz kommen aus lib/agent-docs.js -
// derselben Quelle wie /index.md, /llms.txt und der Skill. Der Agenten-Satz ist
// bewusst immer Englisch: er richtet sich an das Modell, nicht an den Menschen.
import {
  AGENT_GUIDE_URL,
  CLAUDE_CONNECT_URL,
  CHATGPT_PLUGINS_URL,
  CONTACT_EMAIL,
  MCP_CMD,
  MCP_URL,
  SITE_AGENT_LINE,
  SITE_AGENT_PROMPT,
  SITE_URL,
} from "../lib/agent-docs.js";

const title = "Hermes — Give your AI a phone number";
const description =
  "Hermes answers calls and handles them for you — so your AI finally has a voice.";

// Strukturierte Daten (schema.org) fuer Suchmaschinen und KI-Suche: Firma + Produkt
// mit den Tarifen aus dem Katalog. Reiner Datenblock (application/ld+json), kein Skript.
const CENTS_PER_EURO = 100;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE_URL}/#org`, name: "Sundartha", url: `${SITE_URL}/`, email: CONTACT_EMAIL, logo: `${SITE_URL}/apple-touch-icon.png` },
    {
      "@type": "SoftwareApplication",
      name: "Hermes by Sundartha",
      url: `${SITE_URL}/`,
      description,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      publisher: { "@id": `${SITE_URL}/#org` },
      offers: PLAN_CATALOG.map((plan) => ({
        "@type": "Offer",
        name: plan.name,
        price: (plan.amountCents / CENTS_PER_EURO).toFixed(2),
        priceCurrency: plan.currency.toUpperCase(),
        description: `${plan.includedMinutes} minutes of calls per month`,
      })),
    },
  ],
};

// Tarife: Preis (EN/DE-Notation), Minuten und Nummern aus dem Katalog, nie hart codiert.
const plans = PLAN_CATALOG.map((plan) => ({
  ...plan,
  priceEn: formatPlanPrice(plan.amountCents, plan.currency, "en"),
  priceDe: formatPlanPrice(plan.amountCents, plan.currency, "de"),
}));
const starter = plans.find((plan) => !plan.featured);
const pro = plans.find((plan) => plan.featured);
const tiers = [starter, pro];

// Vergleichszeilen: true = enthalten, false = nicht enthalten, sonst der Zellwert.
// { i18n } verweist auf einen Woerterbuch-Eintrag in scripts/home.js.
const rows = [
  { key: "rowNumber", label: "Your own phone number", cells: tiers.map((plan) => plan.numberCount) },
  { key: "rowMinutes", label: "Call minutes per month", cells: tiers.map((plan) => plan.includedMinutes) },
  { key: "rowAnswers", label: "Answers your calls", cells: [true, true] },
  { key: "rowSummaries", label: "Call summaries", cells: [true, true] },
  { key: "rowCalls", label: "Makes calls for you", cells: [false, true] },
  { key: "rowTasks", label: "Takes care of tasks on its own", cells: [false, true] },
  { key: "rowSupport", label: "Support", cells: [{ i18n: "supportEmail", text: "Email" }, { i18n: "supportPriority", text: "Priority" }] },
];

// Terminal-Befehl in drei nicht umbrechende Teile (Befehl, Optionen, URL) - aus MCP_CMD
// abgeleitet, damit die Anzeige nie vom kopierten Befehl abweicht.
const cmdParts = MCP_CMD.split(" ");
const cmdGroups = [cmdParts.slice(0, 3).join(" "), cmdParts.slice(3, -1).join(" "), cmdParts.at(-1)];

const useCases = [
  {
    clip: "uc1",
    start: "0.42",
    preload: "metadata",
    flip: false,
    labelKey: "uc1Label",
    label: "I · Hermes answers",
    titleKey: "uc1Title",
    title: "You're in a meeting. Anna calls.",
    videoKey: "uc1Video",
    video:
      "Mara presents in a meeting while her phone rings on the table and the call goes to Hermes; Anna leaves a message with Hermes and hangs up smiling; Mara steps out and reads the summary",
    ch: "0,3.3,12.2",
    steps: [
      { key: "uc1s1", text: "Anna calls your Hermes number.", noteKey: "uc1s1n", note: "Your phone rings on the table. You keep presenting." },
      { key: "uc1s2", text: "Hermes picks up and talks to Anna.", noteKey: "uc1s2n", note: "“Tell Mara the contract is ready. She can call me back after 4 pm.”" },
      { key: "uc1s3", text: "You step out. The summary is waiting." },
    ],
    result: { arrive: "12.6", timeKey: "now", time: "now", titleKey: "uc1n", title: "Anna called: the contract is ready.", bodyKey: "uc1nb", body: "Call her back after 4 pm." },
  },
  {
    clip: "uc2",
    start: "0.42",
    preload: "none",
    flip: true,
    labelKey: "uc2Label",
    label: "II · Hermes books",
    titleKey: "uc2Title",
    title: "Anna wants a meeting. Hermes books it.",
    videoKey: "uc2Video",
    video:
      "Anna phones from a sunny piazza and asks for a meeting next week. While she is on the line, Hermes finds Wednesday fully booked and Thursday morning taken, and offers Thursday at 14:30; Anna accepts, gets the confirmation and leans back.",
    ch: "0,6.8,13.95",
    steps: [
      { key: "uc2s1", text: "Anna calls and asks for half an hour with you.", noteKey: "uc2s1n", note: "“Does Mara have half an hour for me next week?”" },
      { key: "uc2s2", text: "Hermes checks your calendar while she's on the line.", noteKey: "uc2s2n", note: "Wednesday is full, Thursday morning is taken. “Thursday 14:30 instead?”" },
      { key: "uc2s3", text: "Thursday 14:30, booked. Anna gets the confirmation." },
    ],
    result: { arrive: "15", timeKey: "now", time: "now", titleKey: "uc2n", title: "Booked: Thursday 14:30 with Anna.", bodyKey: "uc2nb", body: "Confirmation sent." },
  },
  {
    clip: "uc3",
    start: "0.5",
    preload: "none",
    flip: false,
    labelKey: "uc3Label",
    label: "III · Hermes calls for you",
    titleKey: "uc3Title",
    title: "Let Hermes call the hairdresser.",
    videoKey: "uc3Video",
    video:
      "Mara types the request on her laptop; the receptionist at Salon Mia takes Hermes' call; Mara reaches for her coffee",
    ch: "0,2.7,7.95",
    steps: [
      { key: "uc3s1", text: "You ask in Claude and tap Confirm.", noteKey: "uc3s1n", note: "“Book me a haircut at Salon Mia on Thursday morning.”" },
      { key: "uc3s2", text: "Only then does Hermes call Salon Mia.", noteKey: "uc3s2n", note: "“Hi, I'm Hermes, an AI assistant calling for Mara.”" },
      { key: "uc3s3", text: "Hermes books it while you finish your coffee." },
    ],
    proof: [
      { at: "0", key: "uc3p1", text: "Request" },
      { at: "0.9", key: "uc3p2", text: "Confirmed" },
      { at: "2.7", key: "uc3p3", text: "Call" },
    ],
    result: { arrive: "6.8", timeKey: "ago2m", time: "2m ago", titleKey: "uc3n", title: "Booked: Thursday 10:00 at Salon Mia.", bodyKey: "uc3nb", body: "The summary is in Claude." },
  },
  {
    clip: "uc4",
    start: "0.42",
    preload: "none",
    flip: true,
    labelKey: "uc4Label",
    label: "IV · Hermes reports back",
    titleKey: "uc4Title",
    title: "Everything lands in one place.",
    videoKey: "uc4Video",
    video:
      "Mara sits in a café in daylight, reads her phone with a smile, puts it face down and sits back",
    ch: null,
    steps: [
      { key: "uc4s1", text: "After the meeting, open your dashboard." },
      { key: "uc4s2", text: "Every call Hermes took or made, in a few lines.", noteKey: "uc4s2n", note: "Your call summaries, at a glance.", noteDesktopOnly: true },
    ],
    dashboard: [
      { dir: "in", time: "10:42", who: "Anna · Berger & Co.", key: "dash1", text: "Contract is ready. Call back after 4 pm." },
      { dir: "in", time: "10:58", who: "Anna · Berger & Co.", key: "dash2", text: "Booked Thursday 14:30. Confirmation sent." },
      { dir: "out", time: "11:20", who: "Salon Mia", key: "dash3", text: "Haircut booked for Thursday 10:00." },
    ],
  },
];

// Ton (apps/web/scripts/home-voice.js legt ihn in die Videodateien und schreibt die Untertitel):
// Ton-Schalter und Untertitel erscheinen nur fuer Szenen, deren Untertitel-Datei im Ordner liegt.
const WIDE_VIDEO = "(min-width: 1001px) and (min-resolution: 1.5dppx), (min-width: 1700px)";
const VIDEO_TYPES = [
  { suffix: `${VIDEO_WIDE_SUFFIX}.av1.mp4`, type: 'video/mp4; codecs="av01.0.08M.08"', media: WIDE_VIDEO },
  { suffix: `${VIDEO_WIDE_SUFFIX}.mp4`, type: 'video/mp4; codecs="avc1.640028"', media: WIDE_VIDEO },
  { suffix: ".av1.mp4", type: 'video/mp4; codecs="av01.0.05M.08"' },
  { suffix: ".mp4", type: 'video/mp4; codecs="avc1.640028"' },
];
const CAPTION_LABELS = { en: "English" };
const voiceDir = join(process.cwd(), "public/assets/home");
const hasVoice = (clip) => voiceFilesFor(clip).every((file) => existsSync(join(voiceDir, file)));
const sceneName = (uc) => uc.label.replace(/^[IV]+ · /, "");
const GERMAN_CAPTIONS = "de";
const hasDialogue = (clip) => hasVoice(clip) && VOICE_SCRIPT[clip].en.length > 0;
const hasGermanCaptions = (clip) => hasDialogue(clip) && existsSync(join(voiceDir, voiceCaptionFile(clip, GERMAN_CAPTIONS)));

// Fussband: Rechtslinks EN /legal/*, in der DE-Ansicht die verbindlichen deutschen Seiten
// (scripts/home.js tauscht href ueber data-href-de).
const legalLinks = [
  { cls: "f-imp", key: "imprint", label: "Imprint", href: "/legal/imprint", hrefDe: "/impressum" },
  { cls: "f-priv", key: "privacy", label: "Privacy", href: "/legal/privacy", hrefDe: "/datenschutz" },
  { cls: "f-terms", key: "terms", label: "Terms", href: "/legal/terms", hrefDe: "/agb" },
];
const year = new Date().getFullYear();
const navLinks = [
  { href: "#idea", key: "navIdea", label: "The idea" },
  { href: "#uses", key: "navUses", label: "Use cases" },
  { href: "#pricing", key: "navPricing", label: "Pricing" },
  { href: "#setup", key: "navSetup", label: "Get started" },
];
const sectionDots = [
  { href: "#top", label: "Hermes" },
  { href: "#idea", key: "navIdea", label: "The idea" },
  { href: "#uses", key: "navUses", label: "Use cases" },
  { href: "#pricing", key: "navPricing", label: "Pricing" },
  { href: "#setup", key: "navSetup", label: "Get started" },
  { href: "#close", key: "navClose", label: "Give your AI wings" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#413530" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="alternate" type="text/markdown" href={new URL("/index.md", Astro.site)} title="This page as Markdown" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <link rel="alternate" type="text/markdown" href={new URL("/agents.md", Astro.site)} title="Setup guide for AI agents" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sundartha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main" data-i18n="skip">Skip to content</a>
    <div class="page">
      <header class="site-head">
        <nav class="wrap nav" aria-label="Main" data-i18n-attr="aria-label:navMain">
          <a href="#top" class="brand">
            <picture>
              <source type="image/webp" srcset="/assets/home/wing-128.webp" />
              <img src="/assets/home/wing-128.png" alt="" width="40" height="40" decoding="async" />
            </picture>
            <span class="brand-txt"><span class="brand-name">Hermes</span> <span class="brand-by">by Sundartha</span></span>
          </a>
          <div class="navlinks">
            {navLinks.map((link) => <a href={link.href} data-i18n={link.key}>{link.label}</a>)}
          </div>
          <div class="navact">
            <a class="hidem navlogin" href={LOGIN_URL} data-i18n="login">Log in</a>
            <a href="#pricing" class="btn b-ghost navcta" data-i18n="getNumber">Get a number</a>
            <button type="button" class="navmenu" aria-label="Open menu" aria-controls="m-menu" aria-expanded="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
            </button>
          </div>
        </nav>
        <div id="m-menu" class="msheet" hidden>
          {navLinks.map((link) => <a href={link.href} data-i18n={link.key}>{link.label}</a>)}
          <a href={LOGIN_URL} data-i18n="login">Log in</a>
        </div>
      </header>

      <nav class="sdots" aria-label="Sections" data-i18n-attr="aria-label:navSections">
        {sectionDots.map((dot) => (
          <a href={dot.href}><span class="sr" data-i18n={dot.key}>{dot.label}</span></a>
        ))}
      </nav>

      <main id="main" tabindex="-1">
        <section id="top" class="hero" data-snap>
          <div class="hmedia">
            <div class="heroimg">
              <div class="herozoom">
                <picture>
                  <source type="image/avif" srcset="/assets/home/hero-768.avif 768w, /assets/home/hero-1280.avif 1280w, /assets/home/hero-1536.avif 1536w" sizes="100vw" />
                  <source type="image/webp" srcset="/assets/home/hero-768.webp 768w, /assets/home/hero-1280.webp 1280w, /assets/home/hero-1536.webp 1536w" sizes="100vw" />
                  <img class="bg hero-img" src="/assets/home/hero-1280.webp" width="1536" height="1024" fetchpriority="high" decoding="async"
                    alt="Ancient columns below a snow-capped mountain at dusk" data-i18n-attr="alt:heroAlt" />
                </picture>
              </div>
            </div>
            <div class="hscrim-x" aria-hidden="true"></div>
            <div class="hscrim-y" aria-hidden="true"></div>
            <div class="hfade" aria-hidden="true"></div>
          </div>

          <div class="wrap hcontent">
            <div class="hcopy">
              <h1 class="serif h1" data-i18n="heroTitle">Give your AI a <em>phone&nbsp;number.</em></h1>
              <p class="in1 hlead"><span data-i18n="heroLead">Hermes answers calls and handles them for you — so your AI finally has a voice.</span><span class="hidem" data-i18n="heroLead2"> It takes messages, books appointments and calls businesses on your behalf.</span></p>
              <div class="in2 hbtns">
                <a href={CLAUDE_CONNECT_URL} target="_blank" rel="noopener noreferrer" class="btn b-stone"><span data-i18n="addClaude">Add to Claude</span><span class="sr" data-i18n="newTab"> (opens in new tab)</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13"></path><path d="M12 5l7 7-7 7"></path></svg>
                </a>
                <a href="#chatgpt" class="btn b-ghost" data-i18n="addChatgpt">Add to ChatGPT</a>
              </div>
            </div>
            <div class="in3 logos">
              <span class="logos-lbl" data-i18n="worksWith">Works with</span>
              <span class="logo"><img src="/assets/home/logo-claude.svg" alt="" width="22" height="22" />Claude</span>
              <span class="logo"><img src="/assets/home/logo-openai.svg" alt="" width="22" height="22" />ChatGPT</span>
              <span class="logo"><img src="/assets/home/logo-gemini.svg" alt="" width="22" height="22" />Gemini</span>
              <span class="logo"><img src="/assets/home/logo-copilot.svg" alt="" width="22" height="22" />Copilot</span>
            </div>
          </div>
        </section>

        <section id="idea" class="split idea" data-snap>
          <div class="idea-img clipin rvm">
            <picture>
              <source type="image/avif" srcset="/assets/home/idea-640.avif 640w, /assets/home/idea-1000.avif 1000w, /assets/home/idea-1800.avif 1800w" sizes="(max-width: 1000px) 100vw, 58vw" />
              <source type="image/webp" srcset="/assets/home/idea-640.webp 640w, /assets/home/idea-1000.webp 1000w, /assets/home/idea-1800.webp 1800w" sizes="(max-width: 1000px) 100vw, 58vw" />
              <img class="bg px idea-pic" src="/assets/home/idea-1000.webp" width="1800" height="1344" loading="lazy" decoding="async"
                alt="A woman working on a laptop at a travertine table under arched windows" data-i18n-attr="alt:ideaAlt" />
            </picture>
          </div>
          <div class="idea-txt">
            <span class="label lbl-muted rv" data-i18n="ideaLabel">The idea</span>
            <h2 class="serif idea-h rv" data-i18n="ideaTitle">Your AI already writes, plans and searches. <em>Now it can pick up the phone.</em></h2>
            <p class="idea-p rv" data-i18n="ideaText">Hermes gives your AI a real number. It answers your callers, calls businesses for you and tells you what was said.</p>
            <ol class="isteps rv">
              <li data-i18n="idea1"><b>Get a number.</b> A real phone number. Monthly, cancel any time.</li>
              <li data-i18n="idea2"><b>Connect your AI.</b> One tap in Claude. Works with ChatGPT, Gemini and Copilot too.</li>
              <li data-i18n="idea3"><b>Let it answer.</b> It picks up, books and calls for you.</li>
            </ol>
          </div>
          <span class="snap-end" aria-hidden="true"></span>
        </section>

        <section id="uses" class="pad dark uses" data-snap>
          <div class="wrap">
            <div class="g12 shead rv">
              <span class="label lbl-dark" data-i18n="usesLabel">Use cases</span>
              <h2 class="serif" data-i18n="usesTitle">What Hermes <em>does for you.</em></h2>
            </div>

            <div class="ucs">
              {useCases.map((uc, ucIndex) => (
                <article class:list={["g12", "scene", { flip: uc.flip }]} data-snap={ucIndex > 0 ? "" : undefined}>
                  <div class="vslot clipin rvm">
                    <video
                      class="bg"
                      data-clip={uc.clip}
                      data-start={uc.start}
                      poster={`/assets/home/${uc.clip}-poster-1280.webp`}
                      width="1280"
                      height="720"
                      muted
                      loop
                      playsinline
                      preload={uc.preload}
                      aria-label={uc.video}
                      data-i18n-attr={`aria-label:${uc.videoKey}`}
                    >
                      {VIDEO_TYPES.map((kind) => (
                        <source
                          src={`/assets/home/${uc.clip}${kind.suffix}`}
                          data-src-de={uc.germanCut ? `/assets/home/${uc.clip}-de${kind.suffix}` : undefined}
                          type={kind.type}
                          media={kind.media}
                        />
                      ))}
                      {hasVoice(uc.clip) &&
                        VOICE_LANGS.map((lang) => (
                          <track kind="captions" srclang={lang} label={CAPTION_LABELS[lang]} src={`/assets/home/${voiceCaptionFile(uc.clip, lang)}`} />
                        ))}
                      {hasGermanCaptions(uc.clip) && (
                        <track kind="subtitles" srclang="de" label="Deutsch" src={`/assets/home/${voiceCaptionFile(uc.clip, GERMAN_CAPTIONS)}`} />
                      )}
                    </video>
                    <img class="bg vposter" src={`/assets/home/${uc.clip}-poster-1280.webp`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
                    {uc.proof && (
                      <div class="vproof">
                        <span class="vproof-eg" data-i18n="example">Example</span>
                        <ol>
                          {uc.proof.map((status) => (
                            <li data-at={status.at} data-i18n={status.key}>{status.text}</li>
                          ))}
                        </ol>
                      </div>
                    )}
                    <div class="vfail" role="status" hidden>
                      <span data-i18n="videoFail">Video didn't load.</span>
                      <button type="button" class="vretry" data-i18n="videoRetry">Try again</button>
                    </div>
                    {hasDialogue(uc.clip) && <p class="vcap" aria-hidden="true" hidden></p>}
                    {hasVoice(uc.clip) && (
                      <button
                        type="button"
                        class="vsound"
                        aria-pressed="false"
                        aria-label={`Sound: ${sceneName(uc)}`}
                        hidden
                      >
                        <svg class="ic-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z"></path><path d="M16 9.5l5 5M21 9.5l-5 5"></path></svg>
                        <svg class="ic-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z"></path><path d="M15.5 9.2a4 4 0 0 1 0 5.6M18.2 6.8a7.5 7.5 0 0 1 0 10.4"></path></svg>
                        <span class="vsound-l">Sound</span>
                        <span class="vsound-s" aria-hidden="true">off</span>
                        <span class="vsound-n" aria-hidden="true" hidden>EN</span>
                      </button>
                    )}
                    {hasDialogue(uc.clip) && (
                      <button type="button" class="vcc" aria-pressed="false" aria-label={`Captions: ${sceneName(uc)}`} hidden>CC</button>
                    )}
                    <button type="button" class="vpause is-paused" aria-label={`Play video: ${uc.label.replace(/^[IV]+ · /, "")}`} hidden>
                      <svg class="ic-pause" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg>
                      <svg class="ic-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
                    </button>
                  </div>
                  <div class="s-body">
                    <div class="rv shd">
                      <span class="label lbl-dark" data-i18n={uc.labelKey}>{uc.label}</span>
                      <h3 class="serif" data-i18n={uc.titleKey}>{uc.title}</h3>
                    </div>
                    <ol class="flow rv" data-ch={uc.ch ?? undefined}>
                      {uc.steps.map((step, index) => (
                        <li>
                          <span class="fn">{index + 1}</span>
                          <span>
                            <span class="ft" data-i18n={step.key}>{step.text}</span>
                            {step.note && <span class:list={["fd", { xm: step.noteDesktopOnly }]} data-i18n={step.noteKey}>{step.note}</span>}
                          </span>
                        </li>
                      ))}
                    </ol>
                    {uc.result && (
                      <div class="result" role="group" aria-label="Notification from Hermes" data-i18n-attr="aria-label:notifLabel" data-arrive={uc.result.arrive}>
                        <span class="appicon">
                          <picture>
                            <source type="image/webp" srcset="/assets/home/wing-128.webp" />
                            <img src="/assets/home/wing-128.png" alt="" width="23" height="23" loading="lazy" decoding="async" />
                          </picture>
                        </span>
                        <div class="nbx">
                          <div class="nhead"><span class="napp">Hermes</span><span class="ntime" data-i18n={uc.result.timeKey}>{uc.result.time}</span></div>
                          <p class="nmsg"><span class="ntitle" data-i18n={uc.result.titleKey}>{uc.result.title}</span> <span class="nbody" data-i18n={uc.result.bodyKey}>{uc.result.body}</span></p>
                        </div>
                      </div>
                    )}
                    {uc.dashboard && (
                      <div class="call">
                        <div class="dhead">
                          <span class="who" data-i18n="dashTitle">Hermes dashboard</span><span class="eg" data-i18n="example">Example</span><span class="meta" data-i18n="dashMeta">Today · 3 calls</span>
                        </div>
                        <ul class="dash">
                          {uc.dashboard.map((row) => (
                            <li>
                              <span class="dir" aria-hidden="true">{row.dir === "in" ? "↘" : "↗"}</span>
                              <span class="sr" data-i18n={row.dir === "in" ? "callIn" : "callOut"}>{row.dir === "in" ? "Incoming call" : "Outgoing call"}</span>
                              <span class="meta">{row.time}</span>
                              <span><span class="dn">{row.who}</span><span class="dd" data-i18n={row.key}>{row.text}</span></span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
            <div class="ucdots" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i><span class="ucdots-lbl" data-i18n="swipe">Swipe for more</span></div>
          </div>
          <span class="snap-end" aria-hidden="true"></span>
        </section>

        <section id="pricing" class="pad dark pricing" data-snap>
          <picture>
            <source type="image/avif" srcset="/assets/home/pricing-960.avif 960w, /assets/home/pricing-1800.avif 1800w" sizes="100vw" />
            <source type="image/webp" srcset="/assets/home/pricing-960.webp 960w, /assets/home/pricing-1800.webp 1800w" sizes="100vw" />
            <img class="bg px" src="/assets/home/pricing-1800.webp" width="1800" height="1200" alt="" loading="lazy" decoding="async" />
          </picture>
          <div class="pscrim" aria-hidden="true"></div>
          <div class="wrap pwrap">
            <div class="chead rv">
              <span class="label lbl-dark-2" data-i18n="pricingLabel">Pricing</span>
              <h2 class="serif" data-i18n="pricingTitle">Two plans, <em>no surprises.</em></h2>
              <p class="plead" data-i18n="pricingLead">Cancel any month. Running low on minutes? We'll let you know – never an automatic surcharge.</p>
            </div>
            <table class="ptable">
              <caption class="sr" data-i18n="pricingCaption">Starter and Pro compared</caption>
              <thead>
                <tr>
                  <td></td>
                  {tiers.map((plan) => (
                    <th scope="col" class:list={["pcol", { pro: plan.featured }]}>
                      <span class="pname">{plan.name}{plan.featured && <> <span class="pop"><span class="hidem">· </span><span data-i18n="recommended">Recommended</span></span></>}</span>
                      <span class="price serif"><BiText en={plan.priceEn} de={plan.priceDe} /></span>
                      <span class="per" data-i18n="perMonth">per month, incl. VAT</span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => (
                  <tr>
                    <th scope="row" data-i18n={row.key}>{row.label}</th>
                    {row.cells.map((cell, index) => (
                      <td class:list={[{ pro: tiers[index].featured, no: cell === false }]}>
                        {cell === true && (
                          <>
                            <svg class="ck" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
                            <span class="sr" data-i18n="included">Included</span>
                          </>
                        )}
                        {cell === false && (
                          <>
                            <span aria-hidden="true">—</span><span class="sr" data-i18n="notIncluded">Not included</span>
                          </>
                        )}
                        {typeof cell === "number" && cell}
                        {typeof cell === "object" && <span data-i18n={cell.i18n}>{cell.text}</span>}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <td></td>
                  {tiers.map((plan) => (
                    <td class:list={[{ pro: plan.featured }]}>
                      <a href={LOGIN_URL} class:list={["btn", plan.featured ? "b-stone" : "b-ghost"]} aria-label={`Choose ${plan.name}`} data-i18n-attr={`aria-label:chooseAria_${plan.slug}`}>
                        <span data-i18n={`choose_${plan.slug}`}>Choose<span class="hidem"> {plan.name}</span></span>
                      </a>
                    </td>
                  ))}
                </tr>
              </tfoot>
            </table>
          </div>
          <span class="snap-end" aria-hidden="true"></span>
        </section>

        <section id="setup" class="pad" data-snap>
          <div class="wrap">
            <div class="g12 shead rv">
              <span class="label lbl-muted" data-i18n="setupLabel">Get started</span>
              <h2 class="serif" data-i18n="setupTitle">Set up in <em>two minutes.</em></h2>
            </div>
            <div class="setup">
              <div class="opt rv" id="chatgpt" tabindex="-1">
                <div class="ohead"><span class="onum">I</span><h3 class="serif" data-i18n="opt1Title">Claude or ChatGPT</h3><span class="obadge" data-i18n="easiest">Easiest</span></div>
                <p class="odesc" data-i18n="opt1Desc">Tap a button. Claude only asks you to confirm; ChatGPT opens Plugins with the URL already copied.</p>
                <ol class="osteps">
                  <li data-i18n="opt1Step1">Tap a button. Claude: just confirm.</li>
                  <li data-i18n="opt1Step2">ChatGPT: + → “Add custom MCP server”.</li>
                  <li data-i18n="opt1Step3">Name it Hermes, paste the URL, sign in.</li>
                </ol>
                <div class="obox obtns">
                  <a href={CLAUDE_CONNECT_URL} target="_blank" rel="noopener noreferrer" class="opill pri">Claude<span class="sr" data-i18n="newTab"> (opens in new tab)</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13"></path><path d="M12 5l7 7-7 7"></path></svg>
                  </a>
                  <a href={CHATGPT_PLUGINS_URL} target="_blank" rel="noopener noreferrer" class="opill pri" data-copy={MCP_URL} data-copy-fail="chatgpt-url"><span class="olbl">ChatGPT</span><span class="sr" data-i18n="chatgptCopies">, copies the Hermes URL</span><span class="sr" data-i18n="newTab"> (opens in new tab)</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13"></path><path d="M12 5l7 7-7 7"></path></svg>
                  </a>
                  <p class="ourl" id="chatgpt-url" hidden><span data-i18n="chatgptUrl">Copying did not work. Copy this URL by hand:</span> <code>{MCP_URL}</code></p>
                </div>
              </div>
              <div class="opt rv">
                <div class="ohead"><span class="onum">II</span><span class="ottl"><h3 class="serif" data-i18n="opt2Title">For developers</h3><span class="osub">Terminal</span></span></div>
                <p class="odesc" data-i18n="opt2Desc">One line in Claude Code. Sign in once via /mcp.</p>
                <ol class="osteps">
                  <li data-i18n="opt2Step1">Copy the command below with the button on the right.</li>
                  <li data-i18n="opt2Step2">Paste it into your terminal and press Enter.</li>
                  <li data-i18n="opt2Step3">Sign in once via /mcp. Done.</li>
                </ol>
                <div class="obox">
                  <code>{cmdGroups.map((group, index) => <>{index > 0 && " "}<span class="nw">{group}</span></>)}</code>
                  <button type="button" class="oicon" aria-label="Copy command" data-i18n-attr="aria-label:copyCommand" data-copy={MCP_CMD}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
                  </button>
                </div>
              </div>
              <div class="opt rv">
                <div class="ohead"><span class="onum">III</span><h3 class="serif" data-i18n="opt3Title">Other AI apps</h3></div>
                <span class="sr" aria-live="polite" id="copy-live"></span>
                <p class="odesc" data-i18n="opt3Desc">Paste this sentence into your AI app, for example Codex or Cursor. It sets everything up for you.</p>
                <ol class="osteps">
                  <li data-i18n="opt3Step1">Copy the sentence below with the button on the right.</li>
                  <li data-i18n="opt3Step2">Paste it into your AI app, like Codex or Cursor.</li>
                  <li data-i18n="opt3Step3">It sets up the rest. Done.</li>
                </ol>
                <div class="obox">
                  <span>{SITE_AGENT_LINE.en} {AGENT_GUIDE_URL}</span>
                  <button type="button" class="oicon" aria-label="Copy sentence" data-i18n-attr="aria-label:copySentence" data-copy={SITE_AGENT_PROMPT}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
                  </button>
                </div>
              </div>
            </div>
            <div class="setdots" aria-hidden="true"><i class="on"></i><i></i><i></i><span class="ucdots-lbl" data-i18n="swipe">Swipe for more</span></div>
            <p class="firstask rv" data-i18n="firstAsk">Then just ask: “Who called today, and what did they want?”</p>
          </div>
          <span class="snap-end" aria-hidden="true"></span>
        </section>

        <section id="close" class="close" aria-labelledby="close-title" data-snap>
          <picture>
            <source type="image/avif" srcset="/assets/home/statue-960.avif 960w, /assets/home/statue-1800.avif 1800w" sizes="(min-width: 1001px) 68vw, 100vw" />
            <source type="image/webp" srcset="/assets/home/statue-960.webp 960w, /assets/home/statue-1800.webp 1800w" sizes="(min-width: 1001px) 68vw, 100vw" />
            <img class="bg sz statue" src="/assets/home/statue-1800.webp" width="1800" height="1200" loading="lazy" decoding="async"
              alt="A marble statue of Hermes in a museum gallery" data-i18n-attr="alt:statueAlt" />
          </picture>
          <div class="cscrim-d" aria-hidden="true"></div>
          <div class="cscrim-m" aria-hidden="true"></div>
          <div class="wrap cwrap">
            <h2 class="serif close-h rv" id="close-title" data-i18n="closeTitle">Give your AI <em>wings.</em></h2>
            <p class="close-p rv" data-i18n="closeText">Keep your time for what matters. <em class="serif">Hermes takes the calls.</em></p>
            <div class="rv cbtns">
              <a href={CLAUDE_CONNECT_URL} target="_blank" rel="noopener noreferrer" class="btn b-stone"><span data-i18n="addClaude">Add to Claude</span><span class="sr" data-i18n="newTab"> (opens in new tab)</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13"></path><path d="M12 5l7 7-7 7"></path></svg>
              </a>
              <a href="#chatgpt" class="btn b-ghost" data-i18n="addChatgpt">Add to ChatGPT</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="foot">
        <div class="wrap">
          <div class="frow">
            <a href="#top" class="fbrand">
              <picture>
                <source type="image/webp" srcset="/assets/home/wing-128.webp" />
                <img src="/assets/home/wing-128.png" alt="" width="22" height="22" loading="lazy" decoding="async" />
              </picture>
              <span>Hermes <i>by Sundartha</i></span>
            </a>
            <nav class="flinks" aria-label="Footer" data-i18n-attr="aria-label:navFooter">
              <a class="fopt" href="#pricing" data-i18n="navPricing">Pricing</a>
              <a class="fopt" href="#setup" data-i18n="navSetup">Get started</a>
              {legalLinks.map((link) => (
                <a class={link.cls} href={link.href} data-href-de={link.hrefDe} data-i18n={link.key}>{link.label}</a>
              ))}
              <a class="f-cancel" href={CANCEL_URL}><BiText en={CANCEL_BUTTON_LABEL_EN} de={CANCEL_BUTTON_LABEL} /></a>
              <a class="f-contact" href={`mailto:${CONTACT_EMAIL}`} data-i18n="contact">Contact</a>
              <a class="f-support" href="/support">Support</a>
            </nav>
          </div>
          <div class="frow fbase">
            <span class="fcopy">
              <span class="fcr">© {year} Sundartha</span>
              <button type="button" class="fck" data-consent-open data-i18n="cookieSettings">Cookie settings</button>
              <span class="fai" data-i18n="aiNote">Images and videos are AI-generated.</span>
            </span>
            <div class="flang" role="group" aria-label="Language" data-i18n-attr="aria-label:language">
              <button type="button" data-lang="en" aria-pressed="true">EN</button>
              <button type="button" data-lang="de" lang="de" aria-pressed="false">DE</button>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <CookieConsent lang="en" placement="hero" />
    <AnalyticsSlot />

    <script>
      // Hoisted script: Astro buendelt es als externes, same-origin Modul
      // (assetsInlineLimit 0) - CSP-konform ohne script-src 'unsafe-inline'.
      import "../scripts/home.js";
    </script>
    <div class="edge edge-top" aria-hidden="true"></div>
    <div class="edge edge-bottom" aria-hidden="true"></div>
  </body>
</html>
