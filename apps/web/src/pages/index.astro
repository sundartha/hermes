---
// Hermes-Startseite — Scroll-Fassung. Umsetzung des verbindlichen Design-
// Entwurfs "Hermes Scroll.dc.html" aus dem Design-Projekt.
//
// Das Quell-Design nutzt das x-dc-Framework und stylt ausschliesslich ueber
// inline style="..."-Attribute. Unter der Produktions-CSP des Static-Service
// (default-src 'self' — also weder style-src 'unsafe-inline' noch
// style-src-attr) waere davon nichts wirksam. Darum hier dieselbe Seite mit
// externem Stylesheet (src/styles/hermes.css) und externem Modul-Script
// (src/scripts/hermes-scroll.js). Gleiche Klassennamen wie im Entwurf.
//
// Standalone-Dokument (KEIN Site-Layout): der Entwurf ist eine Vollbild-Buehne
// mit eigener, transparent ueberlagerter Navigation und eigenem Fussband.
import "../styles/fonts.css";
import "../styles/hermes.css";
import { LOGIN_URL } from "../lib/routes.js";

// Rechtstexte direkt aus dem Content-Verzeichnis — DIESELBE Quelle, aus der
// auch /datenschutz, /impressum und /agb gebaut werden. Kein zweiter Textstand.
import HermesDemo from "../components/HermesDemo.astro";
import CookieConsent from "../components/site/CookieConsent.astro";
import AnalyticsSlot from "../components/site/AnalyticsSlot.astro";
import privacy from "../data/legal/privacy.de.json";
import imprint from "../data/legal/imprint.de.json";
import terms from "../data/legal/terms.de.json";

const title = "Hermes — Gib deiner KI eine Telefonnummer";
const description =
  "Hermes nimmt Anrufe an und führt sie für dich. Ein Anschluss über MCP — und deine KI hat eine Stimme.";

const MCP_URL = "https://app.sundartha.com/mcp";
const MCP_CMD = `claude mcp add --transport http hermes ${MCP_URL}`;
const CONTACT = "kontakt@sundartha.com";

// Die drei Rechtsdokumente im Blatt. "Kontakt" ist im Repo kein eigenes
// Dokument (kein contact.de.json) — dafuer steht der mailto-Link, so wie es
// die heutige Fussnavigation in Site.astro auch haelt.
const legalDocs = [
  { slug: "privacy", href: "/datenschutz", label: "Datenschutz", i18n: "privacy", doc: privacy },
  { slug: "imprint", href: "/impressum", label: "Impressum", i18n: "imprint", doc: imprint },
  { slug: "terms", href: "/agb", label: "AGB", i18n: "terms", doc: terms },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: am iPhone reicht die Buehne bis unter die Statusleiste
         (sonst malt Safari dort einen eigenen Balken in der Seitenfarbe). Die
         Abstaende dazu kommen ueber env(safe-area-inset-*) im CSS. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sundartha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="page">
      <div class="pin-track">
        <div class="stage">
          <div class="hero-bg" aria-hidden="true"></div>
          <div class="howto-bg" aria-hidden="true"></div>
          <div class="scrim-side" aria-hidden="true"></div>
          <div class="scrim-veil" aria-hidden="true"></div>

          <!-- ------------------------------------------------ Navigation -->
          <nav class="nav-desktop" aria-label="Hauptnavigation">
            <a class="lockup" href="/" aria-label="Hermes — Startseite">
              <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
              <span class="lockup__text">
                <span class="lockup__name">HERMES</span>
                <span class="lockup__by">by Sundartha</span>
              </span>
            </a>
            <span class="nav-actions">
              <button class="nav-link" type="button" data-goto="howto:1" data-i18n="howItWorks">So funktioniert's</button>
              <button class="nav-link" type="button" data-goto="price:2" data-i18n="pricing">Preise</button>
              <button class="nav-link" type="button" data-goto="dev:3" data-i18n="forDevs">Für Entwickler</button>
              <span class="lang">
                <button class="lang__opt" type="button" data-lang="de" aria-pressed="true">DE</button>
                <span class="lang__sep" aria-hidden="true">/</span>
                <button class="lang__opt" type="button" data-lang="en" aria-pressed="false">EN</button>
              </span>
              <!-- Owner-Feedback 2026-08-14: oben rechts NICHT noch einmal "Nummer holen" (hat der Hero schon). -->
              <!-- Login als ruhiger Textlink, Registrieren als Pillen-CTA (klassisches Muster). -->
              <!-- BEIDE Ziele bewusst LOGIN_URL: Login = Registrierung (Account entsteht beim ersten OIDC-Login, s. lib/routes.js) — reine Nutzerfuehrung, kein zweiter Funnel. -->
              <a class="nav-link" href={LOGIN_URL} data-i18n="logIn">Login</a>
              <a class="btn-solid" href={LOGIN_URL} data-i18n="signUp">Registrieren</a>
            </span>
          </nav>

          <div class="nav-mobile">
            <a class="lockup" href="/" aria-label="Hermes — Startseite">
              <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
              <span class="lockup__text">
                <span class="lockup__name">HERMES</span>
                <span class="lockup__by">by Sundartha</span>
              </span>
            </a>
            <button class="burger" type="button" data-open-sheet="menu" aria-label="Menü öffnen">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </button>
          </div>

          <!-- ------------------------------------------------------ Hero -->
          <div class="hero-inner">
            <div class="hero-pad">
              <div class="hero-copy">
                <h1 class="hero-title" data-i18n="heroTitle"><span class="l1">Gib deiner KI</span> <span>eine <em>Telefonnummer</em>.</span></h1>
                <p class="hero-lead" data-i18n="heroLead">Hermes nimmt Anrufe an und führt sie für dich. Ein Anschluss über <strong>MCP</strong> — und deine KI hat eine Stimme.</p>
                <div class="hero-actions">
                  <a class="btn-solid btn-solid--hero" href={LOGIN_URL} data-i18n="getNumber">Nummer holen</a>
                  <button class="btn-ghost" type="button" data-goto="howto:1" data-i18n="howItWorks">So funktioniert's</button>
                </div>
              </div>
            </div>
          </div>

          <!-- ------------------------------------ Ebene 2: So funktioniert's -->
          <section class="howto-layer" aria-label="So funktioniert's">
            <h2 class="layer-title" data-i18n="howtoTitle">Ein Anschluss, <em>zwei Minuten</em>.</h2>
            <p class="layer-lead" data-i18n="howtoLead">Ein Anschluss über <strong>MCP</strong>, kein Setup — deine KI ist in unter zwei Minuten unter einer echten Nummer erreichbar.</p>
            <div class="demo-frame">
              <HermesDemo />
            </div>
          </section>

          <!-- ------------------------------------------- Ebene 3: Preise -->
          <section class="price-layer" aria-label="Preise">
            <h2 class="layer-title" data-i18n="priceTitle">Zwei Tarife, <em>keine Überraschungen</em>.</h2>
            <p class="layer-lead" data-i18n="priceLead">Wähle das Paket, welches zu dir passt. <strong>Monatlich kündbar</strong>, <strong>keine versteckten Kosten</strong>.</p>
            <div class="price-grid">
              <div class="plan">
                <span class="plan__head">
                  <span class="plan__label" data-i18n="starterLabel">Starter</span>
                </span>
                <span class="plan__price">4,99 €<span class="plan__per" data-i18n="perMonth">/ Monat</span></span>
                <span class="plan__features">
                  <span data-i18n="starterF1"><strong>30 Minuten</strong> Gespräche pro Monat</span>
                  <span data-i18n="starterF2">Nimmt jeden Anruf für dich an</span>
                  <span data-i18n="starterF3">Fasst jedes Gespräch für dich zusammen</span>
                  <span data-i18n="starterF4">E-Mail-Support</span>
                </span>
                <a class="plan__cta" href={LOGIN_URL} data-i18n="starterCta">Starter wählen</a>
              </div>
              <div class="plan plan--featured">
                <span class="plan__head">
                  <span class="plan__label" data-i18n="businessLabel">Business</span>
                  <span class="plan__badge" data-i18n="popular">Beliebt</span>
                </span>
                <span class="plan__price">9,99 €<span class="plan__per" data-i18n="perMonth">/ Monat</span></span>
                <span class="plan__features">
                  <span data-i18n="businessF1"><strong>120 Minuten</strong> Gespräche pro Monat</span>
                  <span data-i18n="businessF2">Nimmt an <em>und</em> telefoniert für dich raus</span>
                  <span data-i18n="businessF3">Erledigt Aufgaben eigenständig für dich</span>
                  <span data-i18n="businessF4">Priorisierter Support</span>
                </span>
                <a class="plan__cta" href={LOGIN_URL} data-i18n="businessCta">Business wählen</a>
              </div>
            </div>
            <p class="layer-note" data-i18n="footnote">Minuten aufgebraucht? Du bekommst einen Hinweis — kein automatischer Aufpreis.</p>
          </section>

          <!-- -------------------------------------- Ebene 4: Entwickler -->
          <section class="dev-layer" aria-label="Für Entwickler">
            <h2 class="layer-title" data-i18n="devTitle">Ein Endpoint, <em>zwei Wege</em>.</h2>
            <p class="layer-lead" data-i18n="devLead">Hermes ist ein <strong>MCP</strong>-Server. Verbinde ihn im KI-Tool deiner Wahl oder direkt aus dem Terminal.</p>
            <div class="dev-grid">
              <div class="dev-card" data-dev-card="a">
                <span class="dev-card__head">
                  <span class="dev-num">01</span>
                  <span class="dev-card__titles">
                    <span class="dev-eyebrow" data-i18n="devWayA">Im KI-Tool</span>
                    <span class="dev-card__title" data-i18n="devWayATitle">Als Konnektor hinzufügen</span>
                  </span>
                </span>
                <span class="dev-window">
                  <span class="dev-bar">
                    <span class="dev-dot" aria-hidden="true"></span>
                    <span class="dev-dot" aria-hidden="true"></span>
                    <span class="dev-dot" aria-hidden="true"></span>
                    <span class="dev-bar__title" data-i18n="devWindowTitle">Einstellungen › Konnektoren</span>
                  </span>
                  <span class="dev-form-body">
                    <span class="dev-addrow">
                      <span class="dev-addrow__plus" aria-hidden="true">+</span><span data-i18n="devAddRow">Benutzerdefinierten Connector</span>
                    </span>
                    <span class="dev-arrow dev-arrow--1" aria-hidden="true"><span>↓</span></span>
                    <span class="dev-field dev-field--1">
                      <span class="dev-field__label" data-i18n="devFieldName">Name</span>
                      <span class="dev-field__typed">Hermes</span>
                    </span>
                    <span class="dev-arrow dev-arrow--2" aria-hidden="true"><span>↓</span></span>
                    <span class="dev-field dev-field--2">
                      <span class="dev-field__label" data-i18n="devFieldUrl">Server-URL</span>
                      <span class="dev-field__url">{MCP_URL}</span>
                      <button class="dev-copy" type="button" data-copy={MCP_URL} data-i18n="copyLabel">Kopieren</button>
                    </span>
                    <span class="dev-connect" data-i18n="devConnectBtn">Verbinden</span>
                  </span>
                </span>
              </div>

              <div class="dev-card" data-dev-card="b">
                <span class="dev-card__head">
                  <span class="dev-num">02</span>
                  <span class="dev-card__titles">
                    <span class="dev-eyebrow" data-i18n="devWayB">Im Terminal</span>
                    <span class="dev-card__title" data-i18n="devWayBTitle">Mit einem Befehl</span>
                  </span>
                </span>
                <span class="dev-window dev-window--dark">
                  <span class="dev-bar dev-bar--split">
                    <span class="dev-bar__group">
                      <span class="dev-dot" aria-hidden="true"></span>
                      <span class="dev-dot" aria-hidden="true"></span>
                      <span class="dev-dot" aria-hidden="true"></span>
                      <span class="dev-bar__title" data-i18n="devTerminalTitle">zsh — hermes</span>
                    </span>
                    <button class="dev-copy" type="button" data-copy={MCP_CMD} data-i18n="copyLabel">Kopieren</button>
                  </span>
                  <span class="dev-term-body">
                    <span class="dev-term-out">
                      <span class="dev-cmd"><span class="dev-cmd__prompt">$ </span>claude mcp add --transport http hermes \</span>
                      <span class="dev-cmd2"><span class="dev-cmd2__text">&nbsp;&nbsp;&nbsp;&nbsp;{MCP_URL}</span><span class="dev-caret" aria-hidden="true"></span></span>
                      <span class="dev-out dev-out--1" data-i18n="devOut1">✓ MCP-Server „hermes“ hinzugefügt</span>
                      <span class="dev-out dev-out--2" data-i18n="devOut2">✓ Verbunden · Tools verfügbar</span>
                    </span>
                    <span class="dev-ask">
                      <span class="dev-ask__label" data-i18n="devToolsLabel">Frag danach — zum Beispiel</span>
                      <span class="dev-ask__line dev-ask-1" data-i18n="devAsk1">„Wer hat heute angerufen und was wollten sie?“</span>
                      <span class="dev-ask__line dev-ask-2" data-i18n="devAsk2">„Ruf Herrn Müller an und verschiebe den Termin auf Donnerstag.“</span>
                    </span>
                  </span>
                </span>
              </div>
            </div>
            <p class="layer-note" data-i18n="devFootnote">Streamable HTTP, OAuth beim ersten Verbinden. Läuft mit Claude, Codex und jedem MCP-Client.</p>
          </section>

          <!-- -------------------------------------------------- Fussband -->
          <footer class="site-footer">
            <span class="site-footer__copy" data-i18n="footerCopy">© Sundartha — Hermes, dein Telefonassistent</span>
            <span class="site-footer__nav">
              <button class="site-footer__link" type="button" data-goto="howto:1" data-i18n="howItWorks">So funktioniert's</button>
              <button class="site-footer__link" type="button" data-goto="price:2" data-i18n="pricing">Preise</button>
              <button class="site-footer__link" type="button" data-goto="dev:3" data-i18n="forDevs">Für Entwickler</button>
              <a class="site-footer__link" href={LOGIN_URL} data-i18n="getNumber">Nummer holen</a>
              {legalDocs.map((entry) => (
                <a class="site-footer__link" href={entry.href} data-legal-open={entry.slug} data-i18n={entry.i18n}>{entry.label}</a>
              ))}
              <!-- § 312k BGB: gesetzlich vorgegebener Wortlaut, staendig verfuegbar im
                   Fussband. KEIN data-i18n - die Beschriftung bleibt Deutsch, auch wenn
                   der Sprachschalter auf EN steht (der Wortlaut ist nicht frei waehlbar,
                   s. Bericht). -->
              <a class="site-footer__link" href="/kuendigen">Verträge kündigen</a>
              <a class="site-footer__link" href={`mailto:${CONTACT}`} data-i18n="contact">Kontakt</a>
              <button class="site-footer__link" type="button" data-consent-open data-i18n="cookieSettings">Cookie-Einstellungen</button>
            </span>
          </footer>

          <div class="scroll-hint" aria-hidden="true">
            <span class="scroll-hint__rail"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================ Vollbild-Blaetter ===== -->

    <!-- Am Handy wird nicht gescrollt: die drei Sektionen und das Menue
         oeffnen sich als Vollbild. Auf dem Desktop dient nur das Rechts-Blatt. -->
    <div class="sheet" data-sheet="howto" data-open="0" role="dialog" aria-modal="true" aria-label="So funktioniert's">
      <div class="sheet__bg" aria-hidden="true"></div>
      <div class="sheet__veil" aria-hidden="true"></div>
      <div class="sheet__top" aria-hidden="true"></div>
      <div class="sheet__head">
        <span class="lockup">
          <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
          <span class="lockup__text">
            <span class="lockup__name">HERMES</span>
            <span class="lockup__by">by Sundartha</span>
          </span>
        </span>
        <button class="sheet__close" type="button" data-close-sheet aria-label="Schließen">×</button>
      </div>
      <span class="sheet__title" data-i18n="howtoTitle">Ein Anschluss, <em>zwei Minuten</em>.</span>
      <p class="sheet__lead" data-i18n="howtoLead">Ein Anschluss über <strong>MCP</strong>, kein Setup — deine KI ist in unter zwei Minuten unter einer echten Nummer erreichbar.</p>
      <div class="sheet__demo">
        <HermesDemo />
      </div>
      <div class="sheet__card">
        <span class="step">
          <span class="step__num">01</span>
          <span class="step__body">
            <span class="step__title" data-i18n="step1Title">Nummer holen</span>
            <span class="step__text" data-i18n="step1Desc">Eine echte Rufnummer, in zwei Minuten aktiv. Kein Vertrag, keine Hardware.</span>
          </span>
        </span>
        <span class="rule" aria-hidden="true"></span>
        <span class="step">
          <span class="step__num">02</span>
          <span class="step__body">
            <span class="step__title" data-i18n="step2Title">KI verbinden</span>
            <span class="step__text" data-i18n="step2Desc">Ein Anschluss über MCP. Deine KI weiß danach, wer angerufen hat und was zu tun ist.</span>
          </span>
        </span>
        <span class="rule" aria-hidden="true"></span>
        <span class="step">
          <span class="step__num">03</span>
          <span class="step__body">
            <span class="step__title" data-i18n="step3Title">Abnehmen lassen</span>
            <span class="step__text" data-i18n="step3Desc">Hermes spricht, hört zu, vereinbart Termine und schreibt mit. Du liest das Protokoll.</span>
          </span>
        </span>
      </div>
      <a class="sheet__cta" href={LOGIN_URL} data-i18n="getNumber">Nummer holen</a>
    </div>

    <div class="sheet" data-sheet="price" data-open="0" role="dialog" aria-modal="true" aria-label="Preise">
      <div class="sheet__bg" aria-hidden="true"></div>
      <div class="sheet__veil" aria-hidden="true"></div>
      <div class="sheet__top" aria-hidden="true"></div>
      <div class="sheet__head">
        <span class="lockup">
          <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
          <span class="lockup__text">
            <span class="lockup__name">HERMES</span>
            <span class="lockup__by">by Sundartha</span>
          </span>
        </span>
        <button class="sheet__close" type="button" data-close-sheet aria-label="Schließen">×</button>
      </div>
      <span class="sheet__title" data-i18n="priceTitle">Zwei Tarife, <em>keine Überraschungen</em>.</span>
      <p class="sheet__lead" data-i18n="priceLead">Wähle das Paket, welches zu dir passt. <strong>Monatlich kündbar</strong>, <strong>keine versteckten Kosten</strong>.</p>
      <div class="sheet-plans">
        <div class="sheet-plan">
          <span class="sheet-plan__head">
            <span class="sheet-plan__labels">
              <span class="sheet-plan__label" data-i18n="starterLabel">Starter</span>
            </span>
            <span class="sheet-plan__price">4,99 €<span class="sheet-plan__per" data-i18n="perMonth">/ Monat</span></span>
          </span>
          <span class="sheet-plan__features">
            <span data-i18n="starterF1"><strong>30 Minuten</strong> Gespräche pro Monat</span>
            <span data-i18n="starterF2">Nimmt jeden Anruf für dich an</span>
            <span data-i18n="starterF3">Fasst jedes Gespräch für dich zusammen</span>
            <span data-i18n="starterF4">E-Mail-Support</span>
          </span>
          <a class="sheet-plan__cta" href={LOGIN_URL} data-i18n="starterCta">Starter wählen</a>
        </div>
        <div class="sheet-plan sheet-plan--featured">
          <span class="sheet-plan__head">
            <span class="sheet-plan__labels">
              <span class="sheet-plan__label" data-i18n="businessLabel">Business</span>
              <span class="sheet-plan__badge" data-i18n="popular">Beliebt</span>
            </span>
            <span class="sheet-plan__price">9,99 €<span class="sheet-plan__per" data-i18n="perMonth">/ Monat</span></span>
          </span>
          <span class="sheet-plan__features">
            <span data-i18n="businessF1"><strong>120 Minuten</strong> Gespräche pro Monat</span>
            <span data-i18n="businessF2">Nimmt an <em>und</em> telefoniert für dich raus</span>
            <span data-i18n="businessF3">Erledigt Aufgaben eigenständig für dich</span>
            <span data-i18n="businessF4">Priorisierter Support</span>
          </span>
          <a class="sheet-plan__cta" href={LOGIN_URL} data-i18n="businessCta">Business wählen</a>
        </div>
      </div>
      <p class="sheet__note" data-i18n="footnote">Minuten aufgebraucht? Du bekommst einen Hinweis — kein automatischer Aufpreis.</p>
    </div>

    <div class="sheet dev-sheet" data-sheet="dev" data-open="0" role="dialog" aria-modal="true" aria-label="Für Entwickler">
      <div class="sheet__bg" aria-hidden="true"></div>
      <div class="sheet__veil" aria-hidden="true"></div>
      <div class="sheet__top" aria-hidden="true"></div>
      <div class="sheet__head">
        <span class="lockup">
          <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
          <span class="lockup__text">
            <span class="lockup__name">HERMES</span>
            <span class="lockup__by">by Sundartha</span>
          </span>
        </span>
        <button class="sheet__close" type="button" data-close-sheet aria-label="Schließen">×</button>
      </div>
      <span class="sheet__title" data-i18n="devTitle">Ein Endpoint, <em>zwei Wege</em>.</span>
      <p class="sheet__lead" data-i18n="devLead">Hermes ist ein <strong>MCP</strong>-Server. Verbinde ihn im KI-Tool deiner Wahl oder direkt aus dem Terminal.</p>

      <div class="sheet__card">
        <span class="dev-card__head">
          <span class="dev-num">01</span>
          <span class="dev-card__titles">
            <span class="dev-eyebrow" data-i18n="devWayA">Im KI-Tool</span>
            <span class="dev-card__title" data-i18n="devWayATitle">Als Konnektor hinzufügen</span>
          </span>
        </span>
        <span class="dev-window">
          <span class="dev-bar">
            <span class="dev-dot" aria-hidden="true"></span>
            <span class="dev-dot" aria-hidden="true"></span>
            <span class="dev-dot" aria-hidden="true"></span>
            <span class="dev-bar__title" data-i18n="devWindowTitle">Einstellungen › Konnektoren</span>
          </span>
          <span class="dev-form-body">
            <span class="dev-addrow">
              <span class="dev-addrow__plus" aria-hidden="true">+</span><span data-i18n="devAddRow">Benutzerdefinierten Connector</span>
            </span>
            <span class="dev-arrow dev-arrow--1" aria-hidden="true"><span>↓</span></span>
            <span class="dev-field dev-field--1">
              <span class="dev-field__label" data-i18n="devFieldName">Name</span>
