---
// Hermes-Startseite — Scroll-Fassung. Umsetzung des verbindlichen Design-
// Entwurfs "Hermes Scroll.dc.html" aus dem Design-Projekt.
//
// Das Quell-Design nutzt das x-dc-Framework und stylt ausschliesslich ueber
// inline style="..."-Attribute. Unter der Produktions-CSP des Static-Service
// (default-src 'self' — also weder style-src 'unsafe-inline' noch
// style-src-attr) waere davon nichts wirksam. Darum hier dieselbe Seite mit
// externem Stylesheet (src/styles/hermes.css) und externem Modul-Script
// (src/scripts/hermes-scroll.js). Gleiche Klassennamen wie im Entwurf.
//
// Standalone-Dokument (KEIN Site-Layout): der Entwurf ist eine Vollbild-Buehne
// mit eigener, transparent ueberlagerter Navigation und eigenem Fussband.
import "../styles/fonts.css";
import "../styles/hermes.css";
import { LOGIN_URL } from "../lib/routes.js";

// Sprache: die Startseite ist seit 2026-09-10 ENGLISCH als Default — Englisch
// steht im Markup (und ist damit die indexierte Fassung), Deutsch liegt als
// Woerterbuch in scripts/hermes-scroll.js und wird per Umschalter zur Laufzeit
// eingesetzt. Umschalter-Reihenfolge ueberall EN | DE.
//
// Rechtstexte direkt aus dem Content-Verzeichnis — DIESELBE Quelle, aus der
// auch /datenschutz, /impressum, /agb und die EN-Fassungen unter /legal/* gebaut
// werden. Kein zweiter Textstand. Owner-Wunsch 2026-09-28: steht die Seite auf
// Englisch, ist auch das Rechts-Blatt englisch (informative Uebersetzung mit
// Vorranghinweis, lib/legal.js), auf Deutsch die verbindliche Fassung. Beide stehen
// im HTML, sichtbar ist die zur Seitensprache passende ([data-lang-only]).
import HowtoSteps from "../components/HowtoSteps.astro";
import CookieConsent from "../components/site/CookieConsent.astro";
import AnalyticsSlot from "../components/site/AnalyticsSlot.astro";
// Handy scrollt seit 2026-09-26 wie der Desktop (Owner-Entscheidung, revidiert
// den Ein-Screen-Hero vom 2026-08-20). Als letzter Import, damit die Regeln
// nach hermes.css und den Komponenten-Styles greifen.
import "../styles/hermes-mobile-scroll.css";
// Handy-Fassung (< 768 px) nach design/handoff-mobile: eigene Screens, am
// Desktop display:none. Als letzter Import, damit sie die Buehne dort ausblendet.
import MobileHome from "../components/MobileHome.astro";
import LegalTabs from "../components/LegalTabs.astro";
import CancelInfo from "../components/site/CancelInfo.astro";
import SupportInfo from "../components/site/SupportInfo.astro";
import BiText from "../components/site/BiText.astro";
import "../styles/lang-only.css";
import privacy from "../data/legal/privacy.de.json";
import imprint from "../data/legal/imprint.de.json";
import terms from "../data/legal/terms.de.json";
import privacyEn from "../data/legal/privacy.en.json";
import imprintEn from "../data/legal/imprint.en.json";
import termsEn from "../data/legal/terms.en.json";
import { LEGAL_TRANSLATION_NOTICE } from "../lib/legal.js";
import { CANCEL_BUTTON_LABEL, CANCEL_BUTTON_LABEL_EN } from "../lib/subscribe.js";

const title = "Hermes — Give your AI a phone number";
const description =
  "Hermes answers calls and handles them for you. One connection over MCP — and your AI gets a voice.";

const MCP_URL = "https://app.sundartha.com/mcp";
const MCP_CMD = `claude mcp add --transport http hermes ${MCP_URL}`;
const CONTACT = "kontakt@sundartha.com";
// Agenten-Einstieg (Owner-Auftrag 2026-09-25, Vorbild heycall-e.com): dieser Satz
// wird in den eigenen KI-Agenten kopiert; public/agents.md ist die Anleitung fuer ihn.
// Bewusst immer Englisch - er richtet sich an das Modell, nicht an den Menschen.
const AGENT_GUIDE = "sundartha.com/agents.md";
const AGENT_PROMPT = `Set up Hermes for me: https://${AGENT_GUIDE}`;

// Die drei Rechtsdokumente im Blatt. "Kontakt" ist im Repo kein eigenes
// Dokument (kein contact.de.json) — dafuer steht der mailto-Link, so wie es
// die heutige Fussnavigation in Site.astro auch haelt.
const legalDocs = [
  { slug: "privacy", href: "/datenschutz", hrefEn: "/legal/privacy", label: "Privacy", i18n: "privacy", doc: privacy, docEn: privacyEn },
  { slug: "imprint", href: "/impressum", hrefEn: "/legal/imprint", label: "Imprint", i18n: "imprint", doc: imprint, docEn: imprintEn },
  { slug: "terms", href: "/agb", hrefEn: "/legal/terms", label: "Terms", i18n: "terms", doc: terms, docEn: termsEn },
];
// Kuendigen und Support als weitere Reiter im Blatt (Owner-Wunsch 2026-09-27): sie
// oeffnen sich IM Blatt, die Reiterleiste bleibt stehen - vorher fuehrten die Links
// auf eigene Seiten, von denen aus die anderen Texte nicht mehr zu sehen waren. Die
// Seiten bleiben unter ihrer URL (§ 312k BGB, Support-URL). Beschriftung je Sprache:
// der Kuendigungs-Wortlaut kommt aus denselben Konstanten wie der Knopf im
// Kundenbereich (lib/subscribe.js, Owner-Entscheidung 2026-08-14: EN zeigt eine
// gleichwertig eindeutige Formulierung), "Support" ist in DE und EN gleich.
const CANCEL_LABEL = { en: CANCEL_BUTTON_LABEL_EN, de: CANCEL_BUTTON_LABEL };
const infoTabs = [
  { slug: "cancel", href: "/kuendigen", label: CANCEL_LABEL },
  { slug: "support", href: "/support", label: { en: "Support", de: "Support" } },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: am iPhone reicht die Buehne bis unter die Statusleiste
         (sonst malt Safari dort einen eigenen Balken in der Seitenfarbe). Die
         Abstaende dazu kommen ueber env(safe-area-inset-*) im CSS. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="alternate" type="text/markdown" href={new URL("/agents.md", Astro.site)} title="Setup guide for AI agents" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sundartha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <MobileHome mcpUrl={MCP_URL} mcpCmd={MCP_CMD} agentGuide={AGENT_GUIDE} contact={CONTACT} legalDocs={legalDocs} />

    <div class="page">
      <div class="pin-track">
        <div class="stage">
          <div class="hero-bg" aria-hidden="true"></div>
          <div class="howto-bg" aria-hidden="true"></div>
          <div class="scrim-side" aria-hidden="true"></div>
          <div class="scrim-veil" aria-hidden="true"></div>

          <!-- ------------------------------------------------ Navigation -->
          <nav class="nav-desktop" aria-label="Main navigation">
            <a class="lockup" href="/" aria-label="Hermes — home">
              <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
              <span class="lockup__text">
                <span class="lockup__name">HERMES</span>
                <span class="lockup__by">by Sundartha</span>
              </span>
            </a>
            <span class="nav-actions">
              <button class="nav-link" type="button" data-goto="howto:1" data-i18n="howItWorks">How it works</button>
              <button class="nav-link" type="button" data-goto="price:2" data-i18n="pricing">Pricing</button>
              <button class="nav-link" type="button" data-goto="dev:3" data-i18n="forDevs">For developers</button>
              <span class="lang">
                <button class="lang__opt" type="button" data-lang="en" aria-pressed="true">EN</button>
                <span class="lang__sep" aria-hidden="true">/</span>
                <button class="lang__opt" type="button" data-lang="de" aria-pressed="false">DE</button>
              </span>
              <!-- Owner-Feedback 2026-08-14: oben rechts NICHT noch einmal "Nummer holen" (hat der Hero schon). -->
              <!-- Login als ruhiger Textlink, Registrieren als Pillen-CTA (klassisches Muster). -->
              <!-- BEIDE Ziele bewusst LOGIN_URL: Login = Registrierung (Account entsteht beim ersten OIDC-Login, s. lib/routes.js) — reine Nutzerfuehrung, kein zweiter Funnel. -->
              <a class="nav-link" href={LOGIN_URL} data-i18n="logIn">Log in</a>
              <a class="btn-solid" href={LOGIN_URL} data-i18n="signUp">Sign up</a>
            </span>
          </nav>

          <div class="nav-mobile">
            <a class="lockup" href="/" aria-label="Hermes — home">
              <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
              <span class="lockup__text">
                <span class="lockup__name">HERMES</span>
                <span class="lockup__by">by Sundartha</span>
              </span>
            </a>
            <!-- Owner-Feedback 2026-08-26: Login auch auf dem Handy DIREKT in der Leiste sichtbar. -->
            <!-- Im Menü-Blatt bleiben Login + Registrieren zusätzlich stehen. -->
            <span class="nav-mobile__actions">
              <a class="nav-link nav-mobile__login" href={LOGIN_URL} data-i18n="logIn">Log in</a>
              <button class="burger" type="button" data-open-sheet="menu" aria-label="Open menu">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
              </button>
            </span>
          </div>

          <!-- ------------------------------------------------------ Hero -->
          <div class="hero-inner">
            <div class="hero-pad">
              <div class="hero-copy">
                <h1 class="hero-title" data-i18n="heroTitle"><span class="l1">Give your AI</span> <span>a <em>phone number</em>.</span></h1>
                <p class="hero-lead" data-i18n="heroLead">Hermes answers calls and handles them for you. One connection over <strong>MCP</strong> — and your AI gets a voice.</p>
                <div class="hero-actions">
                  <a class="btn-solid btn-solid--hero" href={LOGIN_URL} data-i18n="getNumber">Get a number</a>
                  <button class="btn-ghost" type="button" data-goto="howto:1" data-i18n="howItWorks">How it works</button>
                </div>
              </div>
            </div>
          </div>

          <!-- ------------------------------------ Ebene 2: So funktioniert's -->
          <section class="howto-layer" aria-label="How it works">
            <!-- Nur am Handy: Kopfzeile ueber der Ueberschrift, rechts der Fortschritt
                 durch die drei Schritte (hermes-scroll.js setzt .is-on). -->
            <p class="layer-eyebrow"><span data-i18n="howItWorks">How it works</span><span class="layer-progress" aria-hidden="true"><i></i><i></i><i></i></span></p>
            <h2 class="layer-title" data-i18n="howtoTitle">One connection, <em>two minutes</em>.</h2>
            <p class="layer-lead" data-i18n="howtoLead">One connection over <strong>MCP</strong>, no setup — your AI is reachable on a real number in under two minutes.</p>
            <HowtoSteps lang="en" />
          </section>

          <!-- ------------------------------------------- Ebene 3: Preise -->
          <section class="price-layer" aria-label="Pricing">
            <p class="layer-eyebrow"><span data-i18n="pricing">Pricing</span></p>
            <h2 class="layer-title" data-i18n="priceTitle">Two plans, <em>no surprises</em>.</h2>
            <p class="layer-lead" data-i18n="priceLead">Choose the plan that fits you. <strong>Cancel monthly</strong>, <strong>no hidden costs</strong>.</p>
            <div class="price-grid">
              <div class="plan">
                <span class="plan__head">
                  <span class="plan__label" data-i18n="starterLabel">Starter</span>
                </span>
                <span class="plan__price"><span data-i18n="starterPrice">€4.99</span><span class="plan__per" data-i18n="perMonth">/ month</span></span>
                <span class="plan__features">
                  <span data-i18n="starterF1"><strong>30 minutes</strong> of calls per month</span>
                  <span data-i18n="starterF2">Answers every call for you</span>
                  <span data-i18n="starterF3">Summarizes every call for you</span>
                  <span data-i18n="starterF4">Email support</span>
                </span>
                <a class="plan__cta" href={LOGIN_URL} data-i18n="starterCta">Choose Starter</a>
              </div>
              <div class="plan plan--featured">
                <span class="plan__head">
                  <span class="plan__label" data-i18n="businessLabel">Pro</span>
                  <span class="plan__badge" data-i18n="popular">Popular</span>
                </span>
                <span class="plan__price"><span data-i18n="businessPrice">€9.99</span><span class="plan__per" data-i18n="perMonth">/ month</span></span>
                <span class="plan__features">
                  <span data-i18n="businessF1"><strong>120 minutes</strong> of calls per month</span>
                  <span data-i18n="businessF2">Answers <em>and</em> calls out for you</span>
                  <span data-i18n="businessF3">Handles tasks independently for you</span>
                  <span data-i18n="businessF4">Priority support</span>
                </span>
                <a class="plan__cta" href={LOGIN_URL} data-i18n="businessCta">Choose Pro</a>
              </div>
            </div>
            <p class="layer-note" data-i18n="footnote">Out of minutes? You get a heads-up — never an automatic surcharge.</p>
          </section>

          <!-- -------------------------------------- Ebene 4: Entwickler -->
          <section class="dev-layer" aria-label="For developers">
            <p class="layer-eyebrow"><span data-i18n="forDevs">For developers</span></p>
            <h2 class="layer-title" data-i18n="devTitle">One endpoint, <em>three ways</em>.</h2>
            <p class="layer-lead" data-i18n="devLead">Hermes is an <strong>MCP</strong> server. Connect it in the AI tool of your choice or straight from the terminal.</p>
            <div class="dev-grid">
              <div class="dev-card" data-dev-card="a">
                <span class="dev-card__head">
                  <span class="dev-num">01</span>
                  <span class="dev-card__titles">
                    <span class="dev-eyebrow" data-i18n="devWayA">In your AI tool</span>
                    <span class="dev-card__title" data-i18n="devWayATitle">Add it as a connector</span>
                  </span>
                </span>
                <span class="dev-window">
                  <span class="dev-bar">
                    <span class="dev-dot" aria-hidden="true"></span>
                    <span class="dev-dot" aria-hidden="true"></span>
                    <span class="dev-dot" aria-hidden="true"></span>
                    <span class="dev-bar__title" data-i18n="devWindowTitle">Settings › Connectors</span>
                  </span>
                  <span class="dev-form-body">
                    <span class="dev-addrow">
                      <span class="dev-addrow__plus" aria-hidden="true">+</span><span data-i18n="devAddRow">Add custom connector</span>
                    </span>
                    <span class="dev-arrow dev-arrow--1" aria-hidden="true"><span>↓</span></span>
                    <span class="dev-field dev-field--1">
                      <span class="dev-field__label" data-i18n="devFieldName">Name</span>
                      <span class="dev-field__typed">Hermes</span>
                    </span>
                    <span class="dev-arrow dev-arrow--2" aria-hidden="true"><span>↓</span></span>
                    <span class="dev-field dev-field--2">
                      <span class="dev-field__label" data-i18n="devFieldUrl">Server URL</span>
                      <span class="dev-field__url">{MCP_URL}</span>
                      <button class="dev-copy" type="button" data-copy={MCP_URL} data-i18n="copyLabel">Copy</button>
                    </span>
                    <span class="dev-connect" data-i18n="devConnectBtn">Connect</span>
                  </span>
                </span>
              </div>

              <div class="dev-card" data-dev-card="b">
                <span class="dev-card__head">
                  <span class="dev-num">02</span>
                  <span class="dev-card__titles">
                    <span class="dev-eyebrow" data-i18n="devWayB">In the terminal</span>
                    <span class="dev-card__title" data-i18n="devWayBTitle">With a single command</span>
                  </span>
                </span>
                <span class="dev-window dev-window--dark">
                  <span class="dev-bar dev-bar--split">
                    <span class="dev-bar__group">
                      <span class="dev-dot" aria-hidden="true"></span>
                      <span class="dev-dot" aria-hidden="true"></span>
                      <span class="dev-dot" aria-hidden="true"></span>
                      <span class="dev-bar__title" data-i18n="devTerminalTitle">zsh — hermes</span>
                    </span>
                    <button class="dev-copy" type="button" data-copy={MCP_CMD} data-i18n="copyLabel">Copy</button>
                  </span>
                  <span class="dev-term-body">
                    <span class="dev-term-out">
                      <span class="dev-cmd"><span class="dev-cmd__prompt">$ </span>claude mcp add --transport http hermes \</span>
                      <span class="dev-cmd2"><span class="dev-cmd2__text">&nbsp;&nbsp;&nbsp;&nbsp;{MCP_URL}</span><span class="dev-caret" aria-hidden="true"></span></span>
                      <span class="dev-out dev-out--1" data-i18n="devOut1">✓ Added MCP server “hermes”</span>
                      <span class="dev-out dev-out--2" data-i18n="devOut2">✓ Connected · tools available</span>
                    </span>
                    <span class="dev-ask">
                      <span class="dev-ask__label" data-i18n="devToolsLabel">Just ask — for example</span>
                      <span class="dev-ask__line dev-ask-1" data-i18n="devAsk1">“Who called today, and what did they want?”</span>
                      <span class="dev-ask__line dev-ask-2" data-i18n="devAsk2">“Call Mr. Müller and move his appointment to Thursday.”</span>
                    </span>
                  </span>
                </span>
              </div>
            </div>
            <div class="agent-try agent-try--dev">
              <span class="agent-try__label" data-i18n="agentTryLabel">Try it with your AI</span>
              <span class="agent-try__box">
                <span class="agent-try__prompt">Set up Hermes for me: <span class="agent-try__url">{AGENT_GUIDE}</span></span>
                <button class="agent-try__copy" type="button" data-copy={AGENT_PROMPT} data-i18n="copyLabel">Copy</button>
              </span>
            </div>
            <!-- Nur am Handy: statt der beiden Fenster-Nachbauten EINE Glaskarte mit den
                 drei Wegen - jeweils das, was man kopiert, und ein Copy-Knopf. -->
            <div class="dev-list">
              <div class="dev-list__row">
                <span class="dev-list__head"><span class="dev-list__num">01</span><span class="dev-list__title" data-i18n="devWayATitle">Add it as a connector</span><button class="dev-list__copy" type="button" data-copy={MCP_URL} data-i18n="copyLabel">Copy</button></span>
                <span class="dev-list__code"><span>{MCP_URL}</span></span>
              </div>
              <div class="dev-list__row">
                <span class="dev-list__head"><span class="dev-list__num">02</span><span class="dev-list__title" data-i18n="devWayB">In the terminal</span><button class="dev-list__copy" type="button" data-copy={MCP_CMD} data-i18n="copyLabel">Copy</button></span>
                <span class="dev-list__code"><span>claude mcp add --transport http hermes</span><span>{MCP_URL}</span></span>
              </div>
              <div class="dev-list__row">
                <span class="dev-list__head"><span class="dev-list__num">03</span><span class="dev-list__title" data-i18n="agentTryLabel">Try it with your AI</span><button class="dev-list__copy" type="button" data-copy={AGENT_PROMPT} data-i18n="copyLabel">Copy</button></span>
                <span class="dev-list__prompt">Set up Hermes for me: <strong>{AGENT_GUIDE}</strong></span>
              </div>
            </div>
            <p class="layer-note" data-i18n="devFootnote">Streamable HTTP, OAuth on first connect. Works with Claude, Codex and any MCP client.</p>
          </section>

          <!-- -------------------------------------------------- Fussband -->
          <footer class="site-footer">
            <span class="site-footer__copy" data-i18n="footerCopy">© Sundartha — Hermes, your phone assistant</span>
            <span class="site-footer__nav">
              <button class="site-footer__link" type="button" data-goto="howto:1" data-i18n="howItWorks">How it works</button>
              <button class="site-footer__link" type="button" data-goto="price:2" data-i18n="pricing">Pricing</button>
              <button class="site-footer__link" type="button" data-goto="dev:3" data-i18n="forDevs">For developers</button>
              <a class="site-footer__link" href={LOGIN_URL} data-i18n="getNumber">Get a number</a>
              {legalDocs.map((entry) => (
                <a class="site-footer__link" href={entry.href} data-legal-open={entry.slug} data-i18n={entry.i18n}>{entry.label}</a>
              ))}
              <!-- § 312k BGB: staendig verfuegbar im Fussband. KEIN data-i18n - der Wortlaut
                   ist eine benannte Konstante (lib/subscribe.js), kein Woerterbuch-Wert;
                   BiText zeigt die Fassung zur Seitensprache. -->
              <a class="site-footer__link" href="/kuendigen" data-legal-open="cancel"><BiText {...CANCEL_LABEL} /></a>
              <!-- Support: Beschriftung in DE und EN gleich, darum KEIN data-i18n. Oeffnet wie Kuendigen den Reiter im Rechts-Blatt. -->
              <a class="site-footer__link" href="/support" data-legal-open="support">Support</a>
              <a class="site-footer__link" href={`mailto:${CONTACT}`} data-i18n="contact">Contact</a>
              <button class="site-footer__link" type="button" data-consent-open data-i18n="cookieSettings">Cookie settings</button>
            </span>
          </footer>

          <div class="scroll-hint" aria-hidden="true">
            <span class="scroll-hint__rail"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================ Vollbild-Blaetter ===== -->

    <!-- Am Handy wird nicht gescrollt: die drei Sektionen und das Menue
         oeffnen sich als Vollbild. Auf dem Desktop dient nur das Rechts-Blatt. -->
    <div class="sheet" data-sheet="howto" data-open="0" role="dialog" aria-modal="true" aria-label="How it works">
      <div class="sheet__bg" aria-hidden="true"></div>
      <div class="sheet__veil" aria-hidden="true"></div>
      <div class="sheet__top" aria-hidden="true"></div>
      <div class="sheet__head">
        <span class="lockup">
          <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
          <span class="lockup__text">
            <span class="lockup__name">HERMES</span>
            <span class="lockup__by">by Sundartha</span>
          </span>
        </span>
        <button class="sheet__close" type="button" data-close-sheet aria-label="Close">×</button>
      </div>
      <span class="sheet__title" data-i18n="howtoTitle">One connection, <em>two minutes</em>.</span>
      <p class="sheet__lead" data-i18n="howtoLead">One connection over <strong>MCP</strong>, no setup — your AI is reachable on a real number in under two minutes.</p>
      <HowtoSteps lang="en" variant="sheet" />
      <a class="sheet__cta" href={LOGIN_URL} data-i18n="getNumber">Get a number</a>
    </div>

    <div class="sheet" data-sheet="price" data-open="0" role="dialog" aria-modal="true" aria-label="Pricing">
      <div class="sheet__bg" aria-hidden="true"></div>
      <div class="sheet__veil" aria-hidden="true"></div>
      <div class="sheet__top" aria-hidden="true"></div>
      <div class="sheet__head">
        <span class="lockup">
          <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
          <span class="lockup__text">
            <span class="lockup__name">HERMES</span>
            <span class="lockup__by">by Sundartha</span>
          </span>
        </span>
        <button class="sheet__close" type="button" data-close-sheet aria-label="Close">×</button>
      </div>
      <span class="sheet__title" data-i18n="priceTitle">Two plans, <em>no surprises</em>.</span>
      <p class="sheet__lead" data-i18n="priceLead">Choose the plan that fits you. <strong>Cancel monthly</strong>, <strong>no hidden costs</strong>.</p>
      <div class="sheet-plans">
        <div class="sheet-plan">
          <span class="sheet-plan__head">
            <span class="sheet-plan__labels">
              <span class="sheet-plan__label" data-i18n="starterLabel">Starter</span>
            </span>
            <span class="sheet-plan__price"><span data-i18n="starterPrice">€4.99</span><span class="sheet-plan__per" data-i18n="perMonth">/ month</span></span>
          </span>
          <span class="sheet-plan__features">
            <span data-i18n="starterF1"><strong>30 minutes</strong> of calls per month</span>
            <span data-i18n="starterF2">Answers every call for you</span>
            <span data-i18n="starterF3">Summarizes every call for you</span>
            <span data-i18n="starterF4">Email support</span>
          </span>
          <a class="sheet-plan__cta" href={LOGIN_URL} data-i18n="starterCta">Choose Starter</a>
        </div>
        <div class="sheet-plan sheet-plan--featured">
          <span class="sheet-plan__head">
            <span class="sheet-plan__labels">
              <span class="sheet-plan__label" data-i18n="businessLabel">Pro</span>
              <span class="sheet-plan__badge" data-i18n="popular">Popular</span>
            </span>
            <span class="sheet-plan__price"><span data-i18n="businessPrice">€9.99</span><span class="sheet-plan__per" data-i18n="perMonth">/ month</span></span>
          </span>
          <span class="sheet-plan__features">
            <span data-i18n="businessF1"><strong>120 minutes</strong> of calls per month</span>
            <span data-i18n="businessF2">Answers <em>and</em> calls out for you</span>
            <span data-i18n="businessF3">Handles tasks independently for you</span>
            <span data-i18n="businessF4">Priority support</span>
          </span>
          <a class="sheet-plan__cta" href={LOGIN_URL} data-i18n="businessCta">Choose Pro</a>
        </div>
      </div>
      <p class="sheet__note" data-i18n="footnote">Out of minutes? You get a heads-up — never an automatic surcharge.</p>
    </div>

    <div class="sheet dev-sheet" data-sheet="dev" data-open="0" role="dialog" aria-modal="true" aria-label="For developers">
      <div class="sheet__bg" aria-hidden="true"></div>
      <div class="sheet__veil" aria-hidden="true"></div>
      <div class="sheet__top" aria-hidden="true"></div>
      <div class="sheet__head">
        <span class="lockup">
          <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
          <span class="lockup__text">
            <span class="lockup__name">HERMES</span>
            <span class="lockup__by">by Sundartha</span>
          </span>
        </span>
        <button class="sheet__close" type="button" data-close-sheet aria-label="Close">×</button>
      </div>
      <span class="sheet__title" data-i18n="devTitle">One endpoint, <em>three ways</em>.</span>
      <p class="sheet__lead" data-i18n="devLead">Hermes is an <strong>MCP</strong> server. Connect it in the AI tool of your choice or straight from the terminal.</p>
      <div class="agent-try agent-try--sheet">
        <span class="agent-try__label" data-i18n="agentTryLabel">Try it with your AI</span>
        <span class="agent-try__box">
          <span class="agent-try__prompt">Set up Hermes for me: <span class="agent-try__url">{AGENT_GUIDE}</span></span>
          <button class="agent-try__copy" type="button" data-copy={AGENT_PROMPT} data-i18n="copyLabel">Copy</button>
        </span>
      </div>

      <div class="sheet__card">
        <span class="dev-card__head">
          <span class="dev-num">01</span>
          <span class="dev-card__titles">
            <span class="dev-eyebrow" data-i18n="devWayA">In your AI tool</span>
            <span class="dev-card__title" data-i18n="devWayATitle">Add it as a connector</span>
          </span>
        </span>
        <span class="dev-window">
          <span class="dev-bar">
            <span class="dev-dot" aria-hidden="true"></span>
            <span class="dev-dot" aria-hidden="true"></span>
            <span class="dev-dot" aria-hidden="true"></span>
            <span class="dev-bar__title" data-i18n="devWindowTitle">Settings › Connectors</span>
          </span>
          <span class="dev-form-body">
            <span class="dev-addrow">
              <span class="dev-addrow__plus" aria-hidden="true">+</span><span data-i18n="devAddRow">Add custom connector</span>
            </span>
            <span class="dev-arrow dev-arrow--1" aria-hidden="true"><span>↓</span></span>
            <span class="dev-field dev-field--1">
              <span class="dev-field__label" data-i18n="devFieldName">Name</span>
              <span class="dev-field__typed">Hermes</span>
            </span>
            <span class="dev-arrow dev-arrow--2" aria-hidden="true"><span>↓</span></span>
            <span class="dev-field dev-field--2 dev-field--url">
              <span class="dev-field__label" data-i18n="devFieldUrl">Server URL</span>
              <span class="dev-field__row">
                <span class="dev-field__url">{MCP_URL}</span>
                <button class="dev-copy" type="button" data-copy={MCP_URL} data-i18n="copyLabel">Copy</button>
              </span>
            </span>
            <span class="dev-connect" data-i18n="devConnectBtn">Connect</span>
          </span>
        </span>
      </div>

      <div class="sheet__card">
        <span class="dev-card__head">
          <span class="dev-num">02</span>
          <span class="dev-card__titles">
            <span class="dev-eyebrow" data-i18n="devWayB">In the terminal</span>
            <span class="dev-card__title" data-i18n="devWayBTitle">With a single command</span>
          </span>
        </span>
        <span class="dev-window dev-window--dark">
          <span class="dev-bar dev-bar--split">
            <span class="dev-bar__group">
              <span class="dev-dot" aria-hidden="true"></span>
              <span class="dev-dot" aria-hidden="true"></span>
              <span class="dev-dot" aria-hidden="true"></span>
              <span class="dev-bar__title" data-i18n="devTerminalTitle">zsh — hermes</span>
            </span>
            <button class="dev-copy" type="button" data-copy={MCP_CMD} data-i18n="copyLabel">Copy</button>
          </span>
          <span class="dev-term-body">
            <span class="dev-term-out">
              <span class="dev-cmd"><span class="dev-cmd__prompt">$ </span>claude mcp add --transport http hermes \</span>
              <span class="dev-cmd2"><span class="dev-cmd2__text">&nbsp;&nbsp;&nbsp;&nbsp;{MCP_URL}</span><span class="dev-caret" aria-hidden="true"></span></span>
              <span class="dev-out dev-out--1" data-i18n="devOut1">✓ Added MCP server “hermes”</span>
              <span class="dev-out dev-out--2" data-i18n="devOut2">✓ Connected · tools available</span>
            </span>
            <span class="dev-ask">
              <span class="dev-ask__label" data-i18n="devToolsLabel">Just ask — for example</span>
              <span class="dev-ask__line dev-ask-1" data-i18n="devAsk1">“Who called today, and what did they want?”</span>
              <span class="dev-ask__line dev-ask-2" data-i18n="devAsk2">“Call Mr. Müller and move his appointment to Thursday.”</span>
            </span>
          </span>
        </span>
      </div>

      <p class="sheet__note" data-i18n="devFootnote">Streamable HTTP, OAuth on first connect. Works with Claude, Codex and any MCP client.</p>
    </div>

    <!-- Rechts-Blatt. Die Texte stammen aus src/data/legal/ — derselben Quelle
         wie /datenschutz, /impressum, /agb und /legal/*. Die Seiten bleiben unter
         ihrer URL erreichbar (Pflicht), das Blatt ist der schnelle Weg von hier.
         Jeder Text steht in beiden Sprachen da (data-lang-only). -->
    <div class="sheet legal-sheet" data-sheet="legal" data-open="0" role="dialog" aria-modal="true" aria-label="Legal">
      <div class="sheet__bg" aria-hidden="true"></div>
      <div class="sheet__veil" aria-hidden="true"></div>
      <div class="sheet__top" aria-hidden="true"></div>
      <div class="legal-head">
        <span class="lockup">
          <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
          <span class="lockup__text">
            <span class="lockup__name">HERMES</span>
            <span class="lockup__by">by Sundartha</span>
          </span>
        </span>
        <button class="sheet__close" type="button" data-close-sheet aria-label="Close">×</button>
      </div>
      <div class="legal-body">
        <div class="legal-topper">
          {legalDocs.map((entry) => (
            <span class="legal-title" data-legal-doc={entry.slug} hidden={entry.slug !== "privacy"}><BiText en={entry.docEn.title} de={entry.doc.title} /></span>
          ))}
          {infoTabs.map((entry) => (
            <span class="legal-title" data-legal-doc={entry.slug} hidden><BiText {...entry.label} /></span>
          ))}
          <LegalTabs legalDocs={legalDocs} infoTabs={infoTabs} contact={CONTACT} />
        </div>
        {legalDocs.map((entry) => (
          <div data-legal-doc={entry.slug} hidden={entry.slug !== "privacy"}>
            <div data-lang-only="en">
              <div class="legal-card">
                {entry.docEn.sections.map((section) => (
                  <div class="legal-section">
                    <span class="legal-eyebrow">{section.heading}</span>
                    <span class="legal-text">{section.text}</span>
                  </div>
                ))}
              </div>
              <p class="legal-note">
                {LEGAL_TRANSLATION_NOTICE} — <a href={entry.hrefEn}>Open as a separate page</a>
              </p>
            </div>
            <div data-lang-only="de">
              <div class="legal-card">
                {entry.doc.sections.map((section) => (
                  <div class="legal-section">
                    <span class="legal-eyebrow">{section.heading}</span>
                    <span class="legal-text">{section.text}</span>
                  </div>
                ))}
              </div>
              <p class="legal-note">
                {entry.doc.note} — <a href={entry.href}>Als eigene Seite öffnen</a>
              </p>
            </div>
          </div>
        ))}
        <div class="legal-info" data-legal-doc="cancel" hidden>
          <div data-lang-only="en"><CancelInfo lang="en" /></div>
          <div data-lang-only="de"><CancelInfo /></div>
        </div>
        <div class="legal-info" data-legal-doc="support" hidden>
          <div data-lang-only="en"><SupportInfo inSheet /></div>
          <div data-lang-only="de"><SupportInfo lang="de" inSheet /></div>
        </div>
      </div>
    </div>

    <div class="sheet menu-sheet" data-sheet="menu" data-open="0" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="sheet__bg" aria-hidden="true"></div>
      <div class="sheet__veil" aria-hidden="true"></div>
      <div class="sheet__top" aria-hidden="true"></div>
      <div class="sheet__head">
        <span class="lockup">
          <img class="nav-wing" src="/assets/hermes-wing.png" alt="" />
          <span class="lockup__text">
            <span class="lockup__name">HERMES</span>
            <span class="lockup__by">by Sundartha</span>
          </span>
        </span>
        <button class="sheet__close" type="button" data-close-sheet aria-label="Close">×</button>
      </div>
      <div class="menu-list">
        <button class="menu-item" type="button" data-goto="howto:1" data-from-menu data-i18n="howItWorks">How it works</button>
        <button class="menu-item" type="button" data-goto="price:2" data-from-menu data-i18n="pricing">Pricing</button>
        <button class="menu-item" type="button" data-goto="dev:3" data-from-menu data-i18n="forDevs">For developers</button>
      </div>
      <div class="menu-block">
        <span class="menu-label" data-i18n="language">Language</span>
        <div class="menu-langs">
          <button class="menu-lang" type="button" data-lang="en" aria-pressed="true">English</button>
          <button class="menu-lang" type="button" data-lang="de" aria-pressed="false">Deutsch</button>
        </div>
      </div>
      <!-- Owner-Feedback 2026-08-14: Login + Registrieren statt "Nummer holen" — wie im Desktop-Header (s. nav-actions oben, beide Ziele LOGIN_URL). -->
      <div class="menu-cta-row">
        <a class="sheet__cta sheet__cta--ghost" href={LOGIN_URL} data-i18n="logIn">Log in</a>
        <a class="sheet__cta" href={LOGIN_URL} data-i18n="signUp">Sign up</a>
      </div>
      <div class="menu-foot">
        <div class="menu-foot__links">
          {legalDocs.map((entry) => (
            <a class="menu-foot__link" href={entry.href} data-legal-open={entry.slug} data-i18n={entry.i18n}>{entry.label}</a>
          ))}
          <!-- § 312k BGB: derselbe Wortlaut wie im Fussband oben, KEIN data-i18n (s. dort). -->
          <a class="menu-foot__link" href="/kuendigen" data-legal-open="cancel"><BiText {...CANCEL_LABEL} /></a>
          <!-- Support wie im Fussband oben, KEIN data-i18n (s. dort). -->
          <a class="menu-foot__link" href="/support" data-legal-open="support">Support</a>
          <a class="menu-foot__link" href={`mailto:${CONTACT}`} data-i18n="contact">Contact</a>
          <button class="menu-foot__link" type="button" data-consent-open data-i18n="cookieSettings">Cookie settings</button>
        </div>
        <span class="menu-foot__copy" data-i18n="footerCopy">© Sundartha — Hermes, your phone assistant</span>
      </div>
    </div>

    <CookieConsent lang="en" placement="hero" />
    <AnalyticsSlot />

    <script>
      // Hoisted script: Astro buendelt es als externes, same-origin Modul
      // (assetsInlineLimit 0) — CSP-konform ohne script-src 'unsafe-inline'.
      import "../scripts/hermes-scroll.js";
      import "../scripts/hermes-mobile.js";
    </script>
  </body>
</html>
