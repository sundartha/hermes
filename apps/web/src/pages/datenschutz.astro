---
// Datenschutz — verbindliche deutsche Fassung. Der Text kommt aus
// src/data/legal/privacy.de.json, NICHT aus dieser Datei: dieselbe Quelle, aus der auch
// das Rechts-Blatt der Startseite gebaut wird. Ein zweiter Textstand kann so
// nicht entstehen.
import Hermes from "../layouts/Hermes.astro";
import doc from "../data/legal/privacy.de.json";
---

<Hermes title={doc.metaTitle} description={doc.metaDescription} lang="de">
  <h1 class="doc-title" slot="head">{doc.title}</h1>

  <div class="doc-legal">
    <div class="legal-card">
      {doc.sections.map((section) => (
        <div class="legal-section">
          <h2 class="legal-eyebrow">{section.heading}</h2>
          <p class="legal-text">{section.text}</p>
        </div>
      ))}
    </div>
  </div>

  <p class="doc-note">{doc.note}</p>
</Hermes>
