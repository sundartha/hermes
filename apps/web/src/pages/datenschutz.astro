---
// Marketing: Datenschutz (SSG). Geruest mit Platzhalter-Inhalt — die
// verbindlichen Texte liefert der Owner (Strategie N1, geflaggt).
import Marketing from "../layouts/Marketing.astro";

const sections = [
  {
    heading: "Verantwortliche Stelle",
    text: "Verantwortlich fuer die Datenverarbeitung ist Sundartha. Die vollstaendigen Kontaktdaten findest du im Impressum.",
  },
  {
    heading: "Welche Daten wir verarbeiten",
    text: "Fuer den Betrieb des Telefon-Assistenten verarbeiten wir Konto- und Anrufdaten (z.B. Rufnummern, Gespraechs-Zusammenfassungen). Details ergaenzt der finale Datenschutztext.",
  },
  {
    heading: "Deine Rechte",
    text: "Du hast das Recht auf Auskunft, Berichtigung, Loeschung und Datenuebertragbarkeit. Anfragen richtest du an kontakt@sundartha.com.",
  },
];
---

<Marketing
  title="Datenschutz — Sundartha Hermes"
  description="Datenschutzhinweise zu Sundartha Hermes: verantwortliche Stelle, verarbeitete Daten und deine Rechte."
>
  <section class="section">
    <div class="container">
      <div class="legal">
        <span class="eyebrow">Rechtliches</span>
        <h1 class="section__title">Datenschutz</h1>
        <p class="legal__note">
          Platzhalter-Fassung. Die rechtsverbindliche Datenschutzerklaerung
          liefert Sundartha.
        </p>
        {sections.map((section) => (
          <>
            <h2 class="legal__heading">{section.heading}</h2>
            <p class="legal__text">{section.text}</p>
          </>
        ))}
      </div>
    </div>
  </section>
</Marketing>
