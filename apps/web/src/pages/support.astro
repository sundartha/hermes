---
// Oeffentliche Support-Seite (Englisch, Marketing-Regel). Zweck: die Support-URL, die
// OpenAI fuer eine eingereichte App verlangt - woertlich: "Privacy policy, terms,
// support, and website URLs are public and match the publisher identity."
// (https://developers.openai.com/plugins/deploy/submission, "Final checklist").
// Deshalb OHNE noindex (Produktion muss indexierbar sein; das Labor setzt noindex per
// Header), in der Sitemap und im Fussband jeder Seite verlinkt.
//
// Der Inhalt - und welcher Beleg hinter jeder Aussage steht - liegt in
// components/site/SupportInfo.astro; derselbe Text erscheint als Reiter im Rechts-Blatt
// der Startseite. Kein Inline-Style, kein Script, keine externe Quelle (Produktions-CSP
// default-src 'self').
import Hermes from "../layouts/Hermes.astro";
import SupportInfo from "../components/site/SupportInfo.astro";
---

<Hermes
  lang="en"
  title="Support — Hermes by Sundartha"
  description="How to get help with Hermes: contact, your calls, disconnecting Hermes from your AI assistant, access to and deletion of your data, and cancelling your contract."
>
  <h1 class="doc-title">How can we <em>help</em>?</h1>
  <SupportInfo />
</Hermes>
