---
// So funktioniert's — ruhende Fassung der zweiten Ebene der Startseite.
import Hermes from "../layouts/Hermes.astro";
import HermesDemo from "../components/HermesDemo.astro";
import { LOGIN_URL } from "../lib/routes.js";

const MCP_URL = "https://app.sundartha.com/mcp";

const steps = [
  {
    num: "01",
    title: "Nummer holen",
    text: "Eine echte Rufnummer, in zwei Minuten aktiv. Kein Vertrag, keine Hardware.",
  },
  {
    num: "02",
    title: "KI verbinden",
    text: "Ein Anschluss über MCP. Deine KI weiß danach, wer angerufen hat und was zu tun ist.",
  },
  {
    num: "03",
    title: "Abnehmen lassen",
    text: "Hermes spricht, hört zu, vereinbart Termine und schreibt mit. Du liest das Protokoll.",
  },
];
---

<Hermes
  title="So funktioniert's — Hermes von Sundartha"
  description="Ein Anschluss über MCP, kein Setup — deine KI ist in unter zwei Minuten unter einer echten Nummer erreichbar."
>
  <h1 class="doc-title">Ein Anschluss, <em>zwei Minuten</em>.</h1>
  <p class="doc-lead">
    Ein Anschluss über <strong>MCP</strong>, kein Setup — deine KI ist in unter
    zwei Minuten unter einer echten Nummer erreichbar.
  </p>

  <div class="doc-block doc-demo">
    <HermesDemo />
  </div>

  <div class="doc-block doc-steps">
    <div class="sheet__card">
      {steps.map((step, index) => (
        <>
          {index > 0 && <span class="rule" aria-hidden="true"></span>}
          <span class="step">
            <span class="step__num">{step.num}</span>
            <span class="step__body">
              <span class="step__title">{step.title}</span>
              <span class="step__text">{step.text}</span>
            </span>
          </span>
        </>
      ))}
    </div>
  </div>

  <div class="doc-block doc-steps">
    <div class="sheet__card">
      <span class="dev-card__head">
        <span class="dev-num">→</span>
        <span class="dev-card__titles">
          <span class="dev-eyebrow">Für Entwickler</span>
          <span class="dev-card__title">Ein Endpoint, zwei Wege</span>
        </span>
      </span>
      <span class="step__text">
        Hermes ist ein MCP-Server. Trag <span class="dev-field__url">{MCP_URL}</span>
        als Konnektor im KI-Tool deiner Wahl ein — oder verbinde direkt aus dem
        Terminal. Streamable HTTP, OAuth beim ersten Verbinden.
      </span>
    </div>
  </div>

  <p class="doc-note">
    <a href={LOGIN_URL}>Nummer holen</a> und in zwei Minuten telefonieren lassen.
  </p>
</Hermes>

<script>
  import "../scripts/hermes-demo.js";
</script>
