---
// Marketing: "How it works" (SSG). Statisches HTML, kein Client-Fetch.
// Drei Schritte vom MCP-Anschluss bis zum laufenden Agenten (Auftrag W1).
import Site from "../layouts/Site.astro";

const steps = [
  {
    title: "Connect your AI assistant via MCP",
    text: "Attach Hermes as an MCP server to your agent — Claude, a custom assistant or a workflow. No telephony stack of your own required.",
  },
  {
    title: "Pick a number and plan",
    text: "Choose a phone number and the plan that fits. You decide what your agent may do — view appointments, book them or ask follow-up questions.",
  },
  {
    title: "Hermes makes the calls",
    text: "Hermes answers incoming calls and places outgoing ones on your behalf — and clearly states up front that an assistant is speaking.",
  },
];
---

<Site
  title="How Hermes works — Sundartha"
  description="Your own phone assistant in three steps: connect via MCP, pick a number and plan, let Hermes make the calls."
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">In three steps</span>
      <h1 class="hero__title">How <span class="highlight">Hermes</span> works</h1>
      <p class="hero__lead">
        From the MCP connection to the finished call log — no hardware of your
        own, no waiting.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--three">
        {steps.map((step, index) => (
          <article class="card">
            <span class="step__index" aria-hidden="true">{index + 1}</span>
            <h2 class="card__title">{step.title}</h2>
            <p class="card__text">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">Ready to try it?</h2>
      </div>
      <div class="hero__actions">
        <a class="button button--primary" href="/registrieren">Get started</a>
        <a class="button button--action" href="/preise">View pricing</a>
      </div>
    </div>
  </section>
</Site>
