---
// Marketing: "So funktioniert's" (SSG). Statisches HTML, kein Client-Fetch.
// Drei Schritte vom MCP-Anschluss bis zum laufenden Agenten (Auftrag W1).
import Marketing from "../layouts/Marketing.astro";

const steps = [
  {
    title: "KI-Assistent per MCP verbinden",
    text: "Haenge Hermes als MCP-Server an deinen Agenten — Claude, einen eigenen Assistenten oder Workflow. Kein eigener Telefonie-Stack noetig.",
  },
  {
    title: "Rufnummer und Tarif waehlen",
    text: "Such dir eine Rufnummer und den passenden Tarif aus. Du legst fest, was dein Agent darf — Termine einsehen, buchen oder Rueckfragen stellen.",
  },
  {
    title: "Hermes telefoniert",
    text: "Eingehende Anrufe nimmt Hermes an, ausgehende fuehrt er in deinem Auftrag — und nennt zu Beginn klar, dass ein Assistent spricht.",
  },
];
---

<Marketing
  title="So funktioniert Hermes — Sundartha"
  description="In drei Schritten zum eigenen Telefon-Assistenten: per MCP verbinden, Rufnummer und Tarif waehlen, Hermes telefonieren lassen."
>
  <section class="hero">
    <div class="container">
      <span class="hero__eyebrow">In drei Schritten</span>
      <h1 class="hero__title">So funktioniert <span class="highlight">Hermes</span></h1>
      <p class="hero__lead">
        Vom MCP-Anschluss bis zum fertigen Gespraechsprotokoll — ohne eigene
        Technik, ohne Wartezeit.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--three">
        {steps.map((step, index) => (
          <article class="card">
            <span class="step__index" aria-hidden="true">{index + 1}</span>
            <h2 class="card__title">{step.title}</h2>
            <p class="card__text">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">Bereit, es auszuprobieren?</h2>
      </div>
      <div class="hero__actions">
        <a class="button button--primary" href="/auth/login">Jetzt starten</a>
        <a class="button button--action" href="/preise">Preise ansehen</a>
      </div>
    </div>
  </section>
</Marketing>
