{
  "titel": "Aufräumen-Workflow mit Zeitplan, Environment wartung und Abo-Token",
  "dateien": {
    ".github/workflows/aufraeumen.yml": [
      "name: Aufräumen",
      "on:",
      "  schedule:",
      "    - cron: \"37 2 * * *\"",
      "  workflow_dispatch:",
      "permissions: {}",
      "concurrency:",
      "  group: aufraeumen",
      "  cancel-in-progress: false",
      "jobs:",
      "  agent:",
      "    name: Agent",
      "    runs-on: ubuntu-latest",
      "    environment: wartung",
      "    timeout-minutes: 60",
      "    permissions:",
      "      contents: read",
      "    steps:",
      "      - name: Checkout",
      "        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
      "        with:",
      "          persist-credentials: false",
      "      - name: Node 22",
      "        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
      "        with:",
      "          node-version: 22",
      "      - name: Agenten-Programm installieren",
      "        run: npm ci --ignore-scripts --prefix tools/pruefer",
      "      - name: Aufräumen lassen",
      "        env:",
      "          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}",
      "        run: node tools/ziele.mjs agent --ordner /tmp/ziele"
    ]
  },
  "erwartet": "secrets nur in Workflows aus tools/basis/geheimnis-workflows.json"
}
