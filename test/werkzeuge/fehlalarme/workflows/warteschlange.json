{
  "titel": "Warteschlangen-Workflow mit workflow_run, Environment warteschlange und Bot-Token",
  "dateien": {
    ".github/workflows/ci.yml": [
      "name: CI",
      "on:",
      "  push:",
      "    branches: [master]",
      "permissions:",
      "  contents: read",
      "jobs:",
      "  test:",
      "    runs-on: ubuntu-latest",
      "    steps:",
      "      - name: Schritt",
      "        run: echo ok"
    ],
    ".github/workflows/warteschlange.yml": [
      "name: Warteschlange",
      "on:",
      "  workflow_run:",
      "    workflows: [\"CI\"]",
      "    types: [completed]",
      "permissions: {}",
      "jobs:",
      "  zuruecknehmen:",
      "    name: Rücknahme anlegen",
      "    if: github.event.workflow_run.event == 'push' && github.event.workflow_run.conclusion == 'failure'",
      "    runs-on: ubuntu-latest",
      "    environment: warteschlange",
      "    concurrency:",
      "      group: warteschlange-ruecknahme",
      "      cancel-in-progress: false",
      "    permissions:",
      "      contents: read",
      "    steps:",
      "      - name: Checkout",
      "        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
      "        with:",
      "          fetch-depth: 0",
      "          persist-credentials: false",
      "      - name: Node 22",
      "        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
      "        with:",
      "          node-version: 22",
      "      - name: npm ci",
      "        run: npm ci --ignore-scripts",
      "      - name: Rücknahme anlegen",
      "        env:",
      "          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}",
      "        run: node tools/warteschlange.mjs zuruecknehmen --ordner /tmp/wackelig"
    ]
  },
  "erwartet": "secrets nur in Workflows aus tools/basis/geheimnis-workflows.json"
}
