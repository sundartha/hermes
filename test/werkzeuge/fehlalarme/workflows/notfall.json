{
  "titel": "Notfall-Workflow mit Render-Schlüssel im Environment produktion",
  "dateien": {
    ".github/workflows/notfall.yml": [
      "name: notfall",
      "on:",
      "  workflow_dispatch:",
      "    inputs:",
      "      aktion:",
      "        type: choice",
      "        options:",
      "          - zurueckrollen",
      "          - anrufe-pausieren",
      "          - anrufe-freigeben",
      "permissions: {}",
      "jobs:",
      "  live-anhalten:",
      "    if: inputs.aktion == 'zurueckrollen' && github.ref == 'refs/heads/master'",
      "    runs-on: ubuntu-24.04",
      "    permissions:",
      "      actions: write",
      "    steps:",
      "      - name: Workflow live abschalten",
      "        env:",
      "          GH_TOKEN: ${{ github.token }}",
      "        run: gh workflow disable live.yml --repo \"$GITHUB_REPOSITORY\"",
      "  zurueckrollen:",
      "    needs: live-anhalten",
      "    if: always() && inputs.aktion == 'zurueckrollen' && github.ref == 'refs/heads/master'",
      "    runs-on: ubuntu-24.04",
      "    environment: produktion",
      "    permissions:",
      "      contents: read",
      "    concurrency:",
      "      group: notfall-rollback",
      "      cancel-in-progress: false",
      "    steps:",
      "      - name: Checkout",
      "        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
      "        with:",
      "          persist-credentials: false",
      "      - name: Zurückrollen",
      "        env:",
      "          RENDER_API_KEY: ${{ secrets.RENDER_API_KEY }}",
      "          ZIEL: ${{ inputs.ziel }}",
      "        run: node tools/deploy-weg.mjs zurueckrollen --ziel \"$ZIEL\""
    ]
  },
  "erwartet": "secrets nur in Workflows aus tools/basis/geheimnis-workflows.json"
}
