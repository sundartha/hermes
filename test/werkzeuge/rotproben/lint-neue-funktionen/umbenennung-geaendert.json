{
  "titel": "Umbenennung .js→.ts ändert eine andere Funktion, jede Funktion zählt als neu",
  "vorher": {
    "src/probe/rechnen.js": [
      "export function alt(wert) {",
      "  return wert * 42;",
      "}",
      "",
      "export function sauber(wert) {",
      "  return wert + 1;",
      "}"
    ]
  },
  "loeschen": ["src/probe/rechnen.js"],
  "dateien": {
    "src/probe/rechnen.ts": [
      "export function alt(wert: number): number {",
      "  return wert * 42;",
      "}",
      "",
      "export function sauber(wert: number): number {",
      "  return wert - 1;",
      "}"
    ]
  },
  "erwartet": "src/probe/rechnen.ts:2 no-magic-numbers: No magic number: 42"
}
