{
  "titel": "cache: npm in einem Pull-Request-Workflow ohne Secret",
  "dateien": {
    ".github/workflows/rotprobe.yml": [
      "name: Rotprobe",
      "on:",
      "  pull_request:",
      "    branches: [master]",
      "permissions:",
      "  contents: read",
      "jobs:",
      "  probe:",
      "    runs-on: ubuntu-latest",
      "    steps:",
      "      - name: Node 22",
      "        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
      "        with:",
      "          node-version: 22",
      "          cache: npm",
      "      - name: npm ci",
      "        run: npm ci --ignore-scripts"
    ]
  },
  "erwartet": "cache: und actions/cache sind in Workflow-Dateien verboten"
}
