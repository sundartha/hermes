{
  "titel": "cache: npm in einem Workflow der Secret-Liste mit Environment und Secret",
  "dateien": {
    ".github/workflows/rotproben.yml": [
      "name: Soll und Rot-Proben",
      "on:",
      "  workflow_dispatch:",
      "permissions: {}",
      "jobs:",
      "  rotproben:",
      "    name: Rot-Proben",
      "    runs-on: ubuntu-latest",
      "    environment: rotproben",
      "    permissions:",
      "      contents: read",
      "    steps:",
      "      - name: Checkout",
      "        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
      "        with:",
      "          persist-credentials: false",
      "      - name: Node 22",
      "        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
      "        with:",
      "          node-version: 22",
      "          cache: npm",
      "      - name: npm ci",
      "        run: npm ci --ignore-scripts",
      "      - name: App-Token",
      "        id: app-token",
      "        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1",
      "        with:",
      "          app-id: ${{ vars.AGENT_APP_ID }}",
      "          private-key: ${{ secrets.AGENT_APP_PRIVATE_KEY }}",
      "          repositories: hermes",
      "          permission-contents: read",
      "      - name: Rot-Proben",
      "        env:",
      "          GH_TOKEN: ${{ steps.app-token.outputs.token }}",
      "        run: node tools/rotproben-woche.mjs"
    ]
  },
  "erwartet": "cache: und actions/cache sind in Workflow-Dateien verboten"
}
