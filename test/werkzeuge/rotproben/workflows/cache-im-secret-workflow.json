{
  "titel": "cache: npm in einem Workflow der Secret-Liste mit Environment produktion",
  "dateien": {
    ".github/workflows/wiederherstellung.yml": [
      "name: Wiederherstellung",
      "on:",
      "  workflow_dispatch:",
      "permissions:",
      "  contents: read",
      "jobs:",
      "  pruefen:",
      "    runs-on: ubuntu-24.04",
      "    environment: produktion",
      "    steps:",
      "      - name: Checkout",
      "        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
      "        with:",
      "          persist-credentials: false",
      "      - name: Node 22",
      "        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
      "        with:",
      "          node-version: 22",
      "          cache: npm",
      "      - name: npm ci",
      "        run: npm ci --ignore-scripts",
      "      - name: Pruefen",
      "        env:",
      "          RENDER_API_KEY: ${{ secrets.RENDER_API_KEY }}",
      "        run: node tools/wiederherstellung.mjs pruefen"
    ]
  },
  "erwartet": "cache: und actions/cache sind in Workflows aus tools/basis/geheimnis-workflows.json verboten"
}
