{
  "titel": "Testanfragen nur mit Antwortfrist (hermes-tests/anfrage-mit-frist)",
  "pfade": [
    "eslint.config.*",
    "tools/eslint-rules/"
  ],
  "treffer": {
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      ".",
      "--suppressions-location",
      "eslint-suppressions.empty.json",
      "--format",
      "json"
    ],
    "zaehlen": "eslint-json"
  },
  "probe": {
    "mitnehmen": [
      "eslint.config.js",
      "tools/eslint-rules/index.js",
      "tools/eslint-rules/bestand.js",
      "tools/eslint-rules/keine-kommentare.js",
      "tools/eslint-rules/kein-quelltext-als-text.js",
      "tools/eslint-rules/pfad-falten.js",
      "tools/eslint-rules/namen-ohne-begruendung.js",
      "tools/eslint-rules/knoten.js",
      "tools/eslint-rules/tests.js",
      "tools/eslint-rules/keine-selbstpruefung.js",
      "tools/eslint-rules/fester-importpfad.js",
      "tools/eslint-rules/anfrage-mit-frist.js"
    ],
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      "--format",
      "json",
      "{dateien}"
    ]
  }
}
