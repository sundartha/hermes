{
  "titel": "Tests lesen keinen Quelltext als Text (hermes/kein-quelltext-als-text)",
  "pfade": [
    "eslint.config.*",
    "tools/eslint-rules/",
    "tools/basis/quelltext-als-text.json",
    "tools/basis-vergleich.mjs"
  ],
  "treffer": {
    "befehl": [
      "node",
      "{wurzel}/tools/basis-vergleich.mjs",
      "quelltext-als-text"
    ],
    "zaehlen": "zahlen",
    "vor": [
      " neue Befunde",
      " bekannte"
    ]
  },
  "ausnahmen": {
    "bezeichnung": "Eingefrorene Lesestellen in der Basislinie",
    "datei": "tools/basis/quelltext-als-text.json",
    "zaehlen": "anzahl",
    "anlegen": {
      "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "quelltext-als-text", "--basis-anlegen"]
    }
  },
  "probe": {
    "mitnehmen": [
      "eslint.config.js",
      "tools/eslint-rules/"
    ],
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      "--format",
      "json",
      "{dateien}"
    ]
  }
}
