{
  "titel": "Aussagelose Prüfung vor einem frühen return in einem bestehenden Test",
  "vorher": {
    "package.json": ["{ \"type\": \"module\" }"],
    "test/rechnen.test.js": [
      "import assert from \"node:assert/strict\";",
      "import { test } from \"node:test\";",
      "",
      "test(\"addiert\", () => {",
      "  assert.equal(1 + 2, 3);",
      "});"
    ]
  },
  "dateien": {
    "test/rechnen.test.js": [
      "import assert from \"node:assert/strict\";",
      "import { test } from \"node:test\";",
      "",
      "test(\"addiert\", () => {",
      "  assert.ok(true);",
      "  return;",
      "  assert.equal(1 + 2, 3);",
      "});"
    ]
  },
  "erwartet": "laufen nach der Änderung nicht mehr"
}
