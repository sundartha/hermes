{
  "titel": "Aussagelose Prüfung vor abgefangenen Prüfungen in einem bestehenden Test, den Git als binär ansieht",
  "vorher": {
    "package.json": ["{ \"type\": \"module\" }"],
    "test/rechnen.test.js": [
      "import assert from \"node:assert/strict\";",
      "import { test } from \"node:test\";",
      "",
      "test(\"addiert\", () => {",
      "  assert.equal(1 + 2, 3);",
      "});"
    ]
  },
  "dateien": {
    ".gitattributes": ["test/rechnen.test.js -diff"],
    "test/rechnen.test.js": [
      "import assert from \"node:assert/strict\";",
      "import { test } from \"node:test\";",
      "",
      "test(\"addiert\", () => {",
      "  assert.ok(true);",
      "  try {",
      "  assert.equal(1 + 2, 3);",
      "  } catch {",
      "  }",
      "});"
    ]
  },
  "erwartet": "gibt das Scheitern unveränderter Prüfungen nicht mehr weiter"
}
