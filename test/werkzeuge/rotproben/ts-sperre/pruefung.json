{
  "titel": "TypeScript nur, wo ESLint und tsc es sehen, und fester Bestand",
  "pfade": [
    "tools/ts-sperre.mjs",
    "tools/ts-dateien.mjs",
    "tools/basis/ts-bestand.json",
    "eslint.config.*",
    "tsconfig.json"
  ],
  "treffer": {
    "befehl": ["node", "{wurzel}/tools/ts-sperre.mjs"],
    "zaehlen": "stderr-zeilen"
  },
  "ausnahmen": {
    "bezeichnung": "TypeScript-Dateien im festen Bestand",
    "datei": "tools/basis/ts-bestand.json",
    "zaehlen": "anzahl"
  },
  "probe": {
    "mitnehmen": [
      "tools/basis/ts-bestand.json",
      "eslint.config.js",
      "src/store.js",
      "tsconfig.json",
      "tools/eslint-rules/"
    ],
    "befehl": ["node", "{wurzel}/tools/ts-sperre.mjs", "--basis", "HEAD~1"]
  }
}
