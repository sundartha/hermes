{
  "titel": "Tests prüfen keine eigenen Konstanten (hermes-tests/keine-selbstpruefung)",
  "pfade": [
    "eslint.config.*",
    "tools/eslint-rules/",
    "tools/basis/selbstpruefung.json",
    "tools/basis-vergleich.mjs"
  ],
  "treffer": {
    "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "selbstpruefung"],
    "zaehlen": "zahlen",
    "vor": [" neue Befunde", " bekannte"]
  },
  "ausnahmen": {
    "bezeichnung": "Eingefrorene Selbstprüfungen in der Basislinie",
    "datei": "tools/basis/selbstpruefung.json",
    "zaehlen": "anzahl",
    "anlegen": {
      "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "selbstpruefung", "--basis-anlegen"]
    }
  },
  "probe": {
    "mitnehmen": ["eslint.config.js", "tools/eslint-rules/"],
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      "--format",
      "json",
      "{dateien}"
    ]
  }
}
