{
  "titel": "Testlaufzeit",
  "pfade": [
    "tools/testlaufzeit-pruefen.mjs",
    "tools/testlaufzeit-reporter.mjs",
    "tools/testlaufzeit/",
    "tools/basis/testlaufzeit.json",
    "tools/basis/echte-wartezeiten.json",
    "tools/basis/zeitglieder-bestand.json",
    "test/echt-warten.js",
    "tools/umbenennung.mjs",
    "tools/syntaxbaum.mjs",
    "tools/bestand-rueckfuehrung.mjs"
  ],
  "ausnahmen": {
    "bezeichnung": "Eingefrorene direkte Zeitglieder in Tests",
    "datei": "tools/basis/zeitglieder-bestand.json",
    "zaehlen": "summe"
  },
  "probe": {
    "mitnehmen": [
      "eslint.config.js",
      "tools/basis/zeitglieder-bestand.json",
      "tools/basis/echte-wartezeiten.json",
      "tools/basis/testlaufzeit.json",
      "src/store.js",
      "tools/eslint-rules/index.js",
      "tools/eslint-rules/bestand.js",
      "tools/eslint-rules/keine-kommentare.js",
      "tools/eslint-rules/kein-quelltext-als-text.js",
      "tools/eslint-rules/pfad-falten.js",
      "tools/eslint-rules/namen-ohne-begruendung.js",
      "tools/eslint-rules/knoten.js"
    ],
    "befehl": [
      "node",
      "{wurzel}/tools/testlaufzeit-pruefen.mjs",
      "--laufzeiten",
      ".pruefung/dateien.jsonl",
      "--basis",
      "HEAD~1"
    ]
  }
}
