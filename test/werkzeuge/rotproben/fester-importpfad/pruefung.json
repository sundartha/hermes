{
  "titel": "Dynamische Importe in Tests nur mit festem Pfad (hermes-tests/fester-importpfad)",
  "pfade": [
    "eslint.config.*",
    "tools/eslint-rules/",
    "tools/basis/fester-importpfad.json",
    "tools/basis-vergleich.mjs"
  ],
  "treffer": {
    "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "fester-importpfad"],
    "zaehlen": "zahlen",
    "vor": [" neue Befunde", " bekannte"]
  },
  "ausnahmen": {
    "bezeichnung": "Eingefrorene Importe mit Platzhalter in der Basislinie",
    "datei": "tools/basis/fester-importpfad.json",
    "zaehlen": "anzahl",
    "anlegen": {
      "befehl": [
        "node",
        "{wurzel}/tools/basis-vergleich.mjs",
        "fester-importpfad",
        "--basis-anlegen"
      ]
    }
  },
  "probe": {
    "mitnehmen": ["eslint.config.js", "tools/eslint-rules/"],
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      "--format",
      "json",
      "{dateien}"
    ]
  }
}
