{
  "titel": "Kommentare im Code (hermes/keine-kommentare)",
  "pfade": [
    "eslint.config.*",
    "tools/eslint-rules/",
    "tools/basis/kommentare.json",
    "tools/basis-vergleich.mjs"
  ],
  "treffer": {
    "befehl": [
      "node",
      "{wurzel}/tools/basis-vergleich.mjs",
      "kommentare"
    ],
    "zaehlen": "zahlen",
    "vor": [
      " neue Befunde",
      " bekannte"
    ]
  },
  "ausnahmen": {
    "bezeichnung": "Eingefrorene Kommentare in der Basislinie",
    "datei": "tools/basis/kommentare.json",
    "zaehlen": "anzahl"
  },
  "probe": {
    "mitnehmen": [
      "eslint.config.js",
      "tools/eslint-rules/index.js",
      "tools/eslint-rules/bestand.js",
      "tools/eslint-rules/keine-kommentare.js",
      "tools/eslint-rules/kein-quelltext-als-text.js",
      "tools/eslint-rules/pfad-falten.js",
      "tools/eslint-rules/namen-ohne-begruendung.js",
      "tools/eslint-rules/knoten.js"
    ],
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      "--format",
      "json",
      "{dateien}"
    ]
  }
}
