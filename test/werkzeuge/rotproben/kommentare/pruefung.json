{
  "titel": "Kommentare im Code (hermes/keine-kommentare)",
  "pfade": [
    "eslint.config.*",
    "tools/eslint-rules/"
  ],
  "treffer": {
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      ".",
      "--suppressions-location",
      "eslint-suppressions.empty.json",
      "--format",
      "json"
    ],
    "zaehlen": "eslint-json",
    "regel": "hermes/keine-kommentare"
  },
  "probe": {
    "mitnehmen": [
      "eslint.config.js",
      "src/store.js",
      "tools/eslint-rules/"
    ],
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      "--format",
      "json",
      "{dateien}"
    ]
  }
}
