{
  "titel": "Toter Code (knip)",
  "pfade": [
    "tools/basis-vergleich.mjs",
    "knip.json",
    "tools/basis/knip.json",
    "tools/umbenennung.mjs",
    "tools/syntaxbaum.mjs",
    "tools/bestand-rueckfuehrung.mjs"
  ],
  "treffer": {
    "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "knip"],
    "zaehlen": "zahlen",
    "vor": [" neue Befunde", " bekannte"]
  },
  "ausnahmen": {
    "bezeichnung": "Eingefrorene Befunde in der Basislinie",
    "datei": "tools/basis/knip.json",
    "zaehlen": "anzahl",
    "anlegen": {
      "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "knip", "--basis-anlegen"]
    }
  },
  "probe": {
    "mitnehmen": ["knip.json", "tools/basis/knip.json"],
    "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "knip", "--basis", "HEAD~1"]
  }
}
