{
  "titel": "Umbenennung .js→.ts nur mit Typen bringt einen neuen Kommentar mit",
  "vorher": {
    "src/probe/zahl.js": [
      "// Verdoppelt die Zahl.",
      "export function doppelt(zahl) {",
      "  return zahl * 2;",
      "}"
    ]
  },
  "loeschen": ["src/probe/zahl.js"],
  "dateien": {
    "src/probe/zahl.ts": [
      "// Verdoppelt die Zahl.",
      "export function doppelt(zahl: number): number {",
      "  // Ergebnis ist gerade.",
      "  return zahl * 2;",
      "}"
    ]
  },
  "erwartet": "src/probe/zahl.ts:3 neuer Kommentar"
}
