{
  "titel": "Umbenennung .js→.ts ändert die Rechnung, der alte Kommentar zählt wie in einer neuen Datei",
  "vorher": {
    "src/probe/zahl.js": [
      "// Verdoppelt die Zahl.",
      "export function doppelt(zahl) {",
      "  return zahl * 2;",
      "}"
    ]
  },
  "loeschen": ["src/probe/zahl.js"],
  "dateien": {
    "src/probe/zahl.ts": [
      "// Verdoppelt die Zahl.",
      "export function doppelt(zahl: number): number {",
      "  return zahl * 3;",
      "}"
    ]
  },
  "erwartet": "src/probe/zahl.ts:1 neuer Kommentar"
}
