{
  "titel": "ESLint-Konfiguration, Unterordner und only",
  "pfade": ["tools/eslint-konfig-pruefen.mjs", "tools/basis/eslint-wirksam.json"],
  "treffer": {
    "befehl": ["node", "{wurzel}/tools/eslint-konfig-pruefen.mjs"],
