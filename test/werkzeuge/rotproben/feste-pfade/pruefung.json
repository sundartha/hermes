{
  "titel": "Feste Pfade zeigen auf versionierte Dateien",
  "pfade": [
    "tools/feste-pfade.mjs",
    "tools/feste-pfade/",
    "tools/migrationen-orte.mjs",
    "tools/ts-dateien.mjs",
    "tools/pruefungen-messen.mjs",
    "tools/workflows-pruefen/struktur.mjs",
    "tools/umbenennung.mjs",
    "tools/auftrag/format.mjs",
    "tools/auftrag/zweck.mjs",
