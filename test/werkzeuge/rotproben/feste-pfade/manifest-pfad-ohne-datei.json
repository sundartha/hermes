    "test/a.test.js": ["export const probe = 1;"],
    ".claude/hooks/h.mjs": ["export const haken = 1;"],
    "tools/gate-tests.json": [
      "{\"Probe\": {\"module\": [\"src/a.js#eins\"], \"tests\": [\"test/a.test.js\"]}}"
    ],
    "tools/ziele/geschuetzt.json": [
