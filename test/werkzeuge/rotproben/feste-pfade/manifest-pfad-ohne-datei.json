    ],
    ".dependency-cruiser.cjs": [
      "module.exports = { forbidden: [{ name: \"probe\", from: { path: \"^src/\" }, to: { path: \"^(src|test)/\" } }], required: [{ name: \"pflicht\", module: { path: \"^src/a\\\\.js$\" }, to: { path: \"^src/\" } }] };"
    ],
    "tools/bereiche.json": ["[{\"bereich\": \"probe\", \"quellen\": [\"^src/a\\\\.(js|ts)$\"]}]"],
    "test/werkzeuge/rotproben/probe/pruefung.json": [
      "{\"pfade\": [\"tools/\", \"src/*.js\"], \"probe\": {\"mitnehmen\": [\"tools/gate-tests.json\"]}}"
    ]
  },
  "dateien": {
    "test/werkzeuge/rotproben/probe/pruefung.json": ["{\"pfade\": [\"tools/weg.mjs\"]}"]
