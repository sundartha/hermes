{
  "titel": "ESLint-Regeln",
  "pfade": [
    "eslint.config.*",
    "eslint-suppressions.json",
    "eslint-suppressions.empty.json",
    "eslint-legacy-exceptions.json"
  ],
  "treffer": {
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      ".",
      "--suppressions-location",
      "eslint-suppressions.empty.json",
      "--format",
      "json"
    ],
    "zaehlen": "eslint-json"
  },
  "ausnahmen": {
    "bezeichnung": "Unterdrückte Verstöße in eslint-suppressions.json",
    "datei": "eslint-suppressions.json",
    "zaehlen": "summe"
  },
  "probe": {
    "mitnehmen": [
      "eslint.config.js",
      "src/store.js",
      "tsconfig.json",
      "tools/eslint-rules/index.js",
      "tools/eslint-rules/bestand.js",
      "tools/eslint-rules/keine-kommentare.js",
      "tools/eslint-rules/kein-quelltext-als-text.js",
      "tools/eslint-rules/pfad-falten.js",
      "tools/eslint-rules/namen-ohne-begruendung.js",
      "tools/eslint-rules/knoten.js"
    ],
    "befehl": [
      "node",
      "{wurzel}/node_modules/eslint/bin/eslint.js",
      "--format",
      "json",
      "{dateien}"
    ]
  }
}
