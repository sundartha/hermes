{
  "titel": "Injection-Muster (Semgrep)",
  "pfade": [
    "tools/basis-vergleich.mjs",
    "tools/basis/semgrep-regeln.json",
    "tools/basis/semgrep.json",
    "tools/umbenennung.mjs",
    "tools/syntaxbaum.mjs",
    "tools/bestand-rueckfuehrung.mjs"
  ],
  "treffer": {
    "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "semgrep"],
    "zaehlen": "zahlen",
    "vor": [" neue Befunde", " bekannte"]
  },
  "ausnahmen": {
    "bezeichnung": "Eingefrorene Befunde in der Basislinie",
    "datei": "tools/basis/semgrep.json",
    "zaehlen": "anzahl",
    "anlegen": {
      "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "semgrep", "--basis-anlegen"]
    }
  },
  "probe": {
    "mitnehmen": ["tools/basis/semgrep-regeln.json", "tools/basis/semgrep.json"],
    "befehl": ["node", "{wurzel}/tools/basis-vergleich.mjs", "semgrep", "--basis", "HEAD~1"]
  },
  "benoetigt": "semgrep"
}
